  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምር ፡ ብዙኅ ፡ ከሠተ ፡ በተአምር ፡ ብዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅ ፡ ሞተ ፡ በተአምር ፡ ብዙኅ ፡ በመስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀል ፡ ሰባት ፡ ተአምራት ፡ አድርጎ ፡ ከሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ በኋላ ፡ ሕያው ፡ በተአምር ፡ ብዙኅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመለኮታዊ ፡ ሕይወት ፡ ሕያው ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ከጎኑ ፡ ትኩስ ፡ ደም ፡ ጥሩ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍሶ ፡ ከሠተ ፡ በተአምር ፡ ብዙኅ ፡ በዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግ ፡ ደጅ ፡ ገብቶ ፡ ሰላም ፡ ለክሙ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሱን ፡ የገለጠላቸው ፡ እሊህ ፡ ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርብዓ ፡ ዕለተ ፡ ሲል ፡ ነው ፡ አርባ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን ፡ ሲታያቸው ፡ ኑሮ ፡ እስካረገባት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን ፡ ድረስ ፡ ምነው ፡ ሦስት ፡ ቀን ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለም ፡ የታያቸው ፡ ቢሉ ፡ ከዚያው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብቶ ፡ ከተቈጠረ ፡ ብሎ ። አንድም ፡ የጉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባኤውን ፡ መናገር ፡ ነው ፡ እንጂ ፡ ላን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዱም ፡ ለሁለቱም ፡ ባለሟሎቹ ፡ ሳይታያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ አይውልም ፡ አያድርም ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይዜንዎሙ ፡ ወይነግሮሙ ፡ በእንተ ፡ መንግሥተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዜንዎሙ ፡ ኦሪትን ፡ ይነግሮሙ ፡ ወን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌልን ። አንድም ፡ ይዜንዎሙ ፡ ወንጌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን ፡ ይነግሮሙ ፡ ከዚያው ፡ ከውስጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምቅድመ ፡ ይትወለድ ፡ አብርሃም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀሎኩ ፡ አነ ፡ ትላለችና ። አንድም ፡ ይነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሮሙ ፡ ወንጌልን ፡ ይዜንዎሙ ፡ መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፈ ፡ ኪዳንን ፡ ሲያስተምሯቸው ፡ ሉቃ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፯ ፥ ፳ ፥ ፳፩፥ ሮሜ ፡ ፲፬ ፥ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪፬ ፤ ክፍል ፡ ፩ ፤ ወእንዘ ፡ ይመስሕ ፡ ምስሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሯቸው ፡ ሲመገብ ፡ ኑሮ ፡ እስካረገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባት ፡ ቀን ፡ ድረስ ። አዘዞሙ ፡ ማንሻ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሯቸው ፡ ሲመገብ ፡ ኑሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አዘዞሙ ፡ ኢይፃኡ ፡ እምኢየሩሳሌም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአርብዓ ፡ ዕለት ፡ አዘዞሙ ፡ በአርባኛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቱ ፡ ቀን ፡ ከኢየሩሳሌም ፡ እንዳይወጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንትሙሰ ፡ ንበሩ ፡ ሀገረ ፡ ኢየሩሳሌም ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስከ ፡ ትለብሱ ፡ ኃይለ ፡ እምዓርያም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ አዘዛቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ ፡ ይጽንሑ ፡ ተስፋሁ ፡ ለአብ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሠውጥ ፡ እምነ ፡ መንፈስየ ፡ ዲበ ፡ ኵሉ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሥጋ ፡ ብሎ ፡ የናገረው ፡ ተስፋ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስን ፡ ደጅ ፡ ይጠኑ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጂ ፡ በሰቂለ ፡ ሕሊና ፡ ለማኖር ፡ ለማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለበም ። አንድም ፡ መንፈስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚወርድ ፡ ባንድ ፡ ቦታ ፡ ነው ፡ ካንዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ አንዱ ፡ ሲሉ ፡ ከነግ ፡ ከሠለስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንመለሳለን ፡ ሲሉ ፡ እንዳይቀርባቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በመንፈስ ፡ ቅዱስ ፡ ባልታደሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውነታቸው ፡ አሕዛብ ፡ መከራ ፡ አጽን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተውባቸው ፡ እንዳይክዱ ፡ ዮሐ፡ ፲፭፥ ፳፮።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፡ ፳፬ ፥ ፵፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪፭ ፤ ወይቤሎሙ ፡ ዮሐንስ ፡ አጥመቀ ፡ በማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ፡ በውኃ ፡ ብቻ ፡ አጠመቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንትሙሰ ፡ ታጠምቁ ፡ በመንፈስ ፡ ቅዱስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተ ፡ ግን ፡ በመንፈስ ፡ ቅዱስ ፡ ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠምቃላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስከ ፡ ኅዳጥ ፡ መዋዕል ፡ ዘኢኮነ ፡ ርሑቀ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩቅ ፡ ያይደለ ፡ እስከ ፡ ቅርብ ፡ ቀን ፡ ብዙ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያይደለ ፡ እስከ ፡ ጥቂት ፡ ቀን ፡ ድረስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታጠምቃላችሁ ፡ አላቸው ፡ ም ፡ ፲፩ ፥ ፲፮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፫ ፥ ፳፬። ማቴ ፡ ፫ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "⟪፮ ፤ ክፍል ፡ ፫ ፤ ወእንዘ ፡ ጉቡአን ፡ እሙንቱ ፡ ተስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
