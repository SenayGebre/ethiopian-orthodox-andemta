    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርኀ ፡ ትፍሥሕት ፡ ነው ፡ ሲሉ ፡ ሉቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፬ ፡ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወይቤልዎሙ ፡ አንትሙ ፡ ሰብአ ፡ ገሊላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንትኑ ፡ ቆምክሙ ፡ ትርአዩ ፡ ሰማየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምንት ፡ ቆምክሙ ፡ ትርአዩ ፡ ሰማየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንተ ፡ ትርአዩ ፡ ይላል ፡ እናንት ፡ የገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊላ ፡ ሰዎች ፡ ሰማይ ፡ ሰማይ ፡ እያያችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምን ፡ ቆማችኋል ፡ በሰማይ ፡ ምን ፡ ል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዩ ፡ ቁማችኋል ፡ አሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዝውእቱ ፡ ኢየሱስ ፡ ዘዓርገ ፡ እምኀቤክሙ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከናንት ፡ ተለይቶ ፡ ወደ ፡ ሰማይ ፡ ሲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርግ ፡ ያያችሁት ፡ ይህ ፡ ኢየሱስ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከማሁ ፡ ካዕበ ፡ ይመጽእ ፡ በከመ ፡ ርኢክምዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዓርግ ፡ ሰማየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በብርሃን ፡ በሥልጣን ፡ በቅዳሴ ፡ ሲዓርግ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳያችሁት ፡ ዳግመኛ ፡ በብርሃን ፡ በሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጣን ፡ በቅዳሴ ፡ ይመጣል ፡ ሲመጣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዩታላችሁ ። አንድም ፡ በክበበ ፡ ትስብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እት ፡ ሲዓርግ ፡ እንዳያችሁት ፡ ዳግመኛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በክበበ ፡ ትስብእት ፡ ይመጣል ፡ ሲመጣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዩታላችሁ ፡ አሏቸው ፡ መላእክት ፡ ሐፀ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳት ፡ ኲናተ ፡ እሳት ፡ ይዘው ፡ አይተው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበርና ፡ ያ ፡ ያየነው ፡ እሳት ፡ አቃጥሎት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሆን ፡ እንዳይሉ ፡ በክበበ ፡ ትስብእት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲያርግ ፡ እንዳያችሁት ፡ ዳግመኛ ፡ በክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በበ ፡ ትስብእት ፡ ሲመጣ ፡ ታዩታላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ፡ ሉቃ ፡ ፳፩ ፡ ፳፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእምዝ ፡ ተሠውጡ ፡ ኢየሩሳሌም ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብረ ፡ ዘይት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ከደብረ ፡ ዘይት ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሩሳሌም ፡ ተመለሱ ፡ እንዲያው ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለም ፡ መላእክት ፡ ኦ ፡ ውሉደ ፡ ሰላም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "እትዉ ፡ በሰላም ፡ ብለዋቸዋል ፡ ሰግደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተመልሰዋል ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘእቱት ፡ እምኢየሩሳሌም ፡ መጠነ ፡ ምርዋጸ ፡ ብእሲ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጐልማሳ ፡ አፍታ ፡ ሩጦ ፡ ከቡድ ፡ ሸክም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሸክሞ ፡ የሚያርፍባትን ፡ ያህል ፡ ከኢየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩሳሌም ፡ የምትርቅ ፡ ብሎ ፡ ለደብረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይት ፡ ይቀጥላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንተ ፡ ይእቲ ፡ መንገደ ፡ ቀዳም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይችውም ፡ የቅዳሜ ፡ መንገድ ፡ ያህል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምትርቅ፡ ናት ፡ ቅዳሜ፡ እስከ ፡ ሠለስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድውይ ፡ ለመጠየቅ ፡ ቤተ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ እጅ ፡ ለመንሣት ፡ ምውት ፡ ለመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅበር ፡ መንገድ ፡ ታዝዟልና ፡ አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንገለ ፡ ቀዳም ፡ ይላል ፡ በምሥራቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኩል ፡ ያለች ፡ ሰብአ ፡ ቄዴም ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብአ ፡ ምሥራቅ ፡ ሲል ፡ ጽባሒሃ ፡ ለኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሩሳሌም ፡ ይላታልና ፡ ሉቃ ፡ ፳፬ ፡ ፶ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወበጺሖሙ ፡ ማኅደሮሙ ፡ ኀበ ፡ ይነብሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽርሐ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኅደርና ፡ ጽርሕ ፡ አንድ ፡ ወገን ፡ ወደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚአድሩበት ፡ አዳራሽ ፡ በደረሱ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዓርጉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገቡ ። አንድም ፡ ማኅደርና ፡ ጽርሕ ፡ በየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሱ ፡ ወደሚያድሩበት ፡ በደረሱ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓርጉ፡ ጽርሐ፡ ከአዳራሽ፡ ገቡ፡ (ጥቅ)፡ ወዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርጉ፡ቤተ ፡ መቅደስ ፡ እንዲል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እርከን ፡ እርከን ፡ ያለው ፡ ነውና ፡ ዓርጉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ጴጥሮስ ፡ ወዮሐንስ ፡ ወያዕቆብ ፡ ወእንድርያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
