        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰበሰቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ሰምዕዎሙ ፡ ይነብቡ ፡ ኵሎሙ ፡ በነገረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐውርቲሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በየሀገራቸው ፡ ቋንቋ ፡ ሲናገሩ ፡ ሰምተዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪፯ ፤ ወደንገፁ ፡ ወአንከሩ ፡ ወይቤሉ ፡ አኮኑ ፡ ሰብ",
