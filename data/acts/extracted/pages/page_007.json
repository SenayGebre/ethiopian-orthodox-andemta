        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ነግህ ፡ ብሔሩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜው ፡ ነግህ ፡ ነውና ፡ (ጥቅ) ፡ ወትእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምርት ፡ ለብሔር ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሶቤሁ ፡ ሠለስቱ ፡ ሰዓት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እልፍም ፡ ቢል ፡ ሦስት ፡ ሰዓት ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ፡ ጴጥሮስ ። አንድም ፡ ጊዜው ፡ ነግህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ፡ ይላል ፡ ጴጥሮስ ፡ እልፍም ፡ ቢል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስት ፡ ሰዓት ፡ ነበርና ፡ ይላል ፡ ሉቃስ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ጊዜው ፡ ነግህ ፡ ነበርና ፡ እልፍም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢል ፡ ሦስት ፡ ሰዓት ፡ ነበርና ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃስ ፡ ባገራቸው ፡ ልማድ ፡ ረታቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባገራቸው ፡ የሚጽፍ ፡ ሲጽፍ ፡ የሚደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉስ ፡ ሲደጉስ ፡ አርፍዶ ፡ ቀትር ፡ ሲሆን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እህል ፡ ቀምሶ ፡ አርፎ ፡ ይነሣልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪፲፮ ፤ አላ ፡ ዝ ፡ ውእቱ ፡ ዘይቤ ፡ ኢዩኤል ፡ ነቢይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቢዩ ፡ ኢዩኤል ፡ የተናገረው ፡ ነገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢደርስ ፡ ቢፈጸም ፡ ነው ፡ እንጅ ፡ ይደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስ፡ይፈጸም፡ዘንድ፡ነው፡እንጅ፤ኢዩ፡፫፡፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪፲፯ ፤ ወይከውን ፡ እምድኅረ ፡ ዝ ፡ መዋዕል ፡ ይቤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ እሰውጥ ፡ እምነ ፡ መንፈስየ ፡ ዲበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ ዘሥጋ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምስት ፡ ሺሕ ፡ አምስት ፡ መቶ ፡ ዘመን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲፈጸም ፡ በሥጋዊ ፡ በደማዊ ፡ ሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ የባሕርይ ፡ ሕይወቴ ፡ መንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስን ፡ አሳድርበታለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይትኔበዩ ፡ ደቂቅክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቂቅክሙ ፡ ሐዋርያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዋልዲክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠላሳ ፡ ስድስቱ ፡ ቅዱሳት ፡ አንስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወራዙቲክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብዓ ፡ አርድእት ፡ ራእይ ፡ ያያሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሊቃውንቲክሙ ፡ ሕልመ ፡ የሐልሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስ ፡ በናሕሰ ፡ ኢዮጴ ፡ ዮሐንስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "በደሴተ ፡ ፍጥሞ ፡ ራእይ ፡ ያያሉ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "⟪፲፰ ፤ ወላዕለ ፡ አግብርትየ ፡ ወአዕማትየ ፡ እከዑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምነ ፡ መንፈስየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰብአ ፡ ቆርኔሌዎስ ፡ የባሕርይ ፡ ሕይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቴ ፡ መንፈስ ፡ ቅዱስን ፡ አሳድርባቸዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሁ ፡ ይትኔበዩና ፡ ይትኔበዩ ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገን ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይእተ ፡ አሚረ ፡ ይትኔበዩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ ሁሉም ፡ በሰባ ፡ ሁለት ፡ ቋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቋ ፡ ይናገራሉ ፡ አለ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ነቢዩ ፡ ኢዩኤል ፡ የተናገረው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢደርስ ፡ ቢፈጸም ፡ ነው ፡ እንጅ ፡ ይደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስ ፡ ይፈጸም ፡ ዘንድ ፡ ነው ፡ እንጅ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ (ወይትኔበዩ ፡ ደቂቅክሙ ፡) ፡ ሰብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓ ፡ አርድዕት ፡ (ወአዋልዲክሙ) ፡ አርባዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዋልደ ፡ ፊልጶስ ፡ (ወወራዙቲክሙ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ እስጢፋኖስ ፡ እለ ፡ አጋቦስ ፡ (ወሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃውንቲክሙ)፡ ሐዋርያት ፡ ራእይ፡ ያያሉ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ ሊቃውንቲክሙሰ፡ የናንት፡ ሊቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውንት ፡ ሐና ፡ ቀያፋስ ፡ የሐሰት ፡ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህርት ፡ ያስተምራሉ ፡ ም ፡ ፳፩ ፥ ፱ ። (ወላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕለ ፡ አግብርትየ ፡ ወአእማትየ ፡ እከዑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምነ ፡ መንፈስየ) ፡ እስከ ፡ ምጽአት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድረስ ፡ በሚነሱ ፡ በምእመናን ፡ የባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወቴ ፡ መንፈስ ፡ ቅዱስን ፡ አሳድርባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋለሁ ፡ (ወይእተ ፡ አሚረ ፡ ይትኔበዩ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ በቋንቋ ፡ ይናገራሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪፲፱ ፤ ወእሁብ ፡ ትእምርተ ፡ በሰማይ ፡ በላዕሉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምድር ፡ በላይ ፡ ባለ ፡ በሰማይ ፡ ምል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክት ፡ አሳያለሁ ፡ ሰማይ ፡ ዝናም ፡ ለዘር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠል ፡ ለመከር ፡ እንዳይሰጥ ፡ አደርጋለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመንክረ ፡ በምድር ፡ በታሕቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሰማይ ፡ በታች ፡ ባለ ፡ ምድርም ፡ ምል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክት ፡ አሳያለሁ ፡ አለ ፡ ምድር ፡ የዘሩባትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳታበቅል ፡ የተከሉባትን ፡ እንዳታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸድቅ ፡ አደርጋለሁ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ደመ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ፡ በጺዋዌ ፡ የእስራኤል ፡ ደማቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይፈሳል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእሳተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤታቸው ፡ በእሳት ፡ ይቃጠላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጢሰ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢስ ፡ ይታያል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪፳ ፤ ፀሓይኒ ፡ ይጸልም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀሓይ ፡ ጨለማ ፡ ይሆናል ፡ አለ ፡ ፀሓይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቀ ፡ ካህናቱ ፡ ይጠፋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወርኅኒ ፡ ደመ ፡ ይከውን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጨረቃም ፡ ደም ፡ ይሆናል ፡ አለ ፡ ወርኅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሡ ፡ ይጠፋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "⟪፳፩ ፤ ዘእንበለ ፡ ትብጻሕ ፡ ዕለተ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐባይ ፡ ወግርምት ፡ ወኵሉ ፡ ዘጸውዐ ፡ ስመ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ይድኅን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐባይ ፡ ግርምት ፡ የምትሆን ፡ ዕለተ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ዕለተ ፡ ጺዋዌ ፡ ሳትደስር ፡ ስመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርን ፡ የጠራ ፡ ሁሉ ፡ ይድናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንባቆም ፡ ለጺዋዌ ፡ ሁለት ፡ ዓመት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲቀር ፡ ፍልስጥኤም ፡ ሂዶ ፡ ድኗል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በሚጠት ፡ ቢሉ ፡ ደመ ፡ የአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዛብ ፡ ደማቸው ፡ ይፈሳል ፡ ወእሳተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤታቸው ፡ በእሳት ፡ ይቃጠላል ፡ ወጢሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢስ ፡ ይታያል ። ፀሓይኒ ፡ ይጸልም ፡ ፀሓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ ፡ የአሕዛብ ፡ ንጉሡ ፡ ይጠፋል ፡ ወወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኅኒ ፡ ደመ ፡ ይከውን ፡ ወርኅ ፡ ቢትወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደዱ ፡ ይጠፋል ፡ ዘእንበለ ፡ ትብጻሕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕለተ ፡ እግዚአብሔር ፡ ዓባይ ፡ ወግር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምት ፡ ዕለተ ፡ እግዚአብሔር ፡ ዕለተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚጠት ፡ ሳትደርስ ፡ የእግዚአብሔርን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስም ፡ የጠራ ፡ ሁሉ ፡ ይድናል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማይ ፡ ምልክት ፡ አሳያለሁ ፡ በምድር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ምልክት ፡ አሳያለሁ ፡ ሁለት ፡ አር",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስት ፡ ተናግሯል ፡ ለሁለቱም ፡ ያመጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ፡ (ደመ) ፡ ምድር ፡ ላለው ፡ አመጣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ፡ ወልደ ፡ እግዚአብሔር ፡ ይፈሳል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወእሳተ) ፡ ሰማይ ፡ ላለው ፡ አመጣ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ በአምሳለ ፡ እሳት ፡ ይሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣል ፡ ወጢሰ ፡ ስለ ፡ ሀብቱ ፡ ብዛት ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ አንድ ፡ ወገን ፡ ምድር ፡ ላለው ፡ ደመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ፡ ወልደ ፡ እግዚአብሔር ፡ ይፈሳል ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳተ ፡ ሙቀት ፡ ያለው ፡ ነውና ፡ ወጢሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተንታ ፡ ያለው ፡ ነውና ፡ ፀሓይኒ ፡ ይጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልም ፡ ፀሓይ ፡ ሰማይ ፡ ላለው ፡ አመጣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀሓይ ፡ ጨለማ ፡ ይሆናል ፡ ወወርኅኒ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ፡ ይከውን ፡ ጨረቃም ፡ ደም ፡ ይሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናል ፡ ዘእንበለ ፡ ትብጻሕ ፡ ዕለተ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ዐባይ ፡ ወግርምት ፡ ወኵሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘጸውዐ ፡ ስመ ፡ እግዚአብሔር ፡ ይድኅን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕለተ ፡ እግዚአብሔር ፡ ዕለተ ፡ ትንሣኤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳትደርስ ፡ ስመ ፡ እግዚአብሔርን ፡ የጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራ ፡ ሁሉ ፡ ይድናል ፡ ፈያታዊ ፡ ዘየማን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተዘከረኒ ፡ እግዚኦ ፡ በውስተ ፡ መንግሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትከ ፡ ብሎ ፡ ድኗል ። አንድም ፡ በሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምልክት ፡ አሳያለሁ ፡ አለ ፡ በሮም ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻርና ፡ በኢየሩሳሌም ፡ አንጻር ፡ ያሉ ፡",
          "word_wraps_to_next_line": false
        },
