        },
        {
          "line_num": 14,
          "margin_tag": "፵፪",
          "line_type": "body",
          "text": "፵፪ ፤ ⟪ወነበሩ ፡ ይፀመዱ ፡ ትምህርተ ፡ ሐዋርያት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
