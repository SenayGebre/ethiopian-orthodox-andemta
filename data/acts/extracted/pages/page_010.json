          "text": "ገንዘባቸውንም ፡ ሁሉ ፡ እየሸጡ ፡ ለነዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
