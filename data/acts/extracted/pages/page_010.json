      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወድሙር ፡ ኵሉ ፡ ንዋዮሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገንዘባቸውም ፡ ሁሉ ፡ ባንድነት ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፵፭",
          "line_type": "body",
