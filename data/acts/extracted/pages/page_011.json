        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዘብየሰ ፡ እሁብከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንኪያ ፡ ምን ፡ ይዘህልኛል ፡ ትለኝ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ሆነ ፡ ከያዝሁትስ ፡ እሰጥሃለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ናሁ ፡ በስሙ ፡ ለኢየሱስ ፡ ክርስቶስ ፡ ናዝራዊ ፡ ተን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥእ ፡ ወሑር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሆ ፡ በጌታችን ፡ በኢየሱስ ፡ ክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስም ፡ አምነህ ፡ ተነሣ ፡ ም ፡ ፲፬ ፥ ፱ ፥ ፲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአኀዞ ፡ በእዴሁ ፡ ዘየማን ፡ ወአንሥኦ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዴሁ ፡ ለጴጥሮስ ፡ በቀኝ ፡ እጁ ፡ ይዞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ እዴሁ ፡ ለድውይ ፡ ቀኝ ፡ እጁን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዞ ፡ አስነሣው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪፯ ፤ ወተንሥአ ፡ ሶቤሃ ፡ ወጸንዐ ፡ እገሪሁ ፡ ወሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቌሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግሩ ፡ ጸንቶለት ፡ ወገቡ ፡ ቀንቶለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥግ ፡ መቋሚያ ፡ ሳይሻ ፡ ተነሥቶ ፡ ማቴ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "፰ ፥ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሖረ ፡ ምስሌሆሙ ፡ እንዘ ፡ ይሠግር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስና ፡ ዮሐንስ ፡ የተራመዱትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየተራመደ ፡ ሄደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪፰ ፤ ወቦአ ፡ ምኵራበ ፡ ወአእኰቶ ፡ እግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምኵራቡ ፡ ገብቶ ፡ እግዚአብሔርን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመሰገነ ፡ ከዚህ ፡ ጊዜ ፡ ያደረስኸኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከደዌዬ፡የፈወስኸኝ፡ብሎ፡ኢሳ፡፴፭፥፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪፱ ፤ ወርእይዎ ፡ ኵሎሙ ፡ ሕዝብ ፡ እንዘ ፡ የሐውር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወያአኵት ፡ እግዚአብሔርሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡም ፡ ሁሉ ፡ እግዚአብሔርን ፡ እያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰገነ ፡ ሲሄድ ፡ ባዩት ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪፲ ፤ ወአእመርዎ ፡ ከመ ፡ ውእቱ ፡ ዘይነብር ፡ ኆኅተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኵራብ ፡ እንተ ፡ ስማ ፡ ኦርያ ፡ ወይስእል ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦርያ ፡ በምትባል ፡ ምኵራብ ፡ ደጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀምጦ ፡ ምጽዋት ፡ ሲለምን ፡ የነበረው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ እንደ ፡ ሆነ ፡ አውቀው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወደንገፁ ፡ ወአንከሩ ፡ በእንተ ፡ ዘኮነ ፡ ተአምር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዕሌሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለርሱ ፡ ስለ ፡ ተደረገው ፡ ነገር። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርሱ ፡ ስለ ፡ ተደረገው ፡ ነገር ፡ የአንክሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድንጋጤ ፡ ደነገጡ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪፲፩ ፤ ወእንዘ ፡ ይእኅዝዎ ፡ ጴጥሮስ ፡ ወዮሐንስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይበውኡ ፡ ምኵራበ ፡ ሮጹ ፡ ኵሉ ፡ ሕዝብ ፡ ኀቤሆሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ ፡ ሕዋረ ፡ ሰሎሞን ፡ ድንጉፃኒሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስ ፡ ቀኝ ፡ እጁን ፡ ዮሐንስ ፡ ግራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጁን ፡ ይዘውት ፡ ወደ ፡ ምኵራቡ ፡ ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገቡ ፡ በሕዋረ ፡ ሰሎሞን ፡ የነበሩ ፡ ወደሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋረ ፡ ሰሎሞን ፡ ሲገቡ ፡ በምኵራቡ ፡ የነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሩ ፡ ሕዝቡ ፡ የአንክሮ ፡ ድንጋጤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየደነገጡ ፡ ወደነሱ ፡ ቀረቡ ፡ ም፡ ፭፥ ፲፪ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪፲፪ ፤ ክፍል ፡ ፮ ፤ ወሶበ ፡ ርእዮሙ ፡ ጴጥሮስ ፡ ለሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስም ፡ ሕዝቡን ፡ እያደነቁ ፡ ሲመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡ ፡ ባያቸው ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይቤሎሙ ፡ አንትሙ ፡ ሰብአ ፡ እስራኤል ፡ ምንተኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታነክሩነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንት ፡ የእስራኤል ፡ ልጆች ፡ ለምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታደንቁናላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምንተኑ ፡ ትኔጽሩነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክብራችሁስ ፡ ለምን ፡ ታዩናላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ዘበኃይልነ ፡ ገበርናሁ ፡ ወከመ ፡ ዘበሥልጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንነ ፡ ረሰይናሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኛ ፡ ኃይል ፡ በኛ፡ ሥልጣን፡ እንዳዳነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አድርጋችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አው ፡ እምኀበ ፡ ነፍሳቲነኑ ፡ አሕየውናሁ ፡ ለዝንቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ፡ ይሑር ፡ በእገሪሁ ።⟫",
          "word_wraps_to_next_line": false
        },
