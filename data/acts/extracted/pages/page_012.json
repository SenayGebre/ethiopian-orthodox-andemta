        },
        {
          "line_num": 7,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወእንዘ ፡ ይነግሮሙ ፡ ለሕዝብ ፡ መጽኡ ፡ ሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃነ ፡ ካህናት ፡ ወመገብተ ፡ ምኵራብ ፡ ወሰዱቃው",
          "word_wraps_to_next_line": true
        },
