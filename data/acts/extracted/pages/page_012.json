          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይደመሰስ ፡ ለክሙ ፡ ኃጢአትክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃጢአታችሁ ፡ ይሠረይላችኋል ፡ አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይመጽእ ፡ ለክሙ ፡ መዋዕለ ፡ ሣህል ፡ እምቅድመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገጹ ፡ ለእግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእግዚአብሔር ፡ ዘንድ ፡ የይቅርታ ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መን ፡ ይመጣላችኋል ፡ አለ ፡ በይቅርታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚገኝ ፡ ክብር ፡ ይሰጣችኋል ፤ ም ፡ ፪ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "፴፰ ፤ ኢሳ ፡ ፴፮ ፡ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "፳ ፤ ⟪ወይፌንዎ ፡ ለክሙ ፡ ለኢየሱስ ፡ ክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘአቅደመ ፡ ቀቢአ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስቀድሞ ፡ ያነገሠው ፡ ኢየሱስ ፡ ክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶስን ፡ ይሰድላችኋል ፤ ዳን ፡ ፯ ፡ ፳፪ ፡ ፳፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮሜ ፡ ፰ ፡ ፳፩ ። ራእ ፡ ፳ ፡ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "፳፩ ፤ ⟪ዘኪያሁ ፡ ይሴፈዉ ፡ ሰማያት ፡ ወምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስከ ፡ አመ ፡ ያስተራትዕ ፡ ኵሎ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉን ፡ እስቲያከናውን ፡ ድረስ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ ያሳልፈናል ፡ ብለው ፡ ደጅ ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠኑት።አንድም፡መላእክት፡ደቂቀ፡አዳም።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ በአጸደ ሥጋ፡በአጸደ፡ ነፍስ፡ያሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ልዑላኑ ፡ ትሁታኑ ፡ ዋጋችንን ፡ ይሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠናል ፡ ብለው ፡ ተስፋ ፡ የሚያደርጉት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡አምስት፡ ሽሕ፡ ከአምስት፡ መቶ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመን ፡ የነበሩ ፡ ነፍሳት ፡ ዋጋችንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰጠናል ፡ ብለው ፡ ደጅ ፡ ይጠኑት ፡ የነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በከመ ፡ ነበበ ፡ እግዚአብሔር፡ በነቢያቲሁ፡ቅዱሳን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ እምዓለም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከደጋጉ፡ ወገን፡ በሚሆኑ ። አንድም ፡ አስቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድመው ፡ በነበሩ ፡ በነቢያት ፡ አድሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ተናገረ ፡ ሁሉን ፡ እስቲያከናውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድረስ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "፳፪ ፤ ⟪ሙሴሂ ፡ ይቤሎሙ ፡ ለአበዊነ ፡ ነቢየ ፡ ያነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥእ ፡ ለክሙ ፡ እግዚአብሔር ፡ አምላክነ ፡ እምአኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊክሙ ፡ ዘከማየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙሴም ፡ ለአባቶቻችን ፡ ከወገኖቻችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደኔ ፡ ያለ ፡ ነቢይ ፡ ያስነሣላችኋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሎቱ ፡ ስምዕዎ ፡ ኵሎ ፡ ዘይቤለክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስተማራችሁን ፡ ትምህርት ፡ ተቀበሉት፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘዳግ ፡ ፲፰ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "፳፫ ፤ ⟪ወኵላ ፡ ነፍስ ፡ እንተ ፡ ኢትሰምዖ ፡ ለውእቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቢይ ፡ ለትሠረው ፡ እምሕዝባ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ ያስተማረውን ፡ ትምህርት ፡ የማት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀበል ፡ ሰውነት ፡ ሁሉ ፡ ከወገኗ ፡ ተለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይታ ፡ በደንጊያ ፡ ተወግራ ፡ በእሳት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቃጥላ ፡ ትሙት ፡ ብሎ ፡ ተናግሯል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "፳፬ ፤ ⟪ወኵሎሙ ፡ ነቢያት ፡ እለ ፡ እምአመ ፡ ሳሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ነቢይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሳሙኤል፡ አስቀድሞ፡ በሳሙኤል፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእለኒ ፡ እምድኅሬሁ ፡ ነገሩ ፡ ወአይድዑ ፡ በእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እላንቱ ፡ መዋዕል ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሳሙኤል ፡ በኋላ ፡ የተነሡ ፡ ነቢያትም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዘመኑን፡የጊዜውን፡ ነገር፡ ተናግረዋል፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "መን፡ሦስት፡ ዓመት፡ ከሦስት፡ ወር፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ትውልድ ፡ ሐዋርያት ፡ እንደ ፡ ሆኑ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "፳፭ ፤ ⟪ወአንትሙ ፡ ውሉዶሙ ፡ ለነቢያት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተም ፡ የነቢያት ፡ ልጆች ፡ ናችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውሉደ፡ሥርዐት፡ዘሠርዖ፡ እግዚአብሔር፡ ለአበዊነ ፡⟫",
