        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሎሙ ፡ ዘመደ ፡ ካህናት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "የካህናት ፡ ወገኖች ፡ ሁሉ ፡ ተሰብስበው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናት ፡ ደቂቀ ፡ አሮን ፡ ዘመድ ፡ ደቂቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀዓት ፡ ካህናት ፡ ደቂቀ ፡ ቀዓት ፡ ዘመድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቂቀ ፡ ሜራሪ ፡ ካህናት ፡ ደቂቀ ፡ ሜራሪ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመድ ፡ ደቂቀ ፡ ጌድሶር ፤ ም ፡ ፭ ፡ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፡ ፫ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወአቀምዎሙ ፡ ማዕከለ ፡ አውድ ፡ ወሐተት⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባደባባይ ፡ መካከል ፡ አቁመው ፡ መረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሯቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎሙ ፡ በኀይለ ፡ መኑ ፡ ወበስመ ፡ መኑ ፡ ገበ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ርክሙ ፡ ዘንተ ፡ አንትሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ተአምራቱን ፡ በማን ፡ ስም ፡ በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ኃይል ፡ አደረጋችሁት ፡ ብለው ፤ ማቴ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፩ ፡ ፳፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወመልአ ፡ መንፈስ ፡ ቅዱስ ፡ ሶቤሃ ፡ ላዕለ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ጴጥሮስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ በጴጥሮስ ፡ መንፈስ ፡ ቅዱስ ፡ አደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረበት ፡ ተለይቶትን ፡ ያውቃል ፡ ምላሽ ፡ ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጠለት ፡ ለማለት ፡ ነው ፤ ሉቃ ፡ ፲፪ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወይቤሎሙ ፡ ስምዑ ፡ መላእክተ ፡ ሕዝብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወረበናት ፡ ለእመሁ ፡ ንሕነ ፡ ንትኳነን ፡ ኀቤክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በእንተ ፡ ረድኤተ ፡ ሕሙም ፡ ዘኮነ ፡ ዮም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሕዝቡ ፡ አለቆች ፡ ረበናት ፡ ስሙ ፡ ዛሬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ተደረገው ፡ ስለ ፡ ሕሙሙ ፡ ድኅነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከናንት ፡ ዘንድ ፡ ይሞት ፡ በቃ ፡ የሚፈረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድብን ፡ ከሆነ ፤ ዮሐ ፡ ፲ ፡ ፴፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በምንትኑ ፡ እንከ ፡ ሐይወ ፡ ዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ፡ ሰው ፡ በማን ፡ ስም ፡ በማን ፡ ኃይል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳነ ፡ ትላላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪አእምሩ ፡ እንከ ፡ ጥዩቀ ፡ ኵልክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጐላ ፡ በተረዳ ፡ ነገር ፡ ሁላችሁም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕወቁ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሉ ፡ ቤተ ፡ እስራኤል ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤልም ፡ ሁሉ ፡ ይወቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ በስሙ ፡ ለኢየሱስ ፡ ክርስቶስ ፡ ዘአንትሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ቀተልክምዎ ፡ ወእግዚአብሔር ፡ አንሥኦ ፡ እሙ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ታን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንት ፡ ሰቅላችሁ ፡ በገደላችሁት ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ ግን ፡ ከሙታን ፡ ለይቶ ፡ ባስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሣው ፡ በጌታችን ፡ በኢየሱስ ፡ ክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስም ፡ እንደ ፡ ሆነ ፡ አእምሩ ፤ ዕወቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦቱ ፡ ሐይወ ፡ ዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦቱ ፡ ሐይወና ፡ በስሙ ፡ ለኢየሱስ ፡ ያለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ አንድ ፡ ወገን ፡ በሱ ፡ ስም ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳነ ፡ ዕወቁ ፡ እስራኤልም ፡ ሁሉ ፡ ይወቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቆመ ፡ ቅድሜክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፊታችሁ ፡ ቁሞ ፡ ታዩታላችሁ ፤ ም ፡ ፫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪እስመ ፡ ውእቱ ፡ ዕብን ፡ ዘመነንክምዎ ፡ አን⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ትሙ ፡ ነደቅት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ፡ ልቡና ፡ በትምህርት ፡ ምክን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት ፡ እናንጻለን ፡ የምትሉ ፡ እናንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የናቃችሁት ፡ ወልድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ ኮነ ፡ ውስተ ፡ ርእሰ ፡ ማዕዘንት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሠ ፡ ነገሥት ፡ ሊቀ ፡ ካህናት ፡ በኵረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናን ፡ ሁኗልና ፤ ማቴ ፡ ፳፩ ፡ ፵፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዝ ፡ ፻፲፯ ፡ ፳፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወአልቦ ፡ ካልእ ፡ ሕይወት ፡ በዘየሐይዉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሚያምኑ ፡ በሚድኑ ፡ ገንዘብ ፡ ሌላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወት ፡ የለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ፡ ካልእ ፡ ስም ፡ በታሕተ ፡ ሰማይ ፡ ዘይትወ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሀብ ፡ ለእጓለ ፡ እመሕያው ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሰማይ ፡ በታች ፡ ለሰው ፡ ሁሉ ፡ ድኅነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኖ ፡ የሚሰጥ ፡ ሌላ ፡ ስም ፡ የለምና ፤ ማቴ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ፳፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወሶበ ፡ ርእይዎሙ ፡ ለጴጥሮስ ፡ ወለዮሐንስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ገሃደ ፡ ይነግርዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስንና ፡ ዮሐንስንም ፡ ገልጠው ፡ ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስተምሯቸው ፡ ባዩዋቸው ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአእመርዎሙ ፡ ከመ ፡ ሰብእ ፡ የዋሃን ፡ እሙንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያልተማሩ ፡ ሰዎች ፡ እንደ ፡ ሆኑ ፡ አው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢየአምሩ ፡ መጽሐፈ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፍ ፡ ያልተማሩ ፡ ሰዎች ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆኑ ፡ አውቀው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንከርዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አደነቁባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ የአምርዎሙ ፡ ዘልፈ ፡ ከመ ፡ ምስለ ፡ ኢየ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሱስ ፡ ሀለዉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጌታ ፡ ጋራ ፡ ቀድሞ ፡ እንደ ፡ ነበሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውቋቸዋልና ፡ ምነው ፡ ከጌታ ፡ ጋራ ፡ የነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረው ፡ ሁሉ ፡ አላዋቂ ፡ ደንቆሮ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውን ፡ ቢሉ ፡ እየተከራከሩ ፡ ምላሽ ፡ ያሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጧቸው ፡ ነበርና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወይሬእይዎ ፡ ለዝኩሂ ፡ ብእሲ ፡ ዘሐይወ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይቀውም ፡ ምስሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዳነውንም ፡ ያነን ፡ ሰው ፡ ከነሱ ፡ ጋራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይተውት ፡ ነበርና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኀጥኡ ፡ ዘይብሉ ፡ ወዘይነብቡ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይብሉ ፡ ለራሳቸው ፡ ወዘይነብቡ ፡ ለሌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላው ፡ የሚመልሱት ፡ ምላሽ ፡ ቸገራቸው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፫ ፡ ፰ ፡ ፱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወአዘዙ ፡ ያእትትዎሙ ፡ ሕቀ ፡ እምዓውድ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊመክሩለትም ፡ ሊመክሩበትም ፡ ቢሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ቆይ ፡ ማለት ፡ ልማድ ፡ ነውና ፡ ቆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዩ ፡ በሏቸው ፡ አሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተናገሩ ፡ በበይናቲሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቆይታ ፡ እርስ ፡ በርሳቸው ፡ ተነጋገሩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወይቤሉ ፡ ምንተ ፡ ንሬስዮሙ ፡ ለእሉ ፡ ሰብእ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሊህን ፡ ሰዎች ፡ ምን ፡ እናደርጋቸዋለን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንረስዮሙ ፡ ምን ፡ እናድርጋቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ናሁ ፡ ተዐውቀ ፡ ትምህርቶሙ ፡ በኀበ ፡ ኵሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ይነብሩ ፡ ኢየሩሳሌም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምህርታቸው ፡ በኢየሩሳሌም ፡ በሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖሩ ፡ ሰዎች ፡ ከሁሉ ፡ ደርሶ ፡ ተረዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገሃደ ፡ ኮነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተገለጠ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢንክል ፡ ከቢቶቶ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውረን ፡ ልናስቀረው ፡ አይቻለንም ፤ ዮሐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፩ ፡ ፵፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ዳዕሙ ፡ ከመ ፡ ፈድፋደ ፡ ኢይብዛኅ ፡ በላ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዕለ ፡ ሕዝብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ ግን ፡ ለሕዝቡ ፡ ፈጽሞ ፡ እንዳይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ንገሥጾሙ ፡ ከመ ፡ ዳግመ ፡ ኢይንግሩ ፡ በስሙ ፡ ለኢ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪የሱስ ፡ ለሰብእ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙ ፡ ሕይወት ፡ መድኃኒት ፡ እንደ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳያስተምሩ ፡ ሸመጣጠን ፡ እንተዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ብለው ፤ ም ፡ ፭ ፡ ፳፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ወጸውዕዎሙ ፡ ወይቤልዎሙ ፡ ግሙራ ፡ ኢት⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ንግሩ ፡ ወኢትምህሩ ፡ በስሙ ፡ ለኢየሱስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠርተው ፡ ስሙ ፡ ሕይወት ፡ መድኃኒት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ በስሙ ፡ አታስተምሩ ፡ አሏ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "፲፱ ፤ ⟪ክፍል ፡ ፰ ። ወተሠጥውዎሙ ፡ ጴጥሮስ ፡ ወዮ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሐንስ ፡ ወይቤልዎሙ ፡ ይረትዕኑ ፡ በቅድመ ፡ እግዚ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አብሔር ፡ ኪያክሙ ፡ ንስማዕ ፡ ወአኮ ፡ ለእግዚአብ⟫",
          "word_wraps_to_next_line": true
        },
        {
