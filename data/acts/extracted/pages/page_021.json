          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥተ ፡ ኮሎዶጎሞር ፡ ድል ፡ ነሥቶ ፡ በተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መለሰ ፡ ጊዜ ፡ ብዙኅ ፡ ዓስብከ ፡ ብሎታል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንት ፡ ይከውነኒ ፡ ወናሁ ፡ ዘቀደመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዋይየ ፡ ይወርሰኒ ፡ ኢያቦር ፡ ወልደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመድየ ፡ አለው ፡ አኮ ፡ ዘይወርሰከ ፡ ኢያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
