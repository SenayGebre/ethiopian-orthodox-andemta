          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይወፅእ ፡ እምሐቌከ ፡ ውእቱ ፡ ይወር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰከ ፡ ብሎታል ፡ ከዚህ ፡ በኋላ ፡ ለከ ፡ ወለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘርዕከ ፡ እሁብከሃ ፡ ለዛቲ ፡ ሀገር ፡ እስከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
