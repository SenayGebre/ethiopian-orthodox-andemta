        },
        {
          "line_num": 22,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪ወሀሎ ፡ እግዚአብሔር ፡ ምስሌሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
