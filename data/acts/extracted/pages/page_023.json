          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምልብሱ ፡ ብሎ ፡ ሊቁ ፡ ወስዶታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፍጥ ፡ ፴፯ ፥ ፳፰ ።",
