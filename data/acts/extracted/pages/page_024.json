          "text": "ስቦ ፡ ማታ ፡ ግብር ፡ አግብቶላቸዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለራት ፡ አይበቃቸው ፡ የነበረ ፡ ለምሳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚተርፋቸው ፡ ሆኗል ፡ ይኽን ፡ አይቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሥር ፡ ቤት ፡ ጠባቂው ፡ ባንተ፡ ፈቃድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደሩ ፡ ብሎ ፡ ሹሞታል ፡ ኢኀደረ ፡ ዮሴ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍ ፡ እንበለ ፡ ሢመት ፡ ያሰኘው ፡ ይህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ የፈርዖን ፡ ጠጅ ፡ አሳላፊው ፡ የእን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀራ ፡ አሳላፊው ፡ በድለው ፡ ከዚያ ፡ ታስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረው ፡ ነበር ፡ ሕልም ፡ አይተው ፡ የሚተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረጕምላቸው ፡ አጥተው ፡ አዝነው ፡ ሳለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጥቶ ፡ ሲገባ ፡ አይቷቸው ፡ ምነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዝናችኋል ፡ አላቸው ፡ ሕልም ፡ አይተን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚተረጕምልን ፡ አጥተን ፡ አሉት ፡ ሕል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንማ ፡ እንጅ ፡ እግዚአብሔር ፡ የገለጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ፡ ይተረጕማል ፡ ንገሩኝ ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠጅ ፡ አሳላፊው ፡ ሦስት ፡ የወይን ፡ ዘለላ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጌታዬ ፡ ጽዋ ፡ ጠምቄ ፡ ለጌታዬ ፡ ሳሳል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍለት ፡ አየሁ ፡ አለው ፡ ሠላስ ፡ አውያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠላስ ፡ ዕለታት ፡ ናቸው ፡ እስከ ፡ ሦስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን ፡ ጌታህ ፡ከቀደመ ፡ ሹመትህ፡ ይመል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሃል ፡ ነገር ፡ ግን ፡ በግፍ ፡ ታስሬያለሁና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዘክረኒ ፡ በቅድመ ፡ ፈርዖን ፡ እግዚእከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ፡ ሊፈታ ፡ ቀርቦ ፡ የነበረው ፡ ይህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕዳ ፡ ሆኖበት ፡ ሁለት ፡ ዓመት ፡ ኑሯል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእንጀራ ፡ ቤቱም ፡ ይኽን ፡ አይቶ ፡ ለኔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ የሚተረጕምልኝ ፡ መስሎት ፡ እኔም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጅ ፡ አዝማደ ፡ መባልዕትን ፡ በሦስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንቅብ፡ ደራርቤ፡ ተሸክሜ ፡ ስሄድ ፡ አዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋፍ ፡ ከላዬ ፡ ላይ ፡ እየተነጣጠቁ ፡ ሲመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገቡት ፡ አየሁ ፡ ብሎ ፡ ነገረው ፡ ሠላስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክፋር ፡ ሠላስ ፡ ዕለታት ፡ ናቸው ፡ እስከ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስት ፡ ቀን፡ ጌታህ፡ ያሰቅልሃል ፡ ንጉሥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "የገደለው ፡ አንበሳ ፡ የሰበረው ፡ ይታፈራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ የሚቀብርህ ፡ የለም ፡ ሥጋህን ፡ አዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋፍ ፡ እየተነጣጠቁ ፡ ይመገቡታል ፡አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ ይህ ፡ በሆነ ፡ በሦስተኛው ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈርዖን ፡ የተወለደበትን ፡ ቀን ፡ ለማክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በር ፡ በአዳራሽ ፡ ተገኝቶ ፡ ሳለ ፡ አሕዛብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተወለዱበትን ፡ ቀን ፡ ያከብራሉ ፡ ከጨ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማ ፡ ወደ ፡ ብርሃን ፡ ከጠባብ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰፊ ፡ የወጣንበት ፡ ነው ፡ ሲሉ ። አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ፡ ቀን ፡ ተወልደን ፡ ለዚህ ፡ መዓርግ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደረስነ፡ ሲሉ፡ ጠጅ፡ አሳላፊው፡ ሲያጠፋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጀራ ፡ ቤቱ ፡ ሲያከናውን ፡ አይቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሰበው ፡ ያነን ፡ ጠጅ ፡ አሳላፊውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቀደመ ፡ ሹመቱ ፡ መልሱት ፡ ብሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልሰውታል ፡ እንጀራ ፡ አሳላፊውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቀሉት ፡ ብሏቸው ፡ ሰቅለውታል ፡ ለዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያም ፡ ተረጐመለት ፡ ተደረገለት ፡ በዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያም ፡ ተረጐመበት ፡ ተደረገበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወሀቦ ፡ ሞገሰ ፡ ወጥበበ ፡ በቅድመ ፡ ፈርዖን ፡ ንጉሠ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግብፅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለሟልነትን ፡ ሰጠው ፡ ሕልም ፡ መተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርጐምንም ፡ ገለጠለት ፡ ይህ ፡ በሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሁለት ፡ ዓመቱ ፡ ወቆመ ፡ ፈርዖን ፡ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተ ፡ ገበዘ ፡ ተከዚ ፡ ይላል ፡ ራእይ ፡ ያያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ፡ ከወንዝ ፡ ዳር ፡ የቆምሁ ፡ መስሎት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባት ፡ የወፈሩ ፡ የሰቡ ፡ ላሞች ፡ ከባሕር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲወጡ ፡ ሰባት ፡ የከሱ ፡ የጐፈዩ ፡ ላሞች፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከታትለው ፡ ወጥተው ፡ ውጠዋቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቀደመ፡ ከሳታቸው ፡ ሳይለወጡ ፡ ሰባት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለመለሙ ፡ ያፈሩ ፡ ገብሶች ፡ ከዛፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥር ፡ ሲወጡ ፡ ሰባት ፡ የደረቁ ፡ የሰለቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብሶች ፡ ተከታትለው ፡ ወጥተው ፡ ውጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋቸው ፡ ከቀደመ ፡ ከሳታቸው ፡ ሳይለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጡ ፡ አይቶ ፡ አዘነ ፡ ጠጅ ፡ አሳላፊው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢገባ ፡ አዝኖ ፡ አገኘው ፡ ምነው ፡ አዝነ",
