        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች ፡ እንደ ፡ መጣ ፡ እንደ ፡ መጣ ፡ እየተመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገቡ ፡ ሳይጠቀሙ ፡ አይቶ ፡ እንዲህ ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለም ፡ ቆዩ ፡ ብሎ ፡ አንድ ፡ ጊዜ ፡ ሰብ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
