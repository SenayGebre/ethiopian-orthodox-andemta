        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ አይቶ ፡ ተረጐመበት ፡ ተደረገበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ ይተረጕምልሃል ፡ አለው ፡ ልብሱን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለውጣችሁ ፡ ገላውን ፡ አጥባችሁ ፡ ጠጉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩን ፡ ላጭታችሁ ፡ አምጡት ፡ አላቸው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀሠር ፡ ከንጉሥ ፡ ፊት ፡ አይቀርብምና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንም ፡ ቢሆን ፡ የእሥር ፡ ልማድ፡ አልቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረለትምና ፡ ጠጉሩን ፡ ላጭተው ፡ ልብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱን ፡ ለውጠው ፡ ገላውን ፡ አጥበው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመጡለት ፡ ሕልም ፡ አይቼ ፡ የሚተረጕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምልኝ ፡ አጥቼ ፡ አለው ፡ ሕልምንማ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
