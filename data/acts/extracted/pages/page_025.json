        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ነው ፡ ገና ፡ መጀመሩ ፡ ነው ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስምዖንን ፡ በመያዣ ፡ አስቀርቶ ፡ ሰዷ",
