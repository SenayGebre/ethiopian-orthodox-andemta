  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳይጠፉበት ፡ ነው ፡ ፍጻሜው ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥበብ ፡ እንመረምራለን ፡ ባላችሁ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ፡ ልብ ፡ አትሁኑ ፡ አንድ ፡ ልብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኑ ፡ ሲል ፡ ኢትኅፈር ፡ ኀቤሃ ፡ ለጥበብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በክልኤ ፡ ልብ ፡ አላ ፡ ኩን ፡ ከመ ፡ ዘይዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዕ ፡ ወየአጽድ ፡ እንዲል ። አንድም፡ ሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሴ ፡ የመናንያን ፡ አምሳል ፡ ነው ፡ እንመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንናለን ፡ ባላችሁ ፡ ጊዜ ፡ እንዲያው ፡ አት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሂዱ ፡ ገንዘባችሁን ፡ አከናውናችሁ ፡ መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውታችሁ ፡ ሂዱ ፡ ለማለት ፡ ለአብነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐመልማል ፡ የእስራኤል ፡ የሰውነታቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበልባል ፡ የመከራቸው ፡ ሐመልማሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበልባሉን ፡ አለማጥፋቱ ፡ እስራኤል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራውን ፡ ግብር ፡ ገብተን ፡ ቀኖና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዘን ፡ እናርቀው ፡ አላሉምና ፡ ነበልባሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐመልማሉን ፡ አለማቃጠሉ ፡ መከራው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤልን ፡ ፈጽሞ ፡ አላጠፋቸውምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ሐመልማል ፡ የመቤታችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበልባል ፡ የጌታችን ፡ ቅዱስ ፡ ኤፍሬም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ መሰለው ። አንድም፡ ሐመልማል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የትስብእት ፡ ነበልባል ፡ የመለኮት ፡ ቅዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ፡ ቄርሎስ ፡ እንደ ፡ መሰለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "⟪፴፪ ፤ ወነበቦ ፡ እግዚአብሔር ፡ ወይቤሎ ፡ አነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ ፡ እግዚአብሔር ፡ አምላከ ፡ አበዊከ ፡ አምላከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም ፡ ወአምላከ ፡ ይስሐቅ ፡ ወአምላከ፡ ያዕቆብ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያባቶችህ ፡ የአብርሃም ፡ የይስሐቅ ፡ የያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕቆብ ፡ አምላክ ፡ የምሆን ፡ እኔ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ ነኝ ፡ አለው ፡ አስተርአዮ ፡ መል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አከ ፡ እግዚአብሔር ፡ ብሎ ፡ አልነበረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ፡ ምነው ፡ ከዚህ ፡ አነ ፡ ውእቱ ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ አለ ፡ ቢሉ ፡ መልአክ ፡ ካለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ እግዚአብሔር ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካለ ፡ ዘንድ ፡ መላክ ፡ አይለይምና ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ጌታን ፡ ቅሉ ፡ መልአክ ፡ ይለዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወርዕደ ፡ ሙሴ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙሴም ፡ ደነገጠ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወስእነ ፡ ጠይቆ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መረዳት ፡ ተሳነው ፡ ዘፀአ ፡ ፫ ፡ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "⟪፴፫ ፤ ወይቤሎ ፡ እግዚአብሔር ፡ ፍታሕ ፡ አሣዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒከ ፡ እምእገሪከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርም ፡ ጫማህን ፡ ከእግርህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውልቅ ፡ አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ምድር ፡ ኀበ ፡ ትከይድ ፡ ቅድስት ፡ ይእቲ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህች ፡ የቆምህባት ፡ ምድር ፡ የከበረች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናትና ፡ ለጊዜው ፡ በዘፈቀደ ፡ ታይቶባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል ፡ ፍጻሜው ፡ ግን ፡ ደብረ ፡ ሲና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቤተ ፡ ክርስቲያን ፡ ምሳሌ ፡ ናት ፡ ከቤተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቲያን ፡ በጫማ ፡ መግባት ፡ አይገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባም ፡ ሲል ፡ ያም ፡ የሥጋዌ ፡ አምሳል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ የሥጋዌ ፡ ነገር ፡ ከሚነገርበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጫማ ፡ ሁኖ ፡ መግባት ፡ አይገባም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲል ። አንድም ፡ ተልከህ ፡ የምትሄድባት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግብፅ ፡ ጽንዕት ፡ ናትና ፡ አሣዕነ ፡ ፍርሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ፡ ከልቡናህ ፡ አርቅ ፡ ሲለው ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ከግብፅ ፡ ከተመለስህ ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምትሠራልህ ፡ ሕግ ፡ ደግ ፡ ናትና ፡ ልማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ዮቶርን ፡ ተው ፡ ሲለው ፡ ነው ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ፋል ፡ የሚባል ፡ ጥንቆላ ፡ ነበረው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ ሲለው ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "⟪፴፬ ፤ ርእዮ ፡ ርኢኩ ፡ ሕማሞሙ ፡ ለሕዝብየ ፡ ወሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማዕኩ ፡ ገዓሮሙ ፡ ወወረድኩ ፡ አድኅኖሙ ።⟫",
