        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅእ ፡ እምሐቌከ ፡ ውእቱ ፡ ይነድቅ ፡ ሊተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
