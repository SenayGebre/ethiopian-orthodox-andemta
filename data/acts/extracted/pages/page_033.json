  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ሰቅላችሁ ፡ የገደላችሁት ፡ ጻድቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርይ ፡ የሚሆን ፡ የሱን ፡ መምጣት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስቀድመው ፡ የነገሯቸው ፡ ነቢያትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የገደሏቸው ፡ አይደለምን ፡ ፪ ፡ ዜና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "፴፮ ፡ ፲፮ ። ማቴ ፡ ፳፫ ፡ ፴፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፶፫",
          "line_type": "body",
          "text": "፶፫ ፤ ⟪ወነሣእክሙ ፡ ኦሪተ ፡ በሥርዐተ ፡ መላእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክት ፡ ኢዐቀብክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦሪተ ፡ በሥርዐተ ፡ መላእክት ፡ መላእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክት ፡ እየተራዱት ፡ በሙሴ ፡ ቃል ፡ የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠራች ፡ ኦሪትን ፡ ተቀብላችሁ ፡ አልጠበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃችሁም ። ነሣእክሙ ፡ በሥርዐተ ፡ መላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እክት ፡ ሙሴ ፡ አሮን ፡ እንደ ፡ ተቀበሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀብላችሁ ። ኢዐቀብክሙ ፡ በሥርዐተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መላእክት ፡ ሙሴ ፡ አሮን ፡ እንደ ፡ ጠበቁ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልጠበቃችሁም ። አንድም ፡ ሐና ፡ ቀያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋ ፡ እንዳልጠበቁ ፡ አልጠበቃችሁም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፀአ ፡ ፳ ፡ ፩ ። ገላት ፡ ፫ ፡ ፲፱ ፡ ዕብ ፡ ፪፡፪።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፶፬",
          "line_type": "body",
          "text": "፶፬ ፤ ⟪ወዘንተ ፡ ሰሚዖሙ ፡ ተምዕዑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወነሣእክሙ ፡ ኦሪተ ፡ በሥርዐተ ፡ መላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እክት ፡ ኢዐቀብክሙ ፡ ቢላቸው ፡ ዛሬስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ አለና ፡ እሱን ፡ አልጠበቅህም ፡ብን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ፡ ከኍተት ፡ እስከ ፡ ሽበት ፡ የኖርን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባትን ፡ ሕግ ፡ አልጠበቃችሁም ፡ ይለናል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ ተበሳጩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአብደ ፡ ልቦሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልባቸው ፡ ተነሣሳ ፡ (ጥቅ) ፡ ወአብደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳቤላ ፡ ጠሊ ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሐቀዩ ፡ ስነኒሆሙ ፡ ላዕሌሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥርሳቸውን ፡ አፋጩ ፡ አለ ፡ ትእምርተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽብእ ፡ ነው ፡ አጽንተው ፡ ተጣሉት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፭ ፡ ፴፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፶፭",
          "line_type": "body",
          "text": "፶፭ ፤ ⟪ወመልአ፡መንፈስ፡ቅዱስ፡ላዕለ፡እስጢፋኖስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእስጢፋኖስም ፡ መንፈስ ፡ ቅዱስ ፡ አደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረበት ፡ ተለይቶትን ፡ ያውቃል ፡ ቢሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስጢር ፡ ገለጠለት ፡ ሲል ፡ ነው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነጸረ ፡ ሰማየ ፡ ርኅወ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይ ፡ ሲከፈት ፡ አየሁ ፡ ሐተታ ፡ አሁን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማይ ፡ መከፈት ፡ መዘጋት ፡ ኖሮበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለም ፡ የተዘጋ ፡ ደጅ ፡ በተከፈተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ ያልታየ ፡ ዕቃ ፡ እንዲታይ ፡ ያልተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገለጠ ፡ ምስጢር ፡ ተገለጠ ፡ ሲል ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወርእየ ፡ ስብሐተ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔርን ፡ ጌትነት ፡ አየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢየሱስ ፡ ይቀውም ፡ በየማነ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ በእግዚአብሔር ፡ አብ ፡ ቀኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀምጦ ፡ አየ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፶፮",
          "line_type": "body",
          "text": "፶፮ ፤ ⟪ወይቤ ፡ ናሁ ፡ እሬኢ ፡ ተርኅወ ፡ ሰማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይ ፡ የተከፈተ ፡ ሆኖ ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወልደ ፡ እጓለ ፡ እመሕያው ፡ ይቀውም ፡ በየማነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልደ ፡ እጓለ ፡ እመሕያው ፡ ጌታ ፡ በእግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ አብ ፡ ቀኝ ፡ ተቀምጦ ፡ አያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሁ ፡ አለ ፡ ይኸውም ፡ ምስጢረ ፡ ገድሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፶፯",
          "line_type": "body",
          "text": "፶፯ ፤ ⟪ወከልሑ፡በዐቢይ፡ቃል ፡ ወከደኑ፡እዘኒሆሙ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከፊቱ ፡ የኋላው ፡ ይባስ ፡ ዛሬስ ፡ ለሰማይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደጅ ፡ ለእግዚአብሔር ፡ ልጅ ፡ አበጀለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጠልተን ፡ ሰቅለን ፡ የገደልነውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕሩቅ ፡ ብእሲ ፡ በአብ ፡ ቀኝ ፡ አየሁት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይለናል ፡ ይኽን ፡ የሰማ ፡ ጆሮ ፡ ይበጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠስ ፡ ብለው ፡ ጆሯቸውን ፡ ይዘው ፡ በታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቅ ፡ ቃል ፡ ጮሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
