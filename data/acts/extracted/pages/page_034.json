    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ መስኖ ፡ ውኃ ፡ የመስኖ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባንድ፡ ወገን፡ ባንድ ፡ መሽረብ፡ የወሰዱት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ የሄደበትን ፡ ብቻ ፡ ይጠቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማል ፡ በብዙ ፡ ወገን ፡ በብዙ ፡ መሽረብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወሰዱት ፡ እንደ ፡ ሆነ ፡ ግን ፡ ለብዙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዝርዕት ፡ ለብዙ ፡ አትክልት ፡ ይጠቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማልና ፡ የአይሁድ ፡ ግን ፡ መቸም ፡ መች፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምኔታቸው ፡ አልተፈጸመላቸውም፡ቀድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞ ፡ ጌታን ፡ ሰቅለው ፡ ገለው ፡ ወንጌል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠፋለች ፡ ኦሪት ፡ ትሰፋለች ፡ ብለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበረ ፡ እሱ ፡ ሳለ ፡ እሱ ፡ ብቻ ፡ ያስተምር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበር ፡ እሱ ፡ ከሞተ ፡ በኋላ ፡ ግን ፡ መቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኻያው ፡ ቤተ ፡ ሰብ ፡ ሁሉ ፡ በያሉበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያስተምሩ ፡ ሆነዋል ፡ ኋላም ፡ እስጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋኖስን ፡ በደንጊያ ፡ ወግረው ፡ ገለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌል ፡ ትጠፋለች ፡ ኦሪት ፡ ትሰፋለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ ነበር ፡ እስጢፋኖስ ፡ ሳለ ፡ እሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቻ ፡ ያስተምር ፡ ነበር ፡ እሱ ፡ ከሞተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ ግን ፡ ስምንቱ ፡ ሽሕ ፡ ማኅበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ በያሉበት ፡ የሚያስተምሩ ፡ ሆነዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ መቸም ፡ መች ፡ ተምኔታቸው ፡ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተፈጸመላቸውም ፤ ም ፡ ፲፩፥፲፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወለእስጢፋኖስሰ ፡ ነሥእዎ ፡ ዕደው ፡ ጻድቃን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቀበርዎ ፡ ወላሕውዎ ፡ ዐቢየ ፡ ላሐ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስጢፋኖስንም ፡ ደጋግ ፡ ሰዎች ፡ ልቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጻድቅ ፡ ውኩል ፡ ከመ ፡ አንበሳ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ፡ እሱን ፡ ያገኘ ፡ ያገኘናል ፡ ሳይሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንሥተው ፡ ጽኑ ፡ ልቅሶ ፡ አልቅሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀበሩት ፡ ማቴ ፡ ፲፬ ፥ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወሳውልሰ ፡ ዓዲሁ ፡ ይትቄየም ፡ አብያተ ፡ ክር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቲያናት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳውል፡ግን፡ገና፡ምእመናንን፡ይጣላ፡ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይደቢ ፡ አብያተ ፡ ሰብእ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ፡ ሁሉ ፡ ቤት ፡ ይወር ፡ ይዘርፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከብ ፡ ነበር ፤",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይስሕብ ፡ ዕደወ ፡ ወአንስተ ፡ ወይሞቅሕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሴቶችንም ፡ ወንዶችንም ፡ እያሠረ ፡ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስድ ፡ ነበር ፡ ም ፡ ፱ ፥ ፩ ። ፳፪ ፥ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወእለሰ ፡ ተዘርዉ ፡ አንሶሰዉ ፡ ወመሐሩ ፡ ወሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኩ ፡ ቃለ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወውእተ ፡ አሚረ ፡ ኮነ ፡ ዐቢይ ፡ ምንዳቤ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሁከት ፡ በቤተ ፡ ክርስቲያን ፡ በኢየሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌም ፡ ወተዘርዉ ፡ ኵሎሙ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ በሐውርተ ፡ ይሁዳ ፡ ወሰማርያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገሊላ ፡ ብሎ ፡ ነበርና ፡ በይሁዳ ፡ በሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያ ፡ በገሊላ ፡ የተበተኑ ፡ ስምንት ፡ ሽሕ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኅበር ፡ ሑሩ ፡ ወመሐሩ ፡ ያላት ፡ ወን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌልን ፡ ዙረው ፡ አስተማሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወወረደ ፡ ፊልጶስ ፡ ሀገረ ፡ ሰማርያ ፡ ወሰበከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሙ ፡ በእንተ ፡ ክርስቶስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊልጶስም ፡ ወደ ፡ ሰማርያ ፡ ሂዶ ፡ የክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶስን ፡ ነገር ፡ አስተማራቸው ፤ ም ፡ ፮፥ ፭።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወአፅምእዎ ፡ ሕዝብ ፡ ዘይነግሮሙ ፡ ፊልጶስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊልጶስ ፡ ያስተማራቸውን ፡ ነገር ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ፊልጶስ ፡ ያስተማራቸው ፡ ሕዝቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀበሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰምዕዎ ፡ ኅቡረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ሁነው ፡ ተቀበሉት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያነክሩ ፡ ወይሬእዩ ፡ ተአምረ ፡ ወመንክረ ፡ ዘይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያደርገውን ፡ ተአምራት ፡ እያዩ ፡ ያደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
