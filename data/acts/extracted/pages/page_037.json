          "text": "እየመሩ ፡ ወደ ፡ ደማስቆ ፡ አገቡት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወነበረ ፡ ህየ ፡ ሠሉሰ ፡ ዕለተ ፡ እንዘ ፡ ኢይሬኢ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወኢይበልዕ ፡ ወኢይሰቲ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በደማስቆም ፡ ብርሃን ፡ ሳያይ ፡ እህል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውኃ ፡ ሳይቀምስ ፡ ሦስት ፡ ቀን ፡ ሰነበተ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወሀሎ ፡ አሐዱ ፡ ብእሲ ፡ በሀገረ ፡ ደማስቆ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘእምውስተ ፡ አርድእት ፡ ዘስሙ ፡ ሐናንያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሐዱ ፡ ብእሲ ፡ ዘስሙ ፡ ሐናንያ ፡ ደማ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቆ ፡ በሚባል ፡ አገር ፡ ከሰብዓ ፡ አርድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እት ፡ ወገን ፡ የሚሆን ፡ ሐናንያ ፡ የሚባል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ሰው ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአስተርአዮ ፡ እግዚእነ ፡ በራእይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታችን ፡ ሌሊት ፡ በራእይ ፡ ተነጋገረው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ፡ ሐናንያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐናንያ ፡ አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤ ፡ ነየ ፡ እግዚኦ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቤት ፡ እነሆ ፡ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወይቤሎ ፡ እግዚእነ ፡ ተንሥእ ፡ ወሑር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰኰተ ፡ እንተ ፡ ይብልዋ ፡ ርትዕት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተነሥተህ ፡ ርትዕት ፡ ስሟ ፡ ነው ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርትዕት ፡ ወደሚሏት ። አንድም ፡ የቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናች ፡ ወደምትሆን ፡ አደባባይ ፡ ሂድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኅሥሥ ፡ በቤተ ፡ ይሁዳ ፡ ዘስሙ ፡ ሳውል ፡ ዘሀገረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠርሴስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቤተ ፡ ይሁዳ ፡ የጠርሴስ ፡ አገር ፡ ሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሆን፡ ሳውል፡ የሚባል፡ ሰው ፡ ጠይቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ፡ (ዕርቅ) ፡ ስንክሳር ፡ በቤተ ፡ ገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኤል ፡ ይላል ፡ ከዚህ ፡ በቤተ ፡ ይሁዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ እንደምን ፡ ነው ፡ ቢሉ ፡ ላንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ሁለት ፡ ስም ፡ አለውና ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ቀን ፡ ካንዱ ፡ ቤት ፡ ሁለት ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካንዱ ፡ ቤት ፡ አድሯልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ውእቱ ፡ ናሁ ፡ ይጼሊ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ አሁን፡ ይጸልያልና፡ ም ፡ ፳፩ ፡ ፴፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእንዘ ፡ ይጼሊ ፡ ሳውል ፡ አስተርአዮ ፡ ብእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲ ፡ በአምሳለ ፡ ሐናንያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳውልም ፡ ሲጸልይ ፡ ጌታ ፡ ሐናንያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "መስሎ ፡ ታየው ፡ ተነጋገረው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ቦአ ፡ ኀቤሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደሱ ፡ ገባ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወደየ ፡ እዴሁ ፡ ዲቤሁ ፡⟫",
