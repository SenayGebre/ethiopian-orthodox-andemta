        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባንድ ፡ ልሳን ፡ ኢጣሊቄ ፡ የሚሉት ፡ ጨ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈንታ ፡ ጋዲሳ ፡ ድንስር ፡ ቡርሳ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለት ፡ ማቴ ፡ ፰ ፥ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ጻድቅ ፡ ወፈራሄ ፡ እግዚአብሔር ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ ሰብአ ፡ ቤቱ ፡⟫",
