        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቂሣርያ ፡ ቆርኔሌዎስ ፡ የሚባል ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሐቢ ፡ ውእቱ ፡ ለሕዝበ ፡ ሰጲራ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጲራ ፡ ለሚባል ፡ ጭፍራ ፡ ሹም ፡ ነበር ፡",
