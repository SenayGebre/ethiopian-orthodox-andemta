          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወሀሎ ፡ አሐዱ ፡ ብእሲ ፡ በሀገረ ፡ ቂሣርያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘስሙ ፡ ቆርኔሌዎስ ።⟫",
