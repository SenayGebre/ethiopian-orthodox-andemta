    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቶስ ፡ የተናገረውን ፡ አሰብሁ ፡ ም ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "፭ ። ማቴ ፡ ፫ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ወሶበ ፡ እንከ ፡ ዕሩየ ፡ ወሀቦሙ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ጸጋሁ ፡ ከማነ ፡ እስመ ፡ አምኑ ፡ በእግዚእነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ ክርስቶስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጌታችን ፡ በኢየሱስ ፡ ክርስቶስ ፡ አምነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋልና ፡ እግዚአብሔር ፡ እንደኛ ፡ አስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካክሎ ፡ ልጅነትን ፡ ከሰጣቸው ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪መኑ ፡ እንከ ፡ አነ ፡ ዘእክል ፡ ከሊኦቶ ፡ ለእግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ እንዳያድርባቸው ፡ የምከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለክል ፡ እኔ ፡ ምንድን ፡ ነኝ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እከለክል ፡ ዘንድ ፡ እኔ ፡ ማነኝ ፡ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ወዘንተ ፡ ሰሚዖሙ ፡ አርመሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ በሰሙ ፡ ጊዜ ፡ ክርክሩን ፡ ተዉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአእኰትዎ ፡ ለእግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርንም ፡ አመሰገኑት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሉ ፡ እንዳዒ ፡ ለእመ ፡ ወሀቦሙ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ለአሕዛብ ፡ ከመ ፡ ይነስሑ ፡ ለሕይወት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኅነትን ፡ ለማግኘት ፡ ወደ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ይመለሱ ፡ ዘንድ ፡ ለአሕዛብ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "መለሱን ፡ ይሰጣቸው ፡ እንደ ፡ ሆነ ፡ ማን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውቃል ፡ ብለው ፡ አመሰገኑ ፡ ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሁን ፡ የእግዚአብሔርን ፡ መስጠት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጠራጠር ፡ አይደለም ፡ የነሱን ፡ መመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለስ ፡ መጠራጠር ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "፲፱ ፤ ⟪ክፍል ፡ ፳፪ ። ወእለሰ ፡ ተዘርዉ ፡ በእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅትለተ፡ እስጢፋኖስ ፡ ወሖሩ ፡ ወበጽሑ ፡ ቆጵሮስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወፍንቂስ ፡ ወአንጾኪያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሞተ ፡ እስጢፋኖስ ፡ የተበተኑት ፡ ስም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቱ ፡ ሽሕ ፡ ማኅበር ፡ ቆጵሮስ ፡ ፍን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቂስ ፡ አንጾኪያ ፡ ደረሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ ኢይነግሩ ፡ ቃሎሙ ፡ ዘእንበለ ፡ ለአይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለባሕቲቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአይሁድ ፡ ብቻ ፡ ነው ፡ እንጅ ፡ ከአይ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁድ ፡ ብቻ ፡ በቀር ፡ ወንጌልን ፡ ለአሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛብ ፡ ሳያስተምሩ ፡ ደረሱ ፡ ም ፡ ፰ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "፳ ፤ ⟪ወቦ ፡ እምውስቴቶሙ ፡ ሰብእ ፡ ቆጵሮስ ፡ ወቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሬናውያን ፡ እለ ፡ ሖሩ ፡ አንጾኪያ ፡ ወነገርዎሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአረማውያን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከነሱም ፡ ወገን ፡ የቆጵሮስ ፡ ሰዎች ፡ ቀሬ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናውያን ፡ ፡ ወደ ፡ አንጾኪያ ፡ ሂደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሀርዎሙ፡ በእንተ፡ እግዚእነ፡ ኢየሱስ፡ክርስቶስ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጌታችን ፡ የኢየሱስ ፡ ክርስቶስን ፡ ነገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአረማውያን ፡ ያስተማሩ ፡ አሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "፳፩ ፤ ⟪ወእደ ፡ እግዚአብሔር ፡ ምስሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃይለ ፡ እግዚአብሔር ፡ አድሮባቸዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበዝኀ ፡ ኍልቆሙ ፡ ለእለ ፡ አምኑ ፡ ወተመይጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያመኑ፡ ወደ ፡ እግዚአብሔር ፡ የተመለሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትም ፡ ቍጥራቸው ፡ በዛ ፡ ም ፡ ፪ ፡ ፵፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "፳፪ ፤ ⟪ወተሰምዐ ፡ ዝ፡ ነገር ፡ በአብያተ ፡ ክርስቲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡ ዘኢየሩሳሌም ፡ በእንቲአሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንቲአሆሙና፡ ዝ ፡ ነገር፡ አንድ፡ ወገን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሳቸውም ፡ ነገር ፡ በኢየሩሳሌም ፡ ባሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በምእመናን ፡ ዘንድ ፡ ደርሶ ፡ ተሰማ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈነውዎ ፡ ለበርናባስ ፡ አንጾኪያ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርናባስንም ፡ ትምህርት ፡ እገዝ ፡ ብለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ አንጾኪያ ፡ ሰደዱት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "፳፫ ፤ ⟪ወበጺሖ ፡ ርእየ ፡ ጸጋ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
