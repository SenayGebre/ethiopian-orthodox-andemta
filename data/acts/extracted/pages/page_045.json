          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወርእዮ ፡ ከመ ፡ ተፈሥሑ ፡ አይሁድ ፡ አኀዞ ፡",
          "word_wraps_to_next_line": false
