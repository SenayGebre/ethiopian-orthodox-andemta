        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ ነው ፡ ሤመ ፡ ሎሙ ፡ ያለ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
