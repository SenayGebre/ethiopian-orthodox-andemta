        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውረሶሙ ፡ ምድሮሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባቱን ፡ የከነዓን ፡ ነገሥታት ፡ አጥፍቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድሮሙ ፡ ለአሕዛብ ፡ ነው ፡ የአሕዛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብን ፡ ምድራቸውን ፡ ለእስራኤል ፡ አወረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳቸው ። አንድም ፡ ምድሮሙ ፡ ለእስራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ነው ፡ በተስፋ ፡ ወርሰዋት፡ ነበርና ፡",
