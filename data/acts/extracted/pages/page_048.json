        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖስ ፡ ማዶ ፡ የቀሩትን ፡ ሁለቱን ፡ ነገድ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
