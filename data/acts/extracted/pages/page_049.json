      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘይገብር ፡ ኵሎ ፡ ፈቃድየ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃዴንም ፡ የሚፈጽም ፡ ሁኖ ፡ አገኘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁት ። ፩ ፡ ሳሙኤ ፡ ፲፮ ፥ ፲፪ ፥ ፲፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "፳፫ ፤ ⟪ወእምዘርዐ ፡ ዚአሁ ፡ አምጽአ ፡ ሎሙ ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ መድኃኒተ ፡ ለእስራኤል ፡ ኢየሱስሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህም ፡ በኋላ ፡ ከዳዊት ፡ ባሕርይ ፡ ከዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊት ፡ ወገን ፡ ለእስራኤል ፡ መድኃኒት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አድርጎ ፡ ኢየሱስን ፡ አስነሣላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በከመ ፡ አሰፈዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስመ ፡ እምፍሬ ፡ ከርሥከ ፡ አነብር ፡ ዲበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንበርከ ፡ ብሎ ፡ ተስፋ ፡ እንዳናገረላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ኢሳ ፡ ፲፩ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "፳፬ ፤ ⟪ወሰበከ ፡ ሎሙ ፡ ዮሐንስ ፡ ጥምቀተ ፡ ለኵሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝበ ፡ እስራኤል ፡ ከመ ፡ ይንስሑ ፡ እምቅድመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጽአተ ፡ ዚአሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ፡ ከጌታ ፡ መምጣት ፡ አስቀድሞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስሐ ፡ ይገቡ ፡ ዘንድ ፡ ለእስራኤል ፡ የጌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታን ፡ ጥምቀት ፡ አስተማራቸው ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰኬ ፡ አጠምቀክሙ ፡ በማይ ፡ ለንስሐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱሰ ፡ ያጠምቀክሙ ፡ በመንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስ ፡ ወበእሳት ፡ ብሎ ፡ ማቴ ፡ ፫ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "፳፭ ፤ ⟪ወፈጺሞ ፡ ዮሐንስ ፡ መልእክቶ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስም ፡ ወንጌልን ፡ አስተምሮ ፡ ከፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸመ ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይቤሎሙ ፡ ምንትኑ ፡ ትትሐዘቡኒ ፡ ኪያየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔን ፡ ክርስቶስ ፡ ነው ፡ እያላችሁ ፡ ለምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠረጥሩኛላችሁ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አንሰ ፡ ኢኮንኩ ፡ ኪያሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ፡ ክርስቶስ ፡ አይደለሁም ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ናሁ ፡ ይመጽእ ፡ እምድኅሬየ ፡ ዘኢይደልወኒ ፡ እፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሕ ፡ ቶታነ ፡ አሣእኒሁ ፡ እምእገሪሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግሩን ፡ ጫማ ፡ ልይዝ ፡ የማልበቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ ከኔ ፡ በኋላ ፡ ይመጣል ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፩ ፥ ፳ ። ማር ፡ ፩ ፥ ፯ ። ሉቃ ፡ ፫ ፥ ፲፮ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "፳፮ ፤ ⟪አንትሙ ፡ አኃዊነ ፡ ትውልደ ፡ ዘመደ ፡ አብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሃም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንት ፡ ወንድሞቻችን ፡ የአብርሃም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጆች ፡ ናችሁና ፡ ሐተታ ፡ ዘመድ ፡ ይስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐቅ ፡ ያዕቆብ ፡ ትውልድ ፡ ዐሥራ ፡ ሁለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ። አንድም ፡ ዘመድ ፡ ዐሥራ ፡ ሁለቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትውልድ ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእለ ፡ ትፈርህዎ ፡ ለእግዚአብሔር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርን ፡ የምትፈሩት ፡ የምታመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልኩት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለክሙ ፡ ተፈነወ ፡ ዝ ፡ ነገረ ፡ ሕይወት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ፡ የድኅነት ፡ ነገር ፡ ለናንት ፡ ታዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዟል ፡ ቍ ፡ ፵፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "፳፯ ፤ ⟪ወእለሰ ፡ ይነብሩ ፡ ኢየሩሳሌም ፡ ወመላእክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲሆሙ ፡ አብዱ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሩሳሌም ፡ የሚኖሩ ፡ ግን ፡ አለቆቻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸውም፡ሰነፉ፡ አለ፡ አእምሯቸውን፡ አጡ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢያእመርዎ ፡ ለዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ነገር ፡ ስለሱ ፡ እንደ ፡ ተነገረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላወቁትም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢለበዉ ፡ መጻሕፍተ ፡ ነቢያት ፡ እንዘ ፡ ያነብብዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኵሉ ፡ ሰናብት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጻሕፍተ ፡ ነቢያትን ፡ ቅዳም ፡ ቅዳም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲመለከቱ ፡ የሚናገሩትን ፡ ምስጢሩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልተረዱትም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ ፡ ፈትሑ ፡ ላዕሌሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሞት ፡ በቃ ፡ ፈረዱበት ፡ እንጅ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈጸሙ ፡ ኵሎ ፡ ዘተጽሕፈ ፡ በእንቲአሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለሱ ፡ የተጻፈውን ፡ ሁሉ ፡ ፈጸሙ ፡ አለ፡",
          "word_wraps_to_next_line": false
        },
        {
