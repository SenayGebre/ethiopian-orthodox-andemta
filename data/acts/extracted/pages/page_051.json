      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦ ፡ እለሂ ፡ ኀበ ፡ ሐዋርያት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኩሌቶቹ ፡ ወደ ፡ ሐዋርያት ፡ ሆነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተለያዩ ። አንድም ፡ ወደ ፡ አይሁድ ፡ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆኑ ፡ አሉ ። ወደ ፡ ሐዋርያትም ፡ የሆኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወተበአሱ ፡ አይሁድ ፡ ወአረሚ ፡ ምስለ ፡ መላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እክቲሆሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድና፡ አረሚም፡ ካለቆቻቸው፡ ጋራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከራከሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአኀዙ ፡ ይጻአሉ ፡ ወይትዋገሩ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጻአሉ፡ ስድብ፡ ጀመሩ ፡ ይጸልዑ ፡ ጠብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀመሩ ፡ ደንጊያም ፡ ተጣጣሉ ፡ ቍ ፡ ፲፱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ ። ፩ ፡ ጢሞ ፡ ፫ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወርእዮሙ ፡ ሐዋርያት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያትም ፡ ይህን ፡ ባዩ ፡ ጊዜ ፡ ከዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁነን ፡ የላይ ፡ ፈሪ ፡ የታች ፡ ፈሪ ፡ እያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን ፡ እናጣላለን ፡ ብለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ጐዩ ፡ ውስተ ፡ አህጉረ ፡ ሊቃእንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃእንያ ፡ ወደሚባል ፡ አገር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልስጥራን ፡ ወደርቤን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልስጥራን ፡ ደርቤን ፡ ወደሚባል ፡ አገር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውስተ ፡ አድያም ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደነዚህ ፡ አገሮች ፡ አውራጃ ፡ ሸሽተው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሄዱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወመሀሩ ፡ በህየ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በየደረሱበት ፡ አስተማሩ ፡ ም ፡ ፲፩ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፱ ፥ ፳ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወሀሎ ፡ አሐዱ ፡ ብእሲ ፡ በሀገረ ፡ ልስጥራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘዕውስ ፡ እገሪሁ ፡ ከማሁ ፡ ተወልደ ፡ እምከርሠ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልስጥራንም ፡ ከናቱ፡ ማኅፀን፡ ጀምሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልምሾ ፡ ሁኖ ፡ የተወለደ ፡ አንድ ፡ ሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበረ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዳእሙ ፡ ይነብር ፡ ግሙራ ፡ ወእምአመ ፡ ኮነ ፡ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሖረ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀምጦ ፡ ይኖር ፡ ነበር ፡ እንጅ ፡ ከተወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለደ ፡ ጀምሮ ፡ ከቶ ፡ ቁሞ ፡ ሂዶ ፡ አያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅም ፡ ነበር ፡ ም ፡ ፫ ፥ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወሰምዖ ፡ ለጳውሎስ ፡ እንዘ ፡ ይነግር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ ሲያስተምር ፡ በሰማው ፡ ጊዜ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነጸሮ ፡ ጳውሎስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ነቅቶ ፡ እሱን ፡ ሲመለከት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባየ ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወርእዮ ፡ ከመ ፡ ቦ ፡ ሃይማኖት ፡ ወየሐዩ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምኖ፡ እንዲድን፡ አውቆ፡ ማቴ ፡ ፱ ፥ ፳፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወይቤሎ ፡ በዐቢይ ፡ ቃል ፡ ለከ ፡ እብለከ ፡ በስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ፡ ለኢየሱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጌታችን ፡ በኢየሱስ ፡ ክርስቶስ ፡ ስም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምነህ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ተንሥእ ፡ ወቁም ፡ በእገሪከ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በግርህ ፡ ቀንተህ ፡ ቁም ፡ እልሃለሁ፡ ብሎ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በታላቅ ፡ ቃል፡ ነገረው ፡ ሐተታ፡ በምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቁም ፡ ኑሯል ፡ ቢሉ ፡ ጥግ ፡ መቋሚያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳይሻ ፡ ማለት ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሶቤሃ ፡ ተንሥአ ፡ ወሖረ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ ተነሥቶ ፡ ሄደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወርእዮሙ ፡ አሕዛብ ፡ ዘገብረ ፡ ጳውሎስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሕዛብም ፡ ጳውሎስ ፡ ያደረገውን ፡ ተአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራት ፡ ባዩ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከልሑ ፡ በነገረ ፡ ሊቃእንስጦ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃእንስጦ ፡ በሚባል ፡ ቋንቋ ። አንድም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃእንስጦ ፡ በሚባል ፡ ሰው ፡ ቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጮኸው ፡ ተናገሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሉ፡አማልክት፡ሰብአ፡ተመሰሉ፡ወወረዱ፡ኀቤነ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አማልክት ፡ ሰው ፡ መስለው ፡ ወደኛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጥተዋል ፡ ብለው ፡ ም ፡ ፳፰ ፥ ፮ ።",
          "word_wraps_to_next_line": false
        }
      ]
    }
  ],
