        {
          "line_num": 1,
          "margin_tag": "፶፩",
          "line_type": "body",
          "text": "፶፩ ፤ ⟪ወነገፉ ፡ ጸበለ ፡ እገሪሆሙ ፡ ላዕሌሆሙ ፡ ወኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለፉ ፡ ኢቆንዮን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያትም ፡ የእግራቸውን ፡ ትቢያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራግፈው ፡ ወደ ፡ ኢቆንዮን ፡ ሄዱ ፡ ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተታ ፡ እኛ ፡ ደከምንላችሁ ፡ በእንቢተኛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነታችሁ ፡ ቀረባችሁ ፡ ፍዳችሁ ፡ በራሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ነው ፡ ለማለት ። አንድም ፡ ይህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኛ ፡ እንደ ፡ ተለየ ፡ እናንተም ፡ ከኛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልዩ ፡ ናችሁ ፡ እኛም ፡ ከከብታችሁ ፡ ልዩ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነን ፡ ለማለት ። አንድም ፡ ሥጋችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመቃብር ፡ ነፍሳችሁ ፡ በሲኦል ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲህ ፡ ይርገፍ ፡ ለማለት ። አንድም ፡ በቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወበሀገረ ፡ ኢቆንዮን ፡ ቦኡ ፡ ምኵራበ ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁድ ፡ ወአረሚ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢቆንዮን ፡ በደረሱ ፡ ጊዜ ፡ ከአይሁድና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአረሚ ፡ ምኵራብ ፡ ገብተው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነገሩ ፡ ከመ ፡ ይነግሩ ፡ ዘልፈ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀድሞ ፡ እንዳስተማሩ ፡ አስተማሩ ፡ ሐተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታ ፡ አንድ ፡ ወገኑ ፡ የአረሚ ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገኑ ፡ የአይሁድ ፡ ነው ፡ እንደ ፡ ፈረቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤት ። አንድም ፡ በፊት ፡ የአረሚ ፡ ሆኖ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላ ፡ የአይሁድ ፡ ሆኗል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ አምኑ ፡ ብዙኃን ፡ ጥቀ ፡ እምአይሁድ ፡ ወእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምአረሚኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአይሁድም ፡ ከአረሚም ፡ ወገን ፡ እጅግ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ ሰዎች ፡ እስቲያምኑ ፡ ድረስ ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተማሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወቢጸ ፡ አይሁድ ፡ እለ ፡ አበዩ ፡ ተበአሱ ፡ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ አሕዛብ ፡ ወምስለ ፡ ሐዋርያት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአይሁድ ፡ ወገን ፡ በወንጌል ፡ አናም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንም ፡ ያሉት ፡ ቢጽ ፡ ሐሳውያን ፡ ግን ፡ ካ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "መኑ፡ከአሕዛብ፡ከሐዋርያት፡ጋራ፡ተጣሉ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣር ፡ ልማድ ፡ የተበደለ ፡ ሰው ፡ ቢኖር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣር ፡ ቋጥሮ ፡ ደንጊያ ፡ ኰልኵሎ ፡ ይን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ፡ ብሎ ፡ ሥርዐት ፡ ሠርቶ ፡ ነበርና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚያ ፡ ልማድ ፡ ም ፡ ፲፰ ፥ ፮ ። ማቴ ፡ ፲ ፥ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፶፪",
          "line_type": "body",
          "text": "፶፪ ፤ ⟪ወመልአ ፡ መንፈስ ፡ ቅዱስ ፡ ዲበ ፡ ሐዋርያት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐዋርያትም ፡ መንፈስ ፡ ቅዱስ ፡ አደረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቸው ፡ ተለይቷቸው ፡ ያውቃልን ፡ ሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሠራቸው ፡ ሲል ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተፈሥሑ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመከራው ፡ ደስ ፡ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአጻዐርዋ ፡ ለነፍሶሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውነታቸውን ፡ በመከራው ፡ አስጨነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቋት ፡ ም ፡ ፲፫ ፥ ፶፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወነበሩ ፡ ጉንዱየ ፡ መዋዕለ ፡ እንዘ ፡ ይነግሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስሙ ፡ ለእግዚእነ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያትም ፡ የጌታችን ፡ የኢየሱስ ፡ ክር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቶስ ፡ ስሙ ፡ ሕይወት ፡ መድኃኒት ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ሆነ ፡ እያስተማሩ ፡ ብዙ ፡ ቀን ፡ ኖሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ ውእቱ ፡ ያርኢ ፡ ሰማዕተ ፡ ቃለ ፡ ጸጋሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በለጋስነት ፡ የሠራት ፡ ወንጌልን ፡ በምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክር ፡ እያስረዳላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይገብር ፡ ተአምረ ፡ ወመንክረ ፡ በእደዊሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነሱ ፡ ቃል ፡ በነሱ ፡ ሥልጣን ፡ ተአም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራት ፡ እያደረገላቸው ፡ ም ፡ ፲፱ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕብ ፡ ፪ ፥ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወተናፈቁ ፡ ኵሉ ፡ ሀገር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡ ፡ ሁሉ ፡ ተለያዩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪መንፈቆሙ ፡ መንገለ ፡ አይሁድ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኩሌቶቹ ፡ ወደ ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
