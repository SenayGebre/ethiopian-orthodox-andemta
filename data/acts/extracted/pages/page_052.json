        {
          "line_num": 1,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወሰመይዎ ፡ ለበርናባስ ፡ ድያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርናባስን ፡ ድያ ፡ አሉት ፡ መሽተሪ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ሊቁ ፡ ያነበዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለጳውሎስ ፡ ሄርሜን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስንም ፡ ሄርሜን ፡ አሉት ፡ ዙሐል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ሊቁ ፡ ያነበዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ውእቱ ፡ ሊቀ ፡ ትምህርቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የትምህርቱ ፡ አበጋዝ ፡ እሱ ፡ ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወአምጽኡ ፡ ማሬ ፡ ዘድያስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህነ ፡ ጣዖት ፡ አመጡለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘሀሎ ፡ ቅድመ ፡ ሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደፊት ፡ አቦ ፡ ባለ ፡ አገር ፡ ያለ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ የሀገር ፡ ቀንድ ፡ የሚሆን ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ከሰው ፡ ሁሉ ፡ አስቀድሞ ፡ የነበረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አረጋዊ ፡ ነውና ፡ አምጽኡ ፡ ቅድመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀገር ፡ ከሰው ፡ ሁሉ ፡ አስቀድሞ ፡ አመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ምስለ ፡ አልሀምት ፡ ወመሣውዕ ፡ ኀበ ፡ አንቀጸ ፡ ዐጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ማኅደሮሙ ፡ ምስለ ፡ ሕዝቢሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሠውትን ፡ ላም ፡ ነድተው ፡ ላሙን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያርዱበትን ፡ ወቅለምት ፡ ደሙን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚቀበሉበትን ፡ ብርት ፡ ሥጋውን ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀቅሉበትን ፡ ድስት ፡ ይዘው ፡ ሐዋርያት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደሚያድሩበት ፡ ቤት ፡ በር ፡ ሕዝቡን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብስበው ፡ መጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈቀዱ ፡ ከመ ፡ ይሠዑ ፡ ሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊሠውላቸው ፡ ወደው ፡ መጡ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወሰሚዖሙ ፡ ሐዋርያት ፡ በርናባስ ፡ ወጳው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎስ ፡ ሰጠጡ ፡ አልባሲሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስና ፡ በርናባስም ፡ ይህን ፡ በሰሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ ልብሳቸውን ፡ ቀደዱ ፡ ትእምርተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀዘን ፡ ነው ። አንድም ፡ ኦሪት ፡ ሊቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናቱ ፡ ልብሱን ፡ የቀደደ ፡ ጽሕሙን ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "የላጨ ፡ እንደ ፡ ሆነ ፡ ከሹመቱ ፡ ይሻር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትላለች ፡ ይህ ፡ ግን ፡ ጥቅም ፡ ያለበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሖሩ ፡ ኀበ ፡ አሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ አሕዛብ ፡ ሂደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወከልሑ ፡ ሎሙ ፡ ወይቤልዎሙ ፡ አንትሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብእ ፡ ምንትኑ ፡ ዝ ፡ ነገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየጮሁ ፡ እናንት ፡ ሰዎች ፡ ይህ ፡ ነገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምንድን ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አኮኑ ፡ ከማክሙ ፡ ሰብእ ፡ ንሕነ ፡ ዘንመውት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደናንት ፡ ያለን ፡ ፈራሽ ፡ በስባሽ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዎች ፡ አይደለንምን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወንሜህረክሙ ፡ ከመ ፡ ትኅድጉ ፡ ዘንተ ፡ ከንቶ ፡ ወት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትመየጡ ፡ ኀበ ፡ እግዚአብሔር ፡ ሕያው ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ከንቱ ፡ ነገር ፡ ትታችሁ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔርን ፡ ወደ ፡ ማምለክ ፡ ትመለሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ የምናስተምራችሁ ፡ አይደለንምን፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘገብረ ፡ ሰማየ ፡ ወምድረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይን ፡ ምድርን ፡ የፈጠረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕሩን ፡ የፈጠረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሎ ፡ ዘውስቴቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማይ ፡ ያሉ ፡ ፀሐይ ፡ ጨረቃን ፡ ከዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክብትን ፡ መላእክትን ፡ በምድር ፡ ያሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቂቀ ፡ አዳምን ፡ እንስሳት ፡ አራዊትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕፀው ፡ አዕባንን ። በባሕር ፡ ያሉ ፡ ዓሣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንበሪን ፡ አዞ ፡ ጉማሬን ፡ የፈጠረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፬ ፥ ፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወኀደጎሙ ፡ ለኵሎሙ ፡ አሕዛብ ፡ ይሑሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በግዕዞሙ ፡ በዘቀዲሙ ፡ መዋዕል ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአሕዛብ ፡ በዘቀዲሙ ፡ መዋዕል ፡ ይሑ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩ፡ በግዕዞሙ፡ በዘቀዲሙ ፡ (ግጥም) ፡ በቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሞ ፡ ዘመን ፡ የነበሩ ፡ አሕዛብን ፡ በቀ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ፡ ዕውቀታቸው ፡ ይኖሩ ፡ ዘንድ ፡ በተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋቸው ፡ ጊዜ ፡ ም ፡ ፲፯ ፥ ፴ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪እንዘ ፡ ኢየኀድግ ፡ ርእሶ ፡ ዘእንበለ ፡ ሰማዕት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌትነቱን ፡ ያለ ፡ ምስክር ፡ ሳይተው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይገብር ፡ ሠናይቶ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጎ ፡ ሥራ ፡ እየሠራ ፡ አለ ፡ የቸርነቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ ፡ እየሠራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይሁብ ፡ እምሰማይ ፡ ዝናመ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሰማይ ፡ ዝናም ፡ እያዘነመ ፡ ጠል ፡ ለመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከር ፡ እየሰጠ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያከርም ፡ በበዓመት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጋንና፡ክረምትን፡መዓልትንና፡ ሌሊትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያፈራረቀ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያፈሪ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍሬ ፡ እያፈራ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይሠምር ፡ ከመ ፡ ያጽግበነ ፡ ወያስተፍሥሕ ፡ ልበነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛን ፡ ለመመገብ ፡ ልቡናችንን ፡ ደስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማሰኘት ፡ ፍሬ ፡ እያፈራ ፡ እያበዛ ፡ ጌት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቱን ፡ ያለ ፡ ምስክር ፡ ሳይተው ፡ የተዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ አሕዛብ ፡ ያመልኩት ፡ የነበረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣዖትን ፡ ትታችሁ ፡ እግዚአብሔርን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ማምለክ ፡ ትመለሱ ፡ ዘንድ ፡ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናስተምራችሁ ፡ አይደለምን ፡ መዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "፻፵፯ ፥ ፰ ። ኤር ፡ ፭ ፥ ፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ወዘንተ ፡ ብሂሎሙ ፡ በዕፁብ ፡ አኅደግዎሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአሕዛብ ፡ ኢይሠዑ ፡ ሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ተናግረው ፡ እንዳይሠውላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሕዛብን ፡ በጭንቅ ፡ አስተውዋቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "፲፱ ፤ ⟪ወእንዘ ፡ እሙንቱ ፡ ይሜህሩ ፡ በህየ ፡ መጽኡ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድ ፡ እምአንጾኪያ ፡ ወኢቆንያ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልስጥራን ፡ በደርቤን ፡ በሊቃኦንያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሉ ፡ ሲያስተምሩ ፡ አይሁድ ፡ ከአንጾ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኪያ ፡ ከኢቆንያ ፡ መጥተው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየውህዎሙ ፡ ለአሕዛብ ፡ ከመ ፡ ያሕሥሙ ፡ ልቦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ፡ ላዕሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልባቸውን ፡ አጽንተው ፡ ይጣሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ አሕዛብን ፡ አባበሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወገርዎ ፡ ለጳውሎስ ፡ ወሰሐብዎ ፡ ወአውፅእዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍአ ፡ እምሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ እየጐተቱ ፡ ከከተማ ፡ በአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍአ ፡ አውጥተው ፡ ድንጋይ ፡ ጣሉበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሰሎሙ ፡ ዘሞተ ፡ ወዖድዎ ፡ አርዳኢሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድ ፡ የሞተ ፡ መስሏቸው ፡ ትተውት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሂዱ ። አንድም ፡ ደቀ ፡ መዛሙርቱ ፡ የሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ መስሏቸው ፡ ሊቀብሩት ፡ ቀረቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ ፡ ቆሮ ፡ ፲፩ ፥ ፳፭ ። ፪ ፡ ጢሞ ፡ ፫ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "፳ ፤ ⟪ወተንሥአ ፡ ወቦአ ፡ ምስሌሆሙ ፡ ሀገረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ጳውሎስ ፡ ይህን ፡ ቁም ፡ ነገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎት ፡ ተነሥቶ ፡ አሕዛብን ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ ተከትሏቸው ። አንድም ፡ ደቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዛሙርቱን፡አስከትሎ፡ ወደ፡ ሀገር፡ ገባ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበሳኒታ ፡ ሖረ ፡ ምስለ ፡ በርናባስ ፡ ሀገረ ፡ ደርቤን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነጋው ፡ ከበርናባስ ፡ ጋራ ፡ ደርቤን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደሚባል ፡ አገር ፡ ሂደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "፳፩ ፤ ⟪ወመሐሩ ፡ በይእቲ ፡ ሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርናባስና ፡ ጳውሎስም ፡ በዚያች ፡ አገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተማሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአብኡ ፡ ብዙኃነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ ምእመናንን ፡ አሳመኑ ፡ አጠመቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገብኡ፡ሀገረ፡ ልስጥራን፡ ወኢቆንዮን፡ ወአንጾኪያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ ምእመናንን ፡ ካስተማሩ ፡ ካጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቁ ፡ በኋላ ፡ ልስጥራን ፡ ኢቆንዮን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
