    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "⟪፮ ፤ ወአንገለጉ ፡ ሐዋርያት ፡ ወቀሲሳን ፡ ከመ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይርአዩ ፡ ዘይገብሩ ፡ በእንተ ፡ ዝ ፡ ነገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያትና ፡ ቀሳውስትም ፡ ስለዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ የሚሠሩትን ፡ ሥርዐት ፡ ይበይኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ጉባኤ ፡ አደረጉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪፯ ፤ ወእምድኅረ፡ተዋቀሥዎሙ፡ተንሥአ፡ ጴጥሮስ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስንና ፡ በርናባስን ፡ ከተከራከሯቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ በኋላ ፡ ጴጥሮስ ፡ ተነሥቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ፡ ስምዑ ፡ አኀዊነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሞቻችን ፡ ስሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለሊክሙ ፡ ተአምሩ ፡ ከመ፡ እምትካት ፡ ኀረየኒ ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ከጥንተ ፡ ስብከት ፡ ጀም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮ ፡ እንደ ፡ መረጠኝ ፡ ታውቃላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ አስምዖሙ ፡ ቃለ ፡ አፉየ ፡ ለአሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቃል ፡ ጠይቄው ፡ የነገረኝን ፡ ከራሴ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንቅቼ ፡ ለአሕዛብ፡ እነግራቸው ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትምህርተ ፡ ወንጌሉ ፡ ወይእመኑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊያምኑም፡ በወንጌል፡ ያስተማረኝን፡ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህርት ፡ ለአሕዛብ ፡ እነግራቸው፡ ዘንድ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ፡መረጠኝ፡ታውቃላችሁ፡ ም፡ ፲፩፡ ፲፭።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪፰ ፤ ወእግዚአብሔር ፡ ማእመረ ፡ ልብ ፡ ሰማዕተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮኖሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቡና ፡ ያሰበውን ፡ ኵላሊት ፡ ያመላለሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ የሚያውቅ ፡ እግዚአብሔርም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰከረላቸው ፡ እንደ ፡ መሰከረላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታውቃላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወሀቦሙ ፡ መንፈሰ ፡ ቅዱሰ ፡ ከማነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደኛ ፡ ልጅነትን ፡ ሰጣቸው ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስን ፡ አሳደረባቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪፱ ፤ ወኢፈለጦሙ ፡ እምኔነ ፡ አንጺሖ ፡ ልቦሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሃይማኖት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቡናቸውን ፡ በሃይማኖት ፡ አጽንቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኛ ፡ አለያቸውም ፡ ም ፡ ፲ ፡ ፵፬ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪፲ ፤ ወይእዜኒ ፡ ኢታመክርዎ ፡ ለእግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሁንም ፡ እግዚአብሔርን ፡ አትፈታተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኑት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢታስክምዎሙ ፡ አርዑተ ፡ ዲበ ፡ ክሣውዲሆሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽኑ ፡ ሥርዐት ፡ ሠርታችሁ ፡ አሕዛብን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመትከፈ ፡ ልቡናችሁ ፡ ጠብቁ ፡ አትበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘኢክሀልነ ፡ ጸዊሮቶ ፡ ንሕነ ፡ ወኢአበዊነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛ ፡ ልንፈጽመው ፡ የማይቻለንን ፡ አባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶቻችንም ፡ ሊፈጽሙት ፡ ያልተቻላቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ገላት ፡ ፫ ፡ ፲ ። ፭ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪፲፩ ፤ ዳዕሙ ፡ ከመ ፡ ንሕየው ፡ በጸጋ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእግዚእነ ፡ ኢየሱስ ፡ ክርስቶስ ፡ ንትአመን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእግዚአብሔር ፡ አብ ፡ ቸርነት ፡ በጌታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችን ፡ በኢየሱስ ፡ ክርስቶስ ፡ ቸርነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንድን ፡ ዘንድ ፡ እናምናለን ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንመን ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከማሁ ፡ እሙንቱሂ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛ ፡ እንደ ፡ ዳንነ ፡ እነሱም ፡ ይድኑ ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ፡ ኤፌ ፡ ፪ ፡ ፬—፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪፲፪ ፤ ወሶቤሃ ፡ አርመሙ ፡ ኵሉ ፡ ሕዝብ ፡ ወአፅም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዎሙ ፡ ለጳውሎስ ፡ ወለበርናባስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያንኑ ፡ ጊዜ ፡ ሕዝቡ ፡ ጳውሎስንና ፡ በር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናባስን ፡ ጸጥ ፡ ብለው ፡ አደመጧቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ ይነግሩ ፡ ኵሎ ፡ ዘገብረ ፡ ሎሙ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ተአምረ ፡ ወመንክረ ፡ በውስተ ፡ አሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ በአሕዛብ ፡ ዘንድ ፡ ለነሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
