  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወሖሩ ፡ አህጉረ ፡ ወመሀርዎሙ ፡ ሥርዐተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያት ፡ ዘአዘዙ ፡ ኀቢሮሙ ፡ በኢየሩሳሌም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስለ ፡ ቀሲሳን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በየሀገሩ ፡ እየዞሩ ፡ በኢየሩሳሌም ፡ ከቀሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስት ፡ ጋራ ፡ አንድ ፡ ሆነው ፡ የሠሩትን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐዋርያትን ፡ ሥርዐት፡ አስተማሯቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በኢየሩሳሌም ፡ ከቀሳውስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋራ ፡ ሐዋርያት ፡ አንድ ፡ ሆነው ፡ የሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩትን ፡ ሥርዐት ፡ አስተማሯቸው ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፭ ፡ ፳—፳፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወጸንዑ ፡ አብያተ ፡ ክርስቲያናት ፡ በሃይማኖት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንም ፡ በሃይማኖት ፡ ጸኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንተ ፡ ጽብሓት ፡ ይበዝኁ ፡ ሕዝብ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያምኑትም፡ዕለት፡ዕለት፡ይበዙ፡ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወሖሩ ፡ ፍርግያ ፡ ወብሔረ ፡ ገላትያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያ ፡ ወጥተው ፡ ወደፍርግያ ፡ ወደ፡ ገላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትያ ፡ አገር ፡ ሄዱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከልኦሙ ፡ መንፈስ ፡ ቅዱስ ፡ ኢይንግሩ ፡ ቃለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ በእስያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእስያ ፡ ወንጌልን፡ እንዳያስተምሩ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ ከለከላቸው ፡ ጊዜው ፡ ባይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደርስ ፡ ም ፡ ፲፰ ፡ ፳፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወበጺሖሙ ፡ ሚስያ ፡ ፈቀዱ ፡ ይሑሩ ፡ ቢታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንያ ፡ ወኢያብሖሙ ፡ መንፈሱ ፡ ለኢየሱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚስያ ፡ ደርሰው ፡ ወደ ፡ ቢታንያ ፡ ሊሂዱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደዱ ። ከዚያም ፡ ያስተምሩ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "የኢየሱስ ፡ ክርስቶስ ፡ ሕይወት ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ ግን ፤ አላሰናበታቸውም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወኀሊፎሙ፡እምነ፡ ሚስያ፡ ወረዱ፡ ጢሮአዳ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሚስያ፡ ወጥተው፡ ወደ፡ ጢሮአዳ፡ ሂዱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወአስተርአዮ፡ ለጳውሎስ፡በሌሊት፡ብእሲ፡መቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶናዊ ፡ ይቀውም ፡ ወያስተበቍዖ ፡ ወይቤሎ ፡ ኅልፍ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ መንገሌነ ፡ ለመቄዶንያ ፡ ወነዓ ፡ ርድአነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአምሳለ ፡ መኰንን ፡ መቄዶንያዊ ፡ ሌሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ለጳውሎስ ፡ ታይቶ ፡ በኛ ፡ በኩል ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ መቄዶንያ ። አንድም ፡ እኛ ፡ ወዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለንበት ፡ ወደ ፡ መቄዶንያ ፡ መጥተህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምህርት ፡ እገዘን ፡ ብሎ ፡ ማለደው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወርእዮ ፡ ዘንተ ፡ ፈቀድነ ፡ ንሖር ፡ እንተ ፡ መቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህንም ፡ ባየ ፡ ጊዜ ፡ ወደ ፡ መቄዶንያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልንሄድ ፡ ወደድነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ጸውዐነ ፡ እግዚአብሔር ፡ ንምሀሮሙ ፡ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖትን ፡ ልናስተምራቸው ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ አዝዞናልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወወጺአነ ፡ እምጢሮአዳ ፡ አፍጠነ ፡ ወበጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕነ ፡ አሞትራቄ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጢሮአዳ ፡ ወጥተን ፡ ባንድ ፡ ቀን ፡ አሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትራቄ ፡ ደረስነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበሳኒታ ፡ ሖርነ ፡ ሀገረ ፡ እንተ ፡ ስማ ፡ ብና ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነጋው ፡ ከዚያ ፡ ወጥተን ፡ ብና ፡ ወደም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትባል ፡ አገር ፡ ሄድነ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእምህየ ፡ ፊልቁስ ፡ እንተ ፡ ይእቲ ፡ ቀዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚት ፡ ዘመቄዶንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያም ፡ ወጥተን ፡ የመቄዶንያ ፡ መዲና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደምትሆን ፡ ወደ ፡ ፊልጵስዩስ ፡ ሄድነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይእቲ ፡ ሀገር ፡ ቆሎንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቆላስይስ ፡ አጠገብ ፡ ያለች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወነበርነ ፡ በይእቲ ፡ ሀገር ፡ ኅዳጠ ፡ መዋዕለ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በይእቲ ፡ ሀገር ፡ በፊልጵስዩስ ፡ ጥቂት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
