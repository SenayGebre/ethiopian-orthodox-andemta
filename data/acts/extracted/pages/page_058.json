        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኀደጋ ፡ በጊዜሃ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ ተለይቷት ፡ ወጥቶ ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፡ ፲፯ ፡ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "፲፱ ፤ ⟪ወርእዮሙ ፡ አጋእዝቲሃ ፡ ከመ ፡ አልቦ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ ፡ ታግብእ ፡ ብነታ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌቶችዋም ፡ የምታገባላቸው ፡ ግብር ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ቀረ ፡ ባዩ ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አኀዝዎሙ ፡ ለጳውሎስ ፡ ወለሲላስ ፡ ወሰሐብዎሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ ምሥያጥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስንና ፡ ሲላስን ፡ ይዘው ፡ በአደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባባይ ፡ እየጐተቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "፳ ፤ ⟪ወአብጽሕዎሙ ፡ ኀበ ፡ መኳንንት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ሹማምቱ ፡ አደረሷቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሉ ፡ እሉ ፡ ዕደው ፡ የሀውኩ ፡ ለነ ፡ ሀገረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሊህ ፡ ሰዎች ፡ አገራችንን ፡ ያሸብሩብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአይሁድ ፡ እሙንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዲህም ፡ አይሁድ ፡ ናቸው ፡ ም ፡ ፲፯ ፡ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "፳፩ ፤ ⟪ወይሜህሩ ፡ ለነ ፡ ሕገ ፡ ዘኢይከውነነ ፡ ለገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢር ፡ እንዘ ፡ ሰብአ ፡ ሮሜ ፡ ንሕነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሮም ፡ ሰዎች ፡ ስንሆን ፡ ልንሠራው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የማይገባነን ፡ ሥርዐት ፡ ያስተምሩብናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያሉ ፡ አብጽሕዎሙ ፡ ላለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "፳፪ ፤ ⟪ወተጋብኡ ፡ ሕዝብ ፡ ወመኳንንት ፡ ወአኀዙ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዝብጥዎሙ ፡ በበትር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡም ፡ መኳንንቱም ፡ አንድ ፡ ሆነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰብስበው ፡ በበትር ፡ ደበደቧቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰጠጡ ፡ አልባሲሆሙ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብዳቦቹም ፡ ልብሳቸውን ፡ አሰለቡ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ የነጳውሎስን ፡ ልብሳቸውን ፡ ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈፉ ፡ ፪ ፡ ቆሮ ፡ ፲፩ ፡ ፳፭ ። ፊል ፡ ፩ ፡ ፴ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ተሰ ፡ ፪ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "፳፫ ፤ ⟪ወዘበጥዎሙ ፡ ብዙኀ ፡ ወሞቅሕዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "መላልሰው ፡ ደብድበው ፡ አሠሯቸው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዘዝዎ ፡ ለዐቃቤ ፡ ቤተ ፡ ሞቅሕ ፡ ያጽንዕ ፡ ዐቂ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሥር ፡ ቤት ፡ ጠባቂውንም ፡ አጽንቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጠብቅ ፡ ዘንድ ፡ ጠብቅ ፡ አሉት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "፳፬ ፤ ⟪ወተአዚዞ ፡ ሞቅሖሙ ፡ ውስተ ፡ ውሳጤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ ሞቅሕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሺ ፡ በጄ ፡ ብሎ ፡ ተቀብሎ ፡ ከምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤት ፡ አሠራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአጽንዐ ፡ እገሪሆሙ ፡ ውስተ ፡ ጉንድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግራቸውን ፡ ከፍልፍል ፡ ግንድ ፡ አግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቶ ፡ እሥራት ፡ አጸናባቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "፳፭ ፤ ⟪ወጊዜ ፡ መንፈቀ ፡ ሌሊት ፡ ጸለዩ ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሲላስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈቀ ፡ ሌሊትም ፡ በሆነ ፡ ጊዜ ፡ ጳው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎስና ፡ ሲላስ ፡ ጸሎት ፡ ጸለዩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰብሕዎ ፡ ለእግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርንም ፡ ለመኑት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሙቁሐን ፡ ይሰምዕዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሥረኞችም ፡ ይሰሟቸው ፡ ነበር ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ፡ ፴፩ ፡ ፭ ፡ ፵፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "፳፮ ፤ ⟪ወሶቤሃ ፡ አድለቅለቀ ፡ ዐቢይ ፡ ድልቅልቅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ ፍጹም ፡ መነዋወጥ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንቀልቀለ ፡ መሠረታተ ፡ ቤተ ፡ ሞቅሕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእሥሩ፡ ቤት፡ መሠረት ፡ ያን ፡ ጊዜ ፡ ተነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋወጠ ፡ በድረግ ፡ አለ ፡ ትእምርተ ፡ ኀል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈተ ፡ ዓለም ፡ ትእምርተ ፡ ኀልፈተ ፡ ምኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራብ ፡ ትእምርተ ፡ ምዝባሬ ፡ ቤተ ፡ መቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ ትእምርተ ፡ ዕርገተ ፡ጸሎት ፡ የሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ሁሉ ፡ ልቡና ፡ እንዲህ ፡ አሸብርላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
