        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱ ፡ መጥተው ፡ ያስወጡን ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሏቸው ፡ ም ፡ ፳፪ ፥ ፳፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ክፍል ፡ ፴፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ወሖሩ ፡ አንፊጶል ፡ ወአጶሎንያ ፡ አህጉረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ፡አንፊጶል፡ወደ፡አጶሎንያ፡አገር፡ ሄዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበጽሑ፡ ተሰሎንቄ፡ ኀበ፡ ሀሎ፡ምኵራበ፡ አይሁድ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያም ፡ ወጥተው ፡ የአይሁድ ፡ ምኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራብ ፡ ካለበት ፡ ተሰሎንቄ ፡ ደረሱ ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰ ፡ ፪ ፥ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ወቦአ ፡ ጳውሎስ ፡ ኀቤሆሙ ፡ በከመ ፡ ያለምድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወነበረ፡ይትዋቀሦሙ፡ሠለስተ፡ሰናብተ፡እመጻሕፍት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ እንደለመደ ፡ እነሱ ፡ ወዳሉ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
