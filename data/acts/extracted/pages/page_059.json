          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈትታችሁ ፡ ተዋቸው ፡ ይሂዱ ፡ ብለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ላኩ ።",
