        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ኖረ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪፫ ፤ ወይፌክር ፡ ሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየተረጐመላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያበጽሕ ፡ ከመሂ ፡ ይትቀተል ፡ ክርስቶስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ፡ እንዲሞት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመሂ ፡ ይትነሣእ ፡ እምውታን ፡⟫",
