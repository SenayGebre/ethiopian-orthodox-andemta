        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወረከቡ ፡ ቢጾሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ አገኙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሀርዎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተማሯቸው ፡",
          "word_wraps_to_next_line": false
        },
