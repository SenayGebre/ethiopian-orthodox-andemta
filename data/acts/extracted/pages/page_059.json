        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጥተው ፡ ከሀገራችን ፡ ውጡልን ፡ ብለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ ማለዷቸው ፡ ማቴ ፡ ፰ ፥ ፴፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "⟪፵ ፤ ወወጺኦሙ ፡ እምቤተ ፡ ሞቅሕ ፡ ቦኡ ፡ ቤተ ፡",
