        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህም ፡ እኔ ፡ የነገርኋችሁ ፡ ኤርምያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
