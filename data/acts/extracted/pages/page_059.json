        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈርሁ ፡ ሰሚዖሙ ፡ ከመ ፡ ሰብአ ፡ ሮሜ ፡ እሙንቱ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሮም ፡ ሰዎች ፡ ነን ፡ ያሉትን ፡ በሰሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
