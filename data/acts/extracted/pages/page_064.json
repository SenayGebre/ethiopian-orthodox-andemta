        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምሁር ፡ ፍኖተ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦሪትን ፡ የተማረ ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጸሃቂ ፡ በመንፈሱ ፡ ይንግር ፡ ወይምሀር ፡ በእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጌታችን፡ የኢየሱስ፡ ክርስቶስን፡ነገር፡ ያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምር፡ዘንድ፡ይተጋ፡ነበር።አንድም፡ የጌታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችን፡የኢየሱስ፡ክርስቶስን፡ነገር፡ተግቶ፡ያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምር፡ ነበር፡ ይወርዳል፡ ይወለዳል፡እያለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዳዕሙ ፡ በጥምቀተ ፡ ዮሐንስ ፡ ተጠምቀ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥምቀተ፡ዮሐንስ፡ተጠምቆ፡ነበረ፡እንጅ፡እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ፡ወረደ፡እንደ፡ተወለደ፡አላመነም፡ ነበር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "፳፮ ፤ ⟪ወውእቱ፡ አኀዘ፡ ይንግር፡ ገሃደ፡ በምኵራብ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገልጦ ፡ በምኵራብ ፡ ማስተማር ፡ ጀመረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወርዳል ፡ ይወለዳል ፡ እያለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰምዕዎ ፡ ጵርስቅላ ፡ ወአቂላ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጵርስቅላና ፡ አቂላም ፡ ይወርዳል ፡ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዳል፡ እያለ፡ ሲያስተምር፡ በሰሙት፡ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአቅረብዎ ፡ ኀበ ፡ ማኅደሮሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደሚያድሩበት ፡ ቤት ፡ አስጠግተው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአጠየቅዎ ፡ ፍኖተ ፡ እግዚአብሔር ፡ ፍጹመ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔርን ፡ ነገር ፡ አስረዱት ፡ አለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወርዳል ፡ ይወለዳል ፡ ብለህ ፡ የምታስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምርለት ፡ ወርዷል ፡ ተወልዷል ፡ ብለው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጽመው ፡ አስረዱት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "፳፯ ፤ ⟪ወፈቀደ ፡ ይሑር ፡ አካይያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ አካይያ ፡ ሊሄድ ፡ በወደደ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአብጽሕዎ ፡ ቢጹ ፡ ወጸሐፉ ፡ ሎቱ ፡ ኀበ ፡ አርድ",
          "word_wraps_to_next_line": true,
          "stage1_text": "⟪ወአብጽሕዎ ፡ በጺ ፡ ወጸሐፉ ፡ ሎቱ ፡ ኀበ ፡ አርድ",
          "stage2_correction": {
