        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ፡ ጽፈው ፡ ሰደዱት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበጺሖ ፡ ኀቤሆሙ ፡ ነገሮሙ ፡ ብዙኀ ፡ ለእለ ፡ አም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኑ ፡ በጸጋ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደነሱ ፡ በደረሰ ፡ ጊዜ ፡ በወንጌል ፡ ላመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኑት፡ ፍጹም፡ ትምህርት፡ አስተማራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወረድኦሙ ፡ ለመሃይምናን ፡ ዐቢየ ፡ ረድኤተ ፡⟫",
          "word_wraps_to_next_line": false
        },
