        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳለ ፡ ጳውሎስ ፡ ደጋ ፡ ደጋውን ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
