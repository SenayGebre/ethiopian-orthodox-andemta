    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወይቤሎሙ ፡ ቦኑ ፡ ዘነሣእክሙ ፡ መንፈሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱሰ ፡ እምዘአመንክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካመናችሁ ፡ ጀምሮ ፡ በውኑ ፡ መንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስን ፡ ተቀብላችኋልን ፡ የተቀበላች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁት ፡ መቀበል ፡ አለን ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎ፥ኢሰማዕናሁ፡ጥቀ፡ከመ፡ቦ፡መንፈስ፡ቅዱስ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛስ ፡ ስንኳን ፡ መቀበል ፡ መኖሩንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰምተን ፡ አናውቅም ፡ አሉት ፡ ም ፡ ፲ ፡ ፵።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፯ ፡ ፴፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወይቤሎሙ ፡ በምንትኑ ፡ ተጠመቅሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንኪያ ፡ በምን ፡ ተጠመቃችሁ ፡ አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎ ፡ በጥምቀተ ፡ ዮሐንስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዮሐንስ ፡ ጥምቀት ፡ ነው ፡ አሉት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወይቤሎሙ ፡ ጳውሎስ ፡ ዮሐንስ ፡ አጥመቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጥምቀተ ፡ ንስሐ ፡ እንዘ ፡ ይሰብክ ፡ ከመ ፡ ይእመኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘይመጽእ ፡ እምድኅሬሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ዮሐንስ ፡ ከሱ ፡ በኋላ ፡ በሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣው ፡ በኢየሱስ ፡ ክርስቶስ ፡ ያምኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ እያስተማረ ፡ ለጌታ ፡ የሚያበቃ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥምቀት ፡ አጠመቀ ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘውእቱ ፡ ኢየሱስ ፡ ክርስቶስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኸውም ፡ ኢየሱስ ፡ ክርስቶስ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፡ ፫ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወሰሚዖሙ ፡ ተጠምቁ ፡ በስሙ ፡ ለእግዚእነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ ክርስቶስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ በሰሙ ፡ ጊዜ ፡ በጌታችን ፡ በኢየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱስ ፡ ክርስቶስ ፡ ስም ፡ አምነው ፡ ተጠመቁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወወደየ ፡ እዴሁ ፡ ጳውሎስ ፡ ዲቤሆሙ ፡ ወወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረደ ፡ መንፈስ ፡ ቅዱስ ፡ ላዕሌሆሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጁንም ፡ በጫነባቸው ፡ ጊዜ ፡ መንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስ ፡ አደረባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነበቡ ፡ በነገረ ፡ ኵሉ ፡ በሐውርት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉም ፡ በየሀገሩ ፡ ቋንቋ ፡ ተናገሩ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተነበዩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስጢር ፡ ተረጐሙ ፡ ም ፡ ፳ ፡ ፲፯ ። ፲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "፵፬ ፡ ፵፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወየአክሉ፡ኵሎሙ፡ዐሠርተ፡ወክልኤተ፡ዕደወ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉም፡ዐሥራ፡ሁለት፡ያህል፡ይሆኑ፡ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወቦአ ፡ ጳውሎስ ፡ ምኵራበ ፡ ወነገረ ፡ ገሃደ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ከምኵራቡ ፡ ገብቶ ፡ ገልጦ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተማረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነበረ ፡ ሠለስተ ፡ አውራኃ ፡ ይትዋቀሦሙ ፡ ወያአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኖሙ ፡ በእንተ ፡ መንግሥተ ፡ እግዚአብሔር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየተከራከረ ፡ የእግዚአብሔር ፡ መንግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥት ፡ ወንጌልን ፡ እያሳመናቸው ፡ ሦስት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወር ፡ ኖረ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወቦ ፡ እለ ፡ ክሕዱ ፡ ወተንሥኡ ፡ ወአሕሠሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲበ ፡ ትምህርት ፡ ዘእግዚአብሔር ፡ በቅድመ ፡ ጉባኤ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሕዛብ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አናምንም ፡ ብለው ፡ ተነሥተው፡ በጉባኤ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ ትምህርት ፡ ወንጌልን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲቃላ ፡ ሕግ ፡ ያሉ ፡ አሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኅደጎሙ ፡ ጳውሎስ ፡ ወነሥኦሙ ፡ ለአርድእት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ከነዚያ ፡ ተለይቶ ፡ ምእመና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ አስከትሎ ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሎ ፡ አሚረ ፡ ይነግሮሙ ፡ በመምህረ ፡ ብእሲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘስሙ ፡ ጡራኖስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡራኖስ ፡ በሚባል ፡ ሰው ፡ መምህርነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብቶ ፡ ሁል ፡ ጊዜ ፡ ያስተምራቸው ፡ ነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ። አንድም ፡ በምምህረ ፡ ብእሲ ፡ ዘስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ፡ ጡራኖስ ፡ ጡራኖስ ፡ የሚባል ፡ ሰው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሚያስተምርበት ፡ ቦታ ፡ ገብቶ ፡ ያስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራቸው ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበምኵናነ ፡ መላእክት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለቆች ፡ በሚፈርዱበት ፡ ቦታ ፡ ሆኖ ፡ ያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምራቸው ፡ ነበር ፡ ፪ ፡ ጢሞ ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፭ ። ም ፡ ፱ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወጐንደየ ፡ ከመዝ ፡ ክልኤ ፡ ዓመተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ፡ እያስተማረ፡ ሁለት፡ ዓመት፡ ኖረ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስከ ፡ ሰምዑ ፡ ኵሎሙ ፡ እለ ፡ ይነብሩ ፡ እስያ ፡ ቃለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ አይሁድ ፡ ወአረሚ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእስያ ፡ ያሉ ፡ አይሁድም ፡ አረማውያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንም ፡ ሁሉ ፡ ወንጌልን፡ እስቲረዱ፡ ድረስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ክፍል ፡ ፴፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወዐቢየ ፡ ኅይለ ፡ ይገብር ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእደዊሁ ፡ ለጳውሎስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርም ፡ በጳውሎስ ፡ ቃል ፡ በጳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውሎስ ፡ ሥልጣን ፡ ደጋግ ፡ ተአምራትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያደርግ ፡ ነበር ፡ ም ፡ ፲፬ ፡ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወይወስዱ ፡ እምጽንፈ ፡ ልብሱ ፡ ወሰበኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቲሮሙ ፡ ወያነብሩ ፡ ዲበ ፡ ድውያን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከልብሱ ፡ ዘርፍ ፡ ከመጠምጠሚያው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየቀደዱ ፡ ወስደው ፡ በድውያን ፡ ላይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጥሉት ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየሐይዉ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድውያኑም ፡ ይድኑ ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአጋንንት ፡ እኩያን ፡ ይወፅኡ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንትም ፡ እየወጡ ፡ ይሄዱ ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፭ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወቦ ፡ እለ ፡ አኅዙ ፡ እምአይሁድ ፡ ይዐውዱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይርቅዩ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአይሁድም ፡ ወገን ፡ እየዞሩ ፡ ጨጨ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀጀ ፡ እያሉ ፡ እየደገሙ ። አንድም ፡ ቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠል ፡ እየዘፈዘፉ ፡ የሚረጩ ፡ ነበሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይጼውዑ ፡ ሎሙ ፡ ለአጋንንት ፡ እኩያን ፡ በስመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚእነ ፡ ኢየሱስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጌታችን፡ የኢየሱስ፡ ክርስቶስንም፡ ስም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአጋንንት ፡ ይጠሩባቸው ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎሙ ፡ ናምሕለክሙ ፡ በስሙ ፡ ለኢየሱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘጳውሎስ ፡ ይሜህር ፡ በስሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስ ፡ ስሙ ፡ ሕይወት ፡ መድኃኒት ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ በሚያስተምርለት ፡ በጌታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችን ፡ በኢየሱስ ፡ ክርስቶስ ፡ ስም ፡ ውጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለን ፡ እናዝዛችኋለን ፡ እያሉ ፡ ሉቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "፱ ፡ ፵፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወእሉ ፡ እለ ፡ ከመዝ ፡ ይገብሩ ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሙንቱ ፡ ደቂቀ ፡ ሊቀ ፡ ካህናት ፡ ዘስሙ ፡ አስቄዋ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህም ፡ የሚያደርጉ ፡ አስቄዋ ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባል ፡ የሊቀ ፡ ካህናቱ ፡ ልጆች ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰብዐቱ ፡ እሙንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቍጥራቸውም ፡ ሰባት ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወተሠጥዎሙ ፡ ውእቱ ፡ ጋኔን ፡ እኩይ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ ፡ ቢስ ፡ ጋኔንም ፡ መለሰላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ፡ በኢየሱስኒ ፡ አአምን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሱስ ፡ አምናለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለጳውሎስኒ ፡ አአምሮ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስንም ፡ አውቀዋለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አንትሙ ፡ እንከ ፡ መኑ ፡ አንትሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንት ፡ እነማን ፡ ናችሁ ፡ እናንት ፡ ከኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌላ ፡ ናችሁን ፡ ብሎ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወአብደ ፡ ላዕሌሆሙ ፡ ውእቱ ፡ ዘጋኔን ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኩይ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተነሣሣባቸው ፡ (ጥቅ) ፡ ወአብደ ፡ ዳቤላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠሊ ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኅየሎሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተበራታባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሞዖሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
