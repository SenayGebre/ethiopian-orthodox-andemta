        {
          "line_num": 1,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "፴፯ ፤ ⟪ናሁ ፡ ተባጻሕክምዎሙ ፡ ለእሉ ፡ ሰብእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘኢሰረቁ ፡ ቤተ ፡ አማልክት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአማልክትን ፡ ገንዘብ ፡ ያልሰረቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢፀረፉ ፡ ዲበ ፡ አማልክቲነ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አማልክቶቻችንንም ፡ ያልሰደቡ ፡ እሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህን ፡ ሰዎች ፡ አዳርሱን ፡ ብላችሁ ፡አመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣችኋቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፴፰",
          "line_type": "body",
          "text": "፴፰ ፤ ⟪ወእመሰ ፡ ቦ ፡ ተስናን ፡ ድሜጥሮስ ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኬንት ፡ ለይትዋቀሡ ፡ በበይናቲሆሙ ፡ ናሁ ፡ መኰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ ውስተ ፡ ሀገር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሜጥሮስ ፡ ካንጠረኞች ፡ ጋራ ፡ ባመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣው ፡ ጠብ ፡ ክርክር፡ እንደ ፡ ሆነ፡ እነሆ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሀገር፡ዳኛ፡አለ፡እርስ፡በርሳቸው፡ይባባሉ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "፴፱ ፤ ⟪ወእመሰ ፡ ባዕድ ፡ ማኅሠሥ ፡ ብክሙ ፡ ዘበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ ሕግክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ሕጋችሁ ፡ ኦሪት ፡ ትበልጣለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፳ ፥ ክፍል ፡ ፴፱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወእምድኅረ ፡ ኅልቀ ፡ ሁከክ ፡ ፀውዐ ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርዳኢሁ ፡ ወመሀሮሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠቡ ፡ ክርክሩ ፡ ካለቀ ፡ በኋላ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉባኤው ፡ ከተፈታ ፡ በኋላ ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ ፡ መዛሙርቱን ፡ አስተማራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰዐሞሙ ፡ ወወፅአ ፡ ወሖረ ፡ መቄዶንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰናባብቷቸው ፡ ከዚያ ፡ ወጥቶ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቄዶንያ ፡ ሄደ ፡ ፩ ፡ ጢሞ ፡ ፩ ፥ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወኀለፈ ፡ እንተ ፡ ውእቱ ፡ በሓውርት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመቄዶንያ ፡ አውራጃም ፡ መንገድ ፡ ለመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንገድ ፡ እያስተማረ ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወብዙኀ ፡ መሀሮሙ ፡ በቃሉ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቃሉ ፡ ብዙ ፡ ትምህርት፡ አስተማራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዝ ፡ ሖረ ፡ ኤልዳ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያም ፡ ወጥቶ ፡ ወደ ፡ ኤልዳ ፡ ሄደ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌል ፡ ትበልጣለች ፡ በማለት ፡ ሌላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠብ ፡ ክርክር ፡ እንዳላችሁ ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ንነሥት ፡ ዐውደ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉባኤውን ፡ እንፈታለን ፡ ⟪(ንንሥት ፡ ዐው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ)⟫ ፡ ጉባኤውን ፡ እንፍታ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "፵ ፤ ⟪እስመ ፡ ንትመነሶ ፡ ዮም ፡ በዘአምጻእክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለነ ፡ ሁከከ ፡ ዘአልቦ ፡ ጌጋይ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕዳ ፡ በደል ፡ ሳይኖር ፡ እናንት ፡ ባመጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁት ፡ ጠብ ፡ ክርክር ፡ እንጐዳለንና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልብነ ፡ ዘንትዋቀስ ፡ በእንተ ፡ ዝ ፡ ሁከክ ፡ ወዘንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሂሎ ፡ ነሠተ ፡ ዐውደ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህ ፡ ጠብ ፡ ክርክር ፡ የምንመልሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላሽ ፡ የምንፈርደው ፡ ፍርድ ፡ የለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ጉባኤውን ፡ ፈታ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወነበረ ፡ በህየ ፡ ሠለስተ ፡ አውራኀ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኤልዳም ፡ ሦስት ፡ ወር ፡ ኖረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተማከሩ ፡ አይሁድ ፡ ዲቤሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድም ፡ ሊገሉት ፡ መከሩበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈቀደ ፡ ብሔረ ፡ ሶርያ ፡ ወመከረ ፡ ይሰወጥ ፡ መቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ መከሩበትም ፡ ባወቀ ፡ ጊዜ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሶርያ ፡ ሊሄድ ፡ ወዶ ፡ ሳለ ፡ ወደ ፡ መቄዶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንያ ፡ ሊመለስ ፡ ወደደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወሖሩ ፡ ምስሌሁ ፡ ሱሲ ፡ ጴጥሮስ ፡ ዘሀገረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤርያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሖረም⟫ ፡ ይላል ፡ የቤርያው ፡ ሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱሲ ፡ ጴጥሮስ ፡ (ፀሓይ ፡ ማለት ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምተሰሎንቄ ፡ አርስጥሮኮስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተሰሎንቄ ፡ ሰው ፡ አርስጥሮኮስ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሲኩንዶስ ፥⟫",
          "word_wraps_to_next_line": false,
          "stage1_text": "⟪ወሲኑδοስ ፥⟫",
          "stage2_correction": {
