          },
          "uncertain": []
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጋይዮስ ፡ ደርቤያዊ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የደርቤን ፡ ሰው ፡ ጋይዮስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጢሞቴዎስ ፡ ዘእምልስጥራን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የልስጥራን ፡ ሰው ፡ ጢሞቴዎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምእስያ ፡ ጢኪቆስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእስያ ፡ ጢኪቆስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጥሮፊሞስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥሮፊሞስ ፡ ተከትለውት ፡ ሄዱ ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፯ ፥ ፲ ። ም ፡ ፲፱ ፥ ፳፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወእሙንቱ ፡ ሖሩ ፡ ቅድሜነ ፡ ወጸንሑነ ፡ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተ ፡ ጢሮአዳ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱም ፡ ቀድመውን፡ሄደው፡ በጢሮአዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርፈው ፡ ቆዩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወንሕነሰ ፡ ነገድነ ፡ እምድኅረ ፡ ፋሲካ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊልቆስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛ ፡ ግን ፡ ከበዓለ ፡ ፋሲካ ፡ በኋላ ፡ የመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቄዶንያ ፡ መዲና ፡ ከምትሆን ፡ ከፊልጵስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዩስ ፡ ወጥተን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበጻሕነ ፡ ኀቤሆሙ ፡ ውስተ ፡ ጢሮአዳ ፡ በባሕር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኀምስት ፡ ዕለት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመርከብ ፡ ተጭነን ፡ ባምስት ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱ፡ካሉበት፡ ዘንድ፡ ጢሮአዳ፡ ደረስነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነበርነ ፡ ህየ ፡ ሰቡዐ ፡ መዋዕለ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያም ፡ ሰባት ፡ ቀን ፡ ሰነበትነ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ክፍል ፡ ፵ ። ⟪ወበዕለተ ፡ እሑድ ፡ እንዘ ፡ ጉቡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አን ፡ ንሕነ ፡ ከመ ፡ ንባርክ ፡ ማዕደ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሑድ ፡ ቀን ፡ ጸሎተ ፡ ማዕድ ፡ ለመጸለይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰብስበን ፡ ሳለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይነግሮሙ ፡ ጳውሎስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስ ፡ ለተሰበሰቡት ፡ ሰዎች ፡ ያስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራቸው ፡ ነበር ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ በሳኒታ ፡ ይገይሥ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነጋው ፡ የሚሄድ ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንኀ ፡ ነገረ ፡ እስከ ፡ ንፍቀ ፡ ሌሊት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስከ፡መንፈቀ፡ ሌሊት፡ ድረስ፡ አስተማረ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ቆሮ ፡ ፲፮ ፥ ፪ ። ም ፡ ፪ ፥ ፵፪ ፥ ፵፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወብዙኀ ፡ መኃትው ፡ ውስተ ፡ ውእቱ ፡ ጽርሕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ ፡ ሀሎነ ፡ ጉቡአን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰብስበን ፡ ባለንበትም ፡ ቤት ፡ ብዙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መብራት ፡ ይበራ ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወእንዘ ፡ ይነብር ፡ አሐዱ ፡ ወልድ ፡ ወሬዛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ መስኮት ፡ ዘስሙ ፡ አውጤክስ ፡ ደቀሰ ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖመ ፡ ዐቢየ ፡ ንዋመ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አሐዱ ፡ ወልድ ፡ ወሬዛ ፡ ዘስሙ ፡ አውጤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክስ⟫ ፡ አውጤክስ ፡ የሚባል ፡ አንድ ፡ ብላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቴና ፡ ከመስኮት ፡ ተቀምጦ ፡ ሳለ ፡ ጽኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንቅልፍ ፡ አንቀላፋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንዘ ፡ ይነግር ፡ ጳውሎስ ፡ ብዙኀ ፡ ጐንደየ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስ ፡ ሲያስተምር ፡ ብዙ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆይቶ ፡ ነበርና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምኀበ ፡ ይነውም ፡ ውእቱ ፡ ወልድ ፡ ጸድፈ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሥላስ ፡ ታሕተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተኛበት ፡ ሰገነት ፡ ተነሥቶ ፡ ወደ፡ ታች፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደቀ ፡ ሐተታ ፡ ዐምዱ ፡ ሁለት፡መስኮቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስት ፡ ነውና ። ⟪እምዲበ ፡ ተሥላስ⟫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ፡ ከሦስቱ ፡ መስኮት ፡ በላይ ፡ አንድ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መስኮት ፡ አለ ፡ ከዚያ ፡ ተነሥቶ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታች ፡ ወደቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንሥእዎ ፡ በድኖ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሬሣውን ፡ አነሡት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወወረደ ፡ ጳውሎስ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ከተቀመጠበት ፡ ሰገነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርዶ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነሥአ ፡ ኀቤሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከነሱ ፡ ተቀብሎ ፡ አቅፎ ፡ ያዘው ፡",
          "word_wraps_to_next_line": false
        }
