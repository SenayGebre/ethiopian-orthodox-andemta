      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "፳፮ ፤ ⟪ወናሁ ፡ አሰምዕ ፡ ለክሙ ፡ ዮም ፡ በዛቲ ፡ ዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ፡ ከመ ፡ ንጹሕ ፡ አነ ፡ እምደመ ፡ ኵልክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ፡ በናንት ፡ ከሚመጣው ፡ ፍዳ ፡ ንጹሕ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደሆንሁ ፡ እነሆ ፡ ዛሬ ፡ በዚች ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዳኝባችኋለሁ ፡ ም ፡ ፲፰ ፡ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "፳፯ ፤ ⟪ወአልቦ ፡ ዘኀባእኩክሙ ፡ ወዘኢነገርኩክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሎ ፡ ምክሮ ፡ ለእግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ወዶ ፡ መክሮ ፡ ያደረገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ሥጋዌውን ፡ ያልነገርኋችሁ ፡ የሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርኋችሁ፡ የለም፡ አንድም፡ ወዶ፡ መክሮ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካደረገው ፡ የሥጋዌው ፡ ምስጢር ፡ ያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀረሁባችሁ ፡ የለም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "፳፰ ፤ ⟪ወይእዜኒ ፡ ዕቀቡ ፡ ርእሰክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሁንም ፡ ራሳችሁን ፡ ጠብቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሎ ፡ መራዕየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ ሁሉ ፡ ጠብቁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘሎቱ ፡ ሤመክሙ ፡ መንፈስ ፡ ቅዱስ ፡ ጳጳሳተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈስ ፡ ቅዱስ ፡ ጳጳሳት ፡ አድርጎ ፡ የሾ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማችሁ ፡ እናንት ፡ ዕቀቡ ፡ ጠብቁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ፡ትርአዩ ፡ ቤተ ፡ ክርስቲያኑ ፡ ለክርስቶስ፡ እንተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጥረየ ፡ በደሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወርቀ ፡ ደሙ ፡ የዋጃት ፡ ምእመንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠብቁ ፡ ዘንድ ፡ የሾማችሁ ፡ ፩ ፡ ጢሞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ፡ ፲፮ ። ፩ ፡ ጴጥ ፡ ፭ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፳፱",
          "line_type": "body",
          "text": "፳፱ ፤ ⟪ወአነ ፡ አአምር ፡ ከመ ፡ ይመጽኡ ፡ እምድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅሬየ ፡ ተኵላት ፡ መሰጥ ፡ እለ ፡ ኢይምሕክዋ ፡ ለመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዔት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኔ ፡ በኋላ ፡ ለምእመናን ፡ የማያዝኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውን ፡ እየነጣጠቁ ፡ ወደ ፡ ገሃነም ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያወርዱ ፡ አሰተኞች ፡ መምሕራን፡ እንዲነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሡ ፡ አውቃለሁ ፡ ማቴ ፡ ፯ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "፴ ፤ ⟪ወእምውስቴትክሙ ፡ ይትነሥኡ ፡ ዕደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ይሜህሩ ፡ ጠዋየ ፡ ነገረ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከናንተም ፡ ወገን፡ የማይገባ፡ ትምህርትን፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያስተምሩ ፡ ሰዎች ፡ እንዲነሡ ፡ አው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ያግብእዎሙ ፡ ለአሕዛብ ፡ ኀቤሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሕዛብን፡ ወደነሱ፡ይመልሷቸው፡ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "፴፩ ፤ ⟪ወይእዜኒ ፡ ትግሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህም ፡ ከሆነ ፡ ተግታችሁ ፡ ራሳች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁን ፡ ጠብቁ ፡ ሌላውንም ፡ ጠብቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተዘከሩ ፡ ከመ ፡ ሠለስተ ፡ ዓመተ ፡ ኢኀደገ ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዕየ ፡ ሌሊተ ፡ ወመዓልተ ፡ እንዘ ፡ እሜህረክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኵልክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሁላችሁም ፡ ሳስተምር ፡ በመዓልትም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሌሊትም ፡ ሦስት ፡ ዓመት ፡ እንባዬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳላቋረጠ ፡ አስቡ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "፴፪ ፤ ⟪ወይእዜኒ ፡ አማኅፀንኩክሙ ፡ ኀበ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሁንም ፡ ያመናችሁበት ፡ እግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርን ፡ አትካዱ ፡ ብዬ ፡ አደራ፡ እላችኋለሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ያመናችሁበት ፡ እግዚአብሔር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይለያችሁ ፡ ብዬ ፡ ለእግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አደራ ፡ እላለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለቃለ ፡ ጸጋሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በለጋስነት ፡ የሠራት ፡ ወንጌልንም ፡ አት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካዱ ፡ ብዬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘይክል ፡ ሐኒፆተክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተን ፡ ማጽናት ፡ የሚቻለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየሀብክሙ ፡ ርስተ ፡ ምስለ ፡ ኵሎሙ ፡ ቅዱሳን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቅዱሳን ፡ ከሐዋርያት ፡ ጋራ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱሳን ፡ እንደ ፡ ሐዋርያት ፡ መንግሥተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይን ፡ ያወርሳችሁ ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "፴፫ ፤ ⟪ተአምሩ ፡ ከመ ፡ ኢተሰቆቁ ፡ ንዋየክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለከብታችሁ ፡ እንዳልሳሳሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኢወርቀ ፡ ወኢብሩረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርቅም ፡ ብርም ፡ ሆኖ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢአልባሰ ፡ ኢነሣእኩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልብስም ፡ ሁኖ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢኀበ ፡ አሐዱሂ ፡ እምኔክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከናንት ፡ ካንዱስ ፡ ስንኳ ፡ እንዳልተቀበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልሁ ፡ ታውቃላችሁ ፡ ማቴ ፡ ፲ ፡ ፰ ። ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆሮ ፡ ፱ ፡ ፲፪። ፩ ፡ ሳሙኤ ፡ ፲፪ ፡ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "፴፬ ፤ ⟪ለሊክሙ ፡ ተአምሩ ፡ ኢለትካዝየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የኔን ፡ ግዳጅ ፡ ለመፈጸም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢለእለ ፡ ምስሌየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኔ ፡ ጋራ ፡ ያሉትንም ፡ ሰዎች ፡ ግዳጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለመፈጸም ፡ እንዳልተቀበልሁ ፡ እናንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅሉ ፡ ታውቃላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ ፡ ተቀንያ ፡ እላንቱ ፡ እደውየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእጆቼ፡ ተግባረ፡ እድ ፡ ይዤ ፡ ኖርሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጅ ፡ ም ፡ ፲፰ ፡ ፫ ። ፩ ፡ ቆሮ ፡ ፬ ፡ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "፴፭ ፤ ⟪እስመ ፡ ከማሁ ፡ ይደልወነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ፡ ተግባረ ፡ እድ ፡ መያዙ ፡ ይገባናልና፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ በጻማነ ፡ ወበተግባርነ ፡ ንትወከፎሙ ፡ ለድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኩማን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽረን ፡ ግረን ፡ ባመጣነው ፡ ገንዘብ ፡ ነዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያንን ፡ እንረዳቸው ፡ ዘንድ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽረን ፡ ግረን ፡ ባመጣነው ፡ ገንዘብ ፡ ነዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያንን ፡ እንረዳቸው ፡ ዘንድ ፡ ይህ ፡ መር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳቱ ፡ ይገባናልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘንተ ፡ መሀርኩክሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህነንም ፡ ነገርኋችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ተዘከሩ ፡ ቃሎ ፡ ለእግዚእነ ፡ ኢየሱስ ፡ ዘይቤ ፡ ብፁዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይሁብ ፡ እምዘ ፡ ይነሥእ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚያውም ፡ ላይ ፡ ጌታችን ፡ ኢየሱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ፡ ከሚቀበል ፡ የሚሰጥ ፡ ሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዑድ ፡ ክቡር ፡ ነው ፡ ብሎ ፡ የተናገረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ አስቡ ፡ ብፁዓን ፡ መሐርያን ፡ ያለ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ይሻል ። አንድም ፡ ከሚነሣ ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጥ ፡ ሰው ፡ ንዑድ ፡ ክቡር ፡ ነው ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተናገረውን ፡ ነገር ፡ አስቡ ፡ አሐዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብእሲ ፡ ባዕል ፡ ቦቱ ፡ መጋቢ ፡ ወአስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋደይዎ ፡ ያለውን ፡ ይሻል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ከሰጠው ፡ አርሶ ፡ ቆፍሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽፎ ፡ ደጉሶ ፡ ካገኘው፡ ገንዘብ፡ የሚሰጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ንዑድ ፡ ክቡር ፡ ነው ። መኑ ፡ እንጋ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብር ፡ ጠቢብ ፡ ወምእመን ፡ ዘይሠይሞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚኡ ፡ ውስተ ፡ ቤቱ፡ ያለውን፡ ይሻል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ ካሥር፡ አንድ፡ ከተቀበለው ፡ ገን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘብ ፡ የሚሰጥ ፡ ሰው ፡ ንዑድ ፡ ክቡር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ አሥርዓቶ፡ ለአሥርዓት፡አለና። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም፡ ለምኖ፡ ካገኘው ፡ ገንዘብ ፡ የሚሰጥ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ንዑድ ፡ ክቡር ፡ ነው ፡ የጥኋት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማኝ ፡ ለማታ ፡ ለማኝ ፡ እንዲሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፴፮",
          "line_type": "body",
          "text": "፴፮ ፤ ⟪ወዘንተ ፡ ብሂሎ ፡ ሰገደ ፡ ወጸለየ ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሎሙ ፡ እለ ፡ ሀለዉ ፡ ምስሌሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ከተናገረ ፡ በኋላ ፡ አብረውት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካሉት ፡ ሰዎች ፡ ጋራ ፡ ተንበርክኮ ፡ የመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰነባበቻ ፡ ጸሎት ፡ ጸለየ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "፴፯ ፤ ⟪ወብዙኀ ፡ በከዩ ፡ ኵሎሙ ፡ ወሐቀፍዎ ፡ ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳዶ ፡ ለጳውሎስ ፡ ወሰዐምዎ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉም ፡ አንገቱን ፡ አቅፈው ፡ እያለቀሱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰነባበቱት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፴፰",
          "line_type": "body",
          "text": "፴፰ ፤ ⟪ወፈድፋደሰ ፡ እስመ ፡ ይቤሎሙ ፡ ኢትሬ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዩኒ ፡ እንከ ፡ ገጽየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይልቁንም ፡ እንግዲህ ፡ ወዲህ ፡ መልኬን፡",
          "word_wraps_to_next_line": false
        },
