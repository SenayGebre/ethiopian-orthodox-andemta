      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአስተጋብኡ ፡ ላዕሌሁ ፡ ኵሎ ፡ ሕዝበ ፡ ወአኀዝዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡን ፡ ሁሉ ፡ ሰብስበው ፡ ያዙት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "፳፰ ፤ ⟪ወዐውየዉ ፡ ወይቤሉ ፡ አንትሙ ፡ ሰብአ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤል ፡ ርድኡነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንት ፡ የእስራኤል ፡ ልጆች ፡ እርዱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያሉ ፡ ጮሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ነዋ ፡ ዝ ፡ ብእሲ ፡ ዘይገብር ፡ ማዕሌተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቄሣር ፡ ላይ ፡ ዐመፅን ፡ የሚያደርግ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ይህ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየሀውክ ፡ ሕዝበ ፡ በኵለሄ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባራቱ ፡ መዓዝን ፡ እየዞረ ፡ ሕዝቡን ፡ ሁሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያሸብራል ፡ የሚያሸብር ፡ ይህ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየዐሉ ፡ ኦሪተ ፡ ወምኵራበ ፡ ወይሜህር ፡ ለኵሉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦሪትን ፡ ያሳልፋል ፡ ቤተ ፡ መቅደስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያሳድፋል ፡ አለ ፡ ኦሪት ፡ ትጠፋለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ መቅደስ ፡ ትፈርሳለች ፡ እያለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሰው ፡ ሁሉ ፡ ያስተምራል ፡ የሚያስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምር ፡ ይህ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዓዲ ፡ አረሚኒ ፡ አብአ ፡ ምኵራበ ፡ ወአርኰሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ መቅደስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚያውም ፡ ላይ ፡ አረማውያንን ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ መቅደስ ፡ እያገባ ፡ ቤተ ፡ መቅደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስን ፡ ያሳድፋል ፡ የሚያሳድፍ ፡ ይህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ እያሉ ፡ ጮሁ ፡ ም ፡ ፮ ፡ ፲፬ ። ሕዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "፵፬ ፡ ፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፳፱",
          "line_type": "body",
          "text": "፳፱ ፤ ⟪እስመ ፡ ርእይዎ ፡ ለጥሮፊሞስ ፡ ዘሀገረ ፡ ኤፌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሶን ፡ ምስሌሁ ፡ ውስተ ፡ ሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "የኤፌሶን ፡ ሰው ፡ የሚሆን ፡ ጥሮፊሞስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሱ ፡ ጋራ ፡ በከተማ ፡ አይተውት ፡ ነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሰሎሙ ፡ ዘአብአ ፡ ጳውሎስ ፡ ምኵራበ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምኵራቡ ፡ ያገባው ፡ መስሏቸው ፡ ሳያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባው ፡ አይቀርም ፡ ብለው ፡ ም ፡ ፳ ፡ ፬ ። ፪",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢሞ ፡ ፬ ፡ ፳ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "፴ ፤ ⟪ወተሀውከ ፡ ኵሉ ፡ ሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገሪቱ ፡ ተሸበረች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሮጹ ፡ ኵሉ ፡ ሕዝብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡም ፡ ፈጥነው ፡ ሂደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰሐብዎ ፡ ለጳውሎስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ እየጐተቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአውፅእዎ ፡ እምኵራብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምኵራቡ ፡ አወጡት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዐጸዉ ፡ ኖኅተ ፡ ወፈቀዱ ፡ ይቅትልዎ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊገሉት ፡ ወደው ፡ ደጁን ፡ ዘጉበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘበጥዎ ፡ ብዙኀ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ ጊዜ ፡ መላልሰው ፡ ደበደቡት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "፴፩ ፤ ⟪ወበጽሐ ፡ መልእክት ፡ ኀበ ፡ መልአከ ፡ ሴ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጺራ ፡ ከመ ፡ ተሀውከት ፡ ኢየሩሳሌም ፡ ኵላ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሩሳሌም ፡ በመላዋ ፡ እንደ ፡ ተሸበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረች ፡ የሚነግር ፡ ወደ ፡ ጭፍራው ፡ አለቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልእክት ፡ ደረሰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "፴፪ ፤ ⟪ወተንሥአ ፡ መልአክ ፡ ሶቤሃ ፡ ወሮጸ ፡ ኀቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆሙ ፡ ምስለ ፡ ወዓሊሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሹሙም ፡ ተነሥቶ ፡ ብላቴናውን ፡ አስከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሎ ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሶበ ፡ ርእይዎ ፡ ለመልአክ ፡ ወለመስፍን ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዓሊሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሹሙም ፡ ብላቴናውን ፡ አስከትሎ ፡ ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣ ፡ ባዩት ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኀደጉ ፡ ዘቢጦቶ ፡ ለጳውሎስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ መምታቱን ፡ ተዉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "፴፫ ፤ ⟪ወእምዝ ፡ ቀርበ ፡ መልአክ ፡ ወአኀዞ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ሹሙ ፡ ቀርቦ ፡ ያዘው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዘዘ ፡ ይሞቅሕዎ ፡ (ይእሥርዎ) ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሠሩት ፡ ብሎ ፡ አዘዘ ፡",
