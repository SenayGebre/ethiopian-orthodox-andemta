          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገራቸው ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ፈርሀ ፡ ፊልክስ ፡ እምዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ የተነሣ ፡ ፊልክስ ፡ ፈራ ፡ ከሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱም ፡ በኋላ ፡ እንዲህ ፡ ያለ ፡ አለን፡ብሎ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ፡ ለጳውሎስ ፡ ይእዜሰኬ ፡ ሑር ፡ ወሶበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሕትኩ ፡ እልእክ ፡ ዘይጼውዐከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛሬስ ፡ ሂድ ፡ ለብቻዬ ፡ በሆንሁ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ልኬ ፡ አስጠራሃለሁ ፡ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "⟪፳፮ ፤ ወመሰሎ ፡ ለፊልክስ ፡ ከመ ፡ ይሁቦ ፡ ጳው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎስ ፡ ወይኄልዮ ፡ ንዋየ ፡ ይኅድጎ ፡ ወተሰፈወ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊልክስም ፡ ይፈታው ፡ ዘንድ ፡ ማማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጃ ፡ የሚሰጠኝ ፡ መስሎት ፡ ነበርና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበእንተ ፡ ዝ ፡ ወትረ ፡ ይጼውዖ ፡ ወይትናገሮ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህ ፡ ሁል ፡ ጊዜ ፡ እየጠራ ፡ ይጠይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፳፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ወበጺሖ ፡ ፊስጦስ ፡ ቂሣርያ ፡ ጐንደየ ፡ ሠሉሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዋዕለ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊስጦስም ፡ ቂሣርያ ፡ ገብቶ ፡ ሦስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን ፡ ሰነበተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዝ ፡ ዐርገ ፡ ኢየሩሳሌም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሦስት ፡ ቀን ፡ በኋላ ፡ ወደ ፡ ኢየሩሳሌም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጣ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ወዖድዎ ፡ ሊቃነ ፡ ካህናት ፡ ወዐበይተ ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁድ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሩሳሌም ፡ ያሉ ፡ የካህናት ፡ አለቆች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአይሁድም ፡ ታላላቅ ፡ ሰዎች ፡ ሹመት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዳብር ፡ አሉት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነገርዎ ፡ በእንተ ፡ ጳውሎስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጳውሎስንም ፡ ነገር ፡ ነገሩት ፡ ም ፡ ፳፬ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪፫ ፤ ወሰአልዎ ፡ ከመ ፡ ይጸግዎሙ ፡ ከመ ፡ ይልአክ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያምጽእዎ ፡ ለዐውድ ፡ ዘኢየሩሳሌም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቂሣርያ ፡ ልኮ ፡ አስመጥቶ ፡ በኢየሩሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌም ፡ ባለ ፡ አደባባይ ፡ ይገጥማቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ለመኑት ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "⟪፳፯ ፤ ክፍል ፡ ፴፮ ። ወሶበ ፡ ኀለፈ ፡ ክልኤቱ ፡ ዓመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ለዝንቱ ፡ ነገር ፡ ተስዕረ ፡ ፊልክስ ፡ ወመጽአ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካነ ፡ ሢመቱ ፡ ካልእ ፡ መኰንን ፡ ዘስሙ ፡ ፊስጦስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ፡ ነገር ፡ በሆነ ፡ በሁለት ፡ ዓመት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊልክስ ፡ ተሽሮ ፡ ፊስጦስ ፡ የሚባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌላ ፡ ሹም ፡ በሱ፡ ሥፍራ ፡ ተሹሞ ፡ መጣ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈቀደ ፡ ፊልክስ ፡ ያድሉ ፡ ለአይሁድ ፡ ገሃደ ፡ ወበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ ዝ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህም ፡ ነገር ፡ ፊልክስ ፡ አይሁድን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገልጦ ፡ ደስ ፡ ሊያሰኝ ፡ ወዶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኀደጎ ፡ ለጳውሎስ ፡ ውስተ ፡ ቤተ ፡ ሞቅሕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ ከእሥር ፡ ቤት ፡ ትቶት ፡ ሄደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፳፭ ፡ ፲፬ ። ም ፡ ፳፭ ፡ ፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእሙንቱሰ ፡ ፈቀዱ ፡ ከመ ፡ ይሐሩ ፡ ህየ ፡ ወበፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖት ፡ ይቅትልዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱ ፡ ግን ፡ በመንገድ ፡ ሸምቀው ፡ ቆይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ ሊገሉት ፡ ወደው ፡ ነበር ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፫ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪፬ ፤ ወአውሥኦሙ ፡ ከመ ፡ የዐቅብዎ ፡ ለጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቂሣርያ ፡ ወከመ ፡ የሐውር ፡ ለሊሁ ፡ ፍጡነ ፡ ህየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱም ፡ ጳውሎስን ፡ በቂሣርያ ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠብቁት ፡ እሱም ፡ ፈጥኖ ፡ ወደ ፡ ቂሣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያ ፡ እንዲሄድ ፡ ነገራቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪፭ ፤ ወይቤሎሙ ፡ ለአይሁድ ፡ እለ ፡ ትክሉ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስቴትክሙ ፡ ትትዋቀሡ ፡ ምስለ ፡ ውእቱ ፡ ብእሲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘአስተዋደይክምዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድን ፡ ከናንት ፡ ወገን ፡ ጉልበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላችሁ ። አንድም ፡ ነገር ፡ የምታውቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
