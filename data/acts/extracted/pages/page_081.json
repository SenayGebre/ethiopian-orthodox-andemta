  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐሥር ፡ ቀን ፡ ከሰነበተ ፡ በኋላ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቂሣርያ ፡ ሄደ ፡ ሐተታ ፡ ምነው ፡ አጠራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥሮ ፡ ተናገረ ፡ ቢሉ ፡ አንዱ ፡ የሄደበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱ ፡ የተመለሰበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበሳኒታ ፡ ነበረ ፡ ዐውደ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነጋው ፡ በነገር ፡ ተገኘ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዘዘ ፡ ያምጽእዎ ፡ ለጳውሎስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ አምጡት ፡ ብሎ ፡ አዘዘ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፲፱ ፡ ፲፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወቀሪቦ ፡ ጳውሎስ ፡ አስተዋደይዎ ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ወረዱ ፡ እምኢየሩሳሌም ፡ ብዙኀ ፡ ጌጋየ ፡ ወክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቡደ ፡ በዘኢይክሉ ፡ አብጽሖተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ በቀረበ ፡ ጊዜ ፡ ከኢየሩሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌም ፡ የሄዱ ፡ አይሁድ ፡ መርታት ፡ በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቻላቸው ፡ ጽኑ ፡ ነውር ፡ ከሰሱት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወእንዘ ፡ ይወቅሥ ፡ ሎሙ ፡ ጳውሎስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ ሲከራከር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይብል ፡ አልቦ ፡ ዘአበስኩ ፡ ላዕለሂ ፡ ኦሪቶሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአይሁድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦሪታቸውን ፡ አላፈረስሁም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢዲበ ፡ ምኵራቦሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኵራባቸውንም ፡ አላሳደፍሁም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢለነጋሢ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቄሣርም ፡ ላይ ፡ ዐመፅን ፡ አላደረግሁም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያለ ፡ ሲመልስ ፡ ም ፡ ፳፬ ፡ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ፈቀደ ፡ ፊስጦስ ፡ ያእኵትዎ ፡ አይሁድ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊስጦስ ፡ ግን ፡ አይሁድ ፡ ሊያመሰግኑት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ፡ ለጳውሎስ ፡ ትፈቅድኑ ፡ ትዕርግ ፡ ኢየሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌም ፡ ወበህየ ፡ ትትዋቀሥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ ከዚያ ፡ ትባል ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ኢየሩሳሌም ፡ ልትወጣ ፡ ትወዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለህን ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አው ፡ በኀቤየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይስ ፡ ከዚህ ፡ ከኔ ፡ ዘንድ ፡ ልትባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትወዳለህ ፡ አለው ፡ ም ፡ ፳፬ ፡ ፳፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወአውሥአ ፡ ጳውሎስ ፡ ወይቤሎ ፡ አንሰ ፡ እቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውም ፡ ቅድመ ፡ መንበረ ፡ ቄሣር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ እኔስ ፡ ከቄሣር ፡ እደርሳለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቄሣር ፡ ይግባኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበህየ ፡ ይደሉ ፡ ሊተ ፡ ፍትሕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያ ፡ ሊፈረድብኝ ፡ ይገባኛል ፡ አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለሊከ ፡ ተአምር ፡ እምነ ፡ ኵሉ ፡ ሰብእ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልብየ ፡ ዘአበስኩ ፡ ላዕለ ፡ አይሁድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድን ፡ የበደልሁት ፡ በደል ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌለ ፡ ከሰው ፡ ሁሉ ፡ ይልቅ ፡ አንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅሉ ፡ ታውቃለህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወእመሰ ፡ ቦ ፡ ዘዐመፅኩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የበደልሁት ፡ በደል ፡ እንዳለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦ ፡ እኩይ ፡ ዘገበርኩ ፡ በዘእመውት ፡ ኢይትሀከይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዊተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በምሞት ፡ ገንዘብ ፡ የሠራሁት ፡ ክፉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ ፡ እንዳለ ፡ ሞት ፡ አይገባኝም ፡ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእመሰ ፡ በከ ፡ ያስተዋድዩኒ ፡ እሉ ፡ ዘአልብየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌጋይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በደል ፡ ሳይኖርብኝ ፡ እንዲያው ፡ በከንቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢከሱኝ ፡ ቢያጣሉኝ ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለመኑ ፡ ብእሲ ፡ ይደልዎ ፡ የሀበኒ ፡ ሎሙ ፡ አነ ፡በቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣር ፡ ንጉሥ ፡ እጠርእ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቄሣር ፡ ይግባኝ ፡ ከቄሣር ፡ እደርሳለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስል ፡ ለሳቸው ፡ አሳልፎ ፡ ሊሰጠኝ ፡ ለማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ይቻለዋል ፡ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእምዝ ፡ ተናጊሮ ፡ ፊስጦስ ፡ ምስለ ፡ መማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
