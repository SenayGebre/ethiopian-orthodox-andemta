        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጳውሎስ ፡ ይብል ፡ ሕያው ፡ ውእቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስ ፡ ግን ፡ ተነሥቷል ፡ ይላል ፡ ሉቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፬ ፡ ፳፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪፳ ፤ ወኀጢእየ ፡ አንሰ ፡ ዘእገብር ፡ ሎሙ ፡ ፍትሐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ፡ ማኅሠሦሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔም ፡ ስለሚከራከሩት ፡ ክርክር ፡ የምፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርደው ፡ ቢቸግረኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እቤሎ ፡ ለጳውሎስ ፡ ትፈቅድኑ ፡ ትሑር ፡ ኢየሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌም ፡ ወበህየ ፡ ትትዋቀሥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስን ፡ ኢየሩሳሌም ፡ ሂደህ ፡ ከዚያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልትባባል ፡ ትወዳለህን ፡ አልሁት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአበየ ፡ ውእቱሰ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ ግን ፡ አይሆንም ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተዘመረ ፡ መድኀኒቶ ፡ ኀበ ፡ ንጉሥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሞት ፡ ፍርድ ፡ ለመዳን ፡ በቄሣር ፡ ተማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠነ ፡ አለ ፡ ከቄሣር ፡ እደርሳለሁ ፡ ከቄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣር ፡ ይግባኝ ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "⟪፳፩ ፤ ወእምዝ ፡ አዘዝኩ ፡ ይዕቀብዎ ፡ እስከ ፡ እፌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዎ ፡ ኀበ ፡ ቄሣር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ወደ ፡ ቄሣር ፡ እስክሰደው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድረስ ፡ ጠብቁት ፡ ብዬ ፡ አዘዝኹ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "⟪፳፪ ፤ ወይቤሎ ፡ አግሪጳ ፡ ለፊስጦስ ፡ አነሂ ፡ እፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ፡ እስምዖ ፡ ለውእቱ ፡ ብእሲ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አግሪጳም ፡ የዚያን ፡ ሰው ፡ ነገር ፡ እኔም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቃሉ ፡ ልሰማ ፡ እወዳለሁ ፡ አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ፡ ፊስጦስ ፡ እንከሰኬ ፡ ጌሠመ ፡ ትሰምዖ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊስጦስም ፡ እንኪያስ ፡ ነገ ፡ ትሰማዋለህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "⟪፳፫ ፤ ወበሳኒታ ፡ መጽኡ ፡ አግሪጳ ፡ ወበርንቄ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተረሲዮሙ ፡ ምስለ ፡ ብዙኅ ፡ ግርማ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነጋው ፡ አግሪጳና፡በርንቄ ፡ ልብሰ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥት ፡ ለብሰው ፡ ብዙ ፡ ሠራዊት ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከትለው ፡ መጥተው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦኡ ፡ ወነበሩ ፡ ዐውደ ፡ ምስለ ፡ መሳፍንት ፡ ወዐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በይተ ፡ ሀገር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመሳፍንቱ ፡ ከወይዛዝሩ ፡ ጋራ ፡ ባደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባባይ ፡ ተቀመጡ ፡ አለ ፡ በነገር ፡ ተገኙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዘዘ ፡ ፊስጦስ ፡ ያምጽእዎ ፡ ለጳውሎስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊስጦስም ፡ ጳውሎስን ፡ አምጡት ፡ ብሎ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዘዘ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "⟪፳፬ ፤ ወሶበ ፡ በጽሐ ፡ ጳውሎስ ፡ ይቤ ፡ ፊስጦስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስምዑ ፡ ኵልክሙ ፡ እለ ፡ ሀለውክሙ ፡ ምስሌነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስም ፡ በመጣ ፡ ጊዜ ፡ ፊስጦስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኛ ፡ ጋራ ፡ ያላችሁ ፡ ወንድሞቻችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁላችሁም ፡ ስሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነዋኬ ፡ ውእቱ ፡ ብእሲ ፡ ዘአስተዋደይዎ ፡ አይሁድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሩሳሌም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሩሳሌም ፡ ሳለሁ ፡ አይሁድ ፡ የከሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱት ፡ ሰው ፡ ይህ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበዝየኒ ፡ የዐወይዉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህም ፡ ተከትለው ፡ መጥተው ፡ ይጮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኻሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይስእሉ ፡ ከመ ፡ ግሙራ ፡ ኢያሕይውዎ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግደልልን ፡ ብለው ፡ ይካሰሳሉ ፡ አለ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፪ ፡ ፳፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "⟪፳፭ ፤ አንሰኬ ፡ ሐቲትየ ፡ ጥዩቀ ፡ ከመ ፡ አልቦ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌጋይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ፡ ግን ፡ በደል ፡ እንደሌለበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ፡ እኩይ ፡ ዘገብረ ፡ በዘይመውት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሚሞትበት ፡ ገንዘብ ፡ የሠራው ፡ ክፉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ ፡ እንደሌለ ፡ መርምሬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ውእቱ ፡ ፈተወ ፡ በጺሐ ፡ ኀበ ፡ ንጉሥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቄሣር ፡ እደርሳለሁ ፡ ብሏልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
