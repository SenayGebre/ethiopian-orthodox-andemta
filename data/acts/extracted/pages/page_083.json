    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወየአምሩ ፡ ከመ ፡ በሕገ ፡ አበውየ ፡ እገብር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዘ ፡ ፈሪሳዊ ፡ አነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈሪሳዊ ፡ ስሆን ፡ ባባቶቼ ፡ ሕግ ፡ በኦሪት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸንቼ ፡ ሥራ ፡ እሠራ ፡ እንደ ፡ ነበረ ፡ ያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃሉ ፡ ፈሪሳዊ ፡ ማለት ፡ ዕሉል ፡ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዊ፡ማለት፡ነው፡ም፡፳፫፡፮።ፊል፡፫ ፡ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወይእዜኒ ፡ በጺሖ ፡ ዘአስፈዎሙ ፡ እግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ፡ ለአበዊነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሁንም ፡ እግዚአብሔር ፡ ለአባቶቻችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያናገረው ፡ ተስፋ ፡ በደረሰ ፡ ጊዜ ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፰ ፡ ፳ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪መሀርኩ ፡ ለዐሠርቱ ፡ ወክልኤቱ ፡ ሕዝበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤል ፡ እንዘ ፡ እፀመድ ፡ መዐልተ ፡ ወሌሊተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመዓልትም ፡ በሌሊትም ፡ ፅሙድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኜ ፡ ላሥራ ፡ ሁለቱ ፡ ነገደ ፡ እስራኤል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተማርሁ ። አንድም ፡ ላሥራ ፡ ሁለቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዎች ፡ አስተማርሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በእንተ ፡ ውእቱ ፡ ተስፋ ፡ ዘይትኀሠሡኒ ፡ አይሁድ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድ ፡ የሚከራከሩኝ ፡ የተስፋ ፡ ትን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣኤን ፡ ነገር ፡ አስተማርኋቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኦ ፡ ንጉሥ ፡ አግሪጳ ፡ ምንተ ፡ ትፈትሕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ አግሪጳ ፡ ምን ፡ ትፈርዳለህ ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፬ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪አኮኑ ፡ ይደሉ ፡ ንእመን ፡ ከመ፡እግዚአብሔር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያሕይዎሙ ፡ ለምዉታን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ሙታነ ፡ ሥጋን ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስነሣቸው ፡ በሚያስነሣቸው ፡ በእግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ ልናምን ፡ አይገባምን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወአነሂ ፡ አጥባዕኩ ፡ እግበር ፡ እኩየ ፡ ዲበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙ ፡ ለኢየሱስ ፡ ናዝራዊ ፡ ብዙኀ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔም፡የናዝሬት፡ሰው፡በሚሆን፡በጌታችን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሱስ ፡ ስም፡ባመኑ፡ምእመናን፡ ላይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ መከራ ፡ ላጸናባቸው ፡ ወድጄ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበር ፡ ም ፡ ፱ ፡ ፩-፳፱ ። ም ፡ ፳፪ ፡ ፫-፳፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወገበርኩሂ ፡ በኢየሩሳሌም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድጄም ፡ አልቀረሁ ፡ በኢየሩሳሌም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሉ ፡ ምእመናን ፡ ላይ ፡ መከራ ፡ አጸናሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሞቃሕክዎሙ ፡ ለብዙኃን ፡ ጻድቃን ፡ አስተበዊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕየ ፡ በኀበ ፡ ሊቀ ፡ ካህናት ፡ ከመ ፡ እቅትሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በብዙ ፡ ደጋግ ፡ ሰዎች ፡ መከራ ፡ አጸናባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ዘንድ ፡ ከሊቃነ ፡ ካህናት ፡ ቃስድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ፡ ሹመት ፡ ተካስሼ ፡ ሂጄ ፡ ዕዳ ፡ በደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ፡ የሌለባቸውን ፡ ሰዎች ፡ እያሠርሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ኢየሩሳሌም ፡ እሰዳቸው ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወአምጻእኩ ፡ መጽሐፈ ፡ መባሕት ፡ ለኵሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "መኳርብት ፡ ወዘልፈ ፡ አሐምሞሙ ፡ ከመ ፡ በግብር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይፅርፉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምኵራቡ ፡ ሁሉ ፡ ሹመቴን ፡ የሚመሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክር ፡ ደብዳቤ ፡ አምጥቼ ፡ በግድ ፡ ክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶስን ፡ ዕሩቅ፡ብእሲ ፡ ወንጌልን ፡ ዲቃላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕግ ፡ ይሉ ፡ ዘንድ ፡ ሁል ፡ ጊዜ ፡ መከራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጸናባቸው ፡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈድፋደሰ ፡ አበድኩ ፡ ላዕሌሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይልቁንም ፡ በምእመናን ፡ ተነሳሣሁባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ እዴግኖሙ ፡ ውስተ ፡ አህጉር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዋሉበት ፡ አላሳድር ፡ ካደሩበት ፡ አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውል ፡ እያልሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእንዘ ፡ አሐውር ፡ ሀገረ ፡ ደማስቆ ፡ አስተበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊሕየ ፡ በኀበ ፡ ሊቀ ፡ ካህናት ፡ በእንተ ፡ ዝንቱ ፡ ሶበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከውን ፡ ጊዜ ፡ ቀትር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህ ፡ ነገር ፡ ቃስድነት ፡ ሹመት ፡ ከሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃነ ፡ ካህናት ፡ ዘንድ ፡ ተካስሼ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደማስቆ ፡ ስሄድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ሶበ ፡ ይከውን ፡ ጊዜ ፡ ቀትር ፡ እንዘ ፡ ሀሎኩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ ፍኖት ፡ ኦ ፡ ንጉሥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ አግሪጳ ፡ ሆይ ፡ በጐዳና ፡ ሳለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀትር ፡ በሆነ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ርኢኩ ፡ እምሰማይ ፡ በረቀ ፡ መብረቅ ፡ ዘይበርህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምፀሐይ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከፀሐይ ፡ ይልቅ ፡ የሚያበራ ፡ ብርሃን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወደ ፡ ሰማይ ፡ በላዬ ፡ ላይ ፡ ሲበራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አየሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሉ ፡ ሰብእ ፡ ዘየሐውሩ ፡ ምስሌየ ፡ ወለልየ ፡ ምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሆሙ ፡ ወደቅነ ፡ ውስተ ፡ ምድር ፡ ኵልነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኔ ፡ ጋራ ፡ የሚሄዱትም ፡ ሰዎች ፡ እኔም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከነሱ ፡ ጋራ ፡ ባንድነት ፡ ወደ ፡ ምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደቅነ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወሰማዕኩ ፡ ቃለ ፡ ዘይብለኒ ፡ በነገረ ፡ ዕብራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይስጥ ፡ ሳውል ፡ ሳውል ፡ ለምንት ፡ ትሰድደኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዕብራይስጥ ፡ ቋንቋ ፡ ሳውል ፡ ከዋልሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ፡ አላሳድር ፡ ካደርሁበት ፡ አላውል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምን ፡ ትለኛለህ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይብእሰከ ፡ ረጊፅ ፡ ውስተ ፡ ቀኖት ፡ በሊሕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰይፍ ፡ የረገጠ ፡ እሱ ፡ ይጐዳል ፡ እንጂ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰይፉ ፡ ይጐዳልን ፡ ሲለኝ ፡ ሰማሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወእቤ ፡ አነ ፡ መኑ ፡ አንተ ፡ እግዚኦ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቤቱ ፡ አንተ ፡ ማነህ ፡ አልሁት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤለኒ ፡ እግዚእነ ፡ አነ ፡ ውእቱ ፡ ኢየሱስ ፡ ዘአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ፡ ትሰድደኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተ ፡ ከዋልሁበት ፡ አላሳድር ፡ ካደርሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ፡ አላውል ፡ የምትለኝ ፡ እኔ ፡ ኢየሱስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነኝ ፡ አለኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወባሕቱ ፡ ተንሥእ ፡ ወቁም ፡ በእገሪከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ ግን ፡ ተነሥተህ ፡ በግርህ ፡ ቁም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ በእንተ ፡ ዝ ፡ አስተርአይኩከ፡ እሢምከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላእከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያነትን ፡ እሾምህ ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰማዕተ ፡ በዘርኢከኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባየኸኝ ፡ በሰማኸኝ ፡ ገንዘብ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበዘሀለወከ ፡ ትርአየኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንግዴህም ፡ በምታየኝ ፡ ገንዘብ ፡ ትመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰክርልኝ ፡ ዘንድ ፡ ስለዚህ ፡ ታየሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ወአድኅነከ ፡ እምሕዝብ ፡ ወአሕዛብ ፡ እለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እፌንወከ ፡ አነ ፡ ኀቤሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ፡ አንተን ፡ ከምሰድላቸው ፡ ከሕዝብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአሕዛብ ፡ እጅ ፡ አድንሃለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ከመ ፡ ትክሥት ፡ አዕይንቲሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐይነ፡ልቡናቸውን፡ ታበራላቸው ፡ ዘንድ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትሚጦሙ ፡ እምጽልመት ፡ ውስተ ፡ ብርሃን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከድንቁርና ፡ ወደ ፡ ዕውቀት ፡ ትመልሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምጣዖተ ፡ ሰይጣን ፡ ኀበ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአምልኮተ ፡ ጣዖት ፡ ወደ ፡ አምልኮተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ትመልሳቸው ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይትኀደግ ፡ ሎሙ ፡ ኃጢአቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃጢአታቸው ፡ ይሠረይላቸው ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይርከቡ ፡ መክፈልተ ፡ ምስለ ፡ ቅዱሳን ፡ በአሚን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስምየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስሜ ፡ በማመን ፡ ከቅዱሳን ፡ ከሐዋር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት ፡ ጋራ ፡ እንደ ፡ ቅዱሳን ፡ እንደ ፡ ሐዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያት ፡ ዕድል ፡ ፈንታን ፡ ያገኙ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፡ ፵፭ ፡ ፭ ። ኤፌ ፡ ፩ ፡ ፲፰ ። ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፡ ፴፪ ። ኤፌ ፡ ፩ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
