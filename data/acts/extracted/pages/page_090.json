          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢይስምዑ ፡ በእዘኒሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጆሯቸው ፡ እንዳይሰሙ ፡ ደንቀወ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢይለብዉ ፡ በልቦሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልቡናቸው ፡ እንዳያውቁ ፡ ገዝፈ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢይትመየጡ ፡ ኀቤየ ፡ ወኢይሠሃሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደኔ ፡ እንዳይመለሱ ፡ ይቅር ፡ እንዳልላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ከደኑ ፡ ደንቀወ ፡ ገዝፈ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢሳይያስ ፡ አድሮ ፡ ላባቶቻችሁ ፡ እው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነተኛ ፡ ነገርን ፡ ተናግሯል ፡ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሪክ ፡ በዖዝያን ፡ ጊዜ ፡ ሕዝቡ ፡ ኃጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አት ፡ ሠሩ ፡ ጣዖት ፡ አመለኩ ። ኢሳይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ ፡ ፈርቶ ፡ ባይገሥፃቸው ፡ ለምፅ ፡ ወጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ፡ ሀብተ ፡ ትንቢት ፡ ተነሣው ። በዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መተ ፡ ሞቱ ፡ ዖዝያን ፡ ንጉሥ ፡ ርኢክዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእግዚአብሔር ፡ ልዑል ፡ እንዘ ፡ ይነብር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲበ ፡ መንበሩ ፡ ነዋህ ፡ ወብሩህ ፡ ወም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉእ ፡ ቤተ ፡ ስብሐቲሁ ፡ ወሱራፌል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቀውሙ ፡ ዓውዶ ፡ ለለአሐዱ ፡ በበስድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቱ ፡ ክነፊሆሙ ፡ በክልኤቱ ፡ ክነፊሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከድኑ ፡ እግሮሙ ፡ ወበክልኤቱ ፡ ክነፊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆሙ ፡ ይከድኑ ፡ ገጾሙ ፡ ወበክልኤቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክነፊሆሙ ፡ ይሠሩ ፡ አንፃረ ፡ ኅቡረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዘ ፡ ይብሉ ፡ ቅዱስ ፡ ቅዱስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ጸባዖት ፡ ፍጹም፡ ምሉእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማያተ፡ ወምድረ ፡ ቅድሳተ፡ ስብሐቲከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል፡ ዖዝያን ፡ ከሞተ ፡ በኋላ ፡ ጌታ፡ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንበረ ፡ መንግሥት፡ ሁኖ ፡ በግርማ ፡ ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቶ፡ ያ፡ ያፈርኸው፡ የፈራኸው ፡ ንጉሥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞተ ፡ ያላፈርኸኝ ፡ ያልፈራኸኝ ፡ እኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለሁ ፡ አሁንስ ፡ መነ ፡ እፌኑ ፡ ኀበ ፡ ሕዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብየ ፡ ሕዝቤን ፡ ማን ፡ ያስተምርልኛል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተም፡ ፈራሁ፡ አልህ፡ አለው።እስመ፡ ር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኩሰ፡ ከናፍር፡ አነ፡ ለምጽ፡ ወጥቶብኛልና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጸየፉኛል ፡ እንጅ ፡ እኔ ፡ ባስተማርሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበር ፡ አለው ፡ ይህማ ፡ ወማዕከለ ፡ ሕዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ፡ ዘርኩስ ፡ ከናፍሪሁ ፡ ይላል ፡ ሕዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቡን ፡ ሁሉ ፡ ለምጻም ፡ ማለት ፡ ነውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ሀብተ ፡ ትንቢት ፡ ተነሥቶኛል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለቱ ፡ ነው ፡ ሱራፊን ፡ ከምሥዋዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማያዊ፡ በጉጠት ፡ ፍሕም ፡ አምጥተህ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከንፈሩን ፡ አስነካው ፡ አለው ፡ ወአልከፎ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከናፍሪሁ፡ ይላል ፡ ፍሕሙን ፡ በጉጠት ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጥቶ፡ ከንፈሩን፡ አስነካው፡ ለምጹ፡ ድኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለታል ፡ ሀብተ ፡ ትንቢቱም ፡ ተመልሶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ፡ ሂዶ ፡ ሰሚዐ ፡ ትሰምዑ ፡ ወኢትሌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዉ ፡ ወራእየ ፡ ትሬእዩ ፡ ወኢታአምሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ይህንን ፡ ነግሯቸዋል ። ሱራፊ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቀሳውስት ፡ ኢሳይያስ ፡ የምእመናን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉጠት ፡ የሥልጣነ ፡ ክህነት ፡ ፍሕም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሥጋው ፡ የደሙ ፡ ለምጽ ፡ የፍዳ ፡ የመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርገም ፡ ምሳሌ ፡ በዚህም ፡ ሊቁ ፡ጢሞቴ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎስ ፡ ዘአልቦ፡ ጥሪት፡ መቅዶንዮስን፡ ረቶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በታል ፡ ለአብ ፡ መንበር ፡ አለው ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በር ፡ ሰጥቶ ፡ የተናገረበት ፡ ጊዜ ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድልው ፡ መንበርከ ፡ እግዚኦ ፡ ይላል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለወልድም ፡ መንበር ፡ አለው ፡ መንበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጥቶ ፡ የተናገረበት ፡ ጊዜ ፡ አለ ፡ መንበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርከ ፡ እግዚኦ ፡ ለዓለመ ፡ ዓለም ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለመንፈስ ፡ ቅዱስ ፡ ግን ፡ መንበር ፡ የለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውም፡መንበር፡ ሰጥቶ፡ የተናገረበት፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለም ፡ ብሎ ፡ መንፈስ ፡ ቅዱስ ፡ ሕጹጽ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
