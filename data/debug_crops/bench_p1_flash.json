{
  "running_header": "፻፳ የጌታችን የኢየሱስ ክርስቶስ ቅዱስ ወንጌል ። ቅዱስ ማቴዎስ እንደ ጻፈው ።",
  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪መጽሐፈ ልደቱ ለእግ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዚእነ ኢየሱስ ክርስቶስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌላውያን ሲጽፉ ራሳቸው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን መሠረት አያደርጉም ሌሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች ግን ራሳቸውን መሠረት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያደርጋሉ ምንም የሚገልጽ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቸው መንፈስ ቅዱስ ቢሆን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚጽፉ ከራሳቸው አንቅተው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ። ዳግመኛ ከአንድ አገር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነው ጽፈው ወደ አንዱ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ይሰዱታልና ። ወንጌላውያን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን የሚጽፉ ጌታ የተናገረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ነው እንጂ ከራቸሳው አ",
          "word_wraps_to_next_line": true,
          "uncertain": [
            {
              "printed_text": "ከራቸሳው",
              "alternative": "ከራሳቸው",
              "note": "print typo"
            }
          ]
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቅተው አይደለምና በመካከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ሆነው ይጽፋሉና ። ዳግመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኛ ምንም አንዱም አንዱ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀቡ ፩ዱ ብእሲ ቢል ነገር ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ማያያዝ ነው ። የጌታችን የኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ክርስቶስ የልደቱ ቍጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ይህ ነው ። ጸሐፉ ሰብእኒ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ዘሞተ ወበውእቱ መዋ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕል ወፅአ ትእዛዝ እምኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውግስጦስ ቄሣር ከመ ይጸ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍ ኵሉ ዓለም እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም የጌታችን የኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ የልደቱ ወግ ታሪክ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ነው ። ስም ለዓቢር ትካት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀገረ መጽሐፍ እንዲል ። የወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግ የታሪክ ሀገር ሲል ። ወግ",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "የን ትእማርን የራኬብን የ",
          "word_wraps_to_next_line": true,
          "uncertain": [
            {
              "printed_text": "የን",
              "alternative": "የነ",
              "note": "print typo for የነ"
            }
          ]
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩትን ያመጣል ። ታሪክ ወለአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚእነ ኢየሱስ ክርስቶስ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዝ ውእቱ ልደቱ ብሎ ያመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣል ፤ ልደቱ ለእግዚእነ አለ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ልደታት አሉና ከዚያ ሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለየው ፤ ልደተ አዳም እምድር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልደተ ሔዋን እምገቦ ። ልደተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቤል እምከርሥ ፤ ልደተ በግ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕ እምዕፅ ፤ ልደተ ሙታን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምቃብር አለ ። እኒያ አውጭ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሻሉ ። እርሱ ግን በገዛ ሥልጣኑ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ። የልደቱን ነገር ብቻ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናገራልና መጽሐፈ ልደቱ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምነው ቢሉ ። መጽሐፍ ባንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጀመር ኋላ ብዙ ማምጣት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልማድ ነው ። ከዚያ ሁሉ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቀድሞ ዘልደት ይላል ። የሥነ ፍጥ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረትን ብቻ ተናግሮ ይተዋልን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፈ ልደቱ ባለው በጥቁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር አንድ ይላል የንዑስ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕራፍ አኀዝ ነው ፤ ማቴዎስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፈ ልደቱ ማርቆስ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ውእቱ ወልድየ ፤ ሉቃስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይመስልዎሙ ወልደ ዮሴፍ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ቀዳሚሁ ቃል ያለው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሁሉም የጌትነት ነገር ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ብሎ አራቱ የተባበሩበት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲል ፩ዱ ይበልጣል ፤ ፫ቱ ቢል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማርቆስን አውጥቶ ፤ በሦስተ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኛው በሰንጠረዥ ማርቆስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዳዊት ወልደ አብርሃም⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃስ ፤ ም ፡ ፫ ፥ ቁ ፡ ፴፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዳዊት ልጅ የአብርሃም ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከነገሥታት ዳዊት ከአበው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም ብቻ ይወልዱታልና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህስ አለ ቢሉ ። ትንቢት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተነገረ ለእነዚህ ነውና ። ትንቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትም ከነገሥታት ለሰሎሞን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አነ እከውን አቡሁ ወውእቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከውነኒ ወልድየ ተብሎ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአበውም ለሴም ለይስሐቅ",
          "word_wraps_to_next_line": false
