{
  "pdf_page": 59,
  "book_page_ethiopic": "፶፭",
  "book_page_arabic": 55,
  "running_header": "የጌታችን የኢየሱስ ክርስቶስ ቅዱስ ወንጌል ። ቅዱስ ማቴዎስ እንደ ጻፈው ።",
  "columns": [
    {
      "column_index": 1,
      "section_header": "ምዕራፍ ፩ ።",
      "lines": [
        {
          "line_num": 1,
          "margin_verse_num": "፩",
          "text": "መጽሐፈ ልደቱ ለእግ"
        },
        {
          "line_num": 2,
          "margin_verse_num": null,
          "text": "ዚእነ ኢየሱስ ክርስቶስ ።"
        },
        {
          "line_num": 3,
          "margin_verse_num": null,
          "text": "ወንጌላውያን ሲጽፉ ራሳቸው"
        },
        {
          "line_num": 4,
          "margin_verse_num": null,
          "text": "ን መሠረት አያደርጉም ሌሎ"
        },
        {
          "line_num": 5,
          "margin_verse_num": null,
          "text": "ች ግን ራሳቸውን መሠረት"
        },
        {
          "line_num": 6,
          "margin_verse_num": null,
          "text": "ያደርጋሉ ምንም የሚገልጽ"
        },
        {
          "line_num": 7,
          "margin_verse_num": null,
          "text": "ላቸው መንፈስ ቅዱስ ቢሆን"
        },
        {
          "line_num": 8,
          "margin_verse_num": null,
          "text": "የሚጽፉ ከራሳቸው አንቅተው"
        },
        {
          "line_num": 9,
          "margin_verse_num": null,
          "text": "ነውና ። ዳግመኛ ካንድ አገር"
        },
        {
          "line_num": 10,
          "margin_verse_num": null,
          "text": "ሁነው ጽፈው ወደ አንዱ አ"
        },
        {
          "line_num": 11,
          "margin_verse_num": null,
          "text": "ገር ይሰዱታልና ። ወንጌላውያ"
        },
        {
          "line_num": 12,
          "margin_verse_num": null,
          "text": "ግን የሚጽፉ ጌታ የተናገረ"
        },
        {
          "line_num": 13,
          "margin_verse_num": null,
          "text": "ውን ነው እንጂ ከራቸሳው አ",
          "uncertain": [
            {
              "char_or_word": "ከራቸሳው",
              "alternatives": [
                "ከራሳቸው"
              ],
              "reason": "Typesetting transposition of ቸ and ሳ in the original print"
            }
          ]
        },
        {
          "line_num": 14,
          "margin_verse_num": null,
          "text": "ንቅተው አይደለምና በመካከ"
        },
        {
          "line_num": 15,
          "margin_verse_num": null,
          "text": "ል ሁነው ይጽፋሉና ። ዳግመ"
        },
        {
          "line_num": 16,
          "margin_verse_num": null,
          "text": "ኛ ምንም አንዱም አንዱ ወ"
        },
        {
          "line_num": 17,
          "margin_verse_num": null,
          "text": "ሀሎ ፩ዱ ብእሲ ቢል ነገር ለ"
        },
        {
          "line_num": 18,
          "margin_verse_num": "፩",
          "text": "ማያያዝ ነው ። የጌታችን የኢ"
        },
        {
          "line_num": 19,
          "margin_verse_num": null,
          "text": "የሱስ ክርስቶስ የልደቱ ቍጥ"
        },
        {
          "line_num": 20,
          "margin_verse_num": null,
          "text": "ር ይህ ነው ። ጸሐፍዮ ለብእሲ"
        },
        {
          "line_num": 21,
          "margin_verse_num": null,
          "text": "ከመ ዘሞተ ወበውእቱ መዋ"
        },
        {
          "line_num": 22,
          "margin_verse_num": null,
          "text": "ዕል ወፅአ ትእዛዝ እምኀበ"
        },
        {
          "line_num": 23,
          "margin_verse_num": null,
          "text": "አውግስጦስ ቄሣር ከመ ይጸ"
        },
        {
          "line_num": 24,
          "margin_verse_num": null,
          "text": "ሐፍ ኵሉ ዓለም እንዲል ።"
        },
        {
          "line_num": 25,
          "margin_verse_num": null,
          "text": "አንድም የጌታችን የኢየሱስ"
        },
        {
          "line_num": 26,
          "margin_verse_num": null,
          "text": "ክርስቶስ የልደቱ ወግ ታሪክ"
        },
        {
          "line_num": 27,
          "margin_verse_num": null,
          "text": "ይህ ነው ። ስማ ለዳቤር ትካት"
        },
        {
          "line_num": 28,
          "margin_verse_num": null,
          "text": "ሀገረ መጽሐፍ እንዲል ። የወ"
        },
        {
          "line_num": 29,
          "margin_verse_num": null,
          "text": "ግ የታሪክ ሀገር ሲል ። ወግ"
        }
      ]
    },
    {
      "column_index": 2,
      "section_header": null,
      "lines": [
        {
          "line_num": 1,
          "margin_verse_num": null,
          "text": "የነ ትእማርን የነራኬብን የ"
        },
        {
          "line_num": 2,
          "margin_verse_num": null,
          "text": "ሩትን ያመጣል ። ታሪክ ወለእ"
        },
        {
          "line_num": 3,
          "margin_verse_num": null,
          "text": "ግዚእነ ኢየሱስ ክርስቶስ ከ"
        },
        {
          "line_num": 4,
          "margin_verse_num": null,
          "text": "መዝ ውእቱ ልደቱ ብሎ ያመ"
        },
        {
          "line_num": 5,
          "margin_verse_num": null,
          "text": "ጣል ፥ ልደቱ ለእግዚእነ አለ ፥"
        },
        {
          "line_num": 6,
          "margin_verse_num": null,
          "text": "ብዙ ልደታት አሉና ከዚያ ሲ"
        },
        {
          "line_num": 7,
          "margin_verse_num": null,
          "text": "ለይ ፥ ልደተ አዳም እምድር"
        },
        {
          "line_num": 8,
          "margin_verse_num": null,
          "text": "ልደተ ሔዋን እምገቦ ። ልደተ"
        },
        {
          "line_num": 9,
          "margin_verse_num": null,
          "text": "አቤል እምከርሥ ፥ ልደተ በግ"
        },
        {
          "line_num": 10,
          "margin_verse_num": null,
          "text": "ዕ እምዕፅ ፥ ልደተ ሙታን እ"
        },
        {
          "line_num": 11,
          "margin_verse_num": null,
          "text": "መቃብር አለ ። እኒያ አውጭ"
        },
        {
          "line_num": 12,
          "margin_verse_num": null,
          "text": "ይሻሉ ። እሱ ግን በገዛ ሥልጣኑ"
        },
        {
          "line_num": 13,
          "margin_verse_num": null,
          "text": "ነውና።የልደቱን ነገር ብቻ ይ"
        },
        {
          "line_num": 14,
          "margin_verse_num": null,
          "text": "ናገራልና መጽሐፈ ልደቱ አለ"
        },
        {
          "line_num": 15,
          "margin_verse_num": null,
          "text": "ምነው ቢሉ ። መጽሐፍ በንድ"
        },
        {
          "line_num": 16,
          "margin_verse_num": null,
          "text": "መጀመር ኋላ ብዙ ማምጣት"
        },
        {
          "line_num": 17,
          "margin_verse_num": null,
          "text": "ልማድ ነው ። ከዚያ ሁሉ ኦ"
        },
        {
          "line_num": 18,
          "margin_verse_num": null,
          "text": "ሪት ዘልደት ይላል ። የስነ ፍጥ"
        },
        {
          "line_num": 19,
          "margin_verse_num": null,
          "text": "ረትን ብቻ ተናግሮ ይቀራልን"
        },
        {
          "line_num": 20,
          "margin_verse_num": null,
          "text": "መጽሐፈ ልደቱ ባለው በጥቅ"
        },
        {
          "line_num": 21,
          "margin_verse_num": null,
          "text": "ር አንድ ይላል የንዑስ ም"
        },
        {
          "line_num": 22,
          "margin_verse_num": null,
          "text": "ዕራፍ አንክ ነው ፥ ማቴዎስ"
        },
        {
          "line_num": 23,
          "margin_verse_num": null,
          "text": "መጽሐፈ ልደቱ ማርቆስ አ"
        },
        {
          "line_num": 24,
          "margin_verse_num": null,
          "text": "ንተ ውእቱ ወልድየ ፥ ሉቃስ"
        },
        {
          "line_num": 25,
          "margin_verse_num": null,
          "text": "ወይመስሎሙ ወልደ ዮሴፍ"
        },
        {
          "line_num": 26,
          "margin_verse_num": null,
          "text": "ዮሐንስ ቀዳሚሁ ቃል ያለው"
        },
        {
          "line_num": 27,
          "margin_verse_num": null,
          "text": "ን ሁሉም የጌትነት ነገር ከ"
        },
        {
          "line_num": 28,
          "margin_verse_num": null,
          "text": "ሆነ ብሎ አራቱ የተባበሩበት"
        },
        {
          "line_num": 29,
          "margin_verse_num": null,
          "text": "ሲል ፩ዱ ይላል ፥ ፫ቱ ቢል"
        },
        {
          "line_num": 30,
          "margin_verse_num": null,
          "text": "ማርቆስን አውጥቶ ፥ በሶስተ"
        }
      ]
    },
    {
      "column_index": 3,
      "section_header": null,
      "lines": [
        {
          "line_num": 1,
          "margin_verse_num": null,
          "text": "ኛው ሰንጠረጅ ማርቆስ"
        },
        {
          "line_num": 2,
          "margin_verse_num": null,
          "text": "ለምና ።"
        },
        {
          "line_num": 3,
          "margin_verse_num": null,
          "text": "ወልደ ዳዊት ወልደ አብርሃም"
        },
        {
          "line_num": 4,
          "margin_verse_num": null,
          "text": "ሉቃስ ፥ ም ፥ ፫ ቍ ፴፩ ።"
        },
        {
          "line_num": 5,
          "margin_verse_num": null,
          "text": "የዳዊት ልጅ የአብርሃም ልጅ"
        },
        {
          "line_num": 6,
          "margin_verse_num": null,
          "text": "ከነገሥታት ዳዊት ከአበው"
        },
        {
          "line_num": 7,
          "margin_verse_num": null,
          "text": "አብርሃም ብቻ ይወልዱታልና"
        },
        {
          "line_num": 8,
          "margin_verse_num": null,
          "text": "እንዲህን አለ ቢሉ።ትንቢት"
        },
        {
          "line_num": 9,
          "margin_verse_num": null,
          "text": "የተነገረ ለኒህ ነውና።ትንቢ"
        },
        {
          "line_num": 10,
          "margin_verse_num": null,
          "text": "ቱማ ከነገሥታት ለሰሎሞን"
        },
        {
          "line_num": 11,
          "margin_verse_num": null,
          "text": "አነ እከውኖ አባሁ ወውእቱ"
        },
        {
          "line_num": 12,
          "margin_verse_num": null,
          "text": "ይከውነኒ ወልድየ ተብሎ ።"
        },
        {
          "line_num": 13,
          "margin_verse_num": null,
          "text": "ከአበውም ለሴም ለይኅድር"
        },
        {
          "line_num": 14,
          "margin_verse_num": null,
          "text": "እግዚአብሔር ውስተ ቤቱ ለ"
        },
        {
          "line_num": 15,
          "margin_verse_num": null,
          "text": "ሴም ተብሎ ተነግሮ የለም"
        },
        {
          "line_num": 16,
          "margin_verse_num": null,
          "text": "ቢሉ የሚበዛ የለ ህ ነውና፥"
        },
        {
          "line_num": 17,
          "margin_verse_num": null,
          "text": "በሚበዛው ተናገረ ። አንድም"
        },
        {
          "line_num": 18,
          "margin_verse_num": null,
          "text": "ተስፋ ለተስፋ ሲያነጻጽር በዘ"
        },
        {
          "line_num": 19,
          "margin_verse_num": null,
          "text": "ርእከ ይትባረኩ ኵሎሙ አ"
        },
        {
          "line_num": 20,
          "margin_verse_num": null,
          "text": "ሕዛበ ምድር ያለውንና ። እስ"
        },
        {
          "line_num": 21,
          "margin_verse_num": null,
          "text": "መ እምፍሬ ከርሥከ አነብር"
        },
        {
          "line_num": 22,
          "margin_verse_num": null,
          "text": "ያለውን ተስፋ ለተስፋ ሲያ"
        },
        {
          "line_num": 23,
          "margin_verse_num": null,
          "text": "ነጻጽር።አንድም ዳዊት ሥርወ"
        },
        {
          "line_num": 24,
          "margin_verse_num": null,
          "text": "መንግሥት ነው ። አብርሃምም"
        },
        {
          "line_num": 25,
          "margin_verse_num": null,
          "text": "ሥርወ ሃይማኖት ነውና ። እ"
        },
        {
          "line_num": 26,
          "margin_verse_num": null,
          "text": "ስመ አብርሃም ኮነ ሥርወ"
        },
        {
          "line_num": 27,
          "margin_verse_num": null,
          "text": "ሃይማኖትነ ወሃይማኖቶሙ ለ"
        },
        {
          "line_num": 28,
          "margin_verse_num": null,
          "text": "አይሁድ እንዲል ። የዳዊትን"
        },
        {
          "line_num": 29,
          "margin_verse_num": null,
          "text": "ሥርወ መንግሥትነት ኋላ ያ"
        },
        {
          "line_num": 30,
          "margin_verse_num": null,
          "text": "መጻል ፥ አንድም እግዚአብሔር"
        }
      ]
    }
  ],
