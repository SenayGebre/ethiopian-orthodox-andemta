        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውናንን ሴሎምን ይወልዳል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
