          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስፍና ወምልክና እምአባሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለይሁዳ እስከ አመ ይረክብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘጽኑሕ ሎቱ ተብሎ ተነግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሯል ። ምሳሌውን አሁን ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣል ።ዘፍ፡ ፵፱ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪ወይሁዳኒ ወለደ ፋሬስሃ ወዛ",
          "word_wraps_to_next_line": true
        },
