          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሃ እምትዕማር ።⟫ ዘፍ፡ ፴፰ ፳፱",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ዜዋ ፪ ፬ ፡ ሩት ፬ ፲፰ ፡ ሉቃ",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "፩ዜዋ ፪ ፬ ፡ ሩት ፬ ፲፰ ፡ ፳ጎ",
          "stage2_correction": {
