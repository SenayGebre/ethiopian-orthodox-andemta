          "uncertain": []
        },
        {
          "line_num": 16,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "ይሁዳም ፋሬስን ዛራን ከትዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ወለደ ። የይስሐቅን ልደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት በተናገረ ጊዜ ሳራን ፡ የያዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆብን ልደት በተናገረ ጊዜ ር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቃን ፡ የይሁዳን የወንድሞቹ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ልደት በተናገረ ጊዜ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልያን አለ ራሄልን አላነሣ አ",
