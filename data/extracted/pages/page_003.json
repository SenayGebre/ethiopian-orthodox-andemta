        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በለ መንግሥተ ሰማያትን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወርስምና ያውስ ቢሆን ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁዳን ለይቶ ማንሳቱ ስለምነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
