        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁን ደርሶ እምትዕማር አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምነው ቢሉ ፡ ይህች ምክንያት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላት ናት ። ይሁዳ ሴዋ የምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባል ሚስት አግብቶ ኤርን አ",
