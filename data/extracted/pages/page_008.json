        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማለት ። ክርስቶስ በዳዊት ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በረ ይላሉና ፥ ዳዊት በክርስቶስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከበረ እንጂ እሱማ ጉልማሳ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስገድሎ የጉልማሳ ሚስት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀምቶ አልነበረም ለማለት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪ወሰሎሞንኒ ወለደ ሮብዓምሃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "፫ ነገ ፪ ፴፫ ። ፲፬ ፴፩ ። ፲፩ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "ሰሎሞንም ሮብአምን ወለደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሮብዓምኒ ወለደ አብያሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮብዓምም አብያን ወለደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአብያኒ ወለደ አሳፍሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብያም አሳፍን ወለደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወአሳፍኒ ወለደ ኢዮሳፍጥሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "አሳፍም ኢዮሳፍጥን ወለደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢዮሳፍጥኒ ወለደ ኢዮራምሃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢዮሳፍጥም ኢዮራምን ወለደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢዮራምኒ ወለደ አካዝያስሃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢዮራምም አካዝያስን ወለደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአካዝያስኒ ወለደ ኢዮአስሃ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አካዝያስም ኢዮአስን ወለደ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢዮአስኒ ወለደ አሜስያስሃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢዮአስም አሜስያስን ወለደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ። አካዝያስን ፥ ኢዮአስን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሜስያስን የሚጽፍም የማይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽፍም ይገኛል ። የጻፈ እንደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ የተመቸ ። የተወ እንደሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ በሀገራቸው አንድ አ እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት አ አይገኝምና እና አ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሳስቶት ፥ በሀገራቸውስ ስንኳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሁለት አ አራት አ ይገኛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ብሎ ዝያና ዝያ አሳስቶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ። አንድም መምለክያነ ጣዖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ናቸውና ስማቸው በመጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍ መጻፍ አይገባውም ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎ ። ይህማ አይሆንም ጌታ",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ሎ ። ይህማ አችምይሆን ጌታ",
          "stage2_correction": {
            "pair": "አችምይሆን -> አይሆንም",
            "reason": "Smudged ink in the middle of the word caused the standard Amharic negative verb 'አይሆንም' ('this cannot be, for does the Lord despise a tax collector/sinner?') to be garbled as 'አችምይሆን'."
          }
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግብር ይጸየፋልን ብሎ ። ለቍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥር ይመቸኝ ብሎ ። ለቍጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስ ይመቸኝ ቢል በኒህ ዕጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጥቶባቸዋልን ቢሉ ። ግድፈተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸሐፊ ነው ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአሜስያስኒ ወለደ አዝያንሃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘተሰምየ አዛርያስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሜስያስም አዛርያስ የተባለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዖዝያንን ወለደ ። ሕዝቡ በፍና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሣልቆ በማይገባ ልብሰ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክህኖ ለብሶ ማዕጠንተ ወርቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዞ ከቤተ እግዚአብሔር ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቶ ቢያጥን አዛርያስ ይበሉ",
          "word_wraps_to_next_line": false,
          "stage1_text": "ብቶ ቢያጥኑ አዛርያስ ይበሉ",
          "stage2_correction": {
            "pair": "ኑ -> ን",
            "reason": "The 6th-order sadis 'ን' in singular 'ቢያጥን' (referring to King Uzziah entering the temple to burn incense) was misread as 2nd-order 'ኑ'."
          },
          "uncertain": []
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለውታልና ፥ በፍና ተሣልቆ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለተናገሩ አዛርያስ የተባለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ። አንድም አዛርያስ በሉኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ዖዝያንን ወለደ ። የአዛርያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስን ስራ ልሥራ ማለት አዛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያስ በሉኝ ማለት ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘመኑ ሊቀ ካህናቱ አዛር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ ይባላል በቀኙ ይቀመጣል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምነው ይለዋል ፡ ወካህን ይነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብር በየማኑ እንጂ ይላል ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዋል ። ፍርዱን ይገሥበታል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምነው ይለዋል ። እምነ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥት የዓቢ ክህነት እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ይለዋል ። ከሱ የሚበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጥ ልብስ ይለብሳል ፥ ምነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይለዋል ፥ ካህናቲከ ይለብሱ ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድቀ እንጂ ይላል ይለዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባባቴ ከቤተ መንግሥት ብወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለድ በናቴ ከቤተ ክህነት እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለድ የለምን ብሎ ልብሰ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተክህኖ ለብሶ ማዕጠንተ ወ",
          "word_wraps_to_next_line": true
        },
