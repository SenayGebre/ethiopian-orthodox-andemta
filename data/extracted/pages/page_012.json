          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋ አሜሃ አስተርአየ በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንፈስ ቅዱስ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪ወኵሎንኬ ትውልድ እምአብ",
