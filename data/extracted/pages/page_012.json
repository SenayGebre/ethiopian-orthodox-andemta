        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዳዊት እስከ ፍልሰተ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሎን ትውልድ ፲ወ፬ቱ ።⟫",
