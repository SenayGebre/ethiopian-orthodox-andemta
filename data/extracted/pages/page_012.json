        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዳዊት እስከ ፄዋዌ ፲፬ ትው",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
