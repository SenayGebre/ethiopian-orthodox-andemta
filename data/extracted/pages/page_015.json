          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስት የጎደለው ማለት ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን አግብቶ ቢያወጣው ከዮ",
