          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ እሷን አለው ወልድ አለው",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ንጂ እሷን አለወ ወልድ አለው",
          "stage2_correction": {
            "pair": "ወ -> ው",
