      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕጣን የደቂቀ አዳም ከርቤ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካልዕ ፍጥረት፡ከመ ለስሙ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ክርስቶስ ይስግድ ኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ብርክ ዘውስተ ሰማይ ወዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ምድር ወዘታሕተ ምድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር እንዲል።መላእክት ደቂቀ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳም ካልዕ ፍጥረት ገንዘቦችህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ሲሉ ወርቅ ዕጣን ከርቤ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመጡለት።ይህስ ከወዴት የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣ ነው ቢሉ ሶስቱ መላእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክት ቅዱስ ሚካኤል ቅዱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብርኤል ቅዱስ ሩፋኤል ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቅ ዕጣን ከርቤ አምጥተው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአዳም ሰጡት።አዳም ንሥኢ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዴኪ ብሎ ለሔዋን ሰጣት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔዋን ለሴት ሰጠችው ከሴት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲወርድ ሲዋረድ ከኖኅ ደርሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አል ።ኖኅ ከመርከብ ሲገባ ይዞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ገብቷል ሲወጣም ይዞት ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥቷል በሚሞትበት ጊዜ ሴምን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጄን ከወንድምህ ከካም ወገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ደግ ልጅ ይወለዳልና ካባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ከናቱ አሰናብተህ ወርቁን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕጣኑን ከርቤውን አጽመ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በውን አስጠብቀው ሥራት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራበት ብሎታል፡ካባት ከና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ አሰናብቶ ወርቁን ዕጣኑን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከርቤውን አሸክሞ ሲሄድ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድሞቹ ያፌትና ካም ተከተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉት እናንተ አልታዘዛችሁም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "የታዘዝን እኛ ነን ተመለሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ተመለሱ ፡ መልአክ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተገልጾ እየመራቸው ሄዱ ዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳሌም ሲደርሱ ጐድጓዳ ቦታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገኙ ዓጽመ አበውን ቀብሮ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሶስቱን ንዋያት ሰጥቶ ሥራት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሠራበታል ከሴት አትድረስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳባ ልበስ ሥጋ አትብላ ጠጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "አትጠጣ ራስክን አትላጭ ጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍርህን አትቍረጥ በስንዴ በ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይን አስታኵት ብሎ ። እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህ ሁኖ ሲኖር።አብርሃም ላም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቱ ነገሥተ ሰዶም ረድቶ አራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ነገሥተ ኮሎዶጎሞርን ድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ነሥቶ ሲመለስ ደስ ቢለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመዋዕልየኑ ትፌኑ ቃለከ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚመ ታርእየኒኑ ኪያሃ ዕለተ",
          "word_wraps_to_next_line": false,
          "stage1_text": "ሚመ ታርእየኒሁ ኪያሃ ዕለተ",
          "stage2_correction": {
            "pair": "ሁ -> ኑ",
            "reason": "Ge'ez interrogative enclitic -ኑ on 'ታርእየኒኑ' (parallel to 'በመዋዕልየኑ' in L06), where 'ኑ' was misread as 'ሁ'."
          },
          "uncertain": []
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አው አልቦ አለው። እሱንስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አታየውም ምሳሌውን ታያለህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና ሑር ዕድዎ ለዮርዳኖስ ።ዮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዳኖስን ተሻግረህ ሂድ አለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮርዳኖስን ተሻግሮ ቢሄድ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልከ ጼዴቅ ኅብስተ በረከት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽዋዓ አኰቴት ይዞ ተቀብሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል ፡ መልከ ጼዴቅ የቀሳው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስት አብርሃም የምዕመናን ኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብስቱ የሥጋው ጽዋዕ የደሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮርዳኖስ የጥምቀት ምሳሌ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ጊዜ መልከ ጼዴቅ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቁን ዕጣኑን ከርቤውን ለአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሃም ሰጠው።ከአብርሃም ለይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሐቅ ከይስሐቅ ለያዕቆብ ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስዋል ያዕቆብ ወደግብፅ ሲወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርድ ይዞት ወርዷል ሲወጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ይዞት ወጥቷል። ከያዕቆብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲወርድ ሲዋረድ ከዕሤይ ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስዋል ፡ከዕሤይ ለዳዊት ከዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊት ለሰሎሞን ከሰሎሞን ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮብዓም ደርስዋል።በሮብዓም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ መንግሥት ከሁለት ተከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈለ፡ኢዮርብዓም ወልደ ናባጥ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
