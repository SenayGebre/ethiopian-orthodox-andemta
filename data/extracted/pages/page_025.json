          "line_num": 1,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘከመ ጐየ ውስተ ምድረ ግብፅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪ወእምድኅረ ኃለፉ እሉ ናሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአከ እግዚአብሔር አስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርአዮ በሕልም ለዮሴፍ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእንተ ካልዕ ፍኖት ገብኡ ወአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተዉ ብሔሮሙ ብሎ ነበርና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "ሰብአ ሰገል ከሄዱ በኋላ ከእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚአብሔር የታዘዘ መልአክ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዮሴፍ በሕልም ነገረው ። ሳሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለመንገሩ ከሄዱ በኋላ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገሩ ስለምን ነው ቢሉ ። ሰብአ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰገል ሳሉ ነግሮት ቢሆን ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰደድ አይተው አምላክነቱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተጠራጠሩ ነበርና ። አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካልቀረስ ይዘነው እንሂድ ባሉ",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ከልቀረስ ይዘነው እንሂድ ባሉ",
          "stage2_correction": {
            "pair": "ከ -> ካ",
            "reason": "The printed glyph has the 4th-order right-leg extension (ካልቀረስ, 'since it is not avoided / if it must be so'), which was misread as 1st-order ከ."
          }
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበርና ። ይዘውትም እንዳይሄዱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጌታ ስደቱ ወደ ግብፅ ነው እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ ። ወደ ባቢሎን አይደለምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ይብል ተንሥእ ወንሣእ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕፃነ ወእሞ ወጕየይ ውስተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድረ ግብፅ ።⟫ ተነሥተህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናቱን ብላቴናውን ይዘህ ወደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግብፅ ሂድ ብሎ ነገረው ሐተ",
