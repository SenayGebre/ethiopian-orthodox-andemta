          "text": "ለኝ እንጂ እናቱን አላለኝ ባለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበርና ፡ እሞ ብሎ ሕፃነ ባይል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናቱን አለኝ እንጂ ብላቴና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
