        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከ እንደ አለው ከዚህም በግ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ከ እንደ አለው ከዚሀም በግ",
          "stage2_correction": {
            "pair": "ሀ -> ህ",
            "reason": "Amharic demonstrative ከዚህም ('and here') uses 6th-order ህ, not 1st-order ሀ."
          },
          "uncertain": []
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሩ ነቢይ አለው።ያውስ ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆን ይህ የተነገረ ለሶምሶን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለምን ቢሉ።ለጊዜው ለሶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሶን ቢሆን ፍጻሜው ለጌታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና።አነ እከውኖ አባሁ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ ይከውነኒ ወልድየ ያለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ለጊዜው ለሰሎሞን ቢሆን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍጻሜው ለጌታ እንደ ሆነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውስ ቢሆን በምን ይመስለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋልና እንዲህ አለ ቢሉ።ሶም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሶን በተናቀች መንሰከ አድግ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠላቶቹን እንዳጠፋ ጌታም አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁድ አጋንንት መናፍቃን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በናቁት ሞቱ ሞትን አጥፍቷ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ። ሶምሶን በሕይወተ ሥጋ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳለ ካጠፋቸው አሕዛብ በሞቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያጠፋቸው ይበዛሉ።ጌታም በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወተ ሥጋ ሳለ ካጠፋቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንት በሞቱ ያጠፋቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይበዛሉና።አንድም ከመ ናዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራዊ ይሰመይ ብለህ ናዝሬት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለት ፍልጠት ክፍለት ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። ልጁ ልዩ ይባል ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናዝሬት ገብቶ ኖረ።ዘተብህለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነቢይ ስሙ ለልዑል ቅዱሰ ቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዱሳን ወይትቀባዕ ቅዱሰ ቅዱሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ያለው ይደርስ ይፈጸም ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ናዝሬት ማለት ኅሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርት ማለት ነው፤ይእተ አሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ይሰምያ ለናዝሬት በስመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃሣር እንዲል ። ልጁ ኅሡር ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባል ዘንድ ናዝሬት ገብቶ ኖረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልመንሡር እንዲል በዓረብ",
          "word_wraps_to_next_line": false,
          "stage1_text": "አልህንሡር እንዲል በዓረብ",
          "stage2_correction": {
            "pair": "ህ -> መ",
            "reason": "The printed glyph after አል is መ (አልመንሡር), an Arabic loan/gloss in the Andemta."
          },
          "uncertain": []
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅሡር ሲል ። አንድም ናዝሬት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለት አጽቀ ጽጌ ማለት ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጁ አጽቃዊ ጽጌያዊ ይባል",
          "word_wraps_to_next_line": false,
          "stage1_text": "ልጁ አጽቃያዊ ጽጌያዊ ይባል",
