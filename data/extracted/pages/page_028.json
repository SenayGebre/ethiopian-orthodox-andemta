          },
          "uncertain": []
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ አዕፁቅ እንደ ጽጌያት",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አድርጎ ያስገኛልና፤ያው ግን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነቢይ ቃል ትወጽእ በትር እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሥርወ ዕሤይ ወየዓርግ ጽጌ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምጉንዱ ተብሎ የተነገረው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደርስ ይፈጸም ዘንድ ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ስብከተ ዮሐንስ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፫ቱ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወበውእቱ መዋዕል በጽሐ ዮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐንስ መጥምቅ እንዘ ይሰብክ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገዳመ ይሁዳ ዘዮርዳኖስ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ከመ ናዝራዊ ይሰመይ ወልድየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ነበርና ናዝራዊ በተባለበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ወራት ፡ ቦአ ናዝሬተ ብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበርና ናዝሬት በገባበት ወራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት፤ሐያ አምስቱን ዘመን አንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገን አድርጎ ወበውእቱ መዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕል አለ በዮሐንስ አርባውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን አንዳንድ ቀን አድርጎ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እመ ሳኒታ እንዳለ ። አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወተወሊዶ ብሎ ነበርና ሥጋ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሆነበት ወራት።አንድም ለዮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐንስ ሠላሳ ሲመላው ለጌታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈቅ ሲቀረው በዚያ ወራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት የዮርዳኖስ አውራጃ በምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆን በይሁዳ ምድረ በዳ ዮሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስ መጥምቅ ሲያስተምር ደረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰ።በገዳም አለ ቦታው ነውና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
