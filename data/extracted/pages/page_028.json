          },
          "uncertain": []
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ናዝሬት ገብቶ ኖረ።እሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ጉንድ ሁኖ ምዕመናንን",
          "word_wraps_to_next_line": false,
          "stage1_text": "እንደ ጉንድ ኖሁ ምዕመናንን",
          "stage2_correction": {
            "pair": "ኖሁ -> ሁኖ",
