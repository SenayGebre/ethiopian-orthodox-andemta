      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠመቀ እንደ ሰውነቱ ተረግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጦ እንደ አምላክነቱ አቅልጦ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጥፍቶላቸዋል ። በሲኦል የጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለውን በዕለተ ዓርብ በአካለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ወርዶ ነፍሳትን ሲያወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣ አጥፍቶላቸው ወጥቷል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪ወዮሐንስሰ ዓበዮ እንዘ ይብል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንሰ እፈቅድ እምኀቤከ እጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቅ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "ዮሐንስ ግን ባሪያ በጌታው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጅ ይጠመቃል እንጂ ጌታ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሪያው እጅ ይጠመቃልን ብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሆንም አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንተኑ ትመጽእ ኀቤየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሪያ ወደ ጌታው ይሄዳል እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ ጌታ ወደ ባሪያው ይሄዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን አለው፤እናቱ ምንትኑ አነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ትምጽኢ ኀቤየ እሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእግዚእየ ብላ ነበርና ። ከዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ አያይዞ እንዲህ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወአውሥአ እግዚእ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይቤሎ ኅድግ ምዕረሰ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "ጌታ መለሰ አንድ ጊዜስ ተው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ። ሐተታ አንድ ጊዜ ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠመቅ ሁለተኛ፤በፈቃድ ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠመቅ በግድ፤በሰውነቱ ቢጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቅ በምላክነቱ መጠመቅ የለ",
          "word_wraps_to_next_line": true,
          "uncertain": [
            {
              "printed_text": "በምላክነቱ",
              "alternative": "በአምላክነቱ",
              "note": "syncopated/printed without አ"
            }
          ]
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በትምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ከመዝ ተደላ ውእቱ ለነ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ለኛ ተድላችን ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ። ራሱን ከዮሐንስ አግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቶ አንተም መጥምቀ መለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮት ተብለህ ክብርህ ይነገራልና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔም በባሪያው እጅ ተጠመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀ ተብሎ ትሕትናዬ ይነገራልና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይደልወነ ከመ ንፈጽም ኵሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽድቀ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንቢተ ነቢያትን ልንፈጽም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይገባናልና ዮሐንስ እንዲያጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምቅ ጌታ እንዲጠመቅ ትን",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢት ተነግሯልና ። አንድም ⟪እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመ ከመዝ ተደላ ለነ ።⟫ ራሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ከምእመናን አግብቶ ይህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኛ ተድላችን ነውና ። እናን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተም ብትጠመቁ ይወርድላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችኋል ለማለት ። ⟪ወይደልወነ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ ንፈጽም ኵሎ ጽድቀ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽድቀ ተሰብኦን ልንፈጽም ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባናልና ። አንድም ራሱን ከአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ከመንፈስ ቅዱስ ጋራ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ አድርጎ ይህ ለኛ ተድላች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ነውና አለ ። አብ ዝንቱ ው",
          "word_wraps_to_next_line": true,
          "uncertain": [],
          "stage1_text": "ን ነውና ኽለ ። አብ ዝንቱ ው",
          "stage2_correction": {
            "pair": "ኽለ -> አለ",
            "reason": "Ink smudge on top of አ caused it to be misread as ኽ; standard Amharic quotative verb 'አለ' (he said)."
          }
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እቱ ወልድየ ብሎ ሲመሰክር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈስ ቅዱስ በአምሳለ ርግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ወርዶ ከራሱ ላይ ሲቀመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥ አንድነት ሶስትነት ይገለጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ። ⟪ወይደልወነ ከመ ንፈጽም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሎጽድቀ ።⟫ በማኅፀን የጀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "መርነውን ቸርነት ልንፈጽም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይገባናልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዝ ኀደጎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ በኋላ ተወው ። ሐተታ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲያው አይተወውም ስመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብ ብከ ወስመ ወልድ ለሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከ ወስመ መንፈስ ቅዱስ ሀል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ውስቴትከ ባዕድ አጠምቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስምከ ወበስመ መኑ አጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምቅ ኪያከ አለው ። ወልዱ ለቡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩክ ከሣቴ ብርሃን ተሣሃለነ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተ ካህኑ ለዓለም በከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሢመቱ ለመልከ ጼዴቅ ብለህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጥምቀኝ አለው ። ከዚህ በኋላ",
          "word_wraps_to_next_line": false
        },
