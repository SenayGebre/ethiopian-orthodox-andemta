          },
          "uncertain": []
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአሕዛብ ክፍል ዕፃ በምትሆን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገሊላ ያሉ ። ሐተታ ዘአሕዛብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለና ከዚያ ሲለይ ዘአሕዛብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፥ ሰሎሞን ቤተ መቅደስን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሠራ ጊዜ ወአርድኦ ኪራም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዕፀወ ቄድሮስ ወጰውቄና እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲል ፥ ጥድ ዝግባ እየጠረበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አግዞታል ፥ ሀያ ያህል ቀላል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀላል አህጉር ሰጠው እስመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢዓደማሁ ይላል ደስ ባያሰኙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ወዳጄ በኔና በንተ ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ ምን ቁም ነገር ነው አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። የመልክተኛ ማደሪያ ይሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንህ ብዬ ነው አለው ከዚህ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላ አሕዛብ እንደ ባለጉልት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤል እንደ ባለርስት ሁነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው የሚኖሩ ሁነዋልና ገሊላ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘአሕዛብ አለ ። አንድም ፈርዖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን አሕዛብን ወግቶ ለልጁ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰሎሞን ሚስት ሰጥቷት ነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርና ገሊላ ዘአሕዛብ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ሕዝብ ዘይነብር ውስተ ጽልመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ርእየ ብርሃነ ዓቢየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "በጨለማ ላሉ ሕዝብ ታላቅ ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሃን ወጣላቸው ። ⟪ወለእለሂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይነብሩ ውስተ ጽልመት ወጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላሎተ ሞት ብርሃን ሠረቀ ሎሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጨለማ በሞት ጥላ ለሚኖሩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርሃን ወጣላቸው ብሎ ኢሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይያስ የተናገረው ይደርስ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸም ዘንድ በቅፍርናሆም ኖረ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም በድንቁርና በቀቢጸ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስፋ ለነበሩ ሰዎች ዕውቀት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰጣቸው ፥ አንድ ገጽ በማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞትን በመምሰል ሞት በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣው ምስል ለሚኖሩ ሰዎች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ተወለደላቸው ወንጌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ተጻፈላቸው ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም በሞተ ሥጋ በሞተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ለነበሩ ልጅነት ተሰጣቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። በኃጢአት በክህደት ለነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሩ ሃይማኖት ተገለጸላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ኃጢአትን ጽልመት ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህደትን ጽላሎተ ሞት አለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጨለማ ላይ የዛፍ የገደል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥላ የተጨመረ እንደሆነ ጨ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማው እንዲጠና በኃጢአትም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላይ ክህደት የተጨመረ እንደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፍዳው ይጸናልና ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪ወእምአሜሃ አኀዘ እግዚእ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ይስብክ ወይብል ነስሑ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስመ ቀርበት መንግሥተ ሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማያት ።⟫ ማር ፩ ፲፬ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ዮሐንስ ከተያዘበት ቀን ጀም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮ ጌታችን ኢየሱስ ክርስቶስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደጊቱ በልጅነት ልጅነት በሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይማኖት ልትሰጥ ቀርባለችና እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "መኑ እያለ ያስተምር ጀመረ ዮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐንስ ከተያዘ በኋላ ማስተማሩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለምን ቢሉ መምር ሳለ በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምር ላይ እናስተምራለን አት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሉ ለማለት ። አንድም መም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩ አንድ ዮሐንስ ነበረ ያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ተመተረ እንዳይሉ ትምር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱንም አለወጠውም የስንቱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰሟል እንዳይሉ ፥ አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ቀርበት መንግሥተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማያት ብሎ ያስተማረልኝ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኔ ነኝ ሲል ነው ፥ ነያ ይሰምያ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንግሥተ ሰማያት ለአስተርእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮቱ ማዕከለ ፍቁራኒሁ እንዲል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ቀዳማውያን ሐዋርያት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "⟪ወእንዘ ያንሶሱ መንገለ ባሕረ ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊላ ርእየ ፪ተ አኃወ ።⟫ ማር፩ ፲፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "በገሊላ ባሕር ማዶ ሲመላለስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ወንድማማቾች አገኘ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ስምዖንሃ ዘተሰምየ ጴጥሮስ ።⟫",
          "word_wraps_to_next_line": false
        }
      ]
