        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲና ሕገ ኦሪትን የሠራሁ እኔ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነኝ ሲል።አንድም ልዑለ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ ነኝ ሲል።አንድም የሠራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁላችሁ ሕግ ልዕልት ናት።",
