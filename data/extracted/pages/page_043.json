        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ መዛሙርቱ ወደሱ ቀረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
