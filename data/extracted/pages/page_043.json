        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ተወጻጽተው አምስት ገበያ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያህል ሰዎች ተከተሉት፡ላንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሽማግሌ አሥር ልጆች ነበሩት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኒህ እየራሳቸው አንድ አንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገር አቅንተው ይኖሩ ነ",
          "word_wraps_to_next_line": true,
          "stage1_text": "እገር አቅንተው ይኖሩ ነ",
          "stage2_correction": {
            "pair": "እ -> አ",
            "reason": "The printed glyph is 1st-order አ (አገር አቅንተው, 'developing/settling a town/land'), misread as 6th-order እ."
          },
          "uncertain": []
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርና።አንድም ጲላጦስ ለቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረጥ ይመቸኝ ብሎ አንዱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተማ ካሥር ከፍሎታል፤ከዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህ ተወጻጽተው ተከትለውታል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነዚህም ስለ አምስት ነገር ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተሉታል፡አንዱ ገበያ መል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኩን እናያለን ብለው፤አንዱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገበያ ኅብስት አበርክቶ ያበላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናል ብለው።አንዱ ገበያ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቱን እንሰማለን ብለው።አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዱ ገበያ ከደዌያችን ይፈውሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናል ብለው።አንዱ ገበያ የኦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሪትን መፍረሻ የወንጌልን መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታነጫ እናያለን ብለው ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኒህም ትንቢት ተነግሮላቸዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ተነግሮባቸዋል።መልኩን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናያለን ላሉት ይሤኒ ላህዩ እም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውሉደ እጓለ እመሕያው ተብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎ።ኅብስት አበርክቶ ይመግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በናል ላሉት ወኢያኀጥኦሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምዘፈቀዱ ተብሎ። ያስተም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረናል ላሉት ጥዑም ለጉርዔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "የ ነቢብከ ተብሎ።ከደዌያችን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይፈውሰናል ላሉት ነሥአ ደዌነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወፆረ ሕማመነ ተብሎ ። የኦሪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን መፍረሻ የወንጌልን መታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነጫ እናያለን ባሉት ቅንዓት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አኀዞሙ ለሕዝብ አብዳን ተ",
