        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳልና።ወይረድ ከመ ጠል ነቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብየ እንዲል።አንድም በደብረ",
