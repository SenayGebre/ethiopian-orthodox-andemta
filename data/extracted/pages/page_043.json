        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኖ ማስተማር ልማድ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምር ከፍ ካለ ቦታ ሰማዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ዝቅ ካለ ቦታ የሆኑ እን",
