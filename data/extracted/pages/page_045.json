        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህ እንጢላርዮስ ባለጸጋ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንፉግ ነው ፥ ነዳያን ሲያልፍ አ",
