          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልብሱ ለእርዝና እህሉ ለቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠና እያሉ ያዳክማሉና እንዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዳክሙት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪ከመ በኅቡዕ ይኩን ምጽዋትከ፥⟫",
