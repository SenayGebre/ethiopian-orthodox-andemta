        },
        {
          "line_num": 3,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "ዘፍጥ ፳፰ ፳ ምሳ ፴ ፰ ፩ ጢሞ",
          "word_wraps_to_next_line": false
        },
