          "text": "ብሱት ብለው አኑረውት ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ቢበላው ምቀኝነት ነውና ።",
          "word_wraps_to_next_line": false
        },
