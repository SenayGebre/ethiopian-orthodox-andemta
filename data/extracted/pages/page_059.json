          "text": "ሱት ብለው አኑረውት ነቀዝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢበላው ። ልብሱን ነዳያን ኪለ",
          "word_wraps_to_next_line": true
