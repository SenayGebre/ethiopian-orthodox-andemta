          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ያመጣዋል።እህሉን ነዳያን ኪበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
