          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳግመኛ ለክፉ ጊዜ ይሆነኛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ብሎ ማኖር እግዚአብሔር",
          "word_wraps_to_next_line": true
        },
