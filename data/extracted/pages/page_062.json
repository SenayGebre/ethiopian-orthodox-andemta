          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጅነትን ያገኙ አሕዛብን አብነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አድርገ። እብለክሙ ከመ",
