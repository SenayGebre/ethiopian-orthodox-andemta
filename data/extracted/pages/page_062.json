          "margin_tag": null,
          "line_type": "body",
          "text": "ገኙም ብዬ እንዳላገኙ እነግራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችኋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "⟪ወናሁ ሣዕረ ገዳም ዘዮም ሀሎ",
          "word_wraps_to_next_line": false
        },
