        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንቢት በዚያ ሁሉ ሱባዔ ከአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዛብ እንዳንዱ ልጅነትን አላ",
