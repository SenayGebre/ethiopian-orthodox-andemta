      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለዘሂ አበጠከ አሐደ ምዕራፈ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑር ምስሌሁ ወአብጽሕ ሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ፪ተ ምዕራፈ ወለዘሂ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድ ይትዓገልከ መልበሰከ ኅድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግ ሎቱ ክዳነከሂ ትላለችና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ሰፊ በር ሰፊ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገድ የተባለ ፈቃደ ሥጋ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠባብ በር ጠባብ መንገድ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተባለች ፈቃደ ነፍስ ናት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ሰፊ በር ሰፊ መንገድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተባለ ባለጸጋን መጽውት ድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃን ጹም ማለት ነው ፤ ጠባብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በር ጠባብ መንገድ ባለጸጋን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጹም ድኃን መጽውት ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። አንድም ዕዝራ ያያት መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንገድ ናት ። የማና እሳት ወፀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋማ ቀላይ ወኢታግምር ዘእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንበለ ኪደተ ፩ዱ እግረ ብእሲ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ። ያላንድ ጫማ የማታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቆም መንገድ አይቷል ፤ አሷ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀሎ በሕገ ነፍስ ካልሆኑ አት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባም ሲል ነው እንጂ በቁሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለም ። ከዚህም ጌታን የጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድቃን ማነስ የኃጥአን መብዛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አያሳዝነውም ጥቂት ዕንቍ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ብዙ ወርቅ ባለው ጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቂት ወርቅ ያለው ብዙ ብር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለው ጥቂት ብር ያለው ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዙ ብረት ባለው ጥቂት ብረት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ብዙ ሸክላ ባለው ጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቂት ሸክላ ያለው ብዙ ደንጊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ ባለው እንዳይቀና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ተዓቀቡኬ እምሐሳውያን ነቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት እለ ይመጽኡ ኀቤክሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአልባሰ አባግዕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "የበግ ለምድ ለብሰው ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "እውነተኞች መስለው ከሚመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡ ከሐሰተኞች ሃይማኖታው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን መስለው ከሚመጡ ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናፍቃን መንፈሳውያን መስለ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ከሚመጡ ከሥጋውያን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምራን ተጠበቁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንተ ውስጦሙሰ ተኵላት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰጥ እሙንቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በውስጥ ግን ነጣቂ ተኵላ ና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ማለት ቢመረምሯቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ሰውን እየነጠቁ ወደ ገሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነም የሚያወርዱ ናቸው ። በከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ ይቤ ኢዮብ የሚል አብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ይገኛል ተናግሮ ሳይጻፍ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀረ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ወእምፍሬሆሙ ተአምርዎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እውነተኛ መስለው የሚመጡ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐሰተኞችን ሃይማኖታውያን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "መስለው የሚመጡ መናፍቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን መንፈሳውያን መስለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚመጡ ሥጋውያኑን መምህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራን በምን እናውቃቸዋለን ት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉኝ እንደሆነ በሥራቸው ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቋቸው አላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ይቀስሙሁ እምእስዋክ አስካለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእምአሜከላ በለሰ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚያውስ ላይ ሥራቸውን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንሠራም እንጂ ትምርታቸው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንማ ብንማር ምን ዕዳ ይሆናል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሉኝ እንደሆነ ከሾህ ፍሬን ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደንደር በለስን ይለቅማሉ ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናፍቅ መምር ሃይማኖትን ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋዊ መምር መንፈሳዊ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርትን ከሐሰተኛ መምር እው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነተኛ ትምርትን ይማራሉን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከማሁኬ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "መርዝ መርዝን ኮሶ ኮሶን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲያፈራ ። መናፍቅ መምር ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
