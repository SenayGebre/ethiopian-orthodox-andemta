        {
          "line_num": 1,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "ሁሉ አቤቱ አቤቱ ይልሃል እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚገባውንስ የማይገባውንስ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን እናውቀዋለን ትሉኝ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሆነ፤አቤቱ አቤቱ የሚለኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ መንግሥተ ሰማያት አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባም ። ⟪አኮ ዘይበውእ ።⟫ የሚገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባ አይደለም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘእንበለ ዘይገብር ፈቃዶ ለአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቡየ ዘበሰማያት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰማያዊ አባቴን ፈቃድ የሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራ ይገባል እንጂ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "⟪ወብዙኃን ይብሉኒ በይእቲ ዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት እግዚኦ እግዚኦ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "በእለተ ምጽአት ብዙ ሰዎች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቤቱ አቤቱ ይሉኛል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አኮኑ በስምከ ተነበይነ ።⟫ ዘኍ ፳",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ፲፯ በስምህ መጻእያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ተናግረን የለም ይሉኛል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ። በለዓም ኮከብ ይሠርቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምያዕቆብ ብሎ ተናግሯልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበስምከ አጋንንተ አውጻእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ ።⟫ ግብ ፲፱ ፲፬",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስምህ አጋንንትን ስናወጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልነበርንም ይሉኛል ፡ ደቂ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀ አስቄዋ ጋኔን ያወጡ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበስምከ ኃይላተ ብዙኃ ገበርነ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስምህ ፍጹም ታምራት ስና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደርግ አልነበርንም ይሉኛል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁዳ ሙት እስከ ማንሣት ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሶ ነበርና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "⟪ወይእተ ጊዜ እብሎሙ ግሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራ ኢየአምረክሙ ረኃቁ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኔየ ኵልክሙ እለ ትገብሩ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "መፃ ።⟫ መዝ ፮ ፱ ማቴ ፳፭ ፵፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፲፫ ፳፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "ያን ጊዜ ከቶ አላውቃችሁም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓመፅን የምትሠሩ ሁላችሁም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኔ ራቁ እላቸዋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ። ፈጥሮስ አላውቃችሁ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም አይልም ። ወለድኋችሁ ካድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋችሁ እላቸዋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "⟪ኵሉኬ ዘይሰምዕ ዘንተ ቃልየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይገብሮ ይመስል ብእሴ ጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢበ ዘሐነፀ ቤቶ ዲበ ኰኵሕ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፮ ፵፰ ሮሜ ፪ ፲፫ ያዕ ፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "ይኽን የኔን ነገር ሰምቶ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠራው ሰው ሁሉ ቤቱን በጭ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጫ ላይ የሠራ ብልህ ሰውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይመስላል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "⟪ዘንሙ ዝናማት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "ዝናም ዘነመ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውኅዙ ወሐይዝት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጎርፍ ጎረፈ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነፍሑ ነፋሳት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፋስ ነፈሰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገፍዕዎ ለውእቱ ቤት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ቤት እናናውጽህ አሉት ፡",
          "word_wraps_to_next_line": false,
          "stage1_text": "ያን ቤት እናናውጽሕ አሉት ፡",
          "stage2_correction": {
            "pair": "ሕ -> ህ",
            "reason": "The 2nd person masculine singular object suffix on Amharic 'እናናውጽህ' is printed with 'ህ' (6th order ሀ), not 'ሕ'."
          },
          "uncertain": []
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢወድቀ ፡⟫ አልተናወጸም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ዲበ ኰኵሕ ተሣረረ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጭንጫ ላይ ተሰርቷልና ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተታ ፤ እንደምን አድርገው ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠሩታል ቢሉ ዘይት ያፈሱበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል ይላላል ያን እየቈፈሩ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሠርቱበታል ይጸናል ። አንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ⟪ኵሉ ዘይሰምዕ⟫ ብለህ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልስ ። ይህን የኔን ቃል ሰምቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሠራው ሁሉ ሃይማኖቱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በበጎ ልቡና የያዘ ብልህ ሰው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ይመስላል ። ⟪ዘንሙ ዝናማት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዓላውያን ነገሥታት ከዓላው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን መኳንንት የሚመጣ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከራ ነው ። ⟪ውኅዙ ወኀይዝት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
