        {
          "line_num": 1,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "ከጴጥሮስ ቤት በገባ ጊዜ ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማተ ጴጥሮስን ሆድ ዝማ ታማ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተኝታ አገኛት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወአኃዘ እዴሃ ወገሠሣ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "እጇዋን ይዞ ዳሰሳት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኅደጋ ፈጸንታ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆድ ዝማዋ ተዋት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተንሥአት ወተልአከቶሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተነሥታ አገለገለቻቸው ። መፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትፌት ማሳለፍ አይደለም ለጊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዜው የሚበሉትን እያዘጋጀች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቀረበችላቸው ፍጻሜው ግን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከ፴፮ቱ ቅዱሳት አንስት ገብታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቈጠረች ። አንድም ። ወበዊዖ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለህ መልስ እስራኤልን በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከብባቸው ጴጥሮስ አላቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ ወደ እስራኤል በመምር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት በገባ ጊዜ ረከበ ለሐማተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥ ሮስ ። ኦሪትን ስብ ስታጤስ",
          "word_wraps_to_next_line": false,
          "uncertain": [
            {
              "printed_text": "ጴጥ ሮስ",
              "alternative": "ጴጥሮስ",
              "note": "space due to faded/dropped character or spacing"
            }
          ]
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደም ስታፈስ አገኛት ወአኃዘ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዴሃ ፲ቱቃላትን ባሉት አጽን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶ አሳለፋት ። ወኅደጋ በኦሪት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራት ደም ማፍሰስ ስብ ማጤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ቀረ ። ⟪ወምሴተ ከዊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "ኖ አምጽኡ ኀቤሁ ብዙኃነ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ አጋንንት ።⟫ ማር ፩ ፴፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "ወምሴተ ከዊኖ ወሶበ መስየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ። ሲመሽ በመሸ ጊዜ ብዙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንት ያደሩባቸው ሰዎች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዘው መጡ ። ፈውሱ ከዓቀብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ሥራይ ልዩ ነውና ። እነዚያ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ዕለት እንጂ ፡ በዚህ ዕለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት በዚህ ሰዓት እንጂ በዚህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዓት አይቻልንም ይላሉ ። እሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን በመጡበት ሰዓት ሁሉ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድናቸዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአውጽኦሙ በቃሉ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻኡ መናፍስት ርኩሳን ብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "አወጻቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈወሰ ኵሎ ድዉያነ ።⟫",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕሙማኑን አዳነ ። ⟪ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ይትፈጸም ቃለ ኢሳይያስ ነቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ ዘይቤ ውእቱ ነሥአ ደዌነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወፆረ ሕማመነ ።⟫ ኢሳ ፶፫ ፬",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ጴጥ ፪ ፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ደዌያችንን ተሸከመ ማለት ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳይያስ ደዌ ሥጋችንን በታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራት ደዌ ነፍሳችንን በትምር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አራቀልን ብሎ የተናገረው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንቢት ይደርስ ይፈጸም ዘን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ድውያነ ሥጋን በተአምራት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድውያነ ነፍስን በትምርት አዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ ፡ አንድም ድውያነ ነፍስን በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምርት አዳነ ። ብሎ ኢሳይያስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተናገረው ይደርስ ይፈጸም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ድውያነ ሥጋን በታም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራት አዳነ ። ሞተ ሥጋው ለሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ነፍስ ምልክት እንደሆነ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኅነተ ሥጋው ለድኅነተ ነፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ምልክት ነውና ። አንድም እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስከ አዕርጎ ወአሰሰለ ይላል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብነት ደዌ ነፍሳችንን በመስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀል ተሰቅሎ እስኪያርቅልን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድረስ ደዌ ሥጋችንን በታም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራት አራቀልን ብሎ ኢሳይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ የተናገረው ይደርስ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸም ዘንድ ፡ ፈወሰ ፡ ድውያንን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዳነ ። አንድም ነቢይ ነሥአ ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዌነ ወፆረ ሕማመነ እንዳለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌላዊም ነሥአ ደዌነ ወፆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ሕማመነ ፡ ደዌያችንን ነሣ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሪክ ። ከራድዮን የሚባል ፀዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
