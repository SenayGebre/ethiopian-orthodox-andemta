        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ፡ አዲሱ ራዋት የጠጁን ፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላሎት ይችለዋል የጠጁም ፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላሎት አዲሱን ራዋት ያለፋዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ አንድም ሐዋርያትን በ",
