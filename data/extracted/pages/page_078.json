          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወጸውዖሙ ለ፲ቱ ወ፪ቱ አርዳ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኢሁ ።⟫ ማር ፫ ፲፫ ሉቃ ፮ ፲፫ ፱ ፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "አሥራሁለቱን ደቀ መዛሙር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ጸራቸው ማለት ሾማቸው",
