    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ። አሥራሁለቱ አንቅዕት ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራሁለቱ ሐዋርያት ፸ ተመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርት የ፸ አርድዕት ምሳሌ ። አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም በልብሰ አሮን ባሉ በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሥራሁለቱ አዕናቍ ምሳሌ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በደብረ ሲና ከዙፋኑ እግር በተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገኙ በ፲፪ቱ አዕናቍ ፡ ኤልያስም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ጋን ውሃ አምጡ ብሎ ደግ",
          "word_wraps_to_next_line": true,
          "stage1_text": "፬ ቓል ውሃ አምጡ ብሎ ደግ",
          "stage2_correction": {
            "pair": "ቓል -> ጋን",
            "reason": "In 1 Kings 18:33, Elijah says to fill four jars (፬ ጋን ውሃ አምጡ). Visually, the printed glyphs after ፬ are ጋን (4th order ጋ followed by 6th order ን), misread as ቓል."
          },
          "uncertain": []
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ሠልሱ ብሏቸዋል በዚያ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሳሌ ኢያሱ ዮርዳኖስን ሲሻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር አሥራሁለት ደንጊያ ከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍአ አግብቶ በውስጥ ተክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሏል አሥራሁለት ደንጊያ ከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕሩ አውጥቶ አሸክሞ ወስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶ ፮ን በጌባል ፮ን በገሪዛን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተክሏቸዋል ሰዎቹ የሐዋር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት ደንጊያው የመከራቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሳሌ ። ትንቢቱን አውቆ አና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሯል ምሳሌውንም እንዳ ባ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ግሯል ምሳሌውንም እንዲ ባ",
          "stage2_correction": {
            "pair": "እንዲ -> እንዳ",
            "reason": "The word is እንዳባወቀ (from ማባወቅ, as he made it known/revealed). Visually, ዳ (4th order) has the left-slanted leg, misread as ዲ."
          },
          "uncertain": []
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቀ አስመስሏል ምሥጢሩ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደምን ነው ቢሉ ለ፬ ባሕር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት ሶስት ሶስት ግብር አላቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። አሥራሁለት ይሆናል ከራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ባሕርያት የተፈጠረ ሰውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጠብቅባቸዋለሁ ሲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪ወዝውእቱ አስማቲሆሙ ለ፲ቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወ፪ቱ ሐዋርያት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "ያሥራሁለቱ ሐዋርያት ስማቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ይህ ነው ። ሐዋርያት ማለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ደጃዝማች ቀላጤ ምጥው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍንው ሃያጅ ማለት ነው ። ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጃዝማች በተሾመበት አገር ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቶ የተቀበለውን ሹመት ሽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልማት ሰጥቶ ያከብረዋል ። ካ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህን ቢሆን አስራቱን በኵራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ሰጥቶ ያከብረዋል ። ይህን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "የማይሻ መነኵሴ ቢሆን ከእግሩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድቆ አቡነ ዘበሰማያት ይቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "በላል ለመነኵሴው ክብሩ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያልተቀበለውን ዓይን በፍላት",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጅ እግር በስለት ይቀጣል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያት ትምርታቸውን የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀበሏቸውን በልጅነት ያከብራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ሀብተ ሥርየት ይሰጣሉ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልተቀበሏቸውን በሌጌዎን ይነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳሉ በነፋስ ይሰቅላሉና ። ቀላጤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ በደለኛ ወታደር ካልገዛው አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ገብቶ ያልፈላ ያስጠምቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ያልቦካ ያስጋግራል ፡ የተበደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ ድሃ ከንጉሥ ሄዶ ይጮሃል ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳራሽ ተገኝቶ ቀላጤ ሰጥቶ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰደዋል ፡ ያ ቀላጤ በብርሃን የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባውን በጨለማ በፀሐይ የገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባውን በዝናም አስወጥቶ የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰበረ እንጨቱን የተቀዳ ውሀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ያስመልስለታል ። በደለኛ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወታደር ካልገዛው አገር ገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶ ያልፈላ እንዲያስጠምቅ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቦካ እንዲያስጋግር ። ዲያብሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ያልፈጠረውን ፍጥረት ያልገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛውን ሰውነት ፭ ሽህ ከ፭፻ ዘመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ኃጢአት ሲያሰራ ጣዖት ሲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመልክ መኖሩን መናገር ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተበደለ ድሃ ከንጉሥ ሂዶ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደመጮሁ ነቢያት አንሥእ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃይለከ ፈኑ እዴከ ማለታቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን መናገር ነው ንጉሥ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳራሽ ተገኝቶ ቀላጤ ሰጥቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደመስደድ ፡ ቃለ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ሰው ሁኖ አሥራሁለቱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሐዋርያት ሹሞ መስደዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን መናገር ነው ። ቀላጤ በብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃን የገባውን በጨለማ በፀሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ የገባውን በዝናም እንዲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስወጣ ሐዋርያትም በደዌ የገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባውን በታምራት በክህደት የገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባውን በትምርት ማስወጣታቸ",
          "word_wraps_to_next_line": true
        },
