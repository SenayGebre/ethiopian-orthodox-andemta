        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጨቱን እንዲያስመልስለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአዳም የሄደውን ልጅነት አስ",
          "word_wraps_to_next_line": true
        }
      ]
