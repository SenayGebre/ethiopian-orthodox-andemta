      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልሰዋልና ፤ ፍንው ፡ ወናሁ አነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እፌንወክሙ ከመ አባግዕ ማዕከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለተኵላት ብሎ እንዲያመጣው",
          "word_wraps_to_next_line": false
        },
