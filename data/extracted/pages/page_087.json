      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕርይ አምላክ ይላል ብላችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጥታችኋል ። ⟪ወሚመ ።⟫ ሌታ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ግምጃ እንዲለዋወጥ ዮሐን",
