        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም መልስ ። መቃ መስዬ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ነፋስ አንድ ጊዜ ወደ ቀኝ",
