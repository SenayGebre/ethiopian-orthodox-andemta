        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በያዛቸው ግልጽልጽ አደረገች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ወተሰፍሐት ይእቲ ርእስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሠጠቀት ዓረፍተ ቤት እንዲ",
