          "uncertain": []
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈትልም ነበር ቢሉ ንጉሥ ን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥት ስትዘልፍ አታፍር የነበ",
