        },
        {
          "line_num": 38,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪ወእምዝ አእመሩ አርዳኢሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ በእንተ ዮሐንስ ይቤሎሙ.⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "ከዚህ በኋላ ደቀ መዛሙርቱ",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብሩ ላዕሌሁ ያለውን ሰምተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው የነገራቸው ስለ ዮሐንስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጥምቅ እንደሆነ አወቁ ዮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐንስ መጥምቅ ነው አሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ወርኃዊ ዘይዔርር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪ወበጺሖ ኀበ አሕዛብ ይቤሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ምንትኑ ትትኀሠሥዎሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ፱ ፲፮ ሉቃ ፱ ፴፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "ከሕዝቡ በደረሰ ጊዜ ለምን ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳክሟቸዋላችሁ አላቸው ። ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተታ ስምንቱን መምሕራችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዴት ሄደ እያሉ ሲያደክሟቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ቈይተዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቀርበ ኀቤሁ ብእሲ ወሰገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ሎቱ እንዘ ይትመሐለል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይብል ተሣሃል ሊተ ወል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከነገር ያልገባ ሰው ነው ለብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቻው ቆይቶ ሰገደለት አቤቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጄን አድንልኝ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ እኩይ ጋኔን አኃዞ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢስ ጋኔን አድሮበታልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበአርእስተ አውራኅ ይሣቅዮ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርኀ እያየ ይጥለዋልና ምል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓተ ወርኅ ሲሆን ደም ይመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላል ብርድ ብርድ ይላል ደዌ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቀሰቅሳልና ጨረቃ እንጂ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታመልኩ ነው ለማለት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመብዝኀቶሰ ያወድቆ ውስተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳት ወቦ አመ ያወድቆ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተ ማይ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይልቁንም ብዙ ጊዜ ከእሳት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከውሃ ይጥለዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወአምጻእክዎ ኀበ አርዳኢከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "ያድኑልኛል ብዬ ወደ ደቀ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዛሙርትህ አመጣሁት ።",
