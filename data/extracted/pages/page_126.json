          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውን ሁሉ እየሰበሰበ መንግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥቴን ላሳያችሁ እያለ ምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐት ያሳያል ሆነ በሉት ነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪ወተስእልዎ አርዳኢሁ እንዘ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይብሉ እፎ ይብሉ ጸሐፍት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልያስ ሀለዎ ይምጻእ ቅድመ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "መውደቃቸው ሞት መነሣታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ትንሣኤ መስሏቸው ጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍት ኤልያስ አስቀድሞ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣ ዘንድ እንዳለው የሚና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገሩት እንደምን ነው አሉት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪ወአውሥአ እግዚእ ኢየሱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "ጌታም መለሰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ እወ ኤልያስ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀድም መጺአ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዎን ኤልያስ አስቀድሞ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያስተራትዕ ኵሎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉን ያከናውናል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪ወባሕቱ እብለክሙ ከመ ኤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልያስ ወድአ መጽአ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "ነገር ግን ኤልያስ ፈጽሞ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥቶ እንዳለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢያአመርዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳላወቁት ማለት እንዳልተቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሉት እነግራችኋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ገብሩ ላዕሌሁ ኵሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘከመ ፈቀዱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወደዱትን አደረጉበት እንጂ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ዓስበ ዘማ አደረጉበት እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከማሁ ለወልደ እጓለ እመሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውኒ ሀለዎ ይሕምም እምኔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልደ እጓለ እመሕያው ክር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቶስም እንደሱ ከሳቸው መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከራ ይቀበል ዘንድ አለው ።",
