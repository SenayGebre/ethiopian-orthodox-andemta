        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለብቻቸው ቀርበው እኛ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስወጣት ስለምን ተሣነን አሉት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪ወይቤሎሙ እግዚእ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ሕፀተ ሃይማኖትክሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፲፯ ፮።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ስለ ሃይማኖታችሁ ማነስ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ሃይማኖት ባይኖራችሁ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አማን እብለክሙ እመ ብክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ሃይማኖት መጠነ ኅጠተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰናፔ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አካሏን አይሻም ፍጽምት ና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፍጹም ሃይማኖት ቢኖራችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትብልዎ ለዝ ደብር ፍል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ እምዝየ ኀበ ከሀ ወይፈልስ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ተራራ ከዚህ ተነሥተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህ ወዲያ ሂድ ብትሉት እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲሄድ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ዘይሰአነክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸግሯችሁ የሚቀር እንደሌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ በውነት እነግራችኋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ሊጸና ባይቻል ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጂ በሱ ጊዜ ተደርጓል በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱ ጊዜስ አልተደረገም በአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርሃም ሶርያዊ ጊዜ የተደረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገውን መናገር ነው ፡ ለሊቀ ጳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳሱ አንድ አይሁዳዊ ወዳጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበረው ከንጉሠ ተንባላት ወ",
          "word_wraps_to_next_line": true,
          "uncertain": [
            {
              "printed_text": "ተን ላት",
              "alternative": "ተንባላት",
              "note": "faded ink on ባ"
            }
          ]
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳጆች ናቸው ያም ሊጠይቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያም ሊጠይቅ እየሄዱ ይገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናኛሉ እየተከራከሩ ሊቀ ጳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳስ አይሁዳዊን ምላሽ ያሳጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ከዕለት አንድ ቀን ለብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቻው ገብቶ ነገር ሠራ የኒህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "የክርስቲያን ሃይማኖታቸው እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ ደካማ ነው አለው ። እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኪያ እየተከራከሩ ምላሽ ያሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡችኋልሳ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዚህማ ምልክት አንጅል የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትባል መጽሐፍ አለቻቸው ለእ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "መብክሙ ትላለች ። አድርጉ ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትላቸው አይሆንላቸውም አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው እሱን ሲያገኘው ነገሩን ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣዋል ነገሩ ትዝ ሲለው እሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ያጣዋል ከዕለታት በንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን እሱ ባለበት ነገሩ ትዝ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው አባቴ የምጠይቅህ ኑሮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝ አንተን ሳገኝህ ነገሩን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያጣሁት ነገሩ ትዝ ሲለኝ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተን እያጣሁህ ነበር ። አሁን ግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ነገሩም ትዝ ብሎኛል አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተም መጥተሃል አለው ። ምን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድነው አለው አንጅል የምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባል መጣፍ አለቻችሁን አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። አዎን አለው እንዲህ ትላለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች አለው አዎን አለው ታደር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋላችሁን አለው ፡ አዎን አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚመጠን አእላፍ ክርስቲያን የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚህ ሁሉ ክርስቲያንማ ሃይማኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ተራራ አያህልምን እንኪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ አድርገህ አሳየኝ አለው ቀን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስጠኝ አለው ሶስት ቀን ሰጠው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሂዶ ከመቤታችን ሥዕል አመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለከተ ልጄ እንዲህ ያለው ላንተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደረግልህም የሚደረግለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስምዖን ዘአሐቲ ዓይኑ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተርታ ሰው መስሎ ከገበያ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጨት ሲሸጥ ታገኘዋለህ ሂ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደህ ንገረው እኔን አለችህ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ያለዚያ በጀ አይልህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም አለችው ቢሄድ እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገረችው አገኘው እየፈራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሂዶ በስተኋላው ልብሱን ያዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
