        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንተ ድኅርዋ ዘአውሰበ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
