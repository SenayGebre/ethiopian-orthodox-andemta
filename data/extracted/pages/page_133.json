        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ወንዶች ቢወልዱ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ናቸው ሴቶች ቢወልዱ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቺ ናቸው አይባባሉምና።አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም እሱን ቢመስሉ ያንተ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኑ አትለውም እሷን ቢመስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ያንቺ ይሁኑ አይላትምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም በዚህ ዓለም ሳሉ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጋቸው ጸንተው አሥራት በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵራት ቀዳምያት አውጥተው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንግዳ ተቀብለው ሥጋውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሙን በሚገባ ተቀብለው ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖሩ በወዲያውም አንድ ዓለም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርሰው አንድ ፀሐይ ሞቀው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኖራሉና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "⟪ናሁኬ ኢኮኑ ፪ተ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "እነሆ ሁለት አይባሉም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ አሐዱ ሥጋ እሙንቱ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ አካል ናቸው እንጂ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘእግዚአብሔር አስተጻመረ ሰ",
