          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብእ ኢይፈልጥ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር አንድ ያደረገው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሰው አይለይም ። አትለዩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲል ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪ለምንት እንከ አዘዘ ሙሴ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀብዋ መጽሐፈ ኅድጋቲሃ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይድኀርዋ ፡⟫ ዘዳ ፳፬ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "እንዲህ ከሆነ ሙሴ የምትፈ",
