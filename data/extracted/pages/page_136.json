        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመ ይነብር ውስተ ዓለም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዲስ ይላል ያመናችሁብኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተ በዕለተ ምጽአት ወል",
