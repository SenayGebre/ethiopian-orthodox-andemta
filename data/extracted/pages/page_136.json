          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራኤል ትፈርዳላችሁ ። ያን ጊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዜስ መቀመጥም መፍረድም",
