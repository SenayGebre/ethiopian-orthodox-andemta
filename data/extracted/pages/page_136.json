          "text": "ላ በሥራ ያሰፉታል እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጥምቀት በሚገኘው ክብር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ናቸውና ።",
          "word_wraps_to_next_line": false
        },
