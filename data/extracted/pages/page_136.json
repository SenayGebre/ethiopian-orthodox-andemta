        },
        {
          "line_num": 24,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪እስመ ትመስል መንግሥተ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሰማያት ብእሴ በዓለ ቤት ዘ⟫",
