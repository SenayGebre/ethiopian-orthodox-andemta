          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሥራሁለቱን ነገደ እስራኤል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ታስተምራላችሁ ፤ አንድም",
