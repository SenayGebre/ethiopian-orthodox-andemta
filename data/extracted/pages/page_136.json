        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ብእሲተ ወውሉደ ወገራውኃ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በእንተ ስምየ ምዕተ ምክዕ⟫",
          "word_wraps_to_next_line": true
        },
