          "stage1_text": "ከናንተ ወገን ገጋቦ ሊሆን የ",
          "stage2_correction": {
            "pair": "ጋቦ -> ዥ",
            "reason": "The wide two-legged Fidel ዥ in ገዥ ('ruler', translating Ge'ez ዓቢየ) was split and misread as ጋቦ."
          },
          "uncertain": []
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደደ ሰው ተገዥ ይሁናች",
          "word_wraps_to_next_line": true,
          "stage1_text": "ወደደ ሰው ተገጋቦ ይሁናች",
