        },
        {
          "line_num": 8,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "⟪እስመ ኢመጽአ ወልደ እጓ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
