        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤልም ሕግ መጠበቅ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምደዋልና ዕዋል የአሕዛብ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንበር መሸከም ያለመደች እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሆነች አሕዛብም ሕግ መጠበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅ ያለመዱ ናቸውና።፩ም ዕድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገት የኦሪት ዕዋል የወንጌል ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌ፡እድግት ቀንበር መሸከም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለመደች እንደሆነ ኦሪትም የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተለመደች ሕግ ናትና ዕዋል ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንበር መሸከም ያለመደች እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሆነች ወንጌልም ያልተለመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደች ሕግ ናትና።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወዘይበዝኁ ሕዝብ ነጽፉ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሲሆሙ ውስተ ፍኖት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "የሚበዙት ሕዝብ ልብሳቸውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጎዳና አነጠፉ ። ሐተታ ስንኳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ላንተ ለተቀመጥህበት አህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ መሬት መርገጥ አይገባትም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲሉ ። አንድም በኢዩ ልማድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልሳዕ ከደቂቀ ነቢያት አንዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ቀርነ ቅብዑን ይዘህ ሄደህ",
          "word_wraps_to_next_line": false,
          "stage1_text": "ን ቀርነ ቅብዑን ይዘህ ሂደህ",
          "stage2_correction": {
            "pair": "ሂ -> ሄ",
            "reason": "The 5th-order ring of ሄ in ሄደህ was misread as 3rd-order ሂ."
          },
          "uncertain": []
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢዩን ቀብተህ አንግሥኸው ፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥነህ ና ከሰው ጋራ አትጫወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ብሎ ላከው ። ቢሄድ ኢዩን",
          "word_wraps_to_next_line": false,
          "stage1_text": "ት ብሎ ላከው ። ቢሂድ ኢዩን",
          "stage2_correction": {
            "pair": "ሂ -> ሄ",
            "reason": "Standard Amharic verb ቢሄድ with 5th-order ሄ visible in the print."
