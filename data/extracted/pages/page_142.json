          "uncertain": []
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከባልንጀሮቹ ጋራ ሲጫወት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባደባባይ ተቀምጦ አገኘው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብየ መልእክት አለው።እምኔ",
