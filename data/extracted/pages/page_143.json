        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስተኛው ቆመ ብእሲ አድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርገውታል።ለመሥዋዕት ይሆና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ብሎ የሰባውን ከሩቅ አገር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነድቶ ይዞ ይመጣል ፤ ከመንገድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከሳበታል እመቦ ዘቦ ዝክር ሠ",
