        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስወገሽ ልብስ ለብሶ ወደ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቱ ሂዶ ይቆማል ወግሽቶ ይ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ብቱ ሂዶ ይቆማል ወግሻቶ ይ",
          "stage2_correction": {
            "pair": "ሻ -> ሽ",
            "reason": "The printed glyph is 6th-order ሽ in the Amharic converb ወግሽቶ (from ወገሸ, 'having been startled/spooked, it enters'), misread as 4th-order ሻ."
          },
          "uncertain": []
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባል አውጥቼ ልውሰድ ያለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደሆነ ካል የገባ አይነጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ መቅደስ የገባ አይወጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያሉ በምክንያት ያስቀሩባቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋልና እንዲህ አለ።ገበያው የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናቱ ነው ያሉ እንደሆነ ካ",
