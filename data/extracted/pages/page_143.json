        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሠዋም ይሉታል እሺ ብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለውጦ ይሠዋልና።ቀይ ወርቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያጣ እንደሆነ ነጭ ወርቅ ይዞ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይመጣል፤ለምን ይኸን አመ",
