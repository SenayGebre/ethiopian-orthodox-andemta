        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናይ ዘያበውዕ በግዓ ንዉረ ርጉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ውእቱ ትላለች ኦሪት ይኸን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምን አመጣኸው ይሉታል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔስ የሰባውን ነበር ያመጣሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ከመንገድ ከሳብኝ እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ቅንነትማ ካለ የሰባ የኛ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ባንድ ሁለት ለውጠህ አ",
