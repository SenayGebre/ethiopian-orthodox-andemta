        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይ በአፍአ ጽኑ ፍዳ ወዳለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
