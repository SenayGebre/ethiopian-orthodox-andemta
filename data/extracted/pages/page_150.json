        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዋልና ። ⟪ወእምዝ አዘዞሙ ን",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉሥ ለአግብርቲሁ ።⟫ ከዚህ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላ መላእክትን ከመንግሥተ",
