        },
        {
          "line_num": 7,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወእምዝ ሖሩ ፈሪሳውያን ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተማከሩ ከመ ያስሕትዎ በቃሉ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ፲፪ ፲፫ ። ሉቃ ፳ ፳ ።",
