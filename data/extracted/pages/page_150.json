        },
        {
          "line_num": 10,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "ከዚህ በኋላ ፈሪሳውያን ሂደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው በነገር ሊያስቱት መከሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ዘከመ ይደሉ ውሂበ ጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ባሕት ለቄሣር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ወፈነዉ ኀቤሁ አርዳኢሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስለ ሰብአ ሄሮድስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "ብላቴኖቻቸውን ከሄሮድስ ብላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቴኖች ጋራ ላኩ በሀገር የሊቀ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣኔ ወምበር እንዲኖር ያገር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምዝክር ሹማምት አሉና ። አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም ብላቴኖቻቸውን የሄሮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድስ ብላቴኖች ነን በሉ ብለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላኩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎ ሊቅ ነአምር ከመ",
