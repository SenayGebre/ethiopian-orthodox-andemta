          },
          "uncertain": []
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርዬ ደካማ ቢሆን ባይቻለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝ አይለውም ቢሉ ዳኑ ከመ",
          "word_wraps_to_next_line": false,
          "stage1_text": "ኝ አይለውም ቢሉ ያኑ ከመ",
