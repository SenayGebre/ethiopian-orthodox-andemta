        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻሜያቸው ዘካርያስ ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ም ግፍ ለግፍ ሲያነጻጽር አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤል የሞተ በግፍ ነው ዘካርያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስም የሞተ በግፍ ነውና ። ፫ም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመ ስክየትንና ደመ ስክየትን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲያነጻጽር መልአኩ ለሄኖክ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅደረ ኃጥአንን እያዞረ ሲያሳየ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው አንዲት ነፍስ እየተንጸረጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረች ስታከስስ ስታሳጣ አይቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛመንፈስ ዘመኑ ብሎ ጠየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ዘአቤል ዘቀተሎ እኁ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ቀው ዘአቤል ዘቀተሎ እኅ",
          "stage2_correction": {
