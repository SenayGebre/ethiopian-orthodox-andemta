        {
          "line_num": 1,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "⟪ወበእንተዝ አነ እፌኑ ኀቤክሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "ሶበሰ ሀሎነ የምትሉ ስለሆነ ስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዚህ ነገር ወደናንተ እልካለሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ነቢያተ ፡⟫ ፸ አርድዕትን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሐዋርያተ⟫ ሐዋርያትን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጠበብተ ።⟫ ሹማምንትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጸሐፍተ⟫ መምህራንን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "መተርጕማንን እልካለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ቦ እምኔሆሙ ዘትቀትሉ ፡⟫ ከሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ወገን የምትገድሉት አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦ እምኔሆሙ ዘትሰቅሉ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምትሰቅሉት አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦ እምኔሆሙ ዘትቀሥፉ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኵራባቲክሙ ።⟫ በም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵራባችሁ አግብታችሁ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትገርፉት አለ ። ⟪ወትሰድድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎሙ እምሀገር ውስተ ሀገር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካንዱ አገር ወዳንዱ አገር አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጥታችሁ የምትሰዱት አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "⟪ከመ ይብጻሕ ላዕሌክሙ ደመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሎሙ ጻድቃን እምደመ አቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ጻድቅ እስከ ደመ ዘካርያስ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልደ በራክዩ ዘቀተልክምዎ በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕከለ ቤተ መቅደስ ወምሥዋዕ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፍ ፬ ፰ ዕብ ፲፩ ፬ ፪ዜና ፳፬ ፳፪",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ዘፍ ፬ ፰ ዕብ ፩ ፬ ፪ዜዑዓ ፳፬ ፳፪",
          "stage2_correction": {
            "pair": "፩ -> ፲፩, ዜዑዓ -> ዜና",
            "reason": "Biblical reference underlines misread as characters: Hebrews 11:4 (ዕብ ፲፩ ፬) and 2 Chronicles 24:22 (፪ዜና ፳፬ ፳፪)."
          }
        },
        {
          "line_num": 26,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "ከአቤል ደም ጀምሮ በዕቃቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትና በቤተ መቅደስ መካከል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገደላችሁት እስከ ዘካርያስ ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ድረስ በዓለም የፈሰሰ የጻድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃን ደም ፍዳ ሊደረግባችሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ። ሐተታ ጠርዙንና ጠር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዙን ይዞ ተናገረ ። ለሰማዕታተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሉት ጥንታቸው አቤል ፍ",
          "word_wraps_to_next_line": true,
          "uncertain": [
            {
