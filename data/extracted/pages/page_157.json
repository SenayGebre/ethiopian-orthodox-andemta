            }
          ]
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልጠየቀኝም ልጄን ሊያስገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድለው ነው ሀብት ሳላሳድር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ብሎ ከቤተ መቅደስ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
