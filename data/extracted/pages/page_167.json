          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋዮ ይትገበሩ ቦቱ።⟫ሉቃ ፲፱ ፲፪",
