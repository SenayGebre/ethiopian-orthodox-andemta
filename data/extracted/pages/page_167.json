          "text": "ት የያዙ ናቸው ይህን ይዛች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁ ይህን ካልያዛችሁ አይሆን",
          "word_wraps_to_next_line": true
        },
