        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለም ይህም ሶስቱ የባለጠጎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች ሶስቱ የነዳያን ነው ። ርኅብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኩ ዓረቁ ተሞቃሕኩ የባለጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጎች ። ጸማዕኩ ነግደ ኮንኩ ደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይኩ የነዳያን ። አልብከኑ ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋዓ ማይ ቈሪር ለአስትዮ ዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙዕ አልብከኑ ጠፈር ለአኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሮ ነግድ አልብከኑ እግር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሐውፆ ድውይ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ለመምሕራን ። በክህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደት ምክንያት ብራብ ብጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማ አስተምራችሁኛልና ። በክህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደት እንግዳ ብሆን በትምርት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀብላችሁኛልና ። በክህደት ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክንያት ልጅነት ባይሰጠኝ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖት እንዲሰጠኝ አድርጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችኋልና ። በክህደት ብታመም በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምርት ጠይቃችሁኛልና ። በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕሠረ ክህደት ብታሠር በት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምርት አስፈትታችሁኛልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ለቀሳውስት ። በኃጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አት ከሥጋው ከደሙ ብከለከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል በንስሐ ሥጋውን ደሙን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጥታችሁኛልና ። በኃጢአት እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንግዳ ብሆን በንስሐ ተቀብላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁኛልና ። ልጅነት በኃጢአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ቢነሣኝ በንስሐ እንዲመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለስልኝ አድርጋችሁኛልና ። በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማዕሠረ ኃጢአት ብታሠር በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስሐ አስፈትታችሁኛልና ። አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም አንድ ወገን ። ለባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታውያን ተባሕትዎ ብይዝ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተባሕትዎ መስላችሁኛልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "⟪አሜሃ ያውሥኡ ጻድቃን እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘ ይብሉ እግዚኦ ማዕዜኑ ር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢናከ ርኅበከ ወአብላዕናከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "ጻድቃንም ሰርተውት ያልሠሩት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይመስላቸዋል ከትሕትና ወደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሕትና ይሄዳሉና አቤቱ መቼ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተርበህ አይተንህ አብልተንህ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
