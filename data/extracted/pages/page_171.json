          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወማዕዜ ርኢናከ እንግዳከ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተወከፍናከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ጊዜ እንግዳ ሆነህ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተንህ ተቀብለንህ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዕሩቀከ ወአልበስናከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ጊዜ ታርዘሕ አይተንህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልብሰንህ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "⟪ወድውየከኒ ወሐወፅናከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "ምን ጊዜ ታመህ አይተንህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠይቀንህ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሙቁሐከኒ ወመጻእነ ኀቤከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወነበብናከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቼ ታሥረህ አስፈታንህ ጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቅንህ ይሉታል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "⟪ወእምዝ ያውሥኦሙ ንጉሥ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይቤሎሙ አማን እብለክሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሎ ዘገበርክሙ ለ፩ዱ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሉ ንዑሳን አኃውየ እለ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምኑ ብየ ሊተ ገበርክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "በኔ ካመኑ ምዕመናን ላንዱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያደረጋችሁ ለኔ አደረጋችሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልኝ ላንዱ ያደረጋችሁ ለኔ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማድረጋችሁ ነው ብሎ በው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ይመልስላቸዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፵፩",
          "line_type": "body",
          "text": "⟪ወእምዝ ይብሎሙ ለእለ በፀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋሙ ሑሩ እምኔየ ውስተ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳት ዘለዓለም ዘድልው ለሰይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣን ወለመላእክቲሁ ።⟫ መዝ ፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "፰ ። ማቴ ፯ ፳፫ ። ሉቃ ፲፫ ፳፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፵፩",
          "line_type": "body",
          "text": "ከዚህ በኋላ በግራው ያሉ ኃ",
