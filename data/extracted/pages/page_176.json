          "uncertain": []
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘከመ ሠርዓ ኢየሱስ አኰቴተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ቁርባን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "⟪ወእንዘ ይበልዑ ነሥአ ኅብስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ እግዚእ ኢየሱስ ባረከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ቆሮ ፲፩ ፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "ሲበሉ ጌታ ዳቦውን አንሥቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዞ ባረከ አከበረ ለወጠ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈተተ ።⟫ ገመሰ ቈረሰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ባረከ ገመሰ ቈረሰ ፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተተ አጠቃቀነ አሥራሶስት አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደረገ ። ጌዴዎን ዓሥራሶስት ሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖ ሠውቷልና ፡ አንድም ባሥራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሶስቱ ዕፀወ ዕጣን ምሳሌ ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ዓሥራሶስቱን ፀዋትወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራ እቀበልላችኋለሁ ሲል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክሊለ ሦክ ፡ ተኰርዖ ርእስ ፡ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸፍዖ መልታሕት ፡ ተወክፎ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራቅ ፡ ሰትየ ሐሞት ፡ ተዓሥሮ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኅሪት ፡ ተቀሥፎ ዘባን ፡ ርግዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ገቦ ። ርግዘተ ገቦ ከሞተ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላ ነው አይሰማውም ብለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀዊረ መስቀል ኀምስቱ ቅንዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት እግሩን እየራሱ ቸንክረው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል ያሉ እንደሆነ የተመቸ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
