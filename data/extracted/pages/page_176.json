          "text": "ዲል ። አጥንቱን አትስበሩት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለቱ ለጊዜው ግብፃውያን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲጐዱ እስራኤል አለመጐዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታቸውን መናገር ነው ። ፍጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሜው ግን ኃጥአን ሲጐዱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻድቃን ላለመጐዳታቸው ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌ ነው በቁሙም የሁለቱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንበዶች ጭንና ጭናቸውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየሰበሩ ሲያወርዷቸው የሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን አልሰበሩትምና አጽሞ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትስብሩ እንዲል ። እንደ አር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮስ ፍጡር በመለኮቱ አትበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ሲል ነው ። ከዚህም ኦሪትን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠርቶ አሳልፏታል ። ንጉሥ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሞ ሹሞት የነበረውንና ኋላ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሾመውን አቅርቦ ያን ወ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅሶ ሽሮ ይህን እንዲሾም እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱም ወንጌልን የሚሠራ ነውና",
          "word_wraps_to_next_line": false,
          "stage1_text": "ሱም ወንጌልን የሚሰራ ነውና",
          "stage2_correction": {
