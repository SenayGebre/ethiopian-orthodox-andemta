        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰፍሐ እዴሁ ወመልሐ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥባሕቶ ወዘበጦ ለገብረ ሊቀ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
