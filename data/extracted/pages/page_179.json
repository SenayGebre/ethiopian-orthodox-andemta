          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": "፶፩",
          "line_type": "body",
          "text": "ከጌታ ጋራ ካሉት አንዱ ተ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሥቶ ሰይፉን መዞ የሊቀ ካ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህናቱን ባሪያ መታው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመተሮ ዕዝኖ ዘየማን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
