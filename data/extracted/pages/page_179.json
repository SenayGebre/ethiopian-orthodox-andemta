        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድኑ ንዝብጦሙ ብለውታል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሉቃስ፤አብሮ መብላት አብሮ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
