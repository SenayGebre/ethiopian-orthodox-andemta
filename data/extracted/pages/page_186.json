          "stage1_text": "ያስ ከዚህን ልዩ ነው ለማለት",
          "stage2_correction": {
            "pair": "ን -> ም",
            "reason": "The printed glyph is ከዚህም ('different from this too'), where a faint right loop on ም caused it to be misread as ን."
          },
          "uncertain": []
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ተኈለቈ ምስለ ጌጋ",
          "word_wraps_to_next_line": true,
          "stage1_text": "አንድም ተኈለቈ ምስለ ጌጉ",
          "stage2_correction": {
            "pair": "ጉ -> ጋ",
