        },
        {
          "line_num": 6,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "ፈጥናችሁ ሂዳችሁ ከሙታን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተለይቶ እንደ ተነሣ ለደቀ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዛሙርቱ ንገሯቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወናሁ ይቀድመክሙ ገሊላ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገሊላ ይቀድማችኋል ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መታየትን በገሊላ ይጀምርላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችኋል፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበህየ ትሬእይዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገሊላ ታዩታላችሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ናሁ አይዳዕኩክን።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሆ ነገርኋችሁ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወኃለፋ ፍጡነ እልኩ አንስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት እምኀበ መቃብር በፍርሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት፡ወበረዓድ ወበፍሥሓ ዓቢይ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "በታላቅ ደስታና በፍርሃት ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃብሩ ፈጥነው ሄዱ።ሐተታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአክ አይተዋልና በፍርሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ትንሣኤውን ሰምተዋልና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ብሏቸው ሄዱ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሮፃ ይንግራሆሙ ለአርዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለደቀ መዛሙርቱ ሊነግሯቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጥነው ሄዱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪ወእንዘ የሐውራ ይንግራሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተራከበን እግዚእ ኢየሱስ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍኖት።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "ሊነግሯቸው ሲሄዱ ጌታ ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንገድ ታያቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎን በሀክን፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዴት ሰነበታችሁ አስታረቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋችሁ አላቸው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቀሪቦን ወአኃዛ እገሪሁ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰገዳ ሎቱ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀርበው እግሩን ይዘው እጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሡት ሰገዱለት፤",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪ወእምዝ ይቤሎን እግዚእ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ኢትፍርሃ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "ከዚህ በኋላ ጌታ አትፍሩ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቸው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሑራ ንግራሆሙ ለአኃውየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ይሑሩ ገሊላ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገሊላ ይሄዱ ዘንድ ለወንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞቼ ሂዳችሁ ንገሯቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበህየ ይሬእዩኒ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገሊላ ያዩኛል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘከመ ኄጥዎሙ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪ወኃሊፎን እማንቱ አተዉ ሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገራት ሀገረ ወነገሩ ለሊቃነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናት ኵሎ ዘከመ ኮነ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "ሴቶች ከሄዱ በኋላ ጭፍሮች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከከተማ ገብተው የተደረገው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሁሉ እንደተደረገ ለሊቃነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናት ተናገሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪ወተጋብኡ ወተማከሩ ምስለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃውንት ወወሀብዎሙ ብዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃ ወርቀ ለሠገራት።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "ተሰብስበው ካለቆች ጋራ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክረው ለጭፍሮች ብዙ ወርቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጧቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪ወይቤልዎሙ በሉ አርዳኢሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሊተ መጽኡ ወሠረቅዎ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘ ንነውም ንሕነ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "እኛ ተኝተን ሳለን ሌሊት መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥተው ደቀ መዛሙርቱ ሠርቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ወሰዱት በሉ አሏቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪ወእምከመ ተሰምዓ ዝነገር በኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአከ አሕዛብ ንሕነ ናአምኖ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "ይህ ነገር በጲላጦስ ዘንድ የተሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማ እንደሆነ እኛ እናስረዳዋለን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለክሙሰ ናድኅነክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተንም ከቅጣት እናድናች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋለን። ⟪ወናጸድቅ ነገረክ",
