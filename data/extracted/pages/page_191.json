          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪ወፍጡነ ሑራ ወንግራሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአርዳኢሁ ከመ ተንሥአ እ",
