        },
        {
          "line_num": 2,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወነሢኦሙ ሠገራት ውእተ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቀ ገብሩ በከመ መሐርዎሙ።⟫",
