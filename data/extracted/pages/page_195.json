          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጽዋትን በመስጠት በጾም በጸሎት ልብን ስለ ማ",
          "word_wraps_to_next_line": true
        },
