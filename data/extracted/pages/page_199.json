          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ዘከመ ጸለየ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጌቴሴማን ። ቍ ፴፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ዘከመ አግብኦ ይሁዳ ለክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስቶስ ወዘከመ ተአኅዘ ቍ ፵፯",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ዘከመ ቆመ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቅድመ ዓውድ ። ቍ ፶፯",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ክህደተ ጴጥሮስ ። ቍ ፷፱",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ቀቢፀ ተስፋ ዘይሁዳ ፤ ም ፳፯ ቍ ፫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ዘከመ ቆመ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቅድመ ጲላጦስ ። ቍ ፲፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ዘከመ ኀረይዎ ለበርባን እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 41,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ ኢየሱስ ወዘከመ ኰነንዎ ፥ ቍ ፲፭",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፫፻፲፯",
          "line_type": "section_title",
          "text": "የማቴዎስ ወንጌል አርእስት ማውጫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ መሢሕ ክርስቶስ የዳዊት ልጅ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ግብዞች ፈሪሳውያን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፈሪሳውያን ክፋት።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሩሳሌምን እንደ ነቀፋት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የኢየሩሳሌምንና የቤተ መቅደስን ጥፋት እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተናገረ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ሁለተኛዪቱ ወልደ እጓለ እመሕያው ክርስቶስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምጣት ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለክርስቲያን መትጋት እንዲገባው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ልባሞችና ስለ ሰነፎች አሥር ደናግል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ወርቅ ምሳሌ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ዓለም ማለፍ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የካህናት አለቆች በጌታ ላይ እንደ መከሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ በቢታንያ ለራት እንደ ተቀመጠ ይሁዳም ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃነ ካህናት ጋራ እንደ ተማማለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ሁለተኛዪቱ ራት መዘጋጀት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያሲዘውን ጌታ እንደ ገለጠ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ ቍርባንን እንደሠራ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ የተማሪዎችን ክህደት አስቀድሞ እንደ ተናገረ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ በጌቴሴማን እንደጸለየ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁዳ ክርስቶስን እንደ አስያዘው ፡ ክርስቶስም እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተያዘ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ በደባባይ እንደ ቆመ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስ ጌታን እንደካደው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁዳ ተስፋ እንደቆረጠ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታ በጲላጦስ ፊት እንደቆመ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርባንን ከጌታ ይልቅ እንደመረጡት በጌታም እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፈረዱበት ፥",
