      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአንቀጸ ፡ አሚን ፡ በተአምኖ ፡ ወሰዶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም ፡ ለይስሐቅ ፡ ወልዱ ፡ ብሎ ፡ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖቱን ፡ መስክሮለታል ፡ ከዚህም ፡ ያዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆብ ፡ በአንቀጸ ፡ ምግባር ፡ አኮኑ ፡ አቡነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም ፡ በምግባሩ ፡ ጸድቀ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምግባሩን ፡ መሰከረለት ፡ ዘፍጥ ፡ ፲፭፥፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፡ ፵፩ ፥ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "፳፬ ፤ ⟪ትሬኢኑ ፡ ከመ ፡ በምግባሩ ፡ ይጸድቅ ፡ ሰብእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአኮ ፡ በሃይማኖቱ ፡ ባሕቲታ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ በሃይማኖቱ ፡ ብቻ ፡ ያይደለ ፡ በም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግባሩ ፡ እንዲከብር ፡ ታያለህን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "፳፭ ፤ ⟪ወከማሁ ፡ ረዓብኒ ፡ ዘማ ፡ በምግባሪሃ ፡ ጸድቀት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም ፡ በምግባሩ ፡ ከበረ ፡ እንዳልሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሶበ ፡ ተቀበለቶሙ ፡ ለሰብአ ፡ ዐይን ፡ ወእንተ ፡ ካል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እት ፡ ፍኖት ፡ አውፅአቶሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረዓብ ፡ ዘማም ፡ የእስራኤልን ፡ ጉበኞች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወኢይኩኑ ፡ እምውስቴትክሙ ፡ ብዙኃን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህራን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህም ፡ በሹመት ፡ ተቃንተዋል ፡ ለዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያመጣል ፡ ከናንት ፡ ወገን ፡ ብዙ ፡ መም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህራን ፡ አይኑሩ ። አንድም ፡ መምህራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙኃነ ፡ መምህራን ፡ አይብዙ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ብዙኃን ፡ መምህራነ ፡ ብዙ ፡ ሰዎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች ፡ መምህራን ፡ አይሁኑ ፡ (አይሾሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢል ፡ አንድ ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አኀዊነ ፡ ተአምሩ ፡ ከመ ፡ እንተ ፡ ተዐቢ ፡ ደይነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንነሥእ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሞቻችን ፡ እንሾም ፡ በማለት ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ በመሾም ፡ ተሹመን ፡ በመበደል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽኑ ፡ ፍዳ ፡ እንድንቀበል ፡ ታውቃላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪እስመ ፡ ብዙኀ ፡ ንስሕት ፡ ኵልነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁላችን ፡ ፈጽመን ፡ እንበድላለንና ። አንድ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፍቅር ፡ ተቀብላ ፡ በፍቅር ፡ ሸኝታ ፡ በሰደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቻቸው ፡ ጊዜ ፡ በሙያዋ ፡ በሥራዋ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ከበረች ፡ ታያለህን ። ሐተታ ፡ ከዚያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአንቀጸ ፡ አሚን ፡ ቅዱስ ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረዓብኒ ፡ ዘማ ፡ በተአምኖ ፡ ኢተሐጕለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስለ ፡ አላውያን ፡ ብሎ ፡ ሃይማኖቷን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "መስክሮላታል ፡ ከዚህም ፡ ያዕቆብ ፡ በአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቀጸ ፡ ምግባር ፡ አኮኑ ፡ ረዓብኒ ፡ ዘማ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በምግባሪሃ ፡ ጸድቀት ፡ ብሎ ፡ ምግባሯን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰከረላት ፡ ዕብ ፡ ፲፩ ፥ ፴፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "፳፮ ፤ ⟪በከመ ፡ ሥጋ ፡ ዘአልቦ ፡ መንፈሰ ፡ ምውት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ ፡ ከማሁ ፡ ሃይማኖትኒ ፡ እንተ ፡ አልባቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምግባረ ፡ ሠናይ ፡ ምውት ፡ ይእቲ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ፡ የተለየው ፡ ሥጋ ፡ ሥራ ፡ እንዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሠራ ፡ ምግባር ፡ የሌላትም ፡ ሃይማኖት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ ፡ አታሠራም ፡ ቍ ፡ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፈጽመን ፡ ስለ ፡ በደልን ፡ ጽኑ ፡ ፍዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንድንቀበል ፡ ታውቃላችሁና ፡ ኢይኩኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሰ ፡ ኢይስሕት ፡ በቃሉ ፡ ፍጹም ፡ ውእቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልሾም ፡ በማለት ። አንድም ፡ በመሾም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሹሞ ፡ የማይበድል ፡ ፍጹም ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይክል ፡ ወድዮ ፡ ልጓም ፡ ለኵሉ ፡ ሥጋሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሰውነቱ ፡ ልጓመ ፡ ትዕግሥትን ፡ ገን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘብ ፡ ማድረግ ፡ ይቻለዋል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚቻለው ፡ ፍጹም ፡ ነው ። (ታሪክ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ አባ ፡ መቃርዮስ ፡ በሕፃንነቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንኖ ፡ ገዳም ፡ ገብቷል ፡ ኋላም ፡ መብ",
          "word_wraps_to_next_line": true
        },
        {
