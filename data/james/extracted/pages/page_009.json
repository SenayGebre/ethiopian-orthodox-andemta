  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወናሁ ፡ ልሳንሂ ፡ ተፈጥረት ፡ ውስተ ፡ ነፍስትነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሆ ፡ አንደበት ፡ በሰውነታችን ፡ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስጥ ፡ በጉሮሯችን ፡ ተፈጥራለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወታረምየ ፡ ለሥጋነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋችንን ፡ ታቃጥለዋለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትሎሉ ፡ ክቡተ ፡ ፍጥረተነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካራት ፡ ባሕርያት ፡ የተፈጠረ ፡ ሰውነታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችንን ፡ ትለበልበዋለች። አንድም ፡ ትሌሊ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢል ፡ ነፍሳችንን ፡ ከሥጋችን ፡ ትለያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወታውዒ ፡ እምገሃነም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከገሃነም ፡ አስቀድማ ፡ በዚህ ፡ ዓለም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ከገሃነም ፡ ይልቅ ፡ ታቃጥላለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች ፡ ሐተታ ፡ ገሃነም ፡ ኃጥአንን ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻድቃንን፡ አታቃጥልም፡ አንደበት፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃጥኡንና ፡ ጻድቁን ፡ አትለይምና ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ በገሃነም ፡ ታቃጥላለች ፡ ማቴ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፭ ፡ ፲፩ና ፡ ፲፱ ። ም ፡ ፲፪ ፡ ፴፮ ፡ ፴፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "⟪፯ ፤ እስመ ፡ ኵሉ ፡ ፍጥረተ ፡ አራዊትኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያራዊት ፡ ባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዕዋፍኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአዕዋፍም ፡ ባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘይትሐወስኒ ፡ ውስተ ፡ ባሕር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በባሕር ፡ የሚመላለስ ፡ ያዞ ፡ የጉማሬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዓሣ ፡ የአንበሪ ፡ ባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንስሳኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእንስሳም ፡ ባሕርይ ፡ ሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይገርር ፡ ለፍጥረተ ፡ እጓለ ፡ እመሕያው ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሰው ፡ ባሕርይ ፡ ይገዛል ፡ እኮን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪፰ ፤ ወለልሳነ ፡ እጓለ ፡ እመሕያውሰ ፡ አልቦ ፡ ዘይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክል ፡ አግርሮታ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ፡ አንደበት ፡ ግን ፡ ሊገዛት ፡ ሊገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታት ፡ የሚቻለው ፡ የለም ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እኪት ፡ ይእቲ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክፉ ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልባ ፡ ዐቅም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለክፋቷም፡ ልክ፡ መጠን ፡ የለውም ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ክንድ ፡ ስንዝር ፡ አትባልም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምልእት ፡ ይእቲ ፡ ሕምዘ ፡ ዘይቀትል ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚገል ፡ መርዝን ፡ የተመላች ፡ ናት ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፦መርዝ ፡ እንዲጎዳ ፡ የምትጎዳ ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዝ ፡ ፻፴፱ ፡ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪፱ ፤ ባቲ ፡ ንባርኮ ፡ ለእግዚአብሔር ፡ አብ ፡ ወባቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንረግሞ ፡ ለእጓለ ፡ እመሕያው ፡ ዘበአርአያ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ ተፈጥረ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአንደበት ፡ ወዲህ ፡ እግዚአብሔርን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናመሰግነዋለን ፤ ወዲህ ፡ በአርአያ ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ የተፈጠረ ፡ ሰውን ፡ እንሰድበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋለን ። (ሐተታ) ፡ ዘበአርአያ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ተፈጥረ ፡ አለ ፡ በቅርጽ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ)፡ ነአምን፡ ከመ፡ ቦ፡ ለእግዚአብሔር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዕይንት፡ ወአዕዛን ፡ አዕዳው ፡ ወአእጋር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወኵሎንኬ ፡ እለ ፡ ተርፋ ፡ አባላት ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ። አንድም ፡ በነፍስ ፡ ነው ፡ ነፍስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነባቢት ፡ ለባዊት ፡ ሕያዊት ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደ ፡ ሆነች ፡ ሥላሴም ፡ ነባብያን ፡ ለባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውያን ፡ ሕያዋን ፡ ናቸውና ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ በባሕርይ ፡ የሚገዛውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ በጸጋ ፡ ይገዛዋልና ፡ (ጥቅ) ፡ ወበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ፡ እግዚአብሔር ፡ ርኡስ ፡ ወሥሉጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዕለ ፡ ውስተ ፡ ሰማይ ፡ ወታሕተ ፡ ውስተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ ከማሁ ፡ ሰብእኒ ፡ ርኡስ ፡ ወሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉጥ ፡ ታሕተ ፡ ውስተ ፡ ምድር ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
