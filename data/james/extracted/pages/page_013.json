          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኒ ፡ ታስተፌሥሖ ፡ ለሐራሲሃ ፡ በፍሬሃ ፡",
          "word_wraps_to_next_line": false
