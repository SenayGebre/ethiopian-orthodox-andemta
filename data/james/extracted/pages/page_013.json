          "margin_tag": null,
          "line_type": "body",
          "text": "ሶበ ፡ ትሁቦ ፡ ህየንተ ፡ አሐዱ ፡ ሠላሳ ፡",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ሶበ ፡ ትሁቦ ፡ ህየንተ ፡ አሐዱ ፡ ወላሳ ፡",
          "stage2_correction": {
