        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ የተረዳነው ፡ እሱ ፡ ነው ። ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶማስ ፡ ጐኑን ፡ በዳሰሰው ፡ ጊዜ ፡ እጁን ፡",
          "word_wraps_to_next_line": false
        },
