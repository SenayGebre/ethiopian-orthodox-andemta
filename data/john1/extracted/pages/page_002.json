        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ ፡ ፲፰ ። አኃዊነ ፡ ለኵሉ ፡ መንፈስ ፡ ኢት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እመንዋ ፡ በል ፡ ም ፡ ፬ ፡ ፩ ። ወአልቦ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍርሀት ፡ ውስተ ፡ ተፋቅሮትነ ፡ በል ፡ ፲፰",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ በውኃ ፡ እያጠበ ፡ በደሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፩ ፤ ክፍል ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ንዜንወክሙ ፡ በእንተ ፡ ውእቱ ፡ ዘሀሎ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቅድምና ፡ የነበረ ፡ የሱን ፡ የቅድምናው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ነገር ፡ እንነግራችኋለን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ውእቱ ፡ ዘሰማዕናሁ ፡ በእዘኒነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቅድምናውን ፡ ነገር ፡ ሲናገር ፡ የሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ እሱ ፡ ነው ፤ እምቅድመ ፡ ይትወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለድ ፡ አብርሃም ፡ ሀሎኩ ፡ አነ ፡ ብሎ ፡ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድመ ፡ ይትወለድ ፡ አብርሃም ፡ ሀሎኩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አነ ፡ ያለውን ፡ የቅድምናውን ፡ ነገር ፡ በ",
          "word_wraps_to_next_line": true
        },
