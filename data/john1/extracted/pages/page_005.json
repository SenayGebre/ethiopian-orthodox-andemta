        },
        {
          "line_num": 5,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወዘሰ፡ ያፈቅር፡ ቢጾ፡ ውስተ፡ ብርሃን፡ ይነብር፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሙን ፡ የሚወድ ፡ ግን ፡ በዕውቀት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወንጌል ፡ ይኖራል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ፡ ዕቅፍት ፡ በኀቤሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምግባር፡ ልሥራ፡ ትሩፋት፡ ላብዛ ፡ ቢል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰናክል ፡ የለበትም ፡ ም ፡ ፫ ፥ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወዘሰ ፡ ይጸልእ ፡ ቢጾ ፡ ውስተ ፡ ጽልመት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐውር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሙን ፡ የሚጠላ ፡ ግን ፡ በድንቁርና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኦሪት ፡ ይኖራል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢየአምር ፡ ኀበ ፡ የሐውር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሠራውን ፡ ሥራ ፡ አያውቀውም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ጽልመት ፡ አዖሮ ፡ አዕይንቲሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድንቁርና ፡ እንዳያውቅ ፡ አድርጎታልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ (ወዘሰ ፡ ያፈቅር ፡ ቢጾ ፡) ወን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሙን ፡ የሚወድ፡ በመንግሥተ ፡ ሰማይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኖራል ። (ወአልቦ ፡ ዕቅፍት) ፡ ዕቅፍተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ፡ የለበትም ። (ወዘሰ ፡ ይጸልእ) ፡ ወን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሙን ፡ የሚጠላ ፡ ግን ፡ በገሃነም ፡ ይኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራል ፤ (ወኢየአምር) ፡ የሚሄድበትንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያውቀውም ፡ (እስመ ፡ ጽልመት) ፡ ጨ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማ ፡ እንዳያይ ፡ አድርጎታልና ፡ (ጥቅ) ፡",
