      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውስተ ፡ ጽልመት ፡ ሀሎ ፡ እስከ ፡ ይእዜ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገና ፡ እስከ ፡ ዛሬ ፡ በጨለማ ፡ ይኖራል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ በድንቁርና ፡ በኦሪት ፡ ይኖራል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
