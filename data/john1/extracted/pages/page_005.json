          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ አማን ፡ ብክሙ ፡⟫",
          "word_wraps_to_next_line": false,
          "stage1_text": "⟪ወውእቱ ፡ አመን ፡ ብክሙ ፡⟫",
          "stage2_correction": {
            "pair": "አመን -> አማን",
            "reason": "Canonical Ge'ez root text of 1 John 2:8 ('ወውእቱ ፡ አማን ፡ ብክሙ'); the shortened right leg of 4th-order ማ was misread as 1st-order መ."
          },
          "uncertain": []
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኸውም ፡ በናንተ ፡ ጸንቶ ፡ ይኑር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንትሙኒ ፡ ቦቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተም ፡ በሱ ፡ ጸንታችሁ ፡ ኑሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ኀለፈ ፡ ጽልመት ፡⟫",
          "word_wraps_to_next_line": false
        },
