          "uncertain": []
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናውቃለን ። (ጥቅ) ፡ ወአልቦ ፡ ዘይክል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሂለ፡ እግዚእ ፡ ኢየሱስ፡ ዘእንበለ ፡ ዘመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንፈስ ፡ ቅዱስ ፡ ላዕሌሁ ፡ እንዲል ። አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም ፡ በመንፈስ ፡ ቅዱስ ፡ ልጆች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አድርጎ ፡ (ይነብር) ፡ አድሮብን ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖር ፡ እናውቃለን ። (ጥቅ) ፡ ወየኀድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዕሌነ ፡ ዘቅድስት ፡ ሥላሴ ፡ ተፍጻሜት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንፈስ ፡ ቅዱስ ፡ እንዲል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመንፈስ ፡ ቅዱስ ፡ ጋራ ፡ አድሮብን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲኖር ፡ እናውቃለን ። (ጥቅ) ፡ እመ፡ ቦ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘዐቀበ ፡ ቃልየ ፡ አነ ፡ ወአቡየ ፡ ወመን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ ንመጽእ ፡ ኀቤሁ ፡ ወንገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ፡ ምዕራፈ ፡ ውስቴቱ ፡ እስመ ፡ ስብሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲሁ ፡ ወኀይሉ ፡ የዐርፍ ፡ ላእሌክሙ ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያፈቅረኒ ፡ ይዕቀብ ፡ ቃልየ ፡ ወያፈቅሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቡየ ፡ እንዲል ፡ ዮሐ ፡ ፲፬ ፡ ፳፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
