        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "፳፬ ፤ ⟪ወዘሰ ፡ የዐቅብ ፡ ትእዛዞ ፡ ቦቱ ፡ ይነብር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጉን ፡ የሚጠብቅ ፡ ግን ፡ ተውሕዶት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኖራል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱኒ ፡ ቦቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታም ፡ አድሮበት ፡ ይኖራል ፤ ሕጹፅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጸጋ ፡ ተዋሕዶ ፡ እንደ ፡ ብረትና ፡ እንደ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበዝንቱ ፡ ነአምር ፡ ከመ ፡ ይነብር ፡ ምስሌነ ፡ እምነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈሱ ፡ ቅዱስ ፡ ዘወሀበነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሰጠን ፡ ከመንፈስ ፡ ቅዱስ ፡ ዕውቀትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሥተን ፡ አድሮብን ፡ እንዲኖር ፡ በዚህ ፡",
          "word_wraps_to_next_line": false,
          "stage1_text": "ነሥተን ፡ አድሮብን ፡ እንዲኖር ፡ በዚሀ ፡",
          "stage2_correction": {
