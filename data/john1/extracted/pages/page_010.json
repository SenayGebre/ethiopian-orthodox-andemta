          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናችን ፡ ቢዘልፈን ፡ ግን ፡ አለ ፡ ቢያውቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብን፡ ኃጢአቱን፡ ነው ፤ (ጥቅ) ፡ ይቀልየከ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልብከ ፡ ሳሚ ፡ ወልደ ፡ ጌራ ፡ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ብነ ፡ ገጽ) ፡ ከእግዚአብሔር ፡ ዘንድ ፡ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሟልነት ፡ አለን ፡ ም ፡ ፪ ፡ ፳፰ና ፡ ፬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፯ ። ሮሜ ፡ ፭ ፡ ፩ ፡ ፪ ። ዕብ ፡ ፬ ፡ ፲፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "፳፪ ፤ ⟪ወዘሂ ፡ ሰአልናሁ ፡ ንነሥእ ፡ እምኀቤሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለመነውንም ፡ ከሱ ፡ ዘንድ ፡ እንቀበላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለን ፡ አለ ፡ ይሰጠናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ትእዛዞ ፡ ነዐቅብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጉን ፡ እንጠብቃለንና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወንገብር ፡ ዘይኤድሞ ፡ ቅድሜሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ የሚያሰኘውን ፡ እንሠራለንና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ፡ ፲፩ ፡ ፳፬ ።",
