        },
        {
          "line_num": 15,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "፳፫ ፤ ⟪ወዛቲ ፡ ይእቲ ፡ ትእዛዙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትእዛዙም ፡ ይህች ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ንእመን ፡ በወልዱ ፡ ኢየሱስ ፡ ክርስቶስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በባሕርይ፡ ልጁ፡ በኢየሱስ፡ ክርስቶስ፡ እና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን፡ ዘንድ፡ ነው፡ እንጅ ። እንድናምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትእዛዙ ፡ ነው፡ እንድናምን፡ መሆን፡ ነው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወንትፋቀር ፡ በበይናቲነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እርስ ፡ በርሳችን ፡ ፍቅርን ፡ እንይዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በከመ ፡ ወሀበነ ፡ ትእዛዞ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቂቅየ፡ ተፋቀሩ፡ ብሎ፡ ትእዛዙን፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገረን ፡ ዮሐ ፡ ፮ ፡ ፳፱ ። ማር ፡ ፲፪ ፡ ፴፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪አኀዊነ ፡ ለኵላ ፡ መንፈስ ፡ ኢትእመኑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሞቻችን ፡ ሐሰተኛ ፡ መምህርን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ሐሰተኛ ፡ ትምህርትን ፡ አትመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኗት ፡",
