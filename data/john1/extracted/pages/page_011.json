    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወእሙንቱሰ ፡ እምነ ፡ ዓለም ፡ እሙንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሊያስ ፡ ከዓለም ፡ የተገኙ ፡ ዓለማውያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበእንተ ፡ ዝንቱ ፡ እምነ ፡ ዓለም ፡ ይነብቡ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህ ፡ ዓለማዊ ፡ ትምህርትን ፡ ያስተም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዓለሙኒ ፡ ይሰምዖሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለሙም ፡ ይቀበላቸዋል ፡ (ጥቅ) ፡ እስመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ፡ ያፈቅር ፡ እሊዓሁ ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌባ ፡ ሌባውን ፡ ወንበዴ ፡ ወንበዴውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወዳልና ፡ ዮሐ ፡ ፫ ፡ ፴፩ና ፡ ፲፭ ፡ ፲፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወንሕነሰ ፡ እምነ ፡ እግዚአብሔር ፡ ንሕነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛ ፡ ግን ፡ ከእግዚአብሔር ፡ የተወለድነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእግዚአብሔር ፡ የተማርነ ፡ ነንና ፡ ዓለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማዊ ፡ ትምህርትን ፡ አናስተምርም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘየአምሮ ፡ ለእግዚአብሔር ፡ ይሰምዐነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርን ፡ የሚያምነው ፡ የሚወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደው ፡ ትምህርታችንን ፡ ይቀበለናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘኢኮነ ፡ እምእግዚአብሔር ፡ ኢይሰምዐነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእግዚአብሔር ፡ ያልተማረ ፡ ያልተወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለደ፡ግን ፡ ትምህርታችንን፡ አይቀበለንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበእንተ ፡ ዝንቱ ፡ ነአምራ ፡ ለመንፈሰ ፡ ጽድቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለመንፈሰ ፡ ሐሰት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህም፡እውነተኛይቱን፡ ትምህርትና፡ ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰተኛይቱን፡ ትምህርት፡ እውነተኛይቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህርና ፡ ሐሰተኛይቱን ፡ መምህር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእግዚአብሔር ፡ የተገኘችውን ፡ ትምህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርትና ፡ ከሰይጣን ፡ የተገኘችውን ፡ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህርት ፡ ከእግዚአብሔር ፡ የተማረችውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህርና ፡ ከሰይጣን ፡ የተማረችውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህር ፡ እናውቃለን ፡ ዮሐ ፡ ፰ ፡ ፵፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪አኀዊነ ፡ ለንትፋቀር ፡ በበይናቲነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሞቻችን ፡ እርስ ፡ በርሳችን ፡ ፍቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርን ፡ እንያዝ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ተፋቅሮ ፡ እምነ ፡ እግዚአብሔር ፡ ውእቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቅር ፡ ከእግዚአብሔር ፡ የተገኘ ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሉ ፡ ዘይትፋቀር ፡ እምነ ፡ እግዚአብሔር ፡ ውእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ፡ ተወልደ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቅርን ፡ የያዘ ፡ ሰው ፡ ሁሉ ፡ ከእግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ የተወለደ ። አንድም ፡ የተማረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየአምሮ ፡ ለእግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርን ፡ ያውቀዋል ፡ ይወደዋል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወዘሰ ፡ ኢያፈቅር ፡ ቢጸ ፡ ኢየአምሮ ፡ ለእግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቅርን ፡ የማይዝ ፡ ግን ፡ እግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርን ፡ አያውቀውም ፡ አይወደውም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ እግዚአብሔር ፡ ፍቅር ፡ ውእቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ፍቅር ፡ ነውና ። ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በባሕርዩ ። አንድም፡ አድሮ፡ የሚያፋቅር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ሆነ ፡ በግብሩ ፡ ፍቅር ፡ ብሎታል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወበዝንቱ ፡ ተዐውቀ ፡ ፍቅሩ ፡ ለእግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዕሌነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህም ፡ እግዚአብሔር ፡ ፍቅር ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ለነ ፡ ለኛ ፡ ታወቀ ። አንድም ፡ (ኪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያነ) ፡ እግዚአብሔር ፡ እኛን ፡ መውደዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ፡ ታወቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ለወልዱ ፡ ዋሕድ ፡ ፈነዎ ፡ ውስተ ፡ ዓለም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀዳሚ ፡ ተከታይ ፡ የሌለው ፡ የባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ፡ ልጁን፡ ወደዚህ፡ ዓለም፡ ሰዶታልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ንሕየው ፡ በእንቲአሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
