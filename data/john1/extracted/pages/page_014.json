      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስክርነት ፡ አላመነምና ፡ ሮሜ ፡ ፰ ፥ ፲፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፫ ፥ ፴፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወዛቲ ፡ ይእቲ ፡ ስምዑ ፡ ለእግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ ምስክርነቱ ፡ ይህች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ወሀበነ ፡ ሕይወተ ፡ ዘለዓለም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዘለዓለም ፡ ድኅነትን ፡ የሰጠን ፡ መስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠት ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዛቲ ፡ ይእቲ ፡ ሕይወት ፡ እንተ ፡ በወልዱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህችውም ፡ የዘለዓለም ፡ ድኅነት ፡ በልጁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያገኘናት ፡ ናት ፥ ዮሐ ፡ ፩ ፥ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ዘሀለወ ፡ ምስሌሁ ፡ ወልድ ፡ ቦቱ ፡ ሕይወት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድ ፡ በሕልውናው ፡ ላለ ፡ ለአብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወትነት ፡ አለው ። አንድም ፡ ሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወት ፡ የባሕርዩ ፡ ነው ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብ ፡ በሕልውና ፡ ላለ ፡ ለወልድ ፡ ሕይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወትነት ፡ አለው ፤ ሕይወት ፡ የባሕርዩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። አንድም ፡ ወልድ ፡ ላደረበት ፡ ለም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እመን ፡ ሕይወት ፡ አለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሰ ፡ ኢሀሎ ፡ ምስለ ፡ ወልደ ፡ እግዚአብሔር ፡ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦቱ ፡ ሕይወት ፡ ዘለዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልደ ፡ እግዚአብሔር ፡ ያላደረበት ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዘለዓለም ፡ ድኅነት ፡ የለውም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወዘንተ ፡ ጸሐፍኩ ፡ ለክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ጻፍሁላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ታእምሩ ፡ ከመ ፡ ብክሙ ፡ ሕይወት ፡ ዘለዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለም ፡ እለ ፡ ተአምኑ ፡ በስሙ ፡ ለወልደ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወልደ ፡ እግዚአብሔር ፡ ስም ፡ ላመና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ለናንት ፡ የዘለዓለም ፡ ድኅነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳላችሁ ፡ ታውቁ ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወዛቲ ፡ ይእቲ ፡ እንተ ፡ ብነ ፡ ገጽ ፡ በኀበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሱን ፡ ከነቢያት ፡ አንድ ፡ አድርጎ ፡ ይና",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገራል ፤ ከእግዚአብሔር ፡ ዘንድ ፡ ያለችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለሟልነት ፡ ይህች ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ዘሰአልነ ፡ ኀቤሁ ፡ በስመ ፡ ዚአሁ ፡ ይሰምዐነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈኑ ፡ እዴከ ፡ አንሥእ ፡ ኃይለከ ፡ ብለን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለመንነውን ፡ ልመና ፡ ሰምቶናልና ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፻ ፥ ፳፰ ፤ ፫ ፥ ፳፩ ። ኤፌ ፡ ፫ ፥ ፲፪ ። ዕብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ፥ ፲፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወእመሰ ፡ ርኢነ ፡ ከመ ፡ ዘሰአልናሁ ፡ ይሰምዐነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህም ፡ ቀደም ፡ ፈኑ ፡ እዴከ ፡ አንሥእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃይለከ ፡ ብለን ፡ የለመንነውን ፡ እንዲሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማን ፡ ካወቅንስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ነአምር ፡ እንከ ፡ ከመ ፡ ብነ ፡ ስእለት ፡ ዘሰአልነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኀቤሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛሬም ፡ በቅንው ፡ ወልድከ ፡ በስቁል ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልድከ ፡ ብለን ፡ የምንለምነውን ፡ እንዲሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማን ፡ እናውቃለን ። አንድም ፡ (ወዛቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይእቲ) ፡ ራሱን ፡ ከሐዋርያት ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አድርጎ ፡ ይናገራል ፡ ከእግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ያለችን ፡ ባለሟልነት ፡ ይህች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡ (እስመ ፡ ዘሰአልነ) ፡ ዛሬ ፡ በስቁል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድከ ፡ በቅንው ፡ ወልድከ ፡ ብለን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለመንነውን ፡ ሰምቶናልና ፡ (ወእመሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኢነ) ፡ ዛሬ ፡ በስቁል ፡ ወልድከ ፡ በቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንው ፡ ወልድከ ፡ ብለን ፡ የለመንነውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሰማነ ፡ ካወቅነስ ፡ እንግዴህም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስከ ፡ ምጽአት ፡ ድረስ ፡ በስቁል ፡ ወል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድከ ፡ በቅንው ፡ ወልድከ ፡ ብለን ፡ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
