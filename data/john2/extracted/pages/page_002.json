        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቍ ፡ ፲፪ ። ይኤምኑኪ ፡ በል ፡ ቍ ፡ ፲፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪እምነ ፡ ቀሲስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከኔ ፡ ከቄሱ ፡ ከዮሐንስ ፡ የመጣች ፡ ክታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ። ሐተታ ፡ እስከ፡ ሊቀ፡ ጳጳስነት ፡ ያለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዓርግ ፡ ተሰጥቶት ፡ ሳለ ፡ እምነ፡ ቀሲስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ስለ ፡ ትሕትና ። አንድም፡ እምሊቅ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲል ፡ ነው ፡ ኅረይ ፡ ሰብዓ ፡ ቀሲሳነ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ፡ ሊቃውንተ ፡ ሲል ። አንድም ፡ በበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጠ ፡ መዓርጉ ፡ ተናገረ ፡ ቀሲስ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አበ ፡ ሕዝብ ፡ መገሥጸ ፡ ሕዝብ ፡ መሥተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስርየ ፡ ሕዝብ ፡ ማለት ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለኅሪት ፡ ወለእግዝእት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅሪት ፡ ስሟ ፡ ነው ፡ ለመቤቴ ፡ ለኅሪት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትድረስላት ። ሐተታ ፡ አሁን ፡ ከእኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ የነበረ ፡ ብላቴና ፡ ምን ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ ደረሰና ፡ እንዲህ ፡ ይለኛል ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳትለው ፡ በቀደመ ፡ ስሟ ፡ ጠራት ፤ እና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተም፡ ጌቶቻችሁን፡ በቀደመ ፡ ስማቸው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥሯቸው፡ ለማለት ፡ ለአብነት ። አንድም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኅሪት፡ ለጥምቅት ፡ ሲል ፡ ነው ፤ ወለእግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝእት ፡ በጥምቀት ፡ ባገኘችው ፡ ኀይል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንትን ፡ ለምትገዛ ፡ ድል ፡ ለምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሣ ፡ ትድረስላት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለደቂቃ ፡ ለእንተ ፡ አነ ፡ አፈቅራ ፡ በጽድቅ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሃይማኖት ፡ ጸንተው ፡ ምግባር ፡ ሲሠሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢገኙ ፡ ለምወዳቸው ፡ ለልጆቿ ፡ ትድረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስላቸው ። አንድም ፡ ለኅሪት ፡ ለእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አነ ፡ አፈቅራ ፡ አንድ ፡ ወገን ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበእንተ ፡ ዛቲ ፡ ጽድቅ ፡ አኮ ፡ አነ ፡ ባሕቲትየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘአፍቅራ ፡ አላ ፡ እለኒ ፡ ያአምርዋ ፡ ለጽድቅ ፡ ኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለዚህም ፡ በሃይማኖት ፡ ጸንታ ፡ ብትገኝ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምወዳት ፡ እኔ ፡ ብቻ ፡ አይደለሁም ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ እኔ ፡ ብቻ ፡ የምወዳት ፡ አይደለ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁም ፡ ሃይማኖትን ፡ የሚያውቋት ፡ ሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወዷታል፡እንጅ ፡ ፩ ፡ ጴጥ ፡ ፭ ፥ ፩ ። ፫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወበእንተ ፡ ዛቲ ፡ ጽድቅ ፡ እንተ ፡ ትነብር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀቤነ ፡ ወትሄሉ ፡ ምስሌነ ፡ ወምስሌነ ፡ ይእቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ፡ ዛቲ ፡ ጽድቅና ፡ በእንተ ፡ ዛቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽድቅ ፡ አንድ ፡ ወገን ፡ ነው ። ስለዚች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖት ፡ ከጊዜ ፡ እምነት ፡ እስከ ፡ ዕለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ ሞት ፡ በኛ ፡ ጸንታ ፡ ስለምትኖር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወትሄሉ)፡ ከዕለተ፡ ሞት ፡ እስከ ፡ ዕለተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጽአት ፡ (ወምስሌነ፡ ይእቲ)፡ ከምጽአት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ በኛ ፡ ጸንታ ፡ ስለምትኖር ፡ ሃይማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖት ፡ የምወዳት ፡ (አኮ)፡ እኔ ፡ ብቻ ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለሁም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ሞገስ ፡ ወምሕረት ፡ ወሰላም ፡ እምኀበ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ አብ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእግዚአብሔር ፡ አብ ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምኀበ ፡ ኢየሱስ ፡ ክርስቶስ ፡ ወልዱ ፡ ለአብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ አብ ፡ የባሕርይ ፡ ልጁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሚሆንም ፡ ከኢየሱስ፡ክርስቶስም፡ዘንድ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለሟልነት ፡ ቸርነት ፡ ፍቅር ፡ አንድነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደረግላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
