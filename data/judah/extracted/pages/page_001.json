        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "የይሁዳ ፡ መልእክት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪መልእክተ ፡ ይሁዳ ፡ እኁሁ ፡ ለያዕቆብ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁዳ ፡ ይሁዳ ፡ ይሁዳ ፡ ታዴዎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዕቆብም ፡ ያዕቆብ ፡ ደቂቀ ፡ ዮሴፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ። አንድም ፡ ይሁዳም ፡ ሌላ ፡ ያዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆብም ፡ ሌላ ፡ ያልታወቁ ፡ ናቸው ፡ የዚህ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የይሁዳ ፡ ዕለተ ፡ ዕረፍቱ ፡ ዜና ፡ ገድሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልታወቀም ። አንድም ፡ ዕረፍቱ ፡ በሰኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐያ ፡ አምስት ፡ ቀን ፡ ነው ። (በሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሌ ፡ በዘጠኝ ፡ ቀንም ፡ ይላሉ) ፡ ምክን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት ፡ እንደ ፡ ዳግሚት ፡ ጴጥሮስ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪እምይሁዳ ፡ ገብረ ፡ እግዚአብሔር ፡ ወኢየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱስ ፡ ክርስቶስ ፡ እኁሁ ፡ ለያዕቆብ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ አብ ፡ የኢየሱስ ፡ ክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶስም ፡ አገልጋይ ፡ የያዕቆብ ፡ ወንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምሆን ፡ ከኔ ፡ ከይሁዳ ፡ የመጣች ፡ ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታብ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለእለ ፡ ያፈቅርዎ ፡ ለእግዚአብሔር ፡ አብ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ አብን ፡ ለሚወዱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ስሙያን ፡ ወጽውዓን ፡ በኢየሱስ ፡ ክርስቶስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙያን ፡ በስሙ ። በወልድ ፡ ውሉድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በክርስቶስ ፡ ክርስቲያን ፡ ተብለው ፡ ለተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠሩ ፡ (ጽውዓን) ፡ በኢየሱስ ፡ ክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዑ ፡ ትልዉኒ፡ ተብለው ፡ ለተጠሩ ፡ ትድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረስላቸው ፡ ማቴ ፡ ፲፫ ፥ ፶፭ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ሰላም ፡ ለክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸር ፡ አላችሁን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ተፋቅሮ ፡ ወሣህል ፡ ይብዛኅ ፡ ለክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቅር፡አንድነት፡ይቅርታ፡ ይደረግላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪አኀዊነ ፡ በኵሉ ፡ አስተፋጠንኩ ፡ ከመ ፡ እጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍ ፡ ለክሙ ፡ በእንተ ፡ ሕይወተ ፡ ኵልነ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድሞቻችን ፡ የትንሣኤያችንን ፡ ነገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጽፍላችሁ ፡ ዘንድ ፡ በአፍአ ፡ በውስጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችኮላን ፡ አደረግሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ጥቀ ፡ እጽሕፍ ፡ ለክሙ ፡ ጽሁቀ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግጥም ፡ እስመ ፡ ጥቀ ፡ ጽሁቀ ፡ እጅግ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ እጽፍላችኋለሁ ፡ ብዬ ፡ ነበረና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ እስመ ፡ ጽሕቁ ፡ እጽሕፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለክሙ፡ ጥቀ ፡ ብዙ ፡ እጽፍላችሁ ፡ ዘንድ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድጄ ፡ ነበረና ። አንድም ፡ እስመ ፡ ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁቁ ፡ ጥቀ ፡ እጽሕፍ ፡ ለክሙ ፡ እጽፍላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ዘንድ ፡ ብዙ ፡ ወድጄ ፡ ነበረና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ እስመ ፡ ጽሁቁ ፡ ጥቀ ፡ እጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕፍ፡ ለክሙ ፡ ጥቀ ፡ እጅግ፡ እጽፍላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ብዙ ፡ ወድጄ ፡ ነበረና ፡ ባያደር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰኝ ፡ የትንሣኤያችንን ፡ ነገር ፡ እጽፍላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ዘንድ ፡ ቸኮልሁ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአስተበቍዐክሙ ፡ ከመ ፡ ትትቀነይዋ ፡ ለእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተውህበት ፡ ለቅዱሳን ፡ ሃይማኖት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዘ ፡ አስተበቍዐክሙ ፡ ብሎ ፡ ያነበ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ፡ ሊቁ ፡ ስማልዳችሁ ፡ (ለሃይማኖት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ ተውህበት ፡ ለቅዱሳን ፡ ሲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው) ፡ ለሐዋርያት ፡ የተነገረችውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖት ፡ ትይዝዋት ፡ ዘንድ ፡ (ትማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሯት ፡ ዘንድ ፡ ቢል ፡ አንድ ፡ ነው) ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ጢሞ ፡ ፩ ፥ ፲፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪እስመ ፡ ተደመሩ ፡ ብክሙ ፡ ሰብእ ፡ ረሲዓን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ጽሑፋን ፡ ቀዲሙ ፡ ለዝንቱ ፡ ደይን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስቀድሞ ፡ ለዚህ ፡ ጽኑ ፡ ፍርድ ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልበ ፡ እግዚአብሔር ፡ የተቈጠሩ ፡ የታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቁ ፡ ሰነፎች ፡ ሰዎች ፡ ተቀላቅለውባች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋልና ። አንድም ፡ ስለ ፡ ተቀላቀሉባችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "(አስተፋጠንኩ ፡ እጽሕፍ ፡ ላለው) ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዴት ፡ ተናግሮት ፡ ነበረና ፡ ዝንቱ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጻፈ ፡ ቢሉ ፡ በእንተ ፡ ሕይወተ ፡ ኵልነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ ፡ ነበረና፡ ትንሣኤን ፡ ካነሣ ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ሰብእ ፡ ረሲዓን ፡ ብሎ ፡ ነበረና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያ ፡ አያይዞ ፡ ለዝንቱ ፡ ደይን ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ ወበከመ ፡ ነያ ፡ መንግሥተ ፡ ሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማያት ፡ ማዕከሌሆሙ ፡ ወውሳጤሆሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጻድቃን ፥ ከማሁ ፡ ገሃነምኒ ፡ ነያ ፡ ማዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሌሆሙ ፡ ወውሳጤሆሙ ፡ ለእለ ፡ እጉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛን ፡ በሕማማት ፡ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ያፈልስዎ ፡ ለጸጋ ፡ እግዚአብሔር ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝሙቶሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌልን ፡ በኦሪት ፡ ጽድቅን ፡ በኃጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አት ፡ ዕውነትን ፡ በሐሰት ፡ የሚለውጡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይክሕድዎ ፡ ለዘውእቱ ፡ ባሕቲቱ ፡ ንጉሥ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነ ፡ ኢየሱስ ፡ ክርስቶስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ ብቻ ፡ ንጉሥ ፡ የሚሆን ፡ ኢየሱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስን ፡ የሚክዱ ፡ ቲቶ ፡ ፩ ፥ ፲፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወተአምሩ ፡ ምዕረሰ ፡ ከመ ፡ ኢየሱስ ፡ አድኀነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቦ ፡ እምድረ ፡ ግብፅ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ አስቀድሞ ፡ ያመኑበት ፡ እስራኤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን ፡ ከግብፃውያን ፡ ለይቶ ፡ እንዳዳናቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ ታውቃላችሁ ፥",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበዳግምሰ ፡ ለእለ ፡ ኢአምኑ ፡ አጥፍኦሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላ ፡ ግን ፡ ያላመኑበት ፡ ግብፃውያንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳጠፋቸው፡ ታውቃላችሁ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ጊዜ ፡ ቢያምኑበት ፡ እስራኤልን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከግብፃውያን ፡ እጅ ፡ እንዳዳናቸው ፡ ታው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃላችሁ ፥ ሁለተኛ ፡ ግን ፡ ቢክዱት ፡ ስሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ እልፍ ፡ አጋር ፡ እንዳጠፋቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታውቃላችሁ ፡ ዘኍል ፡ ፲፬ ፥ ፴፭ ። ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆሮ ፡ ፲ ፥ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወለመላእክቲሁኒ ፡ እለ ፡ ኢዐቀቡ ፡ ፍጥረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርያቸውን ፡ ያልጠበቁ ፡ ማለት ፡ ፍጡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራን ፡ ናችሁ ፡ ቢሏቸው ፡ ፈጣርያን፡ ነን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገደግዋ ፡ ለሥርዐቶሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥርዐታቸውን ፡ የተዉ ፡ ማለት ፡ ቀድሱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሏቸው ፡ ቀድሱን፡ ያሉ፡ መላእክትንም፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ውስተ ፡ ደይን ፡ አንበሮሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽኑ ፡ ሥቃይ ፡ ባለበት ፡ በገሃነም ፡ አኖራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተአሥሩ ፡ ለዕለት ፡ ዐባይ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተአሥሩ ፡ እስከ ፡ ዕለት ፤ እስከ ፡ ምጽአት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጋዙ ። አንድም ፡ ተአሠሩ ፡ ለዕለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዕለተ ፡ ምጽአት ፡ ተቀጠሩ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘለሊሆሙ ፡ አቅነዩ ፡ ርእሶሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሳቸውን ፡ ባስገዙ ፡ ገንዘብ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አማልክት ፡ ነን ፡ ባሉ ፡ ገንዘብ ፡ አንበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮሙ ፡ ላለው ፡ ዮሐ ፡ ፰ ፥ ፵፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወከማሁ ፡ ሰዶም ፡ ወገሞራ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዶምንና ፡ ገሞራንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአህጉርኒ ፡ እለ ፡ ምስሌሆን ፡ ወበአርአያሆን ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዋ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳቸውን ፡ አብነት ፡ አድርገው ፡ ኃጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አት ፡ የሠሩትን ፡",
          "word_wraps_to_next_line": false
        }
      ]
    }
