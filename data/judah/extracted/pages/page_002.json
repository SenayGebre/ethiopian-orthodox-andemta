          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወከማሁ ፡ እሉኒ ፡ እለ ፡ በሕልሞሙ ፡ ያጌም",
          "word_wraps_to_next_line": true
