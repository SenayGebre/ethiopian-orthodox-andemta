          "margin_tag": null,
          "line_type": "body",
          "text": "ስቱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመንፈስ ፡ ቅዱስ ፡ አልቦሙ ፥⟫",
