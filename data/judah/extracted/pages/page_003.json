        },
        {
          "line_num": 5,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "፳፩ ፤ ⟪ወበፍቅሩ ፡ ለእግዚአብሔር ፡ ተዐቀቡ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርን ፡ በመውደድ ፡ ሁናችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጠበቁ ፥",
