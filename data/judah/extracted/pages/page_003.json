          "uncertain": []
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ መንፈስ ፡ ቅዱስ ፡ የለም ፡ የሚሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ቆሮ ፡ ፪ ፥ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "፳ ፤ ⟪ወአንትሙሰ ፡ አኀዊነ ፡ ሕንጹ ፡ ርእሰክሙ ፡",
          "word_wraps_to_next_line": false,
          "stage1_text": "፳ ፤ ⟪ወአንትሙሰ ፡ አሐዊነ ፡ ሕንጹ ፡ ርእሰክሙ ፡",
