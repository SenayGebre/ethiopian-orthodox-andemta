        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈስ ፡ ቅዱስ ፡ ያላደረባቸው ። አን",
          "word_wraps_to_next_line": true,
          "stage1_text": "መንፈስ ፡ ቅዱስ ፡ የላደረባቸው ። አን",
          "stage2_correction": {
