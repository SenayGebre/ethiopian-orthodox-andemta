    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበመንፈስ ፡ ቅዱስ ፡ ጸልዩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንፈስ ፡ ቅዱስም ፡ ተቃኝታችሁ ፡ ጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልዩ ፤ (ልጆች ፡ ሁናችሁም ፡ ቢል ፡ ይሆ",
