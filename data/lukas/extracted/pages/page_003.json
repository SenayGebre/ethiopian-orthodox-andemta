        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ፡ ወደህ የተቀበልካት ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጌልን ያስተማሩለት ። ⟪ወፈቀ",
