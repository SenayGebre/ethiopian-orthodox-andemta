          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያደሩለት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተልእክዎ ለቃለ ፈቃዱ፤⟫ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶ የሠራት ። ⟪ለቃለ ፈቃድከ⟫",
