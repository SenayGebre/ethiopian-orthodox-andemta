          },
          "uncertain": []
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህ ምሳሌ ። ሣድስ ወርኀ ያለ",
          "word_wraps_to_next_line": true
        },
