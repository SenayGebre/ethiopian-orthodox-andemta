      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ዘንድ ። ያእምሩ ሊያውቁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም መድኃኒታቸው ክር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቶስን ሊያውቁ ። ታስተምራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፸፰",
          "line_type": "body",
          "text": "⟪በዘይትኀደግ ሎሙ ኃጢአቶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ በሣህሉ ወበምሕረቱ ለአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላክነ ለዘሐወፀነ እምአርያም⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘካ ፫ ፰ ሚል ፬ ፪።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፸፰",
          "line_type": "body",
          "text": "ለና ለ አንድ ወገን ከአር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያም ወርዶ በጐበኘን በፈጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሪያችን ይቅርታና ቸርነት ኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢአታቸውን በሚሠረይላቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ገንዘብ ይሠረይላቸው ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፸፱",
          "line_type": "body",
          "text": "⟪ወሠረቀ ከመ ያርዕዮሙ ብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃና ለእለ ይነብሩ ውስተ ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልመት ወጽላሎተ ሞት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፸፱",
          "line_type": "body",
          "text": "በድንቁርና በቀቢጸ ተስፋ ላሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕውቀትን ይገልጽ ዘንድ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ያርትዕ እገሪነ ውስተ ፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖተ ሰላም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግረ ሕሊናችንን ወደወንጌል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጐዳና ያቃናልን ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፹",
          "line_type": "body",
          "text": "⟪ወልኅቀ ሕፃን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላቴናው አደገ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፹",
          "line_type": "body",
          "text": "⟪ወፀንዐ በመንፈስ ቅዱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንፈስ ቅዱስ ጸና ። ሐተታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጅ የሚያሳድግ ብቻ ጣቢታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለም ። ኃይል አልኅቂተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ አለችና ። ፀንዐ በመንፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ቅዱስ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነበረ ኃቅለ እስከ አመ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገይሥዎ ኀበ እስራኤል ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምከራቸው አስተምራቸው ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ሥላሴ ወደ እስራኤል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመምሕርነት እስኪያማልዱት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድረስ ። አንድም እስራኤል ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከረን አስተምረን ብለው በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሕርነት እስኪማልዱት ድ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረስ በበረሃ ኖረ ። አንድም እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስከ አመ ያስተርኢ ሎሙ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስራኤል ይላል አብነት ። ለእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስራኤል በመምሕርነት እስኪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገለጽ ድረስ በበረሀ ኖረ ።",
          "word_wraps_to_next_line": false,
          "uncertain": []
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ልደተ ኢየሱስ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወኮነ በውእቱ መዋዕል ወፅአ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትእዛዝ እምኀበ አውግሥጦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ቄሣር ከመ ይጸሐፍ ኵሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ኮነ ያለውን ወጽአ ብሎ አመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣው ሰው ሁሉ ከግብር ይቈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠር ዘንድ ፡ በዚያ ወራት ከአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውግሥጦስ ቄሣር ትእዛዝ ወጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸሐፍዮ ለውእቱ ብእሲ ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሞተ እንዲል ። ሐተታ አው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥጦስ ማለት ሠጣጤ ከር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥ ። ቄሣር ማለት ፀጕል ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። ይሕስ እንዳይሆን ጌታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘመኑ ተወልዷል ብሎ አው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥጦስ ማለት ፀጕል ማለት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። ቄሣር ማለት ሠጣጤ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሥ ማለት ነው ። ታሪክ የሮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ንጉሥ ካንድ ጉልማሳ ሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስት ያለ ፈቃዷ ደረሰባት ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሏን ትወድ ነበርና ያለ ፈቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዴ ደረሰብኝ ብላ ታንቃ ሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተች ፡ ወንድሞቿዋ እኅታችን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሞተች እንጂ በሱ ምክንያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ነው ብለው ከቤተ ጣዖት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብቶ ሲወጣ ሸምቀው ገደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉት ፡ ኋላ ሕዝቡ እሱስ አዲስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሞቱ አንድ ሰው ብናሠለጥን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለም ብለው ነገር የሚወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
