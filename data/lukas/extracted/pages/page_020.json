        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቆ ወለትን ጽፎ ሶስተኛ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቅልፍ መጥቶበት ተኛ።ቢነቃ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለትን ፍቆ ድንግልን ጽፎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገኘው።አፍቃለሁ ሲል ኢት",
