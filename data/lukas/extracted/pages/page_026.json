      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳለ ታናሽ አያገባምና ለኤሊ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚስት አጋቡት እሱ ልጅ ሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወልድ ሞተ። አቅም ዘርአ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኁከ ብለው ለያዕቆብ አጋቡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት እሷን አግብቶ ዮሴፍን ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልዳልና። አንድም የጌታ ል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቱ እንደ ማቴዎስ በልደት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋዊ። እንደ ሉቃስ በልደት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጋዊ አይደለምና ተለያይተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ቈጠሩ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ኤሊ።⟫ የኤሊ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ሜልኪ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሜልኪ ልጅ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዮና።⟫ የዮና ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዮሴፍ።⟫ የዮሴፍ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "⟪ወልደ ማታትዩ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "የማታትዩ ልጅ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ አሞጽ።⟫ የአሞጽ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ናሆም።⟫ የናሆም ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ኤስሎም።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የኤስሎም ልጅ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ናጌ።⟫ የናጌ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "⟪ወልደ ማአት።⟫ የማአት ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ማታትዩ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "የማታትዩ ልጅ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ሴሜይ ።⟫ የሴሜይ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዮሴፍ ።⟫ የዮሴፍ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዮዳ።⟫ የዮዳ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "⟪ወልደ ዮናን።⟫ የዮናን ልጅ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ሬስ።⟫ የሬስ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዘሩባቤል ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዘሩባቤል ልጅ ደግ ሰው ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውና ደግነቱን ሲያይ ዘሩባቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን አነሣው መንግሥት ከተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለያየ በኋላ አሥራ ሁለቱን ነገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ አንድ አድርጎ ነግሦአልና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወያዕቆብሰ ያስተኤሪ ንግሠ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ሰላትያል ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰላትያል ልጅ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ኔሪ፤⟫ የኔሪ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "⟪ወልደ ሜልኪ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "የሜልኪ ልጅ ማቴዎስ ሰላት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያልን ወልደ ኢኮንያን ወልደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልያቄም ይለዋል። ሉቃስ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልደ ኔሪ ወልደ ሜልኪ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደምን ነው አይጣላም ቢሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይጣላም። ለዳዊት ናታን ሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሞን የሚባሉ ልጆች ነበሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ማቴዎስ በሰሎሞን የወረደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ሉቃስ በናታን የወረደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ቈጥሮ ነው ። ያውስ ቢሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ላንድ ሰው ሁለት አባት አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለውን ብሎ ማቴዎስ በልደት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋዊ ሉቃስ በልደት ሕጋዊ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቈጥሮ እንዲህ አለ ። አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሜልኪ ነጋሪን ሽታ ወለተ ኤል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትማልም ዘኢየሩሳሌምን አግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቶ ኔሪን ወልዶ ይሞታል። ኤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልያቄም እሷን አግብቶ ኢኮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንያንን ይወልዳል። ኔሪና ኢኮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንያን ወንድማማች ናቸው ኔሪ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታላቅ ነው። ታላቅ ሳለ ታናሽ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያገባምና ለኔሪ ሚስት አጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቡት ልጅ ሳይወልድ ሞተ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅም ዘርአ ለእኁከ ብለው አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋቡት ኢኮንያን እሷን አግብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶ ሰላትያልን ይወልዳል። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም የጌታ ልደቱ እንደ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቴዎስ በልደት ሥጋዊ እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃስ በልደት ሕጋዊ አይደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምና ተለያይተው ቈጠሩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ሐዲ ፡⟫ የሐዲ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ዮሳ ።⟫ የዮሳ ልጅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወልደ ቆሳም ፡⟫ የቆሳም ልጅ",
