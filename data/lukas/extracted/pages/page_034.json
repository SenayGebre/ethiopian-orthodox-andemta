          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ትልወኒ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከተለኝ አለው።",
