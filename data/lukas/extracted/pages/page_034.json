        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለዋቸዋል ሳይመልሱ ዝም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሉ እሱስ ሥርዓት አፍራሽ",
