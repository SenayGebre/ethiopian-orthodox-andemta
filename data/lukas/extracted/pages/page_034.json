          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሕያው ይኅድግ ኃጢአተ በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲበ ምድር።⟫",
