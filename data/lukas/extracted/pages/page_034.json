        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥረይ እንዲገባው ታውቁ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ለውእቱ ድውይ ለከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እብለከ ተንሥእ ወንሣእ ዓራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከ ወእቱ ቤተከ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ድውይ ተነሥተህ አልጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህን ተሸክመህ ወደቤትህ ሂ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ አለው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "⟪ወተንሥአ ሶቤሃ ወነሥአ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራቶ ዘዲቤሁ ይሰክብ በቅድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሜሆሙ ወአተወ ቤቶ እንዘ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
