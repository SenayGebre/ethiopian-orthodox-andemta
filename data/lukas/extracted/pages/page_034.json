        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሎችም ብዙ ሰዎች።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "⟪ወአንጐርጐሩ ጸሐፍት ወፈሪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳውያን ላዕሌሁ፡፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "ጸሐፍት ፈሪሳውያንም በሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቆጡ፡፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎሙ ለአርዳኢሁ ለም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንት ትበልዑ ወትሰትዩ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ኃጥአን ወመጸብሐን።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ መዛሙርቱን ከቀራጮች",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋራ ለምን ትበላላችሁ ትጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣላችሁ አሏቸው። ሐተታ ማ",
