        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስሌሁ መጸብሐን ወኃጥአን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ረፈቁ ምስሌሆሙ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሱ ጋራ ለምሳ የተቀመጡ",
