        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአእኰትዎ ለእግዚአብሔር።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔርንም አመሰገኑ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈርሁ ብዙኃ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጽመው ፈሩ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሉ ርኢነ መንክረ ዮም⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛሬ ድንቅ ነገር አየን አሉ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ተሐርዮቱ ለሌዊ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "⟪ወእምዝ ወጺኦ እምህየ ርዕየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብእሴ መጸብሐዌ ዘስሙ ሌዊ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዘ ይነብር ኀበ ምጽባሕ⟫",
