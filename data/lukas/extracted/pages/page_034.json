        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቴዎስ ለምንት ይበልእ ሊቅክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ አሏቸው ይላል ከዚህ ሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃስ ለምንት ትበልዑ አሏቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው አለ።እንደምን ነው አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣላም ቢሉ አይጣላም ነገር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ማቴዎስ፤መምራችሁ ከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጸብሐን ጋራ ለምን ይበላል",
