        },
        {
          "line_num": 21,
          "margin_tag": "፳፭",
          "line_type": "body",
          "text": "ፈጥኖ ተነሥቶ የተኛበትን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጋ ተሸክሞ እግዚአብሔርን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያመሰገነ በፊታቸው ሄደ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "⟪ወደንገፁ ኵሎሙ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "ሁሉም ደነገጡ።",
