          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪ወሀሎ አሐዱ ብእሲ መስፍን⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "አንድ ሹም ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገብሩ ይደዊ ።⟫",
