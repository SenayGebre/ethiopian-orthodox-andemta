          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝብ ቦአ ቅፍርናሆም ።⟫ማቴ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "፰ ፭ ።",
          "word_wraps_to_next_line": false
        },
