        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልጸቀ ይሙት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊሞት ቀርቦ ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወክቡር ውእቱ በኀቤሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይውም ባለሟሉ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪ወሰሚዖ በእንተ እግዚእ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ከመ ይመጽእ ለአከ ኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤሁ ረበናተ አይሁድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "ጌታችን ኢየሱስ እንደ መጣ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሬ በሰማ ጊዜም የአይሁድን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሽማግሌዎች ላከ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ያስተበቍዕዎ ከመ ይምጻእ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያሕዮ ሎቱ ገብሮ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሪውን እንዲያድንለት ይለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኑት ዘንድ ።",
