          "line_num": 16,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ትምርቱን ለሕዝቡ ነግሮ ከፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
