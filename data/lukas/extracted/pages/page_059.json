        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ እንጀራ ባይገኝ ግሚስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይበቃል መክፈልትን ይዞ።አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም ኅዳጥ የአክል ግሚስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይበቃል ኅዳጥን ይዞ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእመ አኮ አሐቲ መክፈልት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሚስም ባይበቃ አንድ እን",
