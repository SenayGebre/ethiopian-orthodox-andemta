          "text": "ከዚህ በኋላ ሂደው ወዳንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀገር ገቡ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተቀበለቶ አሐቲ ብእሲት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ቤት እንተ ስማ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርታ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማርታ የምትባል ሴት በቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቷ ተቀበለችው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "⟪ወስመ እኅታ ማርያ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "እኅቷ ማርያ ትባላለች።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንተ ነበረት ኀበ እገሪሁ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚእ ኢየሱስ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጌታ ዘንድ ስትማር ትውል",
