        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበር።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትሰምዕ ቃሎ።⟫",
