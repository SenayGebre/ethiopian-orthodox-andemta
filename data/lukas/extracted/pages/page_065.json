          "text": "ላችኋለሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዝ አልቦ ፈድፋደ ዘይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
