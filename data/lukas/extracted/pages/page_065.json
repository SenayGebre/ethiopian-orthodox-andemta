          "line_type": "body",
          "text": "በጨለማ የተናገሩትን በብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃን ይናገሩታል ይሰማል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘኒ አልኆስሱ በዕዝን ይሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብክዎ በአጽራሕ ወበአንሕስት⟫",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ብክም በአጽራሕ ወበአንሕስት⟫",
