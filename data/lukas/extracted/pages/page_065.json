          }
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጆሮ የነገሩዋቸውን በሰገነት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስተምሩታል ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪እብለክሙ ለክሙ ለአእርክትየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢትፍርሕዎሙ ለእለ ይቀትሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክሙ ሥጋክሙ ወነፍስተክሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "ለናንተ ለወዳጆቼ ሰውነታች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁን የሚገሏችሁን አትፍሩ እ",
          "word_wraps_to_next_line": true
        },
