          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚበልጥ የሚሰሩት የለምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪ወባሕቱ አርእየክሙ ዘትፈርሁ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "የምትፈሩትንስ አሳያችኋለሁ።",
          "word_wraps_to_next_line": false
        },
