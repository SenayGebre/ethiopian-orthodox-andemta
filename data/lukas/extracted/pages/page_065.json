          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በክልኤ ጸሪቀ አሶርዮን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "አምስቱ ዖፎች በሁለት ናስ",
