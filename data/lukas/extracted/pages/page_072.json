          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ውርዝውና ዕርግና ። ⟪ወኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረከብኩ ፡⟫ አላገኘሁባቸውም ። ⟪ግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝማ ።⟫ መልአከ ዑቃቢውን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥፋቸው አብነት ሁነው ሌላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን እንዳያስጎዱ አለው ። መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሕረ ንስሐውን አውግዘህ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያቸው አለው ። መልአከ ዑቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢው የዘንድሮን ተዋቸው ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራድቼ ሥራ እስክሠራቸው ድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረስ ። ⟪ለእመቦ ፤⟫ ምናልባት በሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣው ዘመን ሃይማኖት ቢይ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዙ ምግባር ቢሠሩ ። ⟪ወእመ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮሰ ንገዝማ ፡⟫ ያለዚያ ግን እና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠፋቸዋለን ። ⟪እመ ሐዮነ ።⟫ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸም መች ነዋሪዎች ነንና መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሕረ ንስሐው የዘንድሮን ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋቸው መክሬ አስተምሬ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖት እስካስይዛቸው ምግባር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስካሠራቸው ድረስ ፤ ምናልባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ለሚመጣው ዘመን ሃይማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖት ቢይዙ ምግባር ቢሠሩ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዚያ ግን አውግዘን እንለያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋለን ⟪እመ ሐዮነ⟫ ባንሞት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰው ሞት ያጠራጥራል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ብእሲት ዘድኅነት በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዕለተ ሰንበት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪ወእንዘ ይሜህሮሙ በሰንበት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "በ፩ ምኵራብ ።⟫ ቅዳሜ ባን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ምኵራብ ሲአስተምራቸው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪ወሀለወት አሐቲ ብእሲት እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ አድወያ ጋኔን ፲ ወ፰ ዓመተ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "ሰይጣን አሥራ ስምንት ዓመት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንድትታመም ያደረጋት ሴት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበረች ። ⟪ወጐሕቈት።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጎባጣም ነበረች ። አንድም ⟪ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጐሕቈት እንተ አድወያ ጋኔን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእንተ ጐሕቈት⟫ በል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢትክል ቀዊመ ግሙራ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀንቶ መሄድ አይቻላትም ነበር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪ወርእያ እግዚእ ኢየሱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "ጌታም አያት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሐራ ።⟫ አዘነላት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጸውዓ ወይቤላ ኦብእሲቶ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈታሕኪ እምደዌኪ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠርቶ አንች ሴት ከደዌሽ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለይተሻል አላት ። ሐተታ ⟪ተፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሕኪ⟫ ማለቱ ግን እንደተቋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠረ አቅማዳ አድርጓት ነበርና።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪ወአንበረ እደሁ ላዕሌሃ ።⟫",
