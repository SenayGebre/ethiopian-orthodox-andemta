          "text": "ርስቲያን ከተባሉት ልንቆጠር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይገባንም። ⟪አላ ረስየኒ።⟫ ከተ",
          "word_wraps_to_next_line": true
        },
