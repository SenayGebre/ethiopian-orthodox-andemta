        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይቤሎ ዘይንዕስ። ለሁሉም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕግ እንዲያሻቸው አውቆ ሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግ መሥራቱን መናገር ነው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምድኅረ ኀዳጥ።⟫ ሰብአ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለም ሕጉን ተቀብለው ጥቂት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀን ከኖሩ በኋላ ወደ አሕዛብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገር ሄዱ። ⟪ወበህየ ዘረወ።⟫ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃጢአት እየኖሩ ሕጉን አፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረሱ። ወአንፈቆ ብለህ ወኢ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ረሱ። ወአንሊቆ ብለህ ወኢ",
          "stage2_correction": {
            "pair": "ሊ -> ፈ",
            "reason": "Canonical Ge'ez Gospel of Luke 15:14 root word 'ወአንፈቆ' (and when he had spent all); the horizontal bar and bottom loop of 'ፈ' were misread as 'ሊ'."
          },
          "uncertain": []
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደልወኒ እስካለው ጣዖትን",
          "word_wraps_to_next_line": false,
          "stage1_text": "ይደልወኒ እስከለው ጣዖትን",
          "stage2_correction": {
            "pair": "ከ -> ካ",
            "reason": "Amharic Andemta formula 'እስካለው' (up to where it says); the shortened right leg of 4th-order 'ካ' is visible in the image."
          },
          "uncertain": []
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቻ እየተውክ አውርድ። ⟪ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይደልወኒ ።⟫ ከንግዲህ ወዲህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወልድ ውሉድ በክርስቶስ ክ",
          "word_wraps_to_next_line": true
        },
