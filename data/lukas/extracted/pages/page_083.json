          "text": "ነሳሕያን አሕዛብ ቍጠረን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ እንለዋለን ብለው ሂዱ።",
          "word_wraps_to_next_line": false
        },
