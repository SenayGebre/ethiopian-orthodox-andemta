          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወርእዮ አቡሁ፡⟫ እንዳለፈው ⟪ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምጽኡ አልባሰ ቅድመ⟫ ልጅ",
          "word_wraps_to_next_line": true,
          "stage1_text": "አምጽኡ አልባሰ ቅድወ⟫ ልጅ",
          "stage2_correction": {
            "pair": "ወ -> መ",
            "reason": "Canonical Ge'ez Luke 15:22 'አልባሰ ቅድመ' (the first/best robe); ink bleed between the two loops of 'መ' made it resemble 'ወ'."
          },
          "uncertain": []
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት እንዲመለስላቸው። ⟪ወደዩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅልቀተ።⟫ ሃይማኖትን እንዲረ",
