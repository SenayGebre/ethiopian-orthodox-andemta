        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕሊና ምሳሌ ። ለአዳም ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውህብዎ ዓሠርቱ ሕሊናት ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለከሰ አሐዱ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ መንግሥተ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ሔር ወበእንተ ተመይጦቱ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ወልደ እጓለ እመሕያው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪ወሶቤሃ ተስእልዎ ፈሪሳውያን",
