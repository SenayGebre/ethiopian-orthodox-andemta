        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑር ሃይማኖትከ አሕየወተከ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ተነሥተህ ሂድ ሃይማኖትህ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኖሃልና ። ሐተታ ዐሥሩ ለም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻሞች ያሥሩ ሕሊናት ምሳሌ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቀሩት ዘጠኙ የክፉ ሕሊና",
