        },
        {
          "line_num": 24,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወርእዮ አሐዱ እምኔሆሙ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ ነጽሐ ተመይጠ እንዘ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አኵቶ ለእግዚአብሔር በዓቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
