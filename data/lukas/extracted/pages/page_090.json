        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንዘ የሐውሩ ነጽሑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እርሳቸውም ሲሄዱ ዳኑ ነጹ ።",
