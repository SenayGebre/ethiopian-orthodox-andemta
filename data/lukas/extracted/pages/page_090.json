        },
        {
          "line_num": 14,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪ወይቤሉ ወአውየዉ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቅ ተሣሃለነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "ኢየሱስ መምህር ሆይ እዘንል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ብለው አሰምተው ተናገሩ",
