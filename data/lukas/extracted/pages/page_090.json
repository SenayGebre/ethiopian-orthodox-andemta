          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት መቼ ትሰጣለች ብለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠየቁት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአውሥአ ፡⟫ መለሰ ።",
