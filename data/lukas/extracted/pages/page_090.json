        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይቤልዎ ማዕዜ ትመጽእ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንግሥተ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "ፈሪሳውያን የእግዚአብሔር መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንግሥት መቼ ትመጣለች ማ",
