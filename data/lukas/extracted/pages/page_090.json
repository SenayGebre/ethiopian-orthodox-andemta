        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ ካህን ወአፍትኑ ርእሰክሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "አይቷቸው ከካህን ሄዳችሁ ራ",
