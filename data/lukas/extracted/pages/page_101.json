        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ መኑ እገብር ከመዝ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "እኔም ይህን የምሠራ በማን",
