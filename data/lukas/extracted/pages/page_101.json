        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ እኩያን ዐቀብተ ወይን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪ወአኀዘ ይመስል ሎሙ ለሕዝ",
