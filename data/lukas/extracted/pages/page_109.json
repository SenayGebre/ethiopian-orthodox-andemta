      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሂ ጽፍነት ፡⟫ ስንቅም ያለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ መግቦቱን እስኪያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁ ድረስ አትያዙ ይላል መግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦቱን ካወቁ በኋላ ግን ቢይዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ባይዙም አይጐዳምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሰ አልቦ መጥባሕት ይሚጥ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልብሶ ወይሣየጥ ሎቱ መጥባሕተ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰይፍ የሌለው ልብሱን ሺጦ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልብሱ ዋጋ ሰይፍ ይግዛ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፈቃደ ነፍስን ያልያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘ ሰው ፈቃደ ሥጋውን ትቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃደ ነፍሱን ይሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "⟪እብለክሙ ከመ ይበጽሐኒ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሑፍ ወይትፈጸም በላዕሌየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይብል ምስለ ኃጥአን ተኈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቈ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "ከኃጥአን ጋራ ተቈጠረ ተብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተነገረው በኔ እንዲደርስ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውነት እነግራችኋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵሉ ዘበእንቲአየ ይትፌጸም⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለኔ የተነገረው ይፈጸማል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፴፰",
          "line_type": "body",
          "text": "⟪ወይቤልዎ ነዋ ሀለዉ ኀቤነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክልኤቱ መጣብሕ ዝየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፴፰",
          "line_type": "body",
          "text": "አቤቱ ከዚህ ከኛ ዘንድ እነሆ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ሰይፎች አሉ አሉት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ የአክለነ እንከሰ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ሰይፍስ ካለ ይበቃናል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ። አንድም የአክለክሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይበቃችኋል አላቸው ። አንድም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሉይንና ሐዲስን ገንዘብ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድርገናል አሉት ። ብሉይ ሐዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ከያዛችሁስ ይበቃችኋል አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘከመ ጸለየ ኢየሱስ በደብረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘይት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "⟪ወወጺኦ ሖረ በከመ ያለምድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጸሊ ደብረ ዘይት ።⟫ ማቴ ፳፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "፴፮ ማር ፲፬ ፴፪ ዮሐ ፲፰ ፩ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፴፱",
          "line_type": "body",
          "text": "እንደ ለመደ ሊጸልይ ወጥቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብረ ዘይት ሄደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተለውዎ አርዳኢሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ መዛሙርቱም ተከተሉት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "⟪ወበጺሖ ህየ ይቤሎሙ ጸልዩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ኢትባኡ ውስተ መንሱት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፵",
          "line_type": "body",
          "text": "ከዚያም በደረሱ ጊዜ ወደ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከራ እንዳትገቡ ጸልዩ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፵፩",
          "line_type": "body",
          "text": "⟪ወተአተተ እምኔሆሙ መጠነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙጋረ ዕብን ወሰገደ ወጸለየ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፳፮ ፴፱ ማር ፲፬ ፴፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፵፩",
          "line_type": "body",
          "text": "የደንጊያ ውርወራ ያህል ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ደንጊያ ወርውሮ እስከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚደርስበት ድረስ ከርሳቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እልፍ ብሎ ሰገደ ጸለየ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፵፪",
          "line_type": "body",
          "text": "⟪እንዘ ይብል አባ ለእመ ትፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድ አግኀሦ እምኔየ ለዝን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ጽዋዕ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፵፪",
          "line_type": "body",
          "text": "አባቴ ሆይ ከወደድህስ ይህን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽዋዕ ከኔ አርቀው እያለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ፈቃድከ ይኩን ወአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮ ፈቃደ ዚአየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ግን ፈቃድህ ይሁን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጂ የኔ ፈቃድ አይደለም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፵፫",
          "line_type": "body",
          "text": "⟪ወአስተርአዮ መልአከ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ዘይጼንዖ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፵፫",
          "line_type": "body",
          "text": "ለከ ኃይል ለከ ጽንዕ እያለ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚያመሠግነው መልአክ ታየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። አንድም ዘያጸንዖ የሚያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸናው መልአከ እግዚአብሔር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወደሰማይ ተነጋገረው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱሰ ፈርሃ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እርሱ ግን ፈራ ። ሐተታ በሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ልማድ ፈራ ፤ ሰበሰ ኢፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሃ እምኢሰሰለ ፍርሃት እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
