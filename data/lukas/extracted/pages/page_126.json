        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቲያን ሰው ለሞት መዘጋጀት እንዲገባው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ሰባ ሁለቱ ፈራጆች ምክር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ይሁዳ ከአይሁድ ጋራ መስማማት ።",
          "word_wraps_to_next_line": false
        },
