        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይትነሣእ በሣልስት ዕለት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሶስተኛውም ቀን ይነሣል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "⟪ወኢያእመሩ ዘይቤሎሙ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "የነገራቸውን ግን አላወቁትም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይፈርሁዎ ተስእሎቶ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊጠይቁትም ፈሩ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ትሕትና ወትዕግሥት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘክርስቲያን ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "⟪ወበጺሖ ቅፍርናሆም ወበዊኦ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ይቤሎሙ ምንተኑ ሐለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይክሙ በፍኖት በበይናቲክሙ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "ቅፍርናሆም ደርሶ በቤትም በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባ ጊዜ ከመንገድ ምን አሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባችሁ ነበር ብሎ ጠየቃቸው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "⟪ወአርመሙ ፡⟫ ማቴ ፲፰ ፩ ሉቃ ፱ ፵፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "ዝም አሉ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ተበሀሉ በበይናቲሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፍኖት መኑ እንጋ የዓቢ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኔሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሳቸው ማናቸው እንዲበልጥ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንገድ እሱብሳቸው ተነጋግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረው ነበርና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "⟪ወነበረ ወጸውዖሙ ለ፲ቱ ወ፪ቱ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "ተቀምጦም አሥራሁለቱን ጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ዘይፈቅድ ይኩን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቀ ለያትሕት ርእሶ ለኵሉ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በላይ ሊሆን የሚወድ ራሱን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሁሉ ያዋርድ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይክውን ላዕከ ለኵሉ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሁሉም አገልጋይ ይሁን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "⟪ወነሥአ ሕፃነ ወዓቀሞ ማዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "ሕፃኑን ወስዶ በመካከላቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቆመው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንበሮ ውስተ ሕፅኑ⟫",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባጠገቡ አኖረው ፥ ⟪ወይቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሙ ዘተወክፈ ዘከመዝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕፃነ በስምየ ኪያየ ተወክፈ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደዚህ ሕፃን ያለውን በስሜ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተቀበለ እኔን ተቀበለኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፴፮",
          "line_type": "body",
          "text": "⟪ወዘኒ ተወክፈ ኪያየ አኮ ኪያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "የ ባሕቲቶ ዘተወክፈ ዘእንበለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፈነወኒ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፴፮",
          "line_type": "body",
          "text": "እኔንም የተቀበለ የላከኝን ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጂ እኔን ብቻ የተቀበለ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለም ሐተታ በመንገድ ሳሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "መኑ የዓቢ ተባብለዋል ከዚህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ከቤት ገብቶ ቆይቶ በመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንገድ ምን ተባብላችሁ ነበር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው አወቀብን ብለው አር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሙ ፡ ዝም አሉ ፡ ምሳሌ ሕፃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ነገራቸው ። አንድም ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንገድ መኑ የዓቢ ተባብለዋል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቤት ገብቶ ከመንገድ ምን ተባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላችሁ ነበር አላቸው ማን ይበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጣል ተባብለን ነበር አሉት ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌ ሕፃንን ነገራቸው አርመሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ከመንገድ መኑ የዓቢ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተባብለዋል ። ከቤት ገብቶ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌ ሕፃንን ነገራቸው ፥ አላወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀብንም እንዳይሉ በዚያውስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላይ በመንገድ ምን ተባብላች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁ ነበር አላቸው ። አርመሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝም አሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "⟪ወአውሥአ ዮሐንስ ወይቤሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቅ ቦዘርኢነ እንዘ ያወጽእ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንተ በስምከ ወከላዕና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁ ።⟫ ሉቃ ፱ ፵፱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "መምር ሆይ በስምህ አጋንንት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ሲያወጣ አይተን የከለከልነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
