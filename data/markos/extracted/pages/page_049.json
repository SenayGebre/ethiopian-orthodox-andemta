          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "መጥቶም ተኝተው አገኛቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎ ለጴጥሮስ ስምዖን ት",
