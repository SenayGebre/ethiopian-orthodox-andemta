        },
        {
          "line_num": 15,
          "margin_tag": "፵፪",
          "line_type": "body",
          "text": "⟪ተንሥኡ ንሑር ናሁ በጽሐ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘያገብአኒ⟫ ፤",
