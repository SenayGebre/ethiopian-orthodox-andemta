        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ግን ያንተ ፈቃድ ይሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን እንጂ የኔ ፈቃድ አይደለም",
