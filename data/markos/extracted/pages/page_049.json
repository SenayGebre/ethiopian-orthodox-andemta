        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ሱስ ወዘከመ አኀዝዎ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፵፫",
          "line_type": "body",
          "text": "⟪ወእንዘ ይትናገሮሙ በጽሐ ይሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳ አስቆሮታዊ ፩ዱ እም፲ወ፪ቱ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፳፮ ፵፯ ። ሉቃ ፳፪ ፵፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፲፰ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፵፫",
          "line_type": "body",
          "text": "ሲነጋገራቸውም ካሥራ ሁለቱ",
