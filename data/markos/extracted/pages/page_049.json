        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ መጣብሕ ወአብትር እምኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ ሊቃነ ካህናት ወረበናት ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸሐፍት⟫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ሰዎችም ከሱ ጋራ ሾተ",
