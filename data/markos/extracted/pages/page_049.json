        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆን ይሁዳ ደረሰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምስሌሁ ብዙኃን ሰብእ ምስ",
