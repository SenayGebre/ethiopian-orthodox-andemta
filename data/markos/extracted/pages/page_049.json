        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትከሃለከ አኅልፋ እምኔየ ለዛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲ ጽዋዕ⟫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፴፮",
          "line_type": "body",
          "text": "አባቴ ሆይ ሁሉ ይቻልሃል ይህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችን ጽዋ ከኔ አሳልፋት አለው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ፈቃደ ዚአከ ይኩን",
          "word_wraps_to_next_line": false
        },
