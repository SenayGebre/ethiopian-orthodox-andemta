        },
        {
          "line_num": 16,
          "margin_tag": "፴፯",
          "line_type": "body",
          "text": "⟪ወገቢዖ ረከቦሙ እንዘ ይነው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
