        },
        {
          "line_num": 39,
          "margin_tag": "፸",
          "line_type": "body",
          "text": "⟪ወክህደ ካዕበ ።⟫ ሉቃ ፳፪ ፶፰፤",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፸",
          "line_type": "body",
          "text": "ዮሐ ፲፰ ፳፭። ሁለተኛ ካደ",
