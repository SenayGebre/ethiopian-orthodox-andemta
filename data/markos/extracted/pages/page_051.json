        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቀው ብሎ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፸፪",
          "line_type": "body",
          "text": "⟪ወሶቤሃ ነቀወ ካዕበ ዶርሆ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፳፮ ፸፭ ።ዮሐ ፲፫ ፴፰።",
