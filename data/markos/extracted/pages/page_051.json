        },
        {
          "line_num": 23,
          "margin_tag": "፷፰",
          "line_type": "body",
          "text": "አንች የምትዪውን አላውቀው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም አላስተውለውም ብሎ ካደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወፅአ አፍአ ኀበ ጽናፈ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀድ ።⟫",
