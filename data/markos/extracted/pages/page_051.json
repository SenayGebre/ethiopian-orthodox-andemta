        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትክህደኒ ዘእንበለ ይንቁ ዶር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆ ፪ኤ ጊዜ ወበከየ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስም ጌታ ዶሮ ሁለት ጊ",
