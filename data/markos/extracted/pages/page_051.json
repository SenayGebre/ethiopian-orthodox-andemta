          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምድኅረ ሕቀ ካዕበ ይቤል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎ ለጴጥሮስ እለ ይቀውሙ አ",
          "word_wraps_to_next_line": true
        },
