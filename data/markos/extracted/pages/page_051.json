        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቃልከ የዓውቀከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገርህም ያስታውቃል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፸፩",
          "line_type": "body",
          "text": "⟪ወአኀዘ ይትረገም ወይምሀል ።⟫",
