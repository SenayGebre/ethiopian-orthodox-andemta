        },
        {
          "line_num": 21,
          "margin_tag": "፸፪",
          "line_type": "body",
          "text": "ያን ጊዜም ዶሮ ሁለተኛ ጮኸ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተዘከረ ጴጥሮስ ቃሎ ለእግ",
