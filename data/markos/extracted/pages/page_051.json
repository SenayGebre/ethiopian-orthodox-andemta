          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቅጥሩም ውጪ ወደአፍአ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣ ።",
