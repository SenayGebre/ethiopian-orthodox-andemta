          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ኢየአምሮ ለውእቱ ብእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲ ዘትብሉ ፥⟫",
