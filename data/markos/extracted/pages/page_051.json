          "line_num": 13,
          "margin_tag": "፷፯",
          "line_type": "body",
          "text": "ጴጥሮስን እሳት ሲሞቅ አየች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነጸረት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስተዋለችውም ።",
          "word_wraps_to_next_line": false
        },
