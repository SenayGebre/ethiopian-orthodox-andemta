          "text": "⟪ወነቀወ ዶርሆ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶሮም ጮኸ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፷፱",
          "line_type": "body",
          "text": "⟪ወርእየቶ ካዕበ ካልዕት ወለት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፳፮ ፸፩ ።",
