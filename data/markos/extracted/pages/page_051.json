        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዜ አለ ፡ እንደምነው አይለያይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ቢሉ አይለያይም ፡ ነገር እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደማቴዎስ ነው አልጮኸም ፡ማ",
