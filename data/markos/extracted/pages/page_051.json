        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከካህናቱ አለቆች ገረዶች አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲቱ መጣች።",
