        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስን ትሻላችሁን።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ተንሥአ።⟫ ተነሣ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢሀሎ ዝየሰ።⟫ ከዚህስ የለም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወናሁ መካኑ ኀበ ተቀብረ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሆ የተቀበረበት ቦታ፤",
