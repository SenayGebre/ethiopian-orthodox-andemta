          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ትንሣኤሁ ለኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፲፮።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወሶበ ኃለፈት ሰንበት ማርያም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መግደላዊት ወማርያም እመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዕቆብ ወሰሎሜ ተሣየጣ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈወ ከመ ይምጽአ ወይቅብዓ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋሁ፤⟫ማቴ ፳፰ ፩ ሉቃ ፳ ፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፳ ፩።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ሰንበት ባለፈች ጊዜም የያዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆብ እናት ማርያምና የመግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደላዪቱ ማርያም ሰሎሜም መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥተው ሥጋውን ይቀቡ ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሽቱ ገዙ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪ወሖራ ወአንግሐ ጥቀ ሐዊረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀበ መቃብር በእሁድ ሰንበት⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "በመጀመሪያውም ሰንበት ፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሞ ማልደው ወደመቃብር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሄዱ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪ወሶበ ሠረቀ ፀሐይ ይቤላ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በይናቲሆን መኑ ይከሥታ ለነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዕብን እምኆኅተ መቃብር።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "ፀሐይ በወጣች ጊዜም ደንጊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውን ከመቃብሩ አፍ ማን ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሣልናል አሉ።ሐተታ ደርሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ቢሉ ማን ያንሣልን።አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደረሱም ቢሉ ማን ያነሣልናል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሉ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪ወረዊፆን ርእያሃ ለዕብን ኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንኰርኰረት።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "ፈጥነውም ሄደው ደንጊያዪቱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ተገልብጣ አዩዋት።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዓባይ ይእቲ ጥቀ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጅግም ታላቅ ነበረች።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪ወበዊአን ውስተ መቃብር ረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከባ ፩ደ ወሬዛ እንዘ ይነብር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንገለ የማን።⟫ ማቴ ፳፰ ፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፳፬ ፬ ዮሐ ፳ ፲፪፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "ወደ መቃብር በገቡም ጊዜ",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ጉልማሳ በቀኝ በኩል",
