        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳችሁ ለጴጥሮስና ለደቀ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛሙርቱ ንገሯቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበህየ ይሬዕይዎ በከመ ይቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሙ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ነገራቸው ከዚያ ያዩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወወጽአ እምነ መቃብር ወጐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "ያ⟫ ከመቃብር ወጥተው ሸሹ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ አኀዘን ራዓድ ወድንጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፄ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድንጋፄና መንቀጥቀጥም ይዟ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ነበርና፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢነገራ ወኢለመኑሂ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማንም ለማን አልተናገሩም",
