        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርዳኢሁ ወለጴጥሮስ ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቀድሞሙ ገሊላ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ፲፬ ፳፰፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "ወደገሊላ እንዲቀድማቸው ሂ",
