          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይለብስ አልባሰ ንጹሐ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
