    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሜን ፡ በጌምድር ፡ ጐጃም ፡ ሸዋ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በውስጡ ፡ ብዙ ፡ ጠቃቅን ፡ አገር ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳለ ፡ ጶንጦስ ፡ ገላትያ ፡ ቀጰዶቅያ ፡ ምድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ፡ ሮም ፡ እስያ ፡ ቢታንያ ፡ ምድረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅርዕ ፡ ገላትያስ ፡ ምድረ ፡ ፅርዕ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነች ፡ ታውቃለች ፡ ብሎ ፡ ዳና ፡ ፰ ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገን ፡ ምድረ ፡ ሮም ፡ የቀሩት ፡ ምድረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅርዕ ፡ ናቸው ፡ ያዕ ፡ ፩ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ለእለ ፡ ቀደሙ ፡ አእምሮቶ ፡ ለእግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብ ፡ በመንፈስ ፡ ቅዱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንፈስ ፡ ቅዱስ ፡ ልጆች ፡ ሁነው ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ አብን ፡ ማወቅን ፡ ለቀደሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዎች ፡ ትድረስላቸው ። ሐተታ ፡ ምነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖት ፡ አይቀድምምን ፡ ቢሉ ፡ ወአል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦ ፡ ዘይክል ፡ ብሂለ ፡ እግዚእ ፡ ኢየሱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ፡ ዘእንበለ ፡ ዘመንፈስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዕሌሁ ፡ እንዲል ። መጽናቱን ፡ መጉላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ፡ ሲያይ ፡ እንዲህ ፡ አለ ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እውነት ፡ ነው ፡ ሃይማኖት ፡ ይቀድማል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጅነት ፡ ወደ ፡ ኋላ ፡ ይሆናል ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ አብ ፡ በመንፈስ ፡ ቅዱስ ፡ በመን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ የሚወልድ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብን ፡ ማወቅን ፡ ለቀደሙ ፡ ትድረስ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅስ) ፡ ወየኀድር ፡ ላዕሌነ ፡ ዘቅድስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥላሴ ፡ ተፍጻሜት ፡ በመንፈስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ። አንድም ፡ ከመንፈስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋራ ፡ እግዚአብሔር ፡ አብን ፡ ማወቅን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቀደሙ ፡ ሰዎች ፡ ትድረስ ። (ጥቅ) ፡ ተወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐደ ፡ ቃል ፡ በሥጋ ፡ እንዲል። ለስዱዳን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጽፋል ፡ ያሉ ፡ እንደ ፡ ሆነ ፡ ቀደሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጽሕፈት ፡ አስቀድሞ ፡ በቃል ፡ ማወቅን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቀደሙ ። አንድም ፡ በአካል ፡ ፫ ፡ በባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ ፡ በሕልውና ፡ ፩ ፡ ብለው ፡ ከሚያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁት ፡ ዕውቀት ፡ ፩ ፡ ገጽ ፡ ብለው ፡ ማወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅን ፡ ለቀደሙ ። አንድም ፡ ምግባር ፡ ትሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋት ፡ ሠርተው ፡ ከመዓርገ ፡ ነጽሮ ፡ ደር",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ በቅተው ፡ በሃይማኖተ ፡ ርእይ ፡ ከሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውቁት ፡ ዕውቀት ፡ በሃይማኖተ ፡ ሰሚዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማወቅን ፡ ለቀደሙ ፡ ትድረስ ፤ ለባላገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጽፋል ፡ ያሉ ፡ እንደ ፡ ሆነ ፡ ከጽሕፈት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስቀድሞ ፡ በቃል ፡ ማወቅን ፡ ለቀደሙ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ምግባር ፡ ትሩፋት ፡ ሠርተው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመዓርገ ፡ ነጽሮ ፡ ደርሰው ፡ በቅተው ፡ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖተ ፡ ርእይ ፡ ከሚያውቁት ፡ አስቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሞ ፡ በሃይማኖተ ፡ ሰሚዕ ፡ ማወቅን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቀደሙ ፡ ትድረስ ። ወልድን ፡ ስለ ፡ ምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለይቶ ፡ ተወው ፡ ቢሉ ፡ ወላዲ ፡ ካለ ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ፡ ተወላዲ ፡ ግድ ፡ ይመጣልና ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሐዱ ፡ ይትአመን ፡ ይትአመርም ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዲበ ፡ ፩ ፡ ከመ ፡ በዋሕድ ፡ ስም ፡ ሥሉሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያምልኩ ፡ ከመ ፡ ያእምሩከ ፡ ለከ ፡ ለባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲትከ ፡ አምላከ ፡ ጽድቅ ፡ እንዲል ። ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስ ፡ ቢሆን ፡ አብን ፡ ማስቀደሙ ፡ ስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ፡ ነው ፡ ቢሉ ፡ ወላዲ ፡ ሳይል ፡ ተወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላዲ ፡ የሚል ፡ የለምና ። (ጥቅ) ፡ ሃይማኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ እንተ ፡ ትትዌጠን ፡ እምአብ ፡ ኀበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድ ፡ ትበጽሕ ፡ ወኀበ ፡ መንፈስ ፡ ቅዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ፡ ትትፌጸም ፡ እንዲል ፡ አንድም ፡ ኅሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ። በመንፈስ ፡ ቅዱስ ፡ ብለህ ፡ ግጠም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንፈስ ፡ ቅዱስ ፡ ለተመረጡ ፡ ትድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረስ ። ሐተታ ፡ ከቀደመው ፡ ሲለይ ፡ የቀደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መው ፡ የሚመርጣቸው ፡ ሙሴ ፡ የሚመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረጡት ፡ እስራኤል ፡ ዘሥጋ ፡ የሚመረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡበት ፡ መንፈሰ ፡ ረድኤት ፡ የሚመረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡላት ፡ ምድረ ፡ ርስት ፡ ነበረ ፡ ዛሬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ፡ የሚመርጣቸው ፡ ቃል ፡ ሥግው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚመረጡ ፡ እስራኤል ፡ ዘነፍስ ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መረጡበት ፡ መንፈሰ ፡ ልደት ፡ የሚመረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡላት ፡ መንግሥተ ፡ ሰማያት ፡ ናትና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ኅሩያንን ፡ ጥሙቃን ፡ ሲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፤ እምቅድመ ፡ ይባኡ ፡ ውስተ ፡ ኀር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "የት ፡ ናሁ ፡ ይደሉ ፡ ይምሃርዎሙ ፡ ቃለ ፡ ሃ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይማኖት ። አስተዳለወ ፡ መሥዋዕቶ ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀደሶሙ ፡ ለኅሩያኒሁ ፡ እንዲል ። ወለኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎሙ ፡ ሙሴ ፡ አጥመቆሙ ፡ በደመና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወበባሕር ፡ ወተጠምቃ ፡ እገሪሆሙ ፡ ለካህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡ ካለው ፡ ሲለይ ፡ ያ ፡ ምሳሌ ፡ ይህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አማናዊ ፡ ያ ፡ መሬታዊ ፡ ይህ ፡ ሰማያዊ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ ፡ ሥጋዊ ፡ ይህ ፡ መንፈሳዊ ፡ ነውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ፡ይስምዑ፡በንዝኀተ፡ደሙ፡ለኢየሱስ፡ክርስቶስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሱስ ፡ ክርስቶስ ፡ በደሙ ፡ ፈሳሽነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለሙ ፡ እንደ ፡ ዳነ ፡ እርሳቸውም ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳኑ ፡ ይሰሙ ፡ ዘንድ ። ሐተታ ፡ ለስዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳን ፡ ያሉ ፡ እንደ ፡ ሆነ ፡ ምነው ፡ ሰም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ አይደለም ፡ የሄዱት ፡ ቢሉ ፡ ሰሚዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያቆምምና ፡ ለባላገር ፡ ያሉ ፡ እንደ፡ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይስምዑ ፡ የተመቸ ፡ ነው ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኢየሱስ ፡ ክርስቶስ ፡ ደም ፡ ፈሳሽነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለሙ ፡ እንደ ፡ ዳነ ፡ እርሳቸውም ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳኑ ፡ እሽ ፡ በጄ ፡ ይሉ ፡ ዘንድ ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰምዐ ፡ ወተአዘዘ ፡ እስከ ፡ በጽሐ ፡ ለሞት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ። አንድም ፡ ያስተምሩ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ ወኢሐዘብኩ ፡ እስማዕ ፡ በላእሌክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ፡ ካልአ ፡ ነገረ ፡ እንዲል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ ፡ በግዕዝ ፡ ቦታ ፡ የገባ ፡ ነው ። (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኦሪት ፡ ወነቢያት ፡ ሰበኩ ፡ በክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምሑራነ ፡ ልብ ፡ በጥበብ ፡ እንዲል።የኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ፡ ክርስቶስ ፡ የደሙን ፡ ንጽሕና ፡ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሰክሩ ፡ ዘንድ ፡ (ጥቅ) ፡ አንሰ ፡ በእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝንቱ ፡ መጻእኩ ፡ ከመ ፡ እኩን ፡ ሰማዕተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጽድቅ ፡ እንዲል ። ሐተታ ፡ ንዝኀን ፡ ን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሕ ፡ የሚል ፡ ወዴት ፡ አለ ፡ ቢሉ ፡ ኢይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤ ፡ እንዘ ፡ ንጹሐን ፡ አላ ፡ ይቤ ፡ እንዘ፡ንዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀን ፡ ይላል ፤ ከዒው ፡ ያላለ ፡ ንዝኀ ፡ ያለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ምነው ፡ ቢሉ ፡ ትንቢቱ ፡ ምሳሌው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊፈጸም ፡ ትንቢት ፡ ወእነዝኃክሙ ፡ በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ ፡ ንጹሕ ፡ ያለው ፡ ነው ። ምሳሌም ፡ ወነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊሮ ፡ ሙሴ ፡ ትእዛዘ ፡ ኦሪት ፡ ይነዝኅ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብተራሂ ፡ ወኵሎ ፡ ንዋየ ፡ ግብሪሆሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ፡ ነው ። ትንቢቱን ፡ አውቆ ፡ አናግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሯል ፡ ምሳሌውንም ፡ እንጅ ፡ አውቆ ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደርጓል ፡ ፍጻሜው ፡ እንደምን ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሉ ፡ ከዒው ፡ ፩ ፡ ወገን ፡ ነው ፤ ንዝኀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ፡ ከሁሉ ፡ ይደርሳልና ፡ መላእክት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዕለተ ፡ ዐርብ ፡ በቀኖት ፡ የፈሰሰ ፡ ደሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ በጃቸው ፡ እየተቀበሉ ፡ ይህችን ፡ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለም ፡ ረጭተዋታል ፡ እስከዚህስ ፡ ድረስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደርሰው ፡ አይደፍሩም ፡ ብሎ ፡ በጽዋዓ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርሃን ፡ እየተቀበሉ ፡ ረጭተዋታል ፡ ዛሬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብያተ ፡ ክርስቲያናት ፡ የሚሠሩ ፡ ደሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባረፈበት ፡ ላይ ፡ ነው ፡ ይህን ፡ ለምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሻዋል ፡ ቢሉ ፡ እሱ ፡ እንኳ ፡ እጸድቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያይል ፡ ጻድቅ ፡ እከብር ፡ ያይል ፡ ክቡር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራ ፡ የተቀበለ ፡ እናንተማ ፡ መከራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብትቀበሉ ፡ በዛን ፡ ለማለት ፡ ልኡክ ፡ ለኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩያን ፡ ትብጻሕ ፡ ለእለ ፡ ቀደሙ ፡ ይስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምዑ ፡ እለ ፡ ሀለዉ ፡ ይላል ፡ ግጥም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሞገስ ፡ ወሰላም ፡ ይብዛኅ ፡ ለክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖት ፡ ይጽናላችሁ ፡ (ጥቅ) ፡ ኢትግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድፉ ፡ ሞገሰክሙ ፡ እንዲል፤ ምግባር ፡ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸምላችሁ ፡ ባ፩ ፡ ንባብስ ፡ ሁለት ፡ ዘይቤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያስፈታም ፡ ብሎ ፡ አንድ ፡ ወገን ፡ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖት ፡ ምግባር ፡ ይፈጸምላችሁ ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወብዙኀ ፡ በሣህል ፡ ቃለ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ። አንድም ፡ ሞገስ ፡ ባለሟል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ። ወሰላም ፡ ተዋሕዶ ፡ አንድነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደረግላችሁ ፡ (ጥቅ) ፡ ወሰላመ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ እንተ ፡ ኵሉ ፡ ባቲ ፡ እምድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅረ ፡ ሰላመ ፡ ርእሱ ፡ ባልሐነ ፡ እንዲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮሜ ፡ ፲ ፡ ፳፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪፫ ፤ ይትባረክ ፡ እግዚአብሔር ፡ አቡሁ ፡ ለእግዚእነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ ክርስቶስ ፡ ዘወለደነ ፡ በብዝኃ ፡ ምሕረቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሐዋርያት ፡ በምስጋና ፡ መጀመር ፡ ልማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳቸው ፡ ነው ፡ አንድ ፡ ሁነው ፡ ነአኵተከ ፡",
          "word_wraps_to_next_line": false
        }
      ]
