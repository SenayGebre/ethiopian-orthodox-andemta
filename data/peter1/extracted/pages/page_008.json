          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲቱ ፡ አላ ፡ አድኀነ ፡ ካልአነ ፡ ወይዴመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ፡ በእንተ ፡ መንክር ፡ ዳኅናሁ ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ። እንተ ፡ ድሉት ፡ በአብ ፡ ዘንድ ፡ ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቃ ፡ ያለች ፡ ብሎ ፡ ለትንሣኤ ፡ ቀጠለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ)፡ ወኅብእት፡ ሕይወትክሙ ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ፡ በኀበ ፡ እግዚአብሔር ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ። አንድም ፡ ለመድኀኒት ፡ ያለውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለርስት ፡ ብሎ ፡ ሊቁ ፡ ወስዶታል ፤ ለመን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥተ ፡ ሰማይ ፡ ተጠብቀን ፡ ላለን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ ድሉት ፡ በጣዕም፡ በመዓዛ፡ በስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በብርሃን ፡ ተዘጋጅታ ፡ ያለች ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወናሁ ፡ አስተዳለወ ፡ እምቅድመ፡ ይኩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለሞሙ፡ዘድልው፡ለክሙ፡እምቅድመ፡ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትፈጠር፡ዓለም፡ወእምከመ፡ ሖርኩ ፡ ወአስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተዳለውኩ፡ ለክሙ ፡ መካነ ፡ እመጽእ ፡ ካ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕበ ፡ ወእነሥአክሙ ፡ ባለው ፡ከመ ፡ ታስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተርኢ ፡ ፯ ፡ ሽሕ፡ ዘመን፡ ሲፈጸም፡ ጻድቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ ተመልታ ፡ ትገለጽ ፡ ዘንድ ፡ እስት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትገለጽ ፡ ድረስ ፡ (ጥቅ) ፡ ምድርኒ ፡ እንተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢታስተርኢ ፡ አሜሃ ፡ ታስተርኢ ፡ ዝር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕታ ፡ እንዲል ። ኦ፡ እለ፡ በኀይለ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ ዕቁባን ፡ በሃይማኖት ፡ ይላል ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
