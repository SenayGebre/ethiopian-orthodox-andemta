          "margin_tag": null,
          "line_type": "body",
          "text": "ሰከረባቸው ፡ ነቢያት ፡ የሿት ፡ የዞሯት ፡",
          "word_wraps_to_next_line": false,
          "stage1_text": "ሰከረባቸው ፡ ነቢያት ፡ የሺት ፡ የዞሯት ፡",
          "stage2_correction": {
