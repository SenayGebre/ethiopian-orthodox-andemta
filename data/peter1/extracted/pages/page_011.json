          "text": "የተናገሩ ፡ ነቢያት ። አንድም ፡ እለ ፡ ተነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዩ ፡ ወዘነገረ ፡ ብለህ ፡ (ግጠም) ፡ የኢየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
