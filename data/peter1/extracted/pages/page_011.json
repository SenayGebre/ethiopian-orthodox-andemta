        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ተነበዩ ፡ ወዘነገረ ፡ ወዘአቅደመ ፡",
          "word_wraps_to_next_line": false
