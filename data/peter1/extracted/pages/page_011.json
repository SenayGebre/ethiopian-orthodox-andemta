          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ይእቲኬ፡መድኀኒት፡እንተ፡ኀሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥዋ፡ ወዖድዋ፡ነቢያት፡ ስለኛ፡ ክብር፡ የክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብራችንን፡ነገር፡ቢልም፡ይሆናል፡የተናገሩ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቢያት ፡ የሿት ፡ የዞሩላት ፡ የተንከራተቱ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ነቢያት ፡ የሺት ፡ የዞሩላት ፡ የተንከራተቱ",
          "stage2_correction": {
            "pair": "የሺት -> የሿት",
            "reason": "The Amharic gloss for the Ge'ez 'እንተ ኀሠሥዋ' (which they sought) is 'የሿት' (from ሻ, to seek/desire). The bottom horizontal bar of ሿ was misread as the right-leg of ሺ."
          },
          "uncertain": []
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላት ፡ መንግሥተ ፡ ሰማይ ፡ ናት ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦ ፡ እለ ፡ ፄሉ ፡ በሠቅ ፡ ወበሃሜላት ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘብድወ ፡ ጠሊ ፡ እንዲል ። እለ፡ ተነበዩ፡",
          "word_wraps_to_next_line": false
