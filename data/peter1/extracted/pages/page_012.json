          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ፡ እንደ ፡ ሐዋርያት ፡ ቅንቱ ፡ ወገብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቡናችሁን ፡ በንጽሕና ፡ ዝናር ፡ ታጠቁ።",
          "word_wraps_to_next_line": false
