          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለናት ፡ ላባታቸው ፡ ታጥቀው ፡ እንደሚያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገለግሉ ፡ ልጆች ፡ ቅንቱ ፡ ያዕቆብ ፡ ለይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሐቅ ፡ ይስሐቅ ፡ ለአብርሃም ፡ ታጥቀው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያገለግሉ ፡ እንደ ፡ ነበረ። አንድም ፡ የናት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያባታቸውን ፡ ርስት ፡ ጉልት ፡ እንወርሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለን ፡ ብለው ፡ ተስፋ ፡ እንደሚያደርጉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጆች ፡ ተሰፈዉዋ ፡ ላለው ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በንጽሕና ፡ ዝናር ፡ ይታጠቁ ፡ እንደ ፡ ነበ",
          "word_wraps_to_next_line": true
        },
