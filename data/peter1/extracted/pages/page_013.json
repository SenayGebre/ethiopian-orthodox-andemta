          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘእምከመ ፡ የብሰ ፡ ሣዕር ፡ ይትነገፍ ፡ ፍሬሁ ።⟫",
          "word_wraps_to_next_line": false
        },
