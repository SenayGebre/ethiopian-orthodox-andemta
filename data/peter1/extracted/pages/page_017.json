  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪፲፫ ፤ አትሕቱ ፡ ርእሰክሙ ፡ ለኵሉ ፡ ፍጥረተ ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጓለ ፡ እመሕያው ፡ በእንተ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠሪዐ ፡ ቤት ፡ ይሠራል ፡ ሥራውንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በትሕትና ፡ ይጀምራል ፡ ስለ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ብላችሁ ፡ ለሰው ፡ ሁሉ ፡ ተገዙ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ ትሕትና ፡ ምግባራትን ፡ ትሸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከማቸዋለችና ፡ ሥራውን ፡ በትሕትና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀመረ ። (ጥቅ) ፡ ትሕትናሰ ፡ ምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይእቲ ፡ እንተ ፡ ኢትወድቅ ፡ ለጸዊረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ ምግባራት ፡ እንዲል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠብቃቸዋለችና ፡ (ጥቅ) ፡ ወይእቲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምህላወ ፡ እግዚእነ ፡ እንዲል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታለዝባቸዋለችና ። ሐተታ ፡ ባማረ ፡ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማረ ፡ ነገር ፡ ይመስላታል ፡ በበርኖስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለዘቢያ፡ እስመ፡ዘክርስቶስ፡መሐ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ። ሐተታ ፡ ልጅ፡ለአባቱ፡ ቢገዛ፡ርስቱን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጉልቱን ፡ ያወርሰኛል ፡ ብሎ ፡ ነው ፡ ሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌም ፡ ለጌታው ፡ ቢገዛ ፡ ቀዶ ፡ ያለብሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኛል ፡ ቆርሶ ፡ ያጐርሰኛል ፡ ብሎ ፡ ነው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ ፡ መዝሙርም ፡ ለመምህሩ ፡ ቢገዛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከልቡናው ፡ ያለውን ፡ ምስጢር ፡ ነቅቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተግቶ ፡ ይነግረኛል ፡ ብሎ ፡ ነው ፡ ለሁሉ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መገዛት ፡ ግን ፡ ስለ ፡ እግዚአብሔር፡ ብሎ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ፡ በእንተ ፡ እግዚአብሔር ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለንጉሥኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለንጉሥም ፡ ተገዙ ፡ ለኵሉ ፡ ነፍስ ፡ መኰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ ተኰነኑ፡ካለው ፡ ጋራ ፡ አንድ፡ ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ኵሉ ፡ ሎቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ ሊገዛለት ፡ ይገባልና ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ ገንዘቡ ፡ ነውና ፡ አለ ፤ መቅጫው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍጡ ፡ መርቡጡ ፡ በእጁ ፡ ነውና ፡ ይቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣችኋል ። አንድም ፡ የወዲሁ ፡ ዓለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወዲያውም ፡ ዓለም ፡ ፍርድ ፡ የሱ ፡ ነው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና ፡ ይፈርድባችኋል ። ሐተታ ፡ የወዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁስ ፡ ዓለም ፡ ይሁን ፡ የወዲያው ፡ ዓለም ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደምነው ፡ ቢሉ ፡ በወዲያው ፡ እኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተገዙ ፡ ላልኋችሁ ፡ ለምን ፡ ያልተገዛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ብሎ ፡ የሚያስፈርድ ፡ ስለ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወኵሉ ፡ ብውህ ፡ ሎቱ ፡ ካለው ፡ ጋራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ነው ፡ ሮሜ ፡ ፲፫ ፥ ፩ ፥ ፮ ። ቲቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፫ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪፲፬ ፤ ወለመኳንንትኒ ፡ እስመ ፡ ውእቱ ፡ ይፌን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለመኳንንትም ፡ ተገዙ ። ሐተታ ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ ትግሬ ፡ ወርዶ ፡ ላስታ ፡ ወጥቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መግዛት ፡ ባይቻለው ፡ እየሾመ ፡ እየሸለመ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰዳቸዋልና። አንድም ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በንጉሡ ፡ አድሮ ፡ እየሾመ ፡ እየሸለመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰዳቸዋልና ፡ አእምር ፡ ከመ ፡ ልዑል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኴንን ፡ መንግሥተ ፡ ደቂቀ ፡ እጓለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እመሕያው ፡ ወለዘፈቀደ ፡ ይሁብ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ። እስመ ፡ ኢይሠየም ፡ መኰንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘእንበለ ፡ እምኀበ ፡ እግዚአብሔር ፡ ካለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ ጋራ ፡ አንድ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይኰንንዎሙ ፡ ለእለ ፡ ይገብርዋ ፡ ለእኪት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመጸኞችን ፡ እጅ ፡ እግር ፡ በስለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐይን ፡ በፍላት ፡ ይቀጡ ፡ ዘንድ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይትበቀልዎ ፡ ለገባሬ ፡ እኪት ፡ ካለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋራ ፡ አንድ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያአኵትዎሙ ፡ ለእለ ፡ ይገብርዋ ፡ ለሠናይት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃደኞችን ፡ እየሾሙ ፡ እየሸለሙ ፡ ያከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሯቸው ፡ ዘንድ ፡ ወዓዲ ፡ እሙንቱ ፡",
