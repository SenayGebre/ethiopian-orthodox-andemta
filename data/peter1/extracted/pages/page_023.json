      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወዘሰ ፡ ያፈቅራ ፡ ለሕይወት ፡ ወይፈቱ ፡ ይር⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አይ ፡ መዋዕለ ፡ ሠናያተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሕይወት ፡ መኖርን ፡ የሚወድ ፡ በጎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ በጎ ፡ ጳጳስ ፡ የሚነሳበትንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወራት ፡ ሊያውቅ ፡ ሊያይ ፡ የሚወድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ያርምም ፡ ልሳኖ ፡ እምእኪት ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንደበቱን ፡ ከክፉ ፡ ነገር ፡ ይከልክል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከናፍሪሁኒ ፡ ከመ ፡ ኢይንብባ ፡ ሐሰተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከንፈሮቹንም ፡ ሐሰትን ፡ እንዳይናገሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከልክል ። አንድም ፡ ልሳኑ ፡ አንደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቱ ፡ ክፉ ፡ ከመናገር ፡ ይከልክል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከንፈሮቹም ፡ ሐሰት ፡ ከመናገር ፡ ይከል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሉ ። አንድም ፡ ዘንተ ፡ ይቤ ፡ በእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐይው ፡ እንተ ፡ ህየ ፡ ብሎ ፡ ሊቁ ፡ ወስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዶታል ፡ ሐይው ፡ ከመ ፡ መላእክትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዝማነ ፡ መንግሥተ ፡ ሰማያትን ፡ ሊያይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚወድ ፡ ሰው ፡ አንደበቱን ፡ ክርስቶስን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕሩቅ ፡ ብእሲ ፡ ወንጌልን ፡ ዲቃላ ፡ ሕግ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከማለት ፡ ይከልክል ። ከንፈሮቹንም ፡ ይከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልክል ፡ መዝ ፡ ፴፬ ፥ ፲፫ ። ያዕ ፡ ፩ ፥ ፳፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ይትገሐሥ ፡ እምእኪት ፡ ወይግበራ ፡ ለሠና⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክፉውን ፡ ትቶ ፡ በጎ ፡ ሥራ ፡ ይሥራ ። ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተታ ፡ እህል ፡ ከዐፈር ፡ እንዳይቀላቀል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለይኅሥሣ ፡ ለሰላም ፡ ወይትልዋ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍቅርን ፡ የሻት ፡ ይከተላት ። ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሻት ፡ የተጣላው ፡ ወንድሙን ፡ የሚያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስታርቀው ፡ ቢያገኝ ፡ አስታርቀኝ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "መታረቅ ፡ ነው ፡ መከተል ፡ የሚያስታር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ፡ ባያገኝ ፡ ራሱ ፡ ሄዶ ፡ መታረቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ወንድሜ ፡ እኔ ፡ እንጅ ፡ ብበድልህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ብሎ ። አንድም ፡ መሻት ፡ ወንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙን ፡ እናት ፡ አባቱን ፡ ዕቱን ፡ አክስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጎቱን ፡ የገደለበት ፡ ቢሆን ፡ ታረቅ ፡ ሲሉ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ መታረቅ ፡ ነው ፡ መከተል ፡ በዚያው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽናት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪እስመ ፡ አዕይንቲሁ ፡ ለእግዚአብሔር ፡ ኀበ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ጻድቃን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ ዐይኖቹ ፡ ከወዳጆቹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ናቸውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእዝኑሂ ፡ ኀበ ፡ ስእለቶሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀሮውም ፡ ከልመናቸው ፡ ዘንድ ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይግበራ ፡ ለሠናይት ፡ ላለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ገጹ ፡ ለእግዚአብሔር ፡ ኀበ ፡ እለ ፡ ይገብሩ ፡ እኪተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገጹሰ ፡ ሲል ፡ ነው ፡ ገጸ ፡ መዓቱ ፡ ግን ፡ ክፉን ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሚሠሩ ፡ ሰዎች ፡ ነውና ፡ ይትገሐሥ ፡ ላለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ መከራውንስ ፡ ብንቀበል ፡ ማን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያይልናል ፡ ማን ፡ ይሰማልናል ፡ ትሉኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ የእግዚአብሔር ፡ ዐይኖቹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወዳጆቹ ፡ ዘንድ ፡ ናቸውና ፡ ያይላችኋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀሮውም ፡ ከልመናቸው ፡ ነውና ፡ ይሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላችኋል ። አንድም ፡ ይህ ፡ ሁሉ ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራ ፡ የሚመጣብን ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባያይልን ፡ ባይሰማልን ፡ ነው ፡ ትሉኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ የእግዚአብሔር ፡ ዐይኖቹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወዳጆቹ ፡ ዘንድ ፡ ናቸውና ፡ ያይላችኋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀሮውም ፡ ከልመናቸው ፡ ዘንድ ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰማላችኋል ፡ ክብር ፡ ይበዛላችሁ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ እንጅ ፡ ገጹሰ ፡ ፩ ፡ ነው ፡ አይለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጥም ፡ ቃሉ ፡ ቃለ ፡ ዳዊት ፡ ነው ፡ እጅ ፡",
          "word_wraps_to_next_line": false
        },
