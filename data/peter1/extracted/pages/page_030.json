  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ አሰኝታችሁ ፡ ይሁን ፡ እንጅ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፳፩ ፥ ፲፮ ። የሐዋ ፡ ፳ ፥ ፳፰ ። ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢሞ ፡ ፫ ፥ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪እንዘ ፡ ኢትትኄየሉ ፡ ሕዝቦ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወገኖቹ ፡ ሳትበራቱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ ፡ አርአያ ፡ ኩንዎሙ ፡ ለመርዔቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምእመናን ፡ በፍቅር ፡ በትሕትና ፡ አብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ፡ ሁኗቸው ፡ እንጅ ፤ ፪ ፡ ቆሮ ፡ ፩ ፥ ፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲቶ ፡ ፪ ፥ ፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ከመ ፡ አመ ፡ አስተርአየ ፡ እግዚአ ፡ ኖሎት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንሥኡ ፡ አክሊለ ፡ ስብሐት ፡ ዘኢይጸመሂ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአ ፡ ቀሳውስት ፡ ጌታ ፡ በተገለጸ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ የማታልፍ ፡ መንግሥተ ፡ ሰማያት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ትወርሱ ፡ ዘንድ ። ሐተታ ፡ አክሊል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላት ፡ የብዕለ ፡ ሥጋ ፡ ፍጻሜ ፡ ዘውድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ የብዕለ ፡ ነፍስም ፡ ፍጻሜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንግሥተ ፡ ሰማያት ፡ ናትና ፡ አክሊል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላት ፤ ዘኢይጸመሂ ፡ አለ ፡ በለምለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ ይመስላታል ። ጥቅ ፡ ወቈጽለ ፡ ዕፁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒ ፡ ፈውስ ፡ ለሕይወተ ፡ አሕዛብ ፡ እንዳለ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕብ ፡ ፲፫ ፥ ፳ ። ፩ ፡ ቆሮ ፡ ፱ ፥ ፳፭ ። ፪ ፡ ጢሞ ፡ ፬ ፥ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወከማሁ ፡ አንትሙኒ ፡ ወራዙት ፡ ተኰነኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእለ ፡ ይልህቁክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ ለመምህራን ፡ ተገዙ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳልሁ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተም ፡ ዲያቆናት ፡ ከናንተ ፡ በላይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላሉ ፡ ለቀሳውስት ፡ ተገዙ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵልክሙ ፡ ተመሀርዋ ፡ ለአትሕቶ ፡ ርእስክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀሳውስትን ፡ ምእመናንን ፡ ጠብቁ ፤ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳልሁ ፥ ሁሉንም ፡ አንድ ፡ አድርጎ ፡ ትሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትናን ፡ ያዙ ፡ አለ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ እግዚአብሔር ፡ ያኀሥሮሙ ፡ ለዕቡያን ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ትቢተኞችን ፡ ያዋርዳቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋልና ፥",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያከብሮሙ ፡ ለእለ ፡ ይቴሕቱ ፡ ርእሶሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሳቸውን ፡ የሚያዋርዱትን ፡ ግን ፡ ያከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብራቸዋልና ፤ ተመሀርዋ ፡ ላለው ፡ ቃሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃለ ፡ ሐና ፡ ነው ፡ እጅ ፡ አድርጎ ፡ ተናግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮታል ፤ ኤፌ ፡ ፭ ፥ ፳፩ ። ማቴ ፡ ፳፫ ፥ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዕ ፡ ፬ ፥ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪አትሕቱ ፡ እንከ ፡ ርእሰክሙ ፡ ታሕተ ፡ እዴሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእግዚአብሔር ፡ ጽንዕት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቀሳውስት ፡ ተገዙ ። ሐተታ ፡ እዴሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅንዕት ፡ አላቸው ፡ ቀሳውስትን ፡ ፈርዶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅንዕት ፡ ገሃነመ ፡ እሳትን ፡ ለኃጥአን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅንዕት ፡ መንግሥተ ፡ ሰማይን ፡ ለጻድቃን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያወርስባቸዋልና ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ያልዕልክሙ ፤ አመ ፡ ይሔውጸክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በረድኤት ። አንድም ፡ በምፅአት ፡ መጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶ ፡ በጎበኛችሁ ፡ ጊዜ ፡ ልዕልና ፡ ነፍስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጥቶ ፡ ያከብራችሁ ፡ ዘንድ ፤ ኢዮብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፪ ፥ ፳፱ ። ያዕ ፡ ፬ ፥ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወኵሎ ፡ ሕሊናክሙ ፡ ግድፉ ፡ ላዕሌሁ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሳባችሁን ፡ ሁሉ ፡ በሱ ፡ ላይ ፡ አድርጉ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለት ፡ እሱ ፡ ያስብልናል ፡ በሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ውእቱ ፡ ይሔሊ ፡ በእንቲአክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ ፡ የናንተን ፡ ነገር ፡ ያስባልና ፥ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስብላችኋልና ፤ ማቴ ፡ ፮ ፥ ፳፭ ። ፊል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ፥ ፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ጥበቡ ፡ እንከ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተራቀቁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአጥብቡ ፡ ልበክሙ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
