      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ምስለ ፡ ስልዋኖስ ፡ እኁነ ፡ ምእመን ፡ በከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐለይኩ ፡ ኅዳጠ ፡ ጸሐፍኩ ፡ ለክሙ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "የታመነ ፡ ከሚሆን ፡ ከወንድማችን ፡ ከስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልዋኖስ ፡ ጋራ ፡ ጥቂት ፡ እንዳሰብሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥቂት ፡ ጻፍሁላችሁ ፡ ጥቂት ፡ አስቦ ፡ ጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቂት ፡ ጽፎላቸዋልና ። አንድም ፡ እንዳሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሁት ፡ ሳይሆን ፡ ጥቂት ፡ ጻፍሁላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ፡ አስቦ ፡ ጥቂት ፡ ጽፎላቸዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ነግ ፡ ሠልስት ፡ ሳልል ፡ እንዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብሁ ፡ ወዲያው ፡ ፈጥኜ ፡ ጻፍሁላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ አስተብቍዐክሙ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖታችሁ ፡ ተስፋችሁ ፡ በእግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ ይሆን ፡ ዘንድ ፡ ወይእዜኒ ፡ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖትክሙ ፡ ወተስፋክሙ ፡ ይኩን ፡ በእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚአብሔር ፡ ብዬ ፡ ስማልድ ፡ ጻፍሁላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእከውን ፡ ስምዐ ፡ ከመ ፡ በአማን ፡ ስብሐቲሁ ፡ ለእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚአብሔር ፡ ዛቲ ፡ እንተ ፡ ባቲ ፡ ትቀውሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህችም ፡ ጸንታችሁባት ፡ ያለች ፡ ሃይማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖት፡ ተስፋ፡ የባሕርይ ፡ ክብሩን፡ እንድታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣላችሁ፡ ስመሰክር፡ ጻፍሁላችሁ። ወትነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥኡ ፡ በፍጻሜሃ ፡ ለሃይማኖትክሙ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኀኒተ ፡ ነፍስክሙ ፡ ተሰፈውዋ ፡ ለእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ፡ ትመጽእ ፡ ለክሙ ፡ ትፍሥሕት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዬ ። አንድም ፡ ስለ ፡ ሃይማኖታችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈተና፡ ጥቂት፡ መከራ ፡ ትቀበሉ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወባሕቱ ፡ ኅዳጠ ፡ ሀለወክሙ ፡ ትተክዙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ፡ መከራሃ ፡ ለሃይማኖትክሙ ፡ ትእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥተ ፡ ትገብር ፡ ለክሙ ፡ ብዬ ፡ ስማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልድ ፡ ጻፍሁላችሁ ፡ ይህች ፡ ጸንታችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላችሁባት ፡ መከራ ፡ የባሕርይ ፡ ክብሩን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንድታመጣላችሁ ፡ ስመሰክር ፡ ይትባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረክ ፡ እግዚአብሔር ፡ ዘወለደነ ፡ በብዝኀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሕረቱ፡ ወትትረከቡ ፡ ሀለወክሙ ፡ በክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብር ፡ ወበውዳሴ ፡ ወበስብሐት ፡ ብዬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ፈቃደ ፡ ሥጋችሁን ፡ በፈቃደ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ፡ ታርቁ ፡ ዘንድ ፡ ኦ ፡ አኅውየ ፡ ፍቁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራን ፡ እስእለክሙ ፡ ታርሕቅዋ ፡ ለፍት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወተ ፡ ሥጋክሙ ፡ ብዬ ፡ ስማልድ ፡ ጻፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁላችሁ ፡ ይህች ፡ ጸንታችሁባት ፡ ያለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃደ ፡ ነፍስ ፡ የባሕርይ ፡ ክብሩን ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድታመጣላችሁ ፡ ስመሰክር ፡ እስመ፡ ጸጋ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ትትወሀብ ፡ ለዘበእንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሠናይ ፡ ምግባሩ ፡ ይትዔገሣ ፡ ለኀዘን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዬ ፡ ስመሰክር ። አንድም ፡ ክርስቶስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራውን ፡ ታግሦ ፡ እንደ ፡ ተቀበለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራውን ፡ ታግሣችሁ ፡ ትቀበሉ ፡ ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስማልድ ፡ ጻፍሁላችሁ ፡ ወእመሰ ፡ ክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቶስ ፡ ተሰቅለ ፡ በሥጋሁ ፡ በእንቲአነ ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንትሙኒ፡ ተወልተዉ ፡ በይእቲ ፡ ሕሊና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢታንክርዋ ፡ ለእንተ ፡ ትመጽእክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራ ፡ ከመ ፡ ዘነኪር ፡ ብዬ ፡ ይህች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸንታችሁባት ፡ ያለች ፡ ትዕግሥት ፡ የባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕርይ ፡ ክብሩን ፡ እንድታመጣላችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመሰክር ፡ ወእመሰ ፡ ቦ ፡ ዘተዐየሩክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ፡ ስሙ ፡ ለክርስቶስ ፡ ብፁዓን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንትሙ ፡ እስመ ፡ ስብሐቲሁ ፡ ወኀይሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወመንፈሱ ፡ ቅዱስ ፡ የአርፍ ፡ ላዕሌክሙ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዬ ፡ አንድም ፡ ቀሳውስት ፡ ምእመናንን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠብቁ ፡ ዘንድ ፡ ዲያቆናት ፡ ምእመናን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
