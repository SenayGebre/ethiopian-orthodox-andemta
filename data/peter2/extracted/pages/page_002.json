          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዕለቱሰ ፡ ለእግዚአብሔር ፡ በል፡ ፫ ፡ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "chapter_title",
