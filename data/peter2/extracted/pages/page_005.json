  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀሉን ፡ ተሸክሞ ፡ በአንቀጸ ፡ ሮም ፡ ታየው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተ ፡ ጌታዬ ፡ ኢየሱስ ፡ ክርስቶስ ፡ አይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደለህምን ፡ አለው ፡ እዎን ፡ አለው ፤ በከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ ፡ ተሰቀልከ ፡ ቅድመ ፡ በኢየሩሳሌም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳግመኑ፡ትሰቀል፡በሮም፡አለው፡አንተም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈራህ ፡ ምን ፡ ላድርግ፡አለው፡ተሰቀል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጅ ፡ ሲለኝ ፡ ነው ፡ ብሎ ፡ ተመልሶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብቶ ፡ (ወአስተብቍዖሙ ፡ ከመ ፡ ይስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅልዎ፡ቍልቍሊተ፡ይላል)፡እንደ፡ጌታዬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሽቅብ ፡ አትስቀሉኝ ፡ ዘቅዝቃችሁ ፡ ስቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉኝ ፡ ብሎ ፡ ተሰቅሎ ፡ ሙቷልና ፡ በከመ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይድዐኒ ፡ እግዚእየ ፡ ኢየሱስ ፡ ክርስቶስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ዮሐ ፡ ፳፩ ፥ ፲፰-፲፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪፲፭ ፤ ወዓዲ ፡ ጐጕኡ ፡ ከመ ፡ ተሀሉ ፡ ኀቤክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛቲ ፡ ትእዛዝ ፡ ዘልፈ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህች፡ትእዛዝ ፡ ሁል ፡ ጊዜ ፡ በናንተ ፡ ጸን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታ፡ትኖር ፡ዘንድ ፡ አለ ፡ ሠራዒ ፡ መጋቢ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንሣኤ ፡ ሙታን ፡ ኅልፈተ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወምድር ፡ አለ ፡ ትሉ ፡ ዘንድ ፡ ለምግባር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለትሩፋት ፡ ቸኩሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመ ፡ ትዝክርዋ ፡ እምድኅረ ፡ ኅልፈትየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሞትሁም ፡ በኋላ ፡ ታስብዋት ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከማሁ ፡ ትግበሩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ ፡ ስለ ፡ አልኋችሁም ፡ ትሠሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ አስቦ ፡ መቅረት ፡ አይረባምና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትግበሩ ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪፲፮ ፤ እስመ ፡ ኢኮነ ፡ መኃደምተ ፡ ጥበብ ፡ ዘተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተረት ፡ ኦሪትን ፡ የምናስተምር ፡ አይደለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንምና ። አንድም ፡ የምናስተምረው ፡ ተረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ኦሪት ፡ አይደለምና ። ሐተታ ፡ ተረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ አላት ፡ ኦሪትን ፡ ተረት ፡ የራት ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆያ ፡ እንደ ፡ ሆነ ፡ ኦሪትም ፡ የወንጌል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቆያ ፡ ሆና ፡ ተሠርታለችና ፡ ጥበብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላት ፡ ከተርታው ፡ ነገር ፡ ሲለይ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአምርናክሙ ፡ ቦቱ ፡ ኀይሎ ፡ ለእግዚእነ ፡ ኢየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሱስ ፡ ክርስቶስ ፡ ወምጽአቶ ፡ ወህልዎቶ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ህልዎቶ) ፡ ጌታችን ፡ ኢየሱስ ፡ ክርስቶስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድመ ፡ ዓለም ፡ መኖሩን ፡ (ኀይሎ) ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጻኤ ፡ ዓለማትነቱን ፡ (ምጽአቶ) ፡ በሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋ ፡ መምጣቱን ፡ በኦሪት ፡ የነገርናችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለምና ፡ ኢተሎነ ፡ ላለው። አንድም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ምጽአቶ) ፡ በሥጋ፡ መምጣቱን፡(ኀይሎ)፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኅቱም ፡ ድንግልና ፡ መወለዱን ፡ በኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱም ፡ ድንግልና ፡ መፅነሱን ፡ (ህልዎቶ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ፡ዓለም፡ሠላሳ፡ሦስት፡ዓመት፡ከሦስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት፡ ወር፡ መኖሩን። አንድም፡ (ምጽአቶ)፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ ዓለም ፡ ለማሳለፍ ፡ መምጣቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ኀይሎ) ፡ ይህን ፡ ዓለም ፡ ማሳለፉን ፡ (ህል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎቶ) ፡ ይህን ፡ ዓለም ፡ አሳልፎ ፡ መኖሩን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኦሪት ፡ የነገርናችሁ ፡ ያስተማርናችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለምና ። ሐተታ ፡ ምነው ፡ በኦሪት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀዳሚ ፡ ገብረ ፡ እግዚአብሔር ፡ ሰማየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወምድረ ፡ ይል ፡ የለምን ፡ ቢሉ ፡ በኦሪት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነን ፡ የነገርናችሁ ፡ አይደለምና ፡ ሲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። አንድም ፡ ከመዝ ፡ ይቤ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ እንደሚሉ ፡ እንደ ፡ ዓበይተ ፡ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢያት ፡ የነገርናችሁ ፡ አይደለምና ፡ እኛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዘመኑ ፡ ደርሰን ፡ መልኩን ፡ አይተን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብረን ፡ ወጥተን ፡ ወርደን ፡ ነገርናችሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
