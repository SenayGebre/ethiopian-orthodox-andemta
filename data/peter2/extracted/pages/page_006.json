        },
        {
          "line_num": 20,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪፳ ፤ ወዘንተ ፡ ባሕቱ ፡ ቅድመ ፡ አእምሮ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
