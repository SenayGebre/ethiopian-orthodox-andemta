        {
          "line_num": 6,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወይትከሐዱ ፡ በቃለ ፡ ዘለሊሆሙ ፡ ፈጠሩ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከራሳቸው ፡ አንቅተው ፡ በተናገሩት ፡ ይከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራከራሉ ፡ መከራከርማ ፡ እንዳይከራከሩን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቦቱ ፡ የሐውሩ ፥⟫",
          "word_wraps_to_next_line": false
        },
