          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ ከዚያ ፡ ወንዝ ፡ ደርሰን ፡ ከብታች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ አራግፈን ፡ ዳቧችንን ፡ ጐርሰን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውኃችንን ፡ ጠጥተን ፡ ከጥላው ፡ አርፈን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንሄዳለን ፡ ብለው ፡ ይሄዳሉ ፡ ሂደው ፡",
          "word_wraps_to_next_line": false
