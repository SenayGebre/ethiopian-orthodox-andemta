          },
          "uncertain": []
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ንጽፍት) ፡ ተርታ፡ ደቀ ፡ መዝሙር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላሽ ፡ የሚያሳጣቸው ፡ (ወጊሜ ፡ ዘነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋስ) ፡ ጥቂት ፡ ኀይለ ፡ ቃል ፡ የሚረታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ እሊህ ፡ ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ለደይነ ፡ ጽልመት ፡ የዐቅብዎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍትሑ ፡ ርቱዕ ፡ ሥላሴ ፡ ለማያልፍ ፡ ጽኑ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
