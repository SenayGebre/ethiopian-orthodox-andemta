          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥቂት ፡ ቀን ፡ ከኦሪት ፡ ወጥተው ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
