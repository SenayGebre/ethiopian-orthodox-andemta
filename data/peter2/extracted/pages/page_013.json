      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኂኖ ፡ አድኀኖሙ ፡ አኮ ፡ ዘድኅነ ፡ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲቱ፡ አላ፡ አድኀነ፡ ካልአነ፡ ወይዴመሙ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንተ ፡ መንክር ፡ ዳኅናሁ ፡ ወይመጽእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመድኃኒት ፡ ጽኑዕ ፡ ዘእምኀበ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ እንዲል ። የምንወደው ፡ ወንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማችን ፡ ጳውሎስ ፡ የትንሣኤ ፡ ሙታንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ እንደ ፡ ተናገረ ። እስመ ፡ አቅደመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ርእየ ፡ በእንቲአነ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይሠለጡ ፡ ዘእንበሌነ ፡ ብሎ፡ (ጥቅ)፡ ቀደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙነ ፡ በተጋድሎ ፡ ወኢቀደሙነ ፡ በነሢአ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክሊል ፡ ወለኵነኔ ፡ ረሰይከዋ ፡ ከመ ፡ ኅል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀት ፡ እንዲል ። እግዚአብሔር ፡ ጥበቡን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ገለጸለት ፡ የዚህን ፡ የትንሣኤ ፡ ሙታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ ነገር ፡ በተናገረባቸው ፡ በአሥራ ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራቱ ፡ ክታብ ፡ ተጽፎ ፡ እንዳለ ፡ ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የትንሣኤ ፡ ሙታንን ፡ ነገር ፡ ያልተናገረበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ የለምና ፡ በፊልሞና ፡ ስንኳ ፡ ጸጋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሰ ፡ ነበቡ ፡ እሙራን ፡ እሙንቱ ፡ እለ ፡ ይሌብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጳውሎስ ፡ መጻሕፍት ፡ የተናገሩትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ። አንድም ፡ ነበበ ፡ ይላል ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተናገረውን ፡ ነገር ፡ አውቀው ፡ የተረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጐሙ ፡ ሊቃውንት ፡ (እሙራን) ፡ የታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቁ፡ ደጋግ፡ ናቸው፤ ሦስቱ ፡ ጎርጎርዮሳት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለቄርሎስ ፡ እለአትናቴዎስ ፡ እለዮሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስ ፡ አፈ ፡ ወርቅ ፡ ባስልዮስ ፡ ጌርሎስ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ሠራዒ ፡ መጋቢ ፡ ትንሣኤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙታን ፡ ኅልፈተ ፡ ሰማይ ፡ ወምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳለ ፡ አውቀው ፡ የተናገሩ ፡ ነቢያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "የታወቁ ፡ ደጋግ ፡ ናቸው ፤ ሙሴ ፡ ኢዮብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳዊት ፡ ኢሳይያስ ፤ ዕዝራ ፡",
          "word_wraps_to_next_line": false,
          "stage1_text": "ዳዊት ፡ ኢሳይያስ ፤ ሰዝራ ፡",
          "stage2_correction": {
            "pair": "ሰዝራ -> ዕዝራ",
            "reason": "The prophet's name is ዕዝራ (Ezra); the 6th-order ዕ with faded lower curve was misread as ሰ."
          },
          "uncertain": []
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእለሰ ፡ አልቦሙ ፡ ትምህርት ፡ እለ ፡ ኢለበዉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይመይጥዎ ፡ ለቃለ ፡ መጽሐፍ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያልተማሩ ፡ ሰዎች ፡ ግን ፡ የመጽሐፍን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ ይለውጣሉ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ሜጥዎን ፡ ለብዙኃት ፡ መጻሕፍት ፡ ለግዕዞሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለራሳቸው ፡ እንደሚስማማቸው ፡ እንደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚመቻቸው ፡ አድርገው ፡ ብዙዎችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጻሕፍት ፡ እንደ ፡ ለወጡ ፡ ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናሁ ፡ ድንግል ፡ ትፀንስ ፡ ያለውን ፡ ለሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝቅያስ ፡ ሰጠው ፡ እንደ ፡ ተረጐሙ ፡ ድን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግል ፡ የተባለች ፡ ኢየሩሳሌም ፡ ናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድ ፡ የተባልህ ፡ አንተ ፡ ነህ፡ እንዳንተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ፡ ንጉሥ ፡ ነግሦባት ፡ አያውቅምና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ እብን ፡ ዘመነንዋ ፡ ነደቅት ፡ ያለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ለዘሩባቤል ፡ ሰጥተው ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተረጐሙ ፡ (በቁ ፡ ማድረጋቸው ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጅ ፡ ለጊዜው ፡ ምሳሌ ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያማስኑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጻሕፍትን ፡ ይለውጣሉ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ፡ ልቡና ፡ ይለውጣሉ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ይማስኑ) ፡ ራሳቸው ፡ ይጠፋሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪፲፯ ፤ ወአንትሙሰ ፡ አኀዊነ ፡ አቅድሙ ፡ አእምሮ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተስ ፡ ወንድሞቻችን ፡ አስቀድማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችሁ ፡ ይህን ፡ ዕወቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተዐቀቡ ፡ ከመ ፡ ኢትስሐቱ ፡ በዘኢይበቍዕ ፡ ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህርት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በማይረባ ፡ በማይጠቅም ፡ ትምህርት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳትክዱ ፡ ተጠንቀቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ኢትደቁ ፡ እምነ ፡ ምጽናዕክሙ ።⟫",
