          "uncertain": []
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፳፪ ፥ ፮ ፥ ፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ዘኮነ ፡ ስምዐ ፡ በእንተ ፡ ቃለ ፡ እግዚአብሔር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወበእንተ ፡ ስምዑ ፡ ለኢየሱስ ፡ ክርስቶስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሱስ ፡ ክርስቶስ ፡ የመሰከረውን ፡ የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻፈ ፡ እምቅድመ ፡ ይትወለድ ፡ አብርሃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ሀሎኩ ፡ አነ ፡ ብሏል ፡ ብሎ ፤ የኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ፡ ክርስቶስንም ፡ የህልውናውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጌትነቱን ፡ የቅድምናውን ፡ ነገር ፡ የመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰከረ ፡ ቀዳሚሁ ፡ ቃል ፡ ውእቱ ፡ ወው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እቱ ፡ ቃል ፡ ኀበ ፡ እግዚአብሔር ፡ ውእቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወእግዚአብሔር ፡ ውእቱ ፡ ቃል ፡ ብሎ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ (ዘኮነ ፡ ስምዐ) ፡ የወንጌልን ፡ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ፡ የመሰከረ ፡ (ወበእንተ ፡ ስምዑ) ፤ የኢ",
          "word_wraps_to_next_line": true
        },
