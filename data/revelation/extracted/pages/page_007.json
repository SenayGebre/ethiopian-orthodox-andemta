  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኢየሱስ ፡ ክርስቶስ ። ኢየሱስ ፡ ክርስቶስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መከራ ፡ መስቀልን ፡ ታግሦ ፡ ስለ ፡ ተቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በለ ፡ ታግሣችሁ ፡ በምትቀበሉት ፡ መከራ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድማችሁ ፡ የምሆን ፡ ወሱታፌክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንግሥትክሙ ፡ በልጅነትም ፡ ተባባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሪያችሁ ፡ የምሆን ፡ እኔ ፡ ዮሐንስ ፡ እኁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክሙ ፡ በእንተ ፡ ትዕግሥቱ ፡ ለኢየሱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ፡ በመንግሥትክሙ ፡ ወሱታፌክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ፡በሕማምክሙ ፡ በእንተ ፡ ትእግሥቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኢየሱስ ፡ ክርስቶስ ፡ ብለህ ፡ ግጠም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንዘ ፡ ሀሎኩ ፡ ውስተ ፡ ደሴት ፡ እንተ ፡ ስማ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍጥሞ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍጥሞ ፡ በምትባል ፡ ደሴት ፡ ሳለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪በእንተ ፡ ቃለ ፡ እግዚአብሔር ፡ ወበእንተ ፡ ስምዑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኢየሱስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድምናውን ፡ ህልውናውን ፡ ምስክርነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ፡ ስለማስተማር ፡ ፍጥሞ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መካነ ፡ ሣህል ፡ መካነ ፡ ራእይ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። ቀድሞ ፡ ሙሴ ፡ አሮን ፡ አይተውባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታል ፡ ኋላም ፡ እለ ፡ ዳንኤል ፡ እለ ፡ኤርም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ ፡ አይተውባታል ፡ ሮሜ ፡ ፰ ፥ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪መጽአ ፡ ላዕሌየ ፡ መንፈስ ፡ በዕለተ ፡ እሑድ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሑድ ፡ በሚባል ፡ ቀን ፡ መንፈስ ፡ ቅዱስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አደረብኝ ። ሐተታ ፡ ተለይቶት ፡ ያውቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን ፡ ሥራ ፡ አሠራኝ ፡ ሲል ፡ ነው ፤ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሞ ፡ ራእዩን ፡ ያየው ፡ እሑድ ፡ ነው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋላም ፡ የሚፈጸምበት ፡ እሑድ ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዕለተ ፡ እሑድ ፡ አለ ። አንድም ፡ በዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ፡ አሐዱ ፡ ከዕለታት ፡ ባንድ ፡ ቀን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈስ ፡ ቅዱስ ፡ አደረብኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰማዕኩ ፡ ቃለ ፡ ዐቢየ ፡ እምድኅሬየ ፡ ከመ ፡ ቃለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀርን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወደ ፡ ኋላዬ ፡ እንደ ፡ ነጋሪት፡ ያለ፡ ቃል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማሁ ፡ ቀርን ፡ አለ ። ሐተታ ፡ ነጋሪት ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጥኖ ፡ ፈጥኖ ፡ ይመታል ፤ ራእዩም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጥኖ ፡ ፈጥኖ ፡ ይታየዋልና ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነጋሪት ፡ የራቀውን ፡ ያቀርባል ፡ የቀረበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ያርቃል ፤ ራእዩም ፡ የቀረበውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርቆ ፡ የራቀውን ፡ አቅርቦ ፡ ያሳየዋልና።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ነጋሪት ፡ ከዕሩቅ ፡ ይሰማል ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራእዩም ፡ ጽንፍ ፡ እስከ ፡ ጽንፍ ፡ ደርሷል፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስከ ፡ ምጽአት ፡ ሲያይዝ ፡ ሲነገር ፡ ይኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራልና ፡ ከወደ ፡ ኋላዬ ፡ አለ ፡ ከወደ ፡ ኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "የመጣ ፡ ባላጋራ ፡ ጽኑ ፡ ነው ፡ ጽኑ ፡ ራእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ ፡ አየሁ ፡ ሲል ፡ ነው። አንድም፡ ራእዩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚፈጸም፡ ወደኋላ ፡ ነውና ፡ እምድኅሬየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ቍ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወይቤለኒ ፡ ጸሐፍ ፡ እንከ ፡ ዘትሬኢ ፡ ወዘት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰምዕ ፡ ውስተ ፡ መጽሐፍ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምታየውን ፡ የምትሰማውን ፡ በዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፍ ፡ ጻፍ ፡ አለኝ ። ሐተታ ፡ ምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይቷል ፡ ምን ፡ ሰምቷል ፡ ቢሉ ፡ ከወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊቱ፡ ብርሃን፡ አይቷል፡ ከወደኋላው፡ ቃል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰምቷል፡ ውስተ፡ መጽሐፍ ፡ አለ ፡ ያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ ተጽፎ ፡ አይደለም ፡ በኋላ ፡ ስሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፍ ፡ ብሎታል ። አንድም ፡ ውስተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጽሓፍ ፡ ይላል ፡ በብራና ፡ ጻፍ ፡ አለኝ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወፈኑ ፡ ለአብያተ ፡ ክርስቲያናት ፡ ሰብዐቱ ፡ እለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ እስያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽፈህ ፡ በእስያ ፡ በሰባቱ ፡ አሕጉር ፡ ላሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናን ፡ ስደድ ፡ አለኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
