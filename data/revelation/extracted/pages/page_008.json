        {
          "line_num": 1,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪፲፬ ፤ ወጸዐዳ ፡ ርእሱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራስ ፡ ቅሉ ፡ ነጭ ፡ ነው ፡ ጽርየተ ፡ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዩን ፡ መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሥዕርቱ ፡ ከመ ፡ ፀምር ፡ ጸዐዳ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠጉሩም ፡ እንደ ፡ ነጭ ፡ ግምጃ ፡ ነው ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ግም ጃ ፡ ነጭ ፡ ነው ፡ ብሉየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዋዕልነቱን ፡ መናገር ፡ ነው ፤ ወጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕሙ ፡ ጸዐዳ ፡ ከመ ፡ በረድ ፡ ወከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስሐትያ ፡ ይላል ። ኀተምሙ ፡ አብነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያስተረጉምም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአዕይንቲሁ ፡ ከመ ፡ ነደ ፡ እሳት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐይኖቹም ፡ ነደ ፡ እሳት ፡ ይመስላሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳን ፡ ፯ ፡ ፱ ። ም ፡ ፪ ፡ ፲፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪፲፭ ፤ ወእገሪሁ ፡ ከመ ፡ ብርተ ፡ ሊባኖስ ፡ ዘአርሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዎ ፡ በእሳት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግሮቹም ፡ በእሳት ፡ እንደ፡ አፈሉት ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ ፡ ደጋ ፡ ብረት ፡ ናቸው ፡ ትእምርተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀል ፡ ትእምርተ ፡ መዓት ፡ ነው ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ አዕይንቲሁ ፡ ነቢያት ፡ ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዕይንት ፡ አላቸው ፡ ምስጢር ፡ ያያሉና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እገሪሁ ፡ ሐዋርያት ፡ ናቸው ፡ እገሪሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ፡ ሑሩ ፡ ወመሐሩ ፡ ብሏቸዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ አዕይንቲሁ ፡ ቀሳውስት ፡ ናቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ አዕይንት ፡ አላቸው ፡ ምስጢር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያያሉና ፡ እገሪሁ ፡ ዲያቆናት ፡ ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "እገሪሁ ፡ አላቸው ፡ በተልእኮ፡ ይኖራሉ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቃሉ ፡ ከመ ፡ ቃለ ፡ ማይ ፡ ብዙኅ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃሉም ፡ እንደ ፡ መጣያ ፡ ውኃ ፡ ነው ፡ ያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሩቅ ፡ እንዲሰማ ፡ ለመቶ ፡ ሐያ ፡ ቤተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰብእ ፡ ሲያስተምር ፡ ይሰማል ፡ ሲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ እንደ፡ የጕርንድ ፡ ውኃ ፡ ነው ፡ ያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲያስፈራ ፡ የሚያስፈራ ፡ ነው ። ብዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅ፡ ባለው፡ ክቡድ፡ ይላል ፡ ግሩም ፤ ሲል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ም ፡ ፪ ፡ ፲፰ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪፲፮ ፤ ወውስተ ፡ እዴሁ ፡ ዘየማን ፡ ሰብዐቱ ፡ ኮከብ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀኝ ፡ እጁ ፡ ሰባቱ ፡ ከዋክብት ፡ተይዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ። አንድም ፡ በሥልጣኑ ፡ ሰባቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈሳውያን ፡ ከዋክብት ፡ ኤጲስ ፡ ቆጶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳት ፡ ጸንተዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይወፅእ ፡ እምነ ፡ አፉሁ ፡ ሰይፍ ፡ በሊሕ ፡ ዘክልኤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፉሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከአፉም ፡ ሁለት ፡ ልሳን ፡ ያለው ፡ ሰይፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወጣል ፡ አለ ፡ በቃሉ ፡ ንዑና ፡ ሑሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይነገራል ፡ ዘሠለስቱ ፡ አፉሁ ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ በለው ፡ ሰይፍ ፡ ሦስት ፡ ልሳን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው፡ ሰይፍ፡ ከአፉ ፡ ይወጣል፡ አለ ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድነት ፡ ሦስትነት ፡ በቃሉ ፡ ይነገራል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገጹ ፡ ከመ ፡ ፀሐይ ፡ ብሩህ ፡ ዘያስተርኢ ፡ በኀይሉ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊቱም ፡ በቀትር ፡ ጊዜ ፡ በግድ ፡ እንደ ፡",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚታይ ፡ ፀሐይ ፡ ነው ፡ በክበቡ ፡ አብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በብርሃኑ ፡ ወልድ ፡ በሙቀቱ ፡ መንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስ ፡ ይመሰላሉና ፡ አንድም ፡ ገጹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአብ ፡ በገንዘቡ ፡ እንደሚገለጽ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድ ፡ ነው ። አንድም ፡ ገጹ ፡ የወልድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልጁ ፡ እንደሚገለጽ ፡ እንደ ፡ አብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። አንድም ፡ ገጹ ፡ የመንፈስ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገንዘቡ ፡ እንደሚገለጽ ፡ እንደ ፡ ወልድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ቍ ፡ ፳ ። ም ፡ ፪ ፡ ፩ ። ም ፡ ፪ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፪ ። ፲፮ና ፡ ፲፱ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪፲፯ ፤ ወሶበ ፡ ርኢክዎ ፡ ወደቁ ፡ ውስተ ፡ እገሪሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወኮንኩ ፡ ከመ ፡ በድን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
