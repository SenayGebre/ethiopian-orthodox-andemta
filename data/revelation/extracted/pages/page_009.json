          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልነቅፍህም ፡ በሌላው ፡ እነቅፍሃለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
