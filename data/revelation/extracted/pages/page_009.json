          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባቱን ፡ ከዋክብት ፡ በቀኝ ፡ እጁ ፡ ያጸና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሱ።አንድም ፡ ሰባቱን ፡ መንፈሳውያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤጲስ ፡ ቆጶሳት ፡ በሥልጣኑ ፡ ያጸና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘየሐውር ፡ በማእከለ ፡ መኃትው ፡ ዘወርቅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰባቱ ፡ የወርቅ ፡ መቅረዝ ፡ መካከል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሄድ ፡ ፋናም ፡ ቢል ፡ አንድ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ ከዚያ ፡ ይነብር ፡ አለ ፡ ከዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐውር ፡ አለ ፡ እንደምን ፡ ነው ፡ ቢሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃጢአት ፡ ሲሠሩ ፡ ይለያቸዋልና ፡ ከዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐውር፡አለ፡ ጽድቅ፡ሲሠሩ፡ያድርባቸዋል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና፡ከዚያ፡ይነብር፡አለ።አንድም፡የሐውርን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይነብር፡ሲል ፡ ነው። (ጥቅ)፡ ለምንት፡ የሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውር፡ወልደ፡ብእሲት፡ምስለ፡ ብሉየ፡ መዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕል፡ወእለ ፡እምሠጡ፡የሐውሩ፡ባቲ፡እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል፡ወእመ ፡ አኮሰ ፡ እመጽእ ፡ ወአድለቀል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃ፡ለማኅቶትከ፡እምነ፡ መካና፡ ብሎ ፡የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያመጣ ፡ ነውና ፡ እንደ ፡ አርእስት ፡ ዘየ",
          "word_wraps_to_next_line": true
        },
