          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመዝ ፡ ይቤለከ ፡ አኃዜ ፡ ኵሉ ፡⟫",
