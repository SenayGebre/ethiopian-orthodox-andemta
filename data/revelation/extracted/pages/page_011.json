        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውስተ ፡ ውእቱ ፡ መጽሐፍ ፡ ጽሑፍ ፡ ስም ፡ ሐዲስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘአልቦ ፡ ዘየአምሮ ፡ ዘእንበለ ፡ ዘነሥአ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
