      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ዘቦ ፡ እዝን ፡ ሰሚዐ ፡ ለይስማዕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐኬትን ፡ በትጋት ፡ ድል ፡ ቢነሡ ፡ ዋጋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳለ ፡ ድል ፡ ባይነሡ ፡ ዋጋ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌለ ፡ እዝነ ፡ ልቡና ፡ ያለው ፡ ሰው ፡ ያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተውል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ምንተ ፡ ይቤ ፡ መንፈስ ፡ ቅዱስ ፡ ለአብያተ ፡ ክርስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲያናት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላለቃውስ ፡ ይህን ፡ ተናገረ ፡ ለሕዝቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ፡ ተናገረ ፡ ትሉኝ ፡ እንደ ፡ ሆነ ፡ ላለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃው ፡ የተናገረው ፡ ለሕዝቡ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወጸሐፍ ፡ ሎቱ ፡ ለመልአከ ፡ ቤተ ፡ ክርስቲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ዘሎዶቅያ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአከ ፡ ሎዶቅያ ፡ አርክቦስ ፡ ሁለተኛ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙ ፡ ገብጋብኤል ፡ ለሱ ፡ ጻፍለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመዝ ፡ ይቤ ፡ ዘውእቱ ፡ አሜን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሜን ፡ እሱ ፡ እንዲህ ፡ አለ ፡ ብለህ ፡ ጻፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት ፡ አለኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ ሰምዕ ፡ መሃይምን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የታመነ ፡ ምስክር ፡ እሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጻድቅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻድቀ ፡ ባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ እምቅድመ ፡ ኵሉ ፡ ዘፈጠረ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ። አንድም፡ እግዚአብሔርነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ፡ ከፈጠረው ፡ ፍጥረት ፡ ሁሉ ፡ አስቀድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞ ፡ የነበረ፡ እሱ፡ እግዚአብሔር፡ እንዲህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ብለህ ፡ ጻፍለት፡ አለኝ ፡ ም፡ ፩ ፡ ፭።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐ ፡ ፩ ፡ ፫ ። ቆላ ፡ ፩ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪አአምር ፡ ግብረከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድንቁርናህን ፡ አውቃለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ኢኮንከ ፡ ቈሪረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልተማርሁም ፡ ብለህ ፡ እንዳትማር ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢኮንከ ፡ ምውቀ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምሪያለሁ ፡ ብለህ ፡ እንዳታስተምር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውቃለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወርቱዕሰ ፡ ትኩን ፡ ቈሪረ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገባብስ ፡ አልተማርሁም ፡ ብለህ ፡ ልት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማር ፡ ይገባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእመ ፡ አኮ ፡ ምውቀ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውም ፡ ባይሆን ፡ ተምሪያለሁ ፡ ብለህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልታስተምር ፡ ይገባል ፡ ም ፡ ፪ ፡ ፪ ፡ ፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪እስመ ፡ ማእከላይ ፡ አንተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መካከለኛ ፡ ነህና ፡ ከመ ፡ ገጸ ፡ ማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ፡ ማየ ፡ ገጽ ፡ ሲል ፡ ነው ፡ እንደ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፊት ፡ ውኃ ፡ የፊት ፡ ውኃ፡ እጅግ፡ የሞቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ፡ ሆነ፡ ፊት ፡ ይጠብሳል ፡ እጅግም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የበረደ ፡ እንደ ፡ ሆነ ፡ ፊት ፡ ይገበዝዛል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ መካከለኛ ፡ ያደርጉታልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ወትብል ፡ ብዑል ፡ አነ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለጸጋ ፡ ነኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወብዕልኩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከብሪያለሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ፡ ዘእፈቅድ ፡ ምንተኒ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካንተ ፡ ዘንድ ፡ ምንም ፡ ምን ፡ የምሻው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ የለም ፡ ትላለህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለሊከ ፡ ተአምር ፡ ከመ ፡ ነዳይ ፡ ወምስኪን ፡ አንተ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዕሩቅ ፡ ወዕውር ፡ አንተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነዳይ ፡ ምስኪን ፡ ዕሩቅ ፡ ዕውር ፡ እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆንህ ፡ አንተ ፡ ቅሉ ፡ ታውቃለህ፡ ነዳይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስኪን ፡ ዕሩቅ ፡ ዕውር ፡ ብሎ ፡ ሦስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርእስት ፡ ተናግሯል ፡ ለሦስቱም፡ ያመጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ፡ ፩ ፡ ቆሮ ፡ ፫ ፡ ፲፰ና ፡ ፬ ፡ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ወይእዜኒ ፡ እብለከ ፡ ትንሣእ ፡ እምኀቤየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርቀ ፡ ዚአየ ፡ ዘንጡፍ ፡ ወጽሩይ ፡ በእሳት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
