    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገብቼ ፡ እንደኖርሁ ፡ ገብቶ ፡ መኖሩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሰጠዋለሁ ፡ ማቴ ፡ ፲፱ ፡ ፳፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "⟪፳፪ ፤ ዘቦ ፡ እዝን ፡ ሰሚዐ ፡ ለይስማዕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዝነ ፡ ልቡና፡ ያለው ፡ ሰው ፡ ያስተውል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ወእምድኅረ ፡ ዝንቱ ፡ ርኢኩ ፡ ኖኅተ ፡ ርኅተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ ሰማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝ ፡ ሲናገረው ፡ የመጣው ፡ ነው ፡ ከዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ በሰማይ ፡ የተከፈተ ፡ ደጅ ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ አሁን ፡ በሰማይ ፡ መከፈት ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘጋት ፡ ኑሮበት ፡ አይደለም ፡ የተዘጋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደጅ ፡ በተከፈተ ፡ ጊዜ ፡ ያልታየ ፡ ዕቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲታይ ፡ ያልተገለጸ ፡ ምስጢር ፡ ተገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጸልኝ ፡ ሲል ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቀዳማየ ፡ ቃለ ፡ ሰማዕኩ ፡ ከመ ፡ ቃለ ፡ መጥቅዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይትናገር ፡ ምስሌየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ነጋሪት ፡ ለኔ ፡ የሚነግረኝን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዠመሪያውን፡ ቃል ፡ ሰማሁ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀዳማይ ፡ ቃል ፡ ዘሰማዕኩ ፡ ይላል ፡ ወይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤለኒ ፡ ማንሻ ፡ እንደ ፡ ነጋሪት ፡ ለኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲነግረኝ ፡ የሰማሁት ፡ መዠመሪያው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤለኒ ፡ ዕርግ ፡ ዝየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደዚህ ፡ ና ፡ አለኝ ፡ አለ ፡ ከአእምሮ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አእምሮ ፡ ከዕውቀት ፡ ወደ ፡ ዕውቀት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፋለሰኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአነ ፡ አርእየከ ፡ ዘሀለወ ፡ ይኩን ፡ እምድኅረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ይደረግ ፡ ዘንድ ፡ ያለውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሳይሃለሁ ፡ እገልጽልሃለሁና ፡ ወደዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውጣ ፡ አለኝ ፡ ም ፡ ፩ ፡ ፲ ። ወእምዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተመሰጥኩ ፡ በመንፈስ ፡ ይላል ፡ በልቡና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተራቀቅሁ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ምንተ፡ይቤ፡መንፈስ፡ቅዱስ፡ለአብያተ፡ክርስቲያናት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላለቃውስ ፡ ይህን ፡ ተናገረ ፡ ለሕዝቡ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ፡ ተናገረ ፡ ትሉኝ ፡ እንደ ፡ ሆነ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላለቃው ፡ የተናገረው ፡ ለሕዝቡ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ወናሁ ፡ ርኢኩ ፡ መንበር ፡ ውስተ ፡ ሰማይ ፡ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነብር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ በሰማይ ፡ መንበረ ፡ ብርሃን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተዘርግቶ ፡ አየሁ ፡ ሕዝ ፡ ፩ ፡ ፳፮ ። ሕዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲ ፡ ፩ ። ኢሳ ፡ ፮ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪፫ ፤ ወዘዲቤሁ ፡ ይነብር ፡ ይመስል ፡ ኅብሩ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕንቈ ፡ ኢያሰጲድ ፡ ወሰርዲኖ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩም ፡ ላይ ፡ ተቀምጦ ፡ ያለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅብሩ ፡ ኢያሰጲድ ፡ ሰርዲኖ ፡ የሚባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕንቍን ፡ ይመስላል ፡ አለ ፡ ጽርየተ ፡ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዩን ፡ መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወካህናት ፡ እለ ፡ ዐውዱ ፡ ለውእቱ ፡ መንበር ፡ ይመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስል ፡ ኅብሮሙ ፡ ከመ ፡ መረግድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩም ፡ ዙሪያ ፡ ቁመው ፡ ያሉ ፡ ካህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡ ኅብራቸው ፡ መረግድ ፡ የሚባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕንቍን ፡ ይመስላል ፡ አለ ፡ እንበለ ፡ ዘርዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "መገኘታቸውን ፡ መናገር ፡ ነው ፡ (ወብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃን ፡ የዐውዶ ፡ ለውእቱ ፡ መንበር ፡ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላል) ፡ በብርሃን ፡ ተከቦ ፡ ያየዋል ። ኀተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞሙ ፡ አብነት ፡ አያስተረጕምም ፡ ሕዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ፳፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪፬ ፤ ወበዐውዱ ፡ ለውእቱ ፡ መንበር ፡ ዕሥራ ፡ ወአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርባዕቱ ፡ መናብርት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩ ፡ ዙሪያ ፡ ኻያ ፡ አራት ፡ መና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርት ፡ ተዘርግተዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዲበ ፡ ውእቶን ፡ መናብርት ፡ ይነብሩ ፡ ዕሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአርባዕቱ ፡ ሊቃናት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኻያ ፡ አራቱም ፡ መናብርት ፡ ላይ ፡ ኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራት ፡ መላእክት ፡ ተቀምጠዋል ። አን",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ በመንበሩ ፡ ዙሪያ ፡ ኻያ ፡ አራት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መላእክት ፡ ቁመዋል ፡ ሠራዊትም ፡ ቢል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ፡ ነው ፡ ሐተታ ፡ በኻያ ፡ አራቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜያት ፡ ጸልየው ፡ ራሳቸውን ፡ ጠብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ፡ ዋጋቸውን ፡ ተቀብለው ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖሩ ፡ ስለ ፡ ሆነ ፡ ኻያ ፡ አራት ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኻያ ፡ አራቱም ፡ መላእክት ፡ ላይ ፡ ኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራት ፡ ሊቃናት ፡ ተሹመዋል ፡ በኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራቱ ፡ ጊዜያት ፡ ጸልየው ፡ ሌላውንም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሳቸውንም ፡ ጠብቀው ፡ ዋጋቸውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተቀብለው ፡ የሚኖሩ ፡ ስለ ፡ ሆነ ፡ ኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራት ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይለብሱ ፡ ጸዓድወ ፡ አልባሰ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሩህ ፡ ብሩህ ፡ ልብስ ፡ ለብሰዋል ፡ ጸጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸውን ፡ መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዲበ ፡ አርእስቲሆሙ ፡ አክሊላት ፡ ዘወርቅ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በራሳቸውም ፡ ላይ ፡ አክሊል ፡ ደፍተዋል ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክብራቸውን ፡ መናገር ፡ ነው ፡ ኢሳ ፡ ፳፬ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፫ ። ም ፡ ፫ ፡ ፬ ፡ ና ፡ ፭ ፡ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪፭ ፤ ወእምነ ፡ ውእቱ ፡ መንበር ፡ ይወፅእ ፡ መብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረቅ ፡ ወፀዓዕ ፡ ወነጐድጓድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመንበሩም ፡ መብረቅ ፡ ፃዕ ፡ ነጐድጓድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይወጣል ፡ ሐተታ ፡ ፃዕ ፡ ብልጭታው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "መብረቅ ፡ አሰይፎ ፡ የሚወርደው ፡ ነጐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድጓድ ፡ ሲጥል ፡ የሚሰማው ፡ መቅሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍተ ፡ ኃጥአን ፡ ይታዘዛል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወናሁ ፡ ርኢኩ) ፡ በጌትነት ፡ ያለ ፡ ትስብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እትን ፡ በልዕልና ፡ አየሁት ። (ጥቅ) ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በረሰ ፡ ሶበ ፡ ሰማዕከ ፡ ለብዎ ፡ ለመንበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድልወተ ፡ መለኮት ፡ ዘውእቱ ፡ እግዚእና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሥልጣን ፡ እንዲል ። (ወዘዲቤሁ) ፡ ትስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብእትን ፡ የተወሐደ ፡ እሱ ፡ ሰርዲኖ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢያሰጲድ ፡ የሚባል ፡ ዕንቍን ፡ ይመስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላል ፡ እንበለ ፡ ዘርዕ ፡ መገኘቱን ፡ መናገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ (ወካህናት) ፡ በትስብእት ፡ ያመኑ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድራውያን ፡ ካህናትም ፡ ኅብራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መረግድ ፡ የሚባል ፡ ዕንቍን ፡ ይመስላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ንጽሕናቸውን ፡ መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወበዐውዱ ፡ ለውእቱ) ፡ በትስብእት ፡ ኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራት ፡ ምእመናን ፡ አምነዋል ፡ በኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራቱ ፡ ጊዜያት ፡ ጸልየው ፡ ራሳቸውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠብቀው ፡ ዋጋቸውን ፡ ተቀብለው ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖሩ ፡ ስለ ፡ ሆነ ፡ በኻያ ፡ አራቱም ፡ ምእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናን ፡ ላይ ፡ ኻያ ፡ አራት ፡ መምህራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሹመዋል ፡ በኻያ ፡ አራቱ ፡ ጊዜያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸልየው ፡ ራሳቸውን ፡ ሌላውንም ፡ ጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብቀው ፡ ዋጋቸውን ፡ ተቀብለው ፡ የሚኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩ ፡ ስለ ፡ ሆነ ፡ (ወይለብሱ) ፡ ጸጋቸውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወዲበ ፡ አርእስቲሆሙ) ፡ ክብራቸውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናገር ፡ ነው ። (ወእምነ ፡ ውእቱ) ፡ ከት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስብእት ፡ ስመ ፡ ሥላሴ ፡ ይነገራል ፡ (በት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስብእት ፡ አንድነት ፡ ሦስትነት ፡ ይታወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ ቢል ፡ አንድ ፡ ነው) ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወቅድሜሁ ፡ ለውእቱ ፡ መንበር ፡ የኅትዉ ፡ ሰብዐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "መኃትው ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩ ፡ ፊት ፡ ሰባት ፡ ፋና ፡ ይበራሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተቅዋመ ፡ ወርቅ ፡ ባሉ ፡ በሰባቱ ፡ አዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፁቅ ፡ አምሳል ፡ ያሳየዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘውእቱ ፡ መንፈስ ፡ ቅዱስ ፡ ዘእግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
