        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣው ፡ እንደ ፡ ጌታ ፡ ጌታ ፡ በፊትም ፡ በኋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላም ፡ አይሄድም ፡ ሰውም ፡ የሊህ ፡ ሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገዢቸው ፡ ነውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወራብዑ ፡ ይመስል ፡ ከመ ፡ ንስር ፡ ዘይሠርር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራተኛውም ፡ ንስር ፡ ይመስላል ፡ ለአዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋፍ ፡ ጸልዮ ፡ አዕዋፍን ፡ ጠብቆ ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖር ፡ ስለ ፡ ሆነ ፡ ሕዝ ፡ ፩ ፡ ፲ ፡ ፲ና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪፰ ፤ ወለእሉ ፡ አርባዕቱ ፡ እንስሳሁ ፡ ለለአሐዱ ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዱ ፡ እምኔሆሙ ፡ በበስድስቱ ፡ ክነፈሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአራቱም ፡ ኪሩቤል ፡ እያንዳንዳቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስድስት ፡ ክንፍ ፡ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእንተ ፡ ኵለንታሆሙ ፡ ምሉዐን ፡ እሙንቱ ፡ አዕ",
