        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "የግራውን ፡ አልተናገረም ፡ ነበረና ፡ እንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵለንታሆሙ ፡ ለማለት ፡ ደገመው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ መጻእያትን ፡ ኀላፍያትን ፡ ያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃሉ ፡ (የወዲያና ፡ የወዲሁን ፡ ቢል ፡",
          "word_wraps_to_next_line": false
        },
