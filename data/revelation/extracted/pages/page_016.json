          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስ ፡ ቅዱስ ፡ ቅዱስ ፡ እያሉ ፡ ሲያመ",
          "word_wraps_to_next_line": true
        },
