      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርእየተ ፡ እለ ፡ ቄጥሩ ፡ ዘውእቱ ፡ ዖፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይነብር ፡ በሀገረ ፡ ፋርስ ፡ እንዲል ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ወእምገበዋቲሁ)፡ በትስብእት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሉ ፡ ባራቱ ፡ ባሕርያት ፡ አራት ፡ ግብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራት፡ አሉ፡ (ወምሉዐን) ፡ በዘመነ፡ ብሉይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቢያትን ፡ በዘመነ ፡ ሐዲስ ፡ ሐዋርያትን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሾማሉ ፡ (ወቀዳማዊ) ፡ አንበሳ ፡ ተን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥአ ፡ እምገዳም ፡ ያለውን ፡ መናገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ (ወካልኡ) ፡ ወፅአ ፡ ሦር ፡ ጸዓዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለውን፡ መናገር፡ ነው ፡ (ወሣልሱ) ፡ ወብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሲ፡ በውስተ፡ ሰብእ ፡ ያለውን፡ መናገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። (ወራብዑ) ፡ ዖፍ ፡ ንኡስ ፡ ሠረረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለውን ፡ መናገር ፡ ነው ፡ (ወለእሉ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራቱ ፡ ባሕርያት ፡ ለያንዳንዳቸው ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ፡ አንድ ፡ ኅብረ ፡ መልክዕ ፡ ባላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባራቱ ፡ ኪሩቤል ፡ ላይ ፡ ሁነው ፡ በኻያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራቱ ፡ ካህናተ ፡ ሰማይ ፡ ቃል ፡ ይመሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገናሉ ። ወእንተ ፡ ኵለንታሆሙ ፡ ከሐዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያት ፡ በኋላ ፡ እስከ ፡ ምጽአት ፡ የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሡ ፡ መምህራንን ፡ ይሾማሉ ፡ የምሳሌ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሳሌ ፡ ያሳየዋል ፡ ባራቱ ፡ ኪሩቤል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላይ ፡ ሠረገላ ፡ መንበርን ፡ በሠረገላ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በር ፡ ላይ ፡ መንበረ ፡ ብርሃን ፡ ተዘርግቶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚያ ፡ ላይ ፡ የብርሃን ፡ ዘውድ ፡ ያያል ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባራቱ ፡ ኅብር ፡ ላይ ፡ ብስጥ ፡ በብስጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላይ ፡ ማሕሰ ፡ መጸጼት ፡ በማሕሰ ፡ መጸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጼት ፡ ላይ ፡ ብርሃን ፡ ሰፍሮ ፡ ይታይ ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ ፡ ነበረ ፡ ምሳሌ ፡ ነው ፡ አራቱ ፡ ኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብር ፡ ያራቱ ፡ ባሕርያት ፡ ብስጥ ፡ የደመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍስ ፡ ማህሰ ፡ መጸጼት ፡ የነባቢት ፡ ነፍስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርሃን ፡ የመለኮት ፡ መለኮት ፡ አራቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርያት ፡ ደመ ፡ ነፍስን ፡ ነባቢት ፡ ነፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስን፡ ለመዋሐዱ ። አንድም ፡ (ወእምገበዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲሁ)፡ከትስብእት፡ አራቱ፡ ወንጌላውያን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሹመዋል ፡ (ወእንተ፡ ኵለንታሆሙ)፡ ኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላፍያትን፡ መጻእያትን ፡ ያውቃሉ ፡ ያስተ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራሉ ፡ (ወቀዳማዊ) ፡ ዘአንበሳ ፡ ማር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆስ ፡ ያለውን ፡ መናገር ፡ ነው፡ (ወካልኡ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘላህም ፡ ሉቃስ ፡ ያለውን፡ መናገር፡ ነው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወሣልሱ) ፡ ዘብእሲ ፡ ማቴዎስ ፡ ያለውን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናገር ፡ ነው ፡ (ወራብዑ) ፡ ዘንስር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ፡ ያለውን ፡ መናገር ፡ ነው ፡ (ወለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሉ) ፡ አራቱ ፡ ወንጌላውያን ፡ ስድስቱን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃላት ፡ ያስተምራሉ ፤ (ወእንተ ፡ ኵለንታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆሙ) ፡ በየጊዜው ፡ የሚሆነውን ፡ ምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢር ፡ ያውቃሉ ፡ ያስተምራሉ ። አንድም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወእምገበዋቲሁ) ፡ ከትስብእት ፡ አራቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊቃነ ፡ ጳጳሳት ፡ ተሹመዋል ። (ወምሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐን) ፡ ኃላፍያትን ፡ መጻእያትን ፡ ያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃሉ ፡ ያስተምራሉ ፡ (ወቀዳማዊ) ፡ በማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቆስ ፡ ወንበር ፡ ተሹሞ ፡ ማስተማሩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናገር ፡ ነው ፡ (ወካልኡ) ፡ በሉቃስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንበር ፡ ተሹሞ ፡ ማስተማሩን ፡ መናገር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ (ወሣልሱ) ፡ በማቴዎስ ፡ ወንበር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሹሞ ፡ ማስተማሩን ፡ መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወራብዑ) ፡ በዮሐንስ ፡ ወንበር ፡ ተሹሞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማስተማሩን ፡ መናገር ፡ ነው ፡ (ወለእሉ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራቱ ፡ ሊቃነ ፡ ጳጳሳት ፡ በሰባተኛዪቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዓርግ ፡ ሁነው ፡ ስድስቱን ፡ መዓርጋት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰጣሉ ፡ (ወእንተ ፡ ኵለንታሆሙ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
