  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጽሞ ፡ ከዘመነ ፡ ሥጋዌ ፡ እስከ ፡ ዘመነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተንባላት ፡ ያለውን ፡ ዘመን ፡ አንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገን ፡ ከዘመነ ፡ ተንባላት ፡ እስከ ፡ ሐሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዌ ፡ መሢሕ ፡ ያለውን ፡ አንድ ፡ ወገን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሐሳዌ ፡ መሢሕ ፡ እስከ ፡ ምጽአት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለውን ፡ አንድ ፡ ወገን ፡ አድርጎ ፡ ያነን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሳዌ ፡ መሢሕ ፡ ዘመን ፡ ልክ ፡ ከሦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስት ፡ ከፍሎ ፡ አንድ ፡ አንዱን ፡ በሰባት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈቅ ፡ እየቀመረ ፡ ያሳየዋል ፡ እንዲህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ፡ ስለ ፡ ሆነ ፡ የፊቱን ፡ ወደ ፡ ኋላ ፡ የኋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላውን ፡ ወደ ፡ ፊት ፡ ያደርጋል ፡ ያቀዳድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማል ። አንድም ፡ ሁሉም ፡ በሁሉ ፡ እየ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባ ፡ ይተረጐማል ። አንድም ፡ ⟪መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍ ፡ ጽሕፍት⟫ ፡ ምስጢረ ፡ ዘመን ፡ (⟪እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ ውሥጣ⟫) ፡ ያልተገለጸለት ፡ (⟪እንተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍአሃ⟫) ፡ የተገለጸለት ፡ ያልተገለጸለትስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የለም፡ ብሎ፡ (⟪እንተ ፡ ውስጣ⟫) ፡ ከሱ ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀድሞ፡ (⟪ወእንተ ፡ አፍአሃ⟫)፡ በእሱ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእሱ ፡ በኋላ ፡ የሚሆነው ፡ (⟪ወኅትምት⟫) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፍጹም ፡ ሥዋሬ ፡ ተሠውራ ፡ ያለች ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ (⟪መጽሐፍ ፡ ጽሕፍት⟫) ፡ ምሥጢረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ፡ (⟪እንተ ፡ ውሥጣ⟫) ፡ የሚታየው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "(⟪ወእንተ ፡ አፍአሃ⟫) ፡ የማይታየው ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ (⟪እንተ ፡ ውስጣ⟫) ፡ ከሰማይ፡ በላይ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከምድር፡በታች ፡ ያለው ፡ (⟪ወእንተ ፡ አፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሃ⟫) ፡ ከሰማይ፡ በታች ፡ ከምድር ፡ በላይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ፡ (⟪ወኅትምት⟫) ፡ በፍጹም ፡ መናሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግተ ፡ ጥበቡ ፡ ተሠውራ ፡ ያለች ። አንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ⟪ወኅትምት⟫ ፡ በሰባት ፡ ክፍል ፡ የተወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰነች፡(ጥቅ)፡ ወኅተምኪ፡በሰብዐቱ፡ማኅተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም፡ እንዲል፡ (ዘሕልው ፥ ላለው፡ አመጣ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ ብቻ፡ መጻእያትን፡ አያሳየውም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃላፍያትንም፡ ያሳየዋል፡ ብሎ፡ ⟪መጽሐፍ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሕፍት⟫ ፡ አዳም ፡ ⟪እንተ ፡ ውሥጣ⟫) ፡ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍሱ ፡ (⟪ወእንተ ፡ አፍአሃ⟫) ፡ ሥጋው ፡ ⟪ወኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምት⟫ ፡ በሰባት ፡ ሀብታት ፡ የከበረ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሚን ፡ ኵነኔ ፡ ንጽሕና ፡ ኀይል ፡ መንግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥት ፡ ክህነት ፡ ትንቢት ። አንድም ፡ (⟪መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሐፍ ፡ ጽሕፍት⟫) ፡ እመቤታችን ፡ (⟪እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ ውስጣ⟫) ፡ ነፍሷ ፡ (⟪ወእንተ ፡ አፍአሃ⟫) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋዋ ፡ (⟪ወኅትምት⟫ ፡ )በፍጹም ፡ ክብር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የከበረች ፡ (ጥቅ) ፡ እስመ ፡ ኍልቍ ፡ ሰብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐቱ ፡ በኀበ ፡ ዕብራውያን ፡ ፍጹም ፡ ውእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ፡ እንዲል ። አንድም ፡ (⟪መጽሐፍ ፡ ጽሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍት⟫) ፡ ጌታ ፡ ⟪እንተ ፡ ውስጣ⟫ ፡ ነፍሱ ፡ ⟪ወእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ፡ አፍአሃ⟫ ፡ ሥጋው ። አንድም ፡ (⟪እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ፡ ውስጣ⟫ ፡ መለኮት ፡ (⟪ወእንተ ፡ አፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሃ⟫) ፡ ትስብእት ፡ ⟪ወኅትምት⟫፡ ኢሳይያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተናገረለት፡ ሰባቱን፡ ሀብታት ፡ መስጠት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን፡ በተዋህዶ፡ ገንዘብ ፡ ያደረገ ፡ መንፈሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለብዎ ፡ መንፈሰ ፡ አእምሮ ፡ መንፈሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥበብ ፡ መንፈሰ ፡ ምክር ፡ መንፈሰ ፡ ኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይል ፡ መንፈሰ ፡ ረድኤት ፡ መንፈሰ ፡ ፈሪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃ ፡ እግዚአብሔር ፡ ም ፡ ፬ ፥ ፪ ። ሕዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ ፥ ፱ ፥ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ወርኢኩ፡መልአከ፡ዐቢየ፡ይጸርሕ፡ወይብል፡በቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል፡ዐቢይ፡ለመኑ፡ይደልዎ፡ይክሥታ፡ለዛቲ፡መጽሐፍ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሩም ፡ መልአክ ፡ በታላቅ ፡ ቃል ፡ አሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምቶ ፡ ሲናገር ፡ ሰማሁ ፡ ምስጢረ ፡ ምጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
