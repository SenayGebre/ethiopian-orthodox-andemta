  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ አዕይንት ፡ ቀሳውስት ፡ አቅር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንት ፡ ዲያቆናት ፡ ናቸው ፡ አቅርንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ፡ በተልእኮ ፡ ይኖራሉና ፡ እስመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘተወልደ ፡ እመንፈስ ፡ መንፈስ ፡ ውእቱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላቸዋልና ፡ ኢሳ ፡ ፶፫ ፡ ፯ ። ዮሐ ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፱ ። ዘካ ፡ ፬ ፡ ፭ ፡ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወመጽአ ፡ ወተመጠዋ ፡ እምነ ፡ የማኑ ፡ ለዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክቱ ፡ ዘይነብር ፡ ዲበ ፡ መንበር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩ ፡ ላይ ፡ ተቀምጦ ፡ ካለ ፡ ከእሱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በጌትነት ፡ ካለ ፡ ከእሱ ፡ ከቀኝ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጁ ፡ ተቀበላት ፡ ምስጢረ ፡ ምጽአትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አወቃት ፡ መረመራት ፡ ገንዘብ ፡ አደረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወሶበ ፡ ተመጠዋ ፡ ለይእቲ ፡ መጽሐፍ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያችን ፡ መጽሐፍ ፡ በተቀበላት ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስጢረ ፡ ምጽአትን ፡ ባወቃት ፡ በመረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መራት ፡ ገንዘብ ፡ ባደረጋት ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሰገዱ ፡ ሎቱ ፡ ቅድሜሁ ፡ ለውእቱ ፡ በግዕ ፡ እልክቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕሥራ ፡ ወአርባዕቱ ፡ ሊቃናት ፡ ወእልክቱ ፡ አርባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕቱ ፡ እንስሳሁ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኻያ ፡ አራቱ ፡ ሊቃናት ፡ አራቱ ፡ ኪሩቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልም ፡ ሰገዱለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያጸንዑ ፡ ኵሎሙ ፡ ጽዋዓተ ፡ ወርቅ ፡ ዘምሉእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕጣነ ፡ ወመሰንቆ ፡ መዝሙር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽዋዕ ፡ መሰንቆ ፡ አንድ ፡ ወገን ፡ ዕጣን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዝሙር ፡ አንድ ፡ ወገን ፡ ጽሩይ ፡ ምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋና ፡ የሚያመሰግኑበትን ፡ አንደበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተፈጥሮ ፡ ገንዘብ ፡ አድርገዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዝ ፡ ውእቱ ፡ ጸሎቶሙ ፡ ለቅዱሳን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኸውም ፡ ቅዱሳን ፡ የሚያመሰግኑት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስጋና ፡ ነው ፡ ም ፡ ፲፬ ፡ ፻ና ፡ ፲፭ ፡ ፻ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፰ ፡ ፫ ፡ ፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወይዜምሩ ፡ በመዝሙር ፡ ሐዲስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንግዳ፡ ምስጋና፡ ያመሰግናሉ፡ አምላክ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ሆነ፡ ሰው፡ አምላክ፡ ሆነ ፡ እያሉ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይብሉ ፡ ይደልወከ ፡ ትንሥአ ፡ ለዛቲ ፡ መጽሐፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወትፍታሕ ፡ ማኅተሚሃ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህችን ፡ መጽሐፍ ፡ ልትገልጻት ፡ ቍል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፏን ፡ ልትፈታት ፡ ይገባሃል ፡ እያሉ ፡ አለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስጢረ ፡ ምጽአትን ፡ ልታውቃት ፡ ልት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መረምራት ፡ ገንዘብ ፡ ልታደርጋት ፡ ይቻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልሃል ፡ እያሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ተቀተልከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መሥዋዕት ፡ ሆነሃልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተሣየጥከ ፡ በደምከ ፡ ለእግዚአብሔር ፡ እምነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ ሕዝብ ፡ ወአሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሕዝብም ፡ ከአሕዛብም ፡ ወገን ፡ የእግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ማደሪያ ፡ ለመሆን ፡ ለማድረግ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወርቀ ፡ ደምህ ፡ ዋጅተሃልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነገድ ፡ ወበሐውርት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝብ ፡ ያለውን ፡ ነገድ ፡ አሕዛብ ፡ ያለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ በሐውርት ፡ ብሎ ፡ ደገመው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወረሰይከ ፡ እምኔሆሙ ፡ ለመንግሥተ ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ካህናተ ፡ ወነገሥተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኪያሆሙ ፡ ሲል ፡ ነው ፡ እሳቸውን ፡ ካህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናት ፡ ነገሥታት ፡ እያደረግህ፡ ሹመሃልና።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ከሳቸው፡ ወገን፡ ካህናትን፡ ነገሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታትን ፡ መርጠሃልና ፡ ለመንግሥተ ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር፡እግዚአብሔርን፡ ለማገልገል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይምልኩ ፡ ኵሎ ፡ ምድረ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጸጋ ፡ አማልክት ፡ ይባሉ ፡ ዘንድ ፤ ም፡ ፩፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "፯ና ፡ ፳ ፡ ፮ና ፡ ፳፱ ፡ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፩",
          "line_type": "body",
