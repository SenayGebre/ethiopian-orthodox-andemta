          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድል ፡ ሊነሣ ፡ ወጣ ፡ (ወሞዐ) ፡ ድል ፡",
          "word_wraps_to_next_line": false
        },
