        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀተ ፡ ፀሐይ ፡ በአምሳለ ፡ ንጉሥ ፡ ይላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ ወወፅአ ፡ ቍረትን ፡ ሌሊትን ፡",
          "word_wraps_to_next_line": false
        },
