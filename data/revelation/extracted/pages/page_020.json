          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣል ። አንድም ፡ በቀትር ፡ ጊዜ ፡ ፊት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለፊት ፡ ሲያዩት ፡ ዐይን ፡ ይወጋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ከዋክብት ፡ በቀኝ ፡ በግራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፊት ፡ በኋላ ፡ ሁነው ፡ ሰልፍ ፡ ሠርተው፡",
          "word_wraps_to_next_line": false
        },
