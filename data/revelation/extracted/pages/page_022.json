          "text": "ለምን ፡ ይሻዋል ፡ ቢሉ ፡ ለፍጥነት ፡ ባሕ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ፡ ባዜቃን ፡ ለመውጋት ፡ ይህ ፡ ባሕረ ፡",
          "word_wraps_to_next_line": false
