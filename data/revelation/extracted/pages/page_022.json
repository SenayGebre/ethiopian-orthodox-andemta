          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘበልዐ ፡ ሥጋየ ፡ ወሰትየ ፡ ደምየ ፡ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትል ፡ ወንጌልን ፡ አንድ፡ አድርጎ ፡ ማስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማሩን ፡ መናገር ፡ ነው ፡ (ወይንሰ ፡ ወቅ",
          "word_wraps_to_next_line": true
        },
