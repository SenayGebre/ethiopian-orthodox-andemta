          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወሀብዎ ፡ ብዙኀ ፡ ዕጣናተ ፡ ከመ ፡ የሀብ ፡ ለጸሎተ፡⟫",
          "word_wraps_to_next_line": false
