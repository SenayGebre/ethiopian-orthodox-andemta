        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያጸንዕ ፡ ማዕጠንተ ፡ ወርቅ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወርቅ ፡ ጽና ፡ ይዟል ፥ በቄስ ፡ አምሳል ፡",
          "word_wraps_to_next_line": false
