        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይቀውሙ ፡ ቅድመ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኢኩን ፡ ቢያይ ፡ ሰብዐተ ፡ ይቀውሙን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢያይ ፡ ሰብዐቱ ፡ ይላል ፡ ከዚህ፡ በኋላ ፡ ሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
