          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁመው፡አየሁ፡ አለ፡ ባለሟሎች፡ ሆነዋል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወሀብዎሙ ፡ ለእልክቱ ፡ ፯ቱ ፡ መላእክት ፡ ሰብ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዐተ ፡ መጣቅዕተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኒህ ፡ ለሰባቱ ፡ መላእክት ፡ ሰባት ፡ ገን",
          "word_wraps_to_next_line": true,
          "stage1_text": "ለሊህ ፡ ለሰባቱ ፡ መላእክት ፡ ሰባት ፡ ገን",
