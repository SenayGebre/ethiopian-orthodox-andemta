        },
        {
          "line_num": 13,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወመጽአ ፡ ካልእ ፡ መልአክ ፡ ወቆመ ፡ ቅድመ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
