        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታ ፡ ሰባት ፡ ነጋሪት ፡ ሰባት ፡ መለከት ፡",
          "word_wraps_to_next_line": false
        },
