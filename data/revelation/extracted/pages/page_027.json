        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌላ ፡ መልአክ ፡ ከወደ ፡ ምሥራቅ ፡ መ",
          "word_wraps_to_next_line": true
        },
