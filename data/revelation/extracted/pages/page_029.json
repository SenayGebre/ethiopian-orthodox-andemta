        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀሐይ ፡ የእስራኤል ፡ ሊቀ ፡ ካህናቱ ፡ ወር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅ ፡ ንጉሡ ፡ በሚጠት ፡ ፀሐይ ፡ የአሕዛብ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ ወርኅ ፡ ቢትወደዱ ፡ ጠፉ ፡ በፄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋዌ ፡ ኤልያቄም ፡ ኢኮንያን ፡ ሴዴቅያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሴዴቅያስ ፡ ጊዜ ፡ ፍጹም ፡ ፄዋዌ ፡ ተደርጓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ በሚጠት ፡ ናቡከደነጾር ፡ ዮርማሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዴቅ፡ብልጣሶር፡ በብልጣሶር፡ ጊዜ፡ ፍጹም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚጠት፡ተደርጓልና፡ ሣልስተ፡ እዴሃ፡ለፀሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ፡አለ ፡ወሣልስተ፡ እዴሃ፡ ለወርኅ፡ ወሣል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ፡ እዴሆሙ ፡ ለከዋክብት ፡ ከመኳንንቱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም፡ሲሦዎቹ፡ ጠፉ፤እንዳይፈርዱ፡ አለ ፡ የዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቀት፡ሥራ፡እንዳይሠሩ፡ እንዳይገዙ፡ ፀሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ፡ያለውን፡ ዕለት፡ወርኅ፡ ያለውን፡ ሌሊት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ፡ደገመው።አንድም፡በማእከለ፡ዘመን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢመጡ፡ፀሐይ፡ ሊቀ፡ጳጳስ፡ወርኅ ፡ ጳጳስ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ ፀሐይን፡ጳጳስ፡ያሉ፡ እንደ፡ሆነ፡ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኅ፡ ኤጲስ፡ቆጶስ፡ ነው፡ ጠፉ፡በነፍስ፡ ተጎ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ርኅ፡ ኤጺስ፡ቆጶስ፡ ነው፡ ጠፉ፡በነፍስ፡ ተጎ",
          "stage2_correction": {
            "pair": "ጺ -> ጲ",
            "reason": "The printed glyph in ኤጲስ፡ቆጶስ (episkopos/bishop) is ጲ (p'ait), which was misread as ጺ."
          },
          "uncertain": []
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዱ፡ሣልስተ፡እዴሃ፡ላለው፡ ሊቀ፡ጳጳሱ፡ ለኤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጲስ፡ቆጶስ፡ሦስተኛ፡ነውና፡ (ወሣልስተ፡እ",
          "word_wraps_to_next_line": true,
          "stage1_text": "ጺስ፡ቆጶስ፡ሦስተኛ፡ነውና፡ (ወሣልስተ፡እ",
          "stage2_correction": {
            "pair": "ጺ -> ጲ",
            "reason": "The printed glyph in ለኤጲስ፡ቆጶስ is ጲ, misread as ጺ."
          },
          "uncertain": []
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዴሆሙ)ከመምህራኑም፡ ሲሦዎቹ፡ጠፉ፡እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዳያስተምሩ፡(ወሣልስተ፡እዴሆሙ)፡መዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወሶበ ፡ ጠቅዐ ፡ ኃምስ ፡ መልአክ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባምስተኛው ፡ መንፈቅ ፡ አምስተኛው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአክ ፡ ሥራውን፡ ሁሉ ፡ በሠራ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወረደ ፡ ኮከብ ፡ እምሰማይ ፡ ዲበ ፡ ምድር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮከብ ፡ ከሰማይ ፡ ወረደ ፡ አለ ፡ መልአክ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ሥራውን ፡ ሠራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተውህበ ፡ ሎቱ ፡ መራኁተ ፡ አንቅዕተ ፡ ቀላያት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰብድአትን ፡ ከተማ ፡ በር ፡ የሚከፍት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ፡ ቍልፍ ፡ አለ ፡ የሚከፍትበት ፡ ሥል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣን ፡ ተሰጠው ፡ (ታሪክ) ፡ እስክንድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "እየዞረ ፡ ሲወጋ ፡ ከሰብድአት ፡ ከተማ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቱን ፡ ከሦስት፡ ከፍለው፡በአንዱ ፡ እጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተግባረ ፡ እድ ፡ ይይዙበታል ፡ በአንዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጅ ፡ ጊዜያት ፡ ያደርሱበታል ፡ በአንዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "እጅ ፡ ያስተምሩበታል ፡ ተግባረ ፡ እድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሚይዙበት ፡ ጊዜያት ፡ በሚያደርሱበት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀርቶ ፡ በሚያስተምሩበት ፡ ይመጣባቸዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ ሣልስተ ፡ እዴሆሙ ፡ ለዕለት ፡ ወለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሊት ፡ አለ ፤ ም፡ ፮ ፡ ፲፪። ዘፀአ፡ ፲፡ ፳፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወሰማዕኩ ፡ አሐዱ ፡ ንስር ፡ ይሠርር ፡ ማእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከለ ፡ ሰማይ ፡ ወምድር ፡ ወይብል ፡ በዐቢይ ፡ ቃል ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስር ፡ መልአክ ፡ ነው ፡ በኅዋ ፡ እየበረረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ ፡ ሲል ፡ ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አሌ ፡ ሎሙ ፡ አሌ ፡ ሎሙ ፡ ለእለ ፡ ይነብሩ ፡ ዲበ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ እምነ ፡ ዘተርፈ ፡ ቃለ ፡ መጥቅዖሙ ፡ ለሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለስቱ ፡ መላእክት ፡ እለ ፡ ሀለዎሙ ፡ ይጥቅዑ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራቸውን ፡ ይሠሩ ፡ ዘንድ ፡ ያላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስቱ ፡ መላእክት ፡ የሚሠሩት ፡ ሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ኋላ ፡ ከመቅረቱ ፡ የተነሣ ፡ በዚህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ፡ ለሚኖሩ ፡ ሰዎች ፡ ወዮላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዮ፡ ሊሉላቸው፡ይገባል፡ ሲል፡ሰማሁ፡ም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፬፡ ፮ ። ም፡ ፱፡ ፲፪ና፡ ፲፩ ፡ ፲፬ና ፡፲፪፡ ፲፪።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደረሰ ፡ እሊህ ፡ ሰብድአት ፡ ብዙ ፡ ኀብረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልክ ፡ ያላቸው ፡ ደንጊያውን ፡ ብረቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
