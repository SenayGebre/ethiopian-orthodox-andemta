      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳት ፡ ከዕንጨት ፡ ጋራ፡ በተዋሐደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ በግዙፍ ፡ ዕንጨት ፡ ምክንያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከረቂቅ ፡ እሳት ፡ ጢስ ፡ እንዲወጣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪(ወከደኖ)⟫ ፡ መንፈስ ፡ ቅዱስ ፡ ፀበሓይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ በራሱ ፡ ላይ ፡ ተቀመጠ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪(ወኮነ)⟫ ፡ የሀብቱን ፡ ብዛት ፡ መናገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ። አንድም ፡ አብ ፡ በደመና ፡ ዝንቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ ፡ ወልድየ ፡ ብሎ ፡ አሰምቶ ፡ የባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ ፡ ልጅነቱን ፡ እንደ ፡ መሰከረ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስም፡ በርግብ፡ አምሳል፡ ወርዶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በራሱ ፡ ላይ ፡ በመቀመጡ ፡ የባሕርይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጅነቱን ፡ መሰከረ ። አንድም ፡ ⟪(ወሶበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠቅዐ)⟫ ፡ ጌታ ፡ ከእግዚአብሔር ፡ ታዝዞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣ ፡ (ጥቅ) ፡ ወፃእኩ ፡ እምአብ ፡ ወመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻእኩ ፡ አቡየ ፡ ፈነወኒ ፡ ወአነ ፡ ተፈኖኩ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ፡ ⟪(ወረደ)⟫ ፡ በመስቀል ፡ ነፍሱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሥጋው ፡ ለይቶ ፡ በአካለ ፡ ነፍስ ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲኦል ፡ ሄደ፡ ⟪(ወተውህበ ፡ ሎቱ)⟫ ፡ ለሐራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊ ፡ የጌታን ፡ ጎን፡ የሚወጋበት፡ ጦር ፡ ሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልጣን ፡ ተሰጠው ፡ ⟪(ወዐርገ ፡ ጢስ)⟫ ፡ ከጌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታ ፡ ጎን ፡ ትኩስ ፡ ደም ፡ ጥሩ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈሰሰ ፡ ጢስ ፡ ከጕድጓዱ፡ በዝቶ ፡ እንዲወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣ ፡ ⟪(ወከደኖ)⟫ ፡ ፀሐይ ፡ ቃልን ፡ አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰው ። አንድም ፡ ወርዶ ፡ ምድሩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለበሰው ፡ ⟪(ወኮነ ፡ ከመ ፡ ደመና)⟫ ፡ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተ ፡ ደመና ፡ ነው ፡ አራት ፡ ኅብር ፡ አለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ ነጭ ፡ ቀይ ፡ ብጫ ፡ ጥቁር ፡ አራቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርያት፡ እንዳልተለዩበት ፡ ለማጠየቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትኩስ፡ ደም፡ ጥሩ፡ ውኃ፡ ሙቀት፡ ትንታ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላቸው ፡ ሁነው ፡ ፈሰዋልና ፡ ከዚያው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም፡ ነጩና፡ ቀዩ፡ ጎልቶ፡ ይታያል ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ ፡ ፊደል ፡ ሁኖ ፡ ፈሷልና ፡ ⟪(ወእምነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ ፡ ጢስ)⟫ ፡ ከጎኑ ፡ በፈሰሰ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጠምቀው ፡ ምእመናን ፡ ከመንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዱስ ፡ ተወልደው ፡ ከብረው ፡ ታዩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ አንበጣ ፡ አላቸው ፡ ለአንበጣ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክንፍ ፡ አለው ፡ ክንፈ ፡ ጸጋ ፡ አላቸውና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፉጨት ፡ ይጣራል ፡ በስብከት ፡ ይጣራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉና ፡ አንዱ ፡ የወደቀ ፡ እንደ ፡ ሆነ ፡ ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንፍ ፡ ለክንፍ ፡ ተደጋግፎ ፡ ይዞት ፡ ይሄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳል ፡ አንዱ ፡ ቢደክም ፡ አንዱ ፡ ያጸና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ፡ ካንዱ ፡ የቀረውን ፡ አንዱ ፡ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽመዋል ፡ (ጥቅ)፡ ለእመ፡ ወድቀ ፡ አሐዱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሐዱ ፡ ያነሥኦ ፡ እኁኒ ፡ ዘይትራዳእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኁሁ ፡ ከመ ፡ ሀገር ፡ እንተ ፡ ባ ፡ ጥቅም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወፈነዎሙ ፡ በክልኤቱ ፡ እንዲል ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጣ ፡ ከጕድጓዱ ፡ በዝቶ ፡ ይወጣል፡ በዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ ይወጣሉና ፡ በየደረሰበት ፡ ወድቆ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድቆ ፡ ይቀራል ፡ በየደረሱበት ፡ ወድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀው ፡ ወድቀው ፡ ይቀራሉና ፡ ዘአልቦ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ ይለዋል ፡ አልብነ ፡ ንጉሥ ፡ ዘእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንበለ ፡ ኢየሱስ ፡ ክርስቶስ ፡ ይላሉና ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጣ ፡ መጥቆ ፡ ይበራል ፡ ተመስጦ ፡ አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸውና ፡ (ልዕልና ፡ ነፍስም ፡ ቢል ፡ አንድ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው) ፡ ⟪(ወወሀብዎሙ ፡ ይኩኑ)⟫ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዋርያት ፡ ያለ ፡ ሥልጣን ፡ ሰጥዋቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ አቃርብት ፡ አላቸው ፡ ጊንጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአፍዋም ፡ በጅራቷም፡ ትናደፋለች፤ ሐዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርያትም ፡ በወዲሁ ፡ የፈረዱት ፡ በወዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያው፡ አይገሠሥባቸውምና፡ ዘዐሰርክሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በምድር ፡ ይኩን ፡ዕሱረ ፡ በሰማያት ፡ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፈታሕክሙ ፡ በምድር ፡ ይኩን ፡ፍቱሐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማያት ፡ እንዲል ። አንድም ፡ ላዕለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቃርብት፡ ይላል፡ በአጋንንት ፡ ላይ፡ ሥል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣንን፡ ሰጥዋቸው ፡ (ጥቅ) ፡ ወሀብኩክሙ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥልጣነ ፡ ትኪዱ ፡ ላዕለ ፡ አቃርብት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዲበ፡ ኵሉ፡ ኃይለ፡ ጸላኢ፡ እንዲል ፡ ⟪(ወአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘዝዎሙ)⟫፡ ሣዕረ፡ ኦሪትን፡ ወሐመልማለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንጌልን፡ አታጥፉ፡ አሏቸው፡ (ጥቅ) ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጋብእ፡ሣዕረ፡ደብር፡ ወእምካልእሆሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐመልማለ ፡ ዘርዕ ፡ እንዲል ፡ ማስጠበቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸውን ፡ መናገር ፡ ነው ። ⟪(ወኢኵሎ፡ ዕፀ)⟫፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባቱን ፡ ዕፀዋት ፡ አታጥፉ ፡ አሏቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕፀ ፡ ታቦት ፡ ዕፀ ፡ መስቀል ፡ ዕፀ ፡ ዘይት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕፀ ፡ ሜሮን ፡ ዕፀ ፡ ሥርናይ ፡ ዕፀ ፡ ወይን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘጠኙ ፡ ዕፀወ ፡ ዕጣን ፡ አንድ ፡ ወገን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪(ዘእንበለ ፡ እለ ፡ አልቦሙ)⟫ ፡ በገጸ ፡ ልቡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡ ስመ ፡ እግዚአብሔር ፡ ካልተጻፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቸው ፡ ሰዎች፡ በቀር፡ ያልተጻፈባቸውን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰዎች ፡ ነው ፡ እንጅ ፡ ⟪(ወአዘዝዎሙ)⟫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሊያን፡ ቅሉ ፡ አውግዘው ፡ እንዳይለይዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው፡ አትለይዋቸው፡ አሏቸው፡ ⟪(ዳዕሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ፡ ያሕምምዎሙ)⟫፡ ዘመነ፡ ሥጋዌ ፡ እስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኪፈጸም፡ ቀኖና፡ እየሰጡ ፡ መከራ ፡ ያጸኑባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ዘንድ ፡ እንጅ ፡ (ጥቅ) ፡ ተሠርዐ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ፡ ለኀበ ፡ ዐሠርቱ ፡ ክፍል ፡ ወበጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐ ፡ እስከ ፡ ዐሥር ፡ ወተርፈ ፡ መንፈቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐሥር ፡ እንዲል፡ አጽኑባቸው፡ አሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪(ወሕማሞሙሰ)⟫ ፡ በሰው ፡ ላይ ፡ በቀኖና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያመጡትም ፡ መከራ ፡ ሐዋርያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደሚያመጡት ፡ መከራ ፡ ነው ። ⟪(ወበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቶን ፡ መዋዕል)⟫ ፡ በዚያ ፡ ወራት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ በሰማዕትነት ፡ ሊሞት ፡ ይሻል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አያገኝም ፡ በሰማዕትነት ፡ ሊሞት ፡ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳል ፡ በሰማዕትነት ፡ መሞት፡ ከእሱ፡ ይታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣል ፡ ሁሉ ፡ አማኒ ፡ ሆኖ ፡ ነው ፡ ⟪(ወከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዝ ፡ ውእቱ)⟫ ፡ የደቀ ፡ መዛሙርቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሥጢር ፡ አስተያየት ፡ እንዲህ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪(ከመ ፡ አፍራስ)⟫ ፡ መናፍቃንን ፡ ለመር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታት ፡ ተፅርረው ፡ እንዳሉ፡ እንደ ፡ መም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህራኑ ፡ ምስጢር ፡ አስተያየት ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ የመምህራኑ ፡ ምስጢር ፡ አስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያየት ፡ እንዲህ ፡ ነው ፡ ለፀቢዐ ፡ አጋንን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ተፅርረው ፡ ያሉ ፡ ባሕታውያን ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደሚያዩት ፡ ምስጢር ፡ ነው ፡ ⟪(ወውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርእሶሙ ፡ ቦሙ)⟫ ፡ በአእምሯቸው ፡ በን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሐ ፡ ልቡና ፡ የሚገለጽ ፡ ብዙ ፡ ምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢር ፡ አለ ፡ ሥላሴን ፡ መላእክትን ፡ በ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚያዩበት ፡ በንጽሐ ፡ ልቡና ፡ ቢል ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ፡ ነው ፡ ⟪(ወገጾሙ ፡ ከመ ፡ ገጸ ፡ ሰብእ)⟫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሥላሴ ፡ ፊት ፡ በባለሟልነት ፡ መገለጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው፡ ሃይማኖታቸውን፡ በሰው ፡ ፊት፡ ገል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸው፡ እንደ፡ መመስከራቸው፡ ነው፡ (ጥቅ)፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሰ ፡ አምነኒ ፡ በቅድመ ፡ ሰብእ ፡ አነኒ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አአምኖ ፡ በቅድመ ፡ አቡየ ፡ ዘበሰማያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዘሰ ፡ ክሕደኒ ፡ በቅድመ ፡ ሰብእ ፡ አነኒ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እክሕዶ ፡ በቅድመ ፡ አቡየ ፡ ዘበሰማያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ፡ ⟪(ወሥዕርቶሙ)⟫ ፡ ለመምህራኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሐዋርያት ፡ ያለ ፡ ደቀ ፡ መዝሙር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ፡ ሐተታ ፡ ሥዕርት ፡ አላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠጕር ፡ ለራስ ፡ ጌጥ ፡ እንደ ፡ ሆነ ፡ ደቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
