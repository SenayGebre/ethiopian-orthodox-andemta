        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕር ፡ ወየብስ፡ ነኝ፡ ይላል ፡ ቅዱስ ፡ ሚ",
          "word_wraps_to_next_line": true
        },
