      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪፲ ፤ ወነሣእክዋ ፡ ለይእቲ ፡ መጽሐፍ ፡ እምነ ፡ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዴሁ ፡ ለውእቱ ፡ መልአክ ፡ ወበላዕክዋ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያችን ፡ መጽሐፍ ፡ ከመልአኩ ፡ እጅ ፡ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀብዬ ፡ በላኋት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኮነተኒ ፡ ጥዕምተ ፡ በውስተ ፡ አፉየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላፌ ፡ ጣፈጠችኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሶበ ፡ ውኅጥክዋ ፡ አምረረታ ፡ ለከርሥየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከበላኋት ፡ በኋላ ፡ ግን ፡ ለልቡናዬ ፡ አልተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስማማችኝም ። አንድም ፡ (ወውእቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል) ፡ ከወደ ፡ ሰማይ ፡ የሰማሁት ፡ ቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኔ ፡ ነገረኝ ፡ ዳግመኛ ፡ ምሥጢረ ፡ ምጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አትን ፡ ግፍዐ ፡ ሰማዕታትን ፡ ግብር ፡ ገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተህ ፡ ከመላኩ ፡ ዘንድ ፡ ዕወቃት ፡ መር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምራት ፡ አለኝ ፡ (ወሖርኩ) ፡ ከመላኩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ሂጄ ፡ ምሥጢረ ፡ ምጽአትን ፡ ግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍዐ ፡ ሰማዕታትን ፡ ግለጥልኝ ፡ አልሁት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወይቤለኒ ፡ ንሥእ ፡ ወብልዓ) ፡ ትገለጥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልህ ፡ አለኝ ፡ (ወለትምረራ) ፡ ለልቡናህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታሳዝንህ ፡ ለጊዜው ፡ ግን ፡ ደስ ፡ ታሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝህ ፡ አለኝ ፡ (ወነሣእክዋ ፡ ለይእቲ ፡ መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፍ) ፡ ምሥጢረ ፡ ምጽአትን ፡ ግፍዐ ፡ ሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ወመጠወኒ ፡ ሕለተ ፡ ወርቅ ፡ ዘመጠነ ፡ በትር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብትር ፡ የሚያህል ፡ የወርቅ ፡ ዘንግ ፡ ሰጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝ ፡ ሐተታ ፡ ብትር ፡ የሚቈረጥ ፡ በሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁመት ፡ ልክ ፡ ሦስት ፡ ክንድ ፡ ከስንዝር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ፡ ዘመጠነ ፡ በትር ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤለኒ ፡ ንሣእ ፡ ወመጥን ፡ ቤተ ፡ መቅደሱ ፡ ለእግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንካ ፡ ቤተ ፡ መቅደስን ፡ ስፈር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምሥዋዖ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድስቱን ፤",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማዕታትን ፡ ግብር ፡ ገብቼ ፡ አወቅኋት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መረመርኋት ፡ (ወኮነተኒ) ፡ ለጊዜው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ አሰኘችኝ ፡ (ወሶበ ፡ ውኅጥክዋ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካወቅኋት ፡ ከመረመርኋት ፡ በኋላ ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሳዘነችኝ ፡ ምሥጢር ፡ ለጊዜው ፡ ሲገለጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ ያሰኛል ፡ ኋላ ፡ ግን ፡ ያሳዝናልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪፲፩ ፤ ወይቤለኒ ፡ ሀለወከ ፡ ካዕበ ፡ ትትነበይ ፡ ለአሕዛብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወለሕዝብ ፡ ወለበሐውርት ፡ ወለነገሥት ፡ ብዙኃን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳግመኛም ፡ ሕዝብን ፡ አሕዛብን ፡ ታስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምር ፡ ዘንድ ፡ አለህ ፡ አለኝ ፡ አሕዛብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለውን ፡ በሐውርት ፡ ሕዝብ ፡ ያለውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገሥት ፡ ብሎ ፡ ደገመው ፡ ሐተታ ፡ ካዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ ፡ ለጥንተ ፡ ስብከት ፡ ነው ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእሱን ፡ ለሐዋርያት ፡ ካዕበ ፡ አለ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ በደሴተ ፡ ፍጥሞ ፡ ሳለ ፡ ወንድሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቼ ፡ ሁሉ ፡ በየሀገረ ፡ ስብከታቸው ፡ ጸን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ ያስተምራሉ ፡ የእኔ ፡ ማስተማር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃድህ ፡ ባይሆን ፡ ነው ፡ ብሎ ፡ ቢያመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለክት ፡ አይዞህ ፡ ሕዝብን ፡ አሕዛብን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታስተምር ፡ ዘንድ ፡ አለህ ፡ ብሎት ፡ ነበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረና ፡ ሀለወከ ፡ ካዕበ ፡ ትትነበይ ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኀበሂ ፡ ይሰግዱ ፡ ሎቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅኔ ፡ መዐልቱን ፡ ስፈር ፡ አለኝ ፡ ሕዝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "፵ ፥ ፫ ። ዘካ ፡ ፪ ፥ ፩ ፥ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪፪ ፤ ወዐጸደሰ ፡ ጽናፌ ፡ ኅድግ ፡ ወኢትመጥን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቅጽር ፡ ውጭ ፡ ያለውን ፡ ግን ፡ እሰፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራለሁ ፡ አትበል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ተውህበት ፡ ለአሕዛብ ፡ በዛ ፡ ሀገር ፡ ቅድስት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናን ፡ በዙሪያው ፡ ተሳፍረው ፡ ሊሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍሩባት ፡ ታዝዟልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይትካየድዋ ፡ አርብዓ ፡ ወክልኤተ ፡ አውራኀ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፍጹም ፡ ቍጥር ፡ አርብዓ ፡ ወክልኤተ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውራኀ ፡ አለ ፡ የከተማ ፡ ቦታ ፡ ውድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ። አንድም ፡ ሐሳዌ ፡ መሢሕ ፡ ቤተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቅደስ ፡ እንዳይገባ ፡ ዕወቅ ፡ (ወዐጸደሰ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከከተማው ፡ ግን ፡ አይገባም ፡ አትበል ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "(እስመ ፡ ተውህበት) ፡ ከቢታንያ ፡ እስከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብረ ፡ ዘይት ፡ ተሳፍረው ፡ ሊሰፍሩባት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዝዟልና ፡ (ዕርቅ) ፡ ከዚያ ፡ ቅዱስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጳውሎስ ፡ ይነብር ፡ ቤተ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላል ፡ ከዚህ ፡ ዮሐንስ ፡ አይገባም ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደምነው ፡ ቢሉ ፡ ነገር ፡ እንደ ፡ ዮሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስ ፡ ነው ፡ አይገባም ፡ ቅዱስ ፡ ጳውሎስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይነብር ፡ ቤተ ፡ እግዚአብሔር ፡ አለ ፡ ከከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተማው ፡ ይገባል ፡ የካህናቱን ፡ ቤት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመ ፡ እግዚአብሔር ፡ ከተጠራበት ፡ ብሎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ እግዚአብሔር ፡ አለው ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ፡ እንደ ፡ ዮሐንስ ፡ ነው ፡ አይገባም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወይትካየድዋ) ፡ ሦስት ፡ ዓመት ፡ ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንፈቅ ፡ ተሳፍረው ፡ ይሰፍሩባታል ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ (ንሣእ ፡ ወመጥን) ፡ ብዕለ ፡ እስራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ጥቂት ፡ እንደ ፡ ሆነ ፡ ዕወቅ ፡ (ወዐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸደሰ) ፡ ብዕለ ፡ አሕዛብ ፡ ግን ፡ ጥቂት ፡ ነው ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትበል ፡ (እስመ ፡ ተውህበት) ፡ ብዕል ፡ ለአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዛብ ፡ ተሰጥቷልና ። አንድም ፡ እስራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ጥቂት ፡ እንደ ፡ ሆኑ ፡ ዕወቅ ፡ አሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛብ ፡ ግን ፡ ጥቂቶች ፡ ናቸው ፡ ፡ አትበል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዛት ፡ ለአሕዛብ ፡ ተሰጥቷልና ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ እመቤታችን ፡ እንበለ ፡ ዘርዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንበለ ፡ ሩካቤ ፡ እንድትወልድ ፡ ዕወቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሎች ፡ ሴቶች ፡ ግን ፡ እንበለ ፡ ዘርዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንበለ ፡ ሩካቤ ፡ ይወልዳሉ ፡ አትበል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘርዕ ፡ በሩካቤ ፡ ሊወልዱ ፡ ታዝዟልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በጌታ ፡ በመለኮቱ ፡ ሕማም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞት ፡ እንደሌለበት ፡ ዕወቅ ፡ በሰውነቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ፡ ሕማም ፡ ሞት ፡ የለበትም ፡ አትበል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰውነቱ ፡ ሊታመም ፡ ሊሞት ፡ ለአይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁድ ፡ ተሰጥቷልና ። አንድም ፡ በሰማዕ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታት ፡ በነፍስ ፡ መከራ ፡ እንደሌለባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕወቅ ፡ በሥጋ ፡ ግን ፡ መከራ ፡ የለባቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውም ፡ አትበል ፡ በሥጋ ፡ መከራ ፡ ሊቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሉ ፡ ለአሕዛብ ፡ ተሰጥተዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ኃጥአን ፡ መንግሥተ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳይገቡ ፡ ዕወቅ ፡ ገሃነመ ፡ እሳት ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይገቡም ፡ አትበል ፡ ገሃነመ ፡ እሳት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊገቡ ፡ ታዝዟልና ። አንድም ፡ ቤተ ፡ መቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ ተባርኮ ፡ እንዲሠራ ፡ ዕወቅ ፡ ሌሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቹ ፡ ምኵራባት ፡ ግን ፡ ተባርከው ፡ ይሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሉ ፡ አትበል ፡ ሳይባረኩ ፡ እንዲሠሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዝዟልና ፡ ምሥጢሩ ፡ ደሙ ፡ በነጠበበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤተ ፡ መቅደስ ፡ እንዲሠራ ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ (ወይትካየድዋ) ፡ የፊተኛውን ፡ ይዞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሄዳል ፡ ይከይድዋም ፡ ይላል ፡ ሉቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፩ ፥ ፳፬ ። ም ፡ ፲፩ ፥ ፫ና ፡ ፲፪ ፥ ፮ ፥ ፲፬ና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፫ ፥ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪፫ ፤ ወእኤዝዞሙ ፡ ለክልኤቱ ፡ ጻድቃንየ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይትነበዩ ፡ መዋዕለ ፡ ዐሠርተ ፡ ወክልኤተ ፡ ምእተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወስሳ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለቱን ፡ ወዳጆቼን ፡ አዝዛቸዋለሁ ፡ ሽሕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሁለት ፡ መቶ ፡ ስድሳ ፡ ዕለት ፡ ያስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሩ ፡ ዘንድ ፡ ሐተታ ፡ የሦስቱ ፡ ዓመት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
