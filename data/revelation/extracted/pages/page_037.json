    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወእሉ ፡ እሙንቱ ፡ ክልኤ ፡ ዕፀ ፡ ዘይት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለቱ ፡ ዕፀ ፡ ዘይት ፡ እሊህ ፡ ኤልያስና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሄኖክ ፡ ናቸው ፡ ሄኖክ ፡ ማለት ፡ ተሐድሶ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማለት ፡ ነው ፡ ተሐድሶ ፡ በዘይት ፡ ነውና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልያስም ፡ ማለት ፡ ዘይት ፡ ማለት ፡ ነው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ ወገደፈቶ ፡ ታሕተ ፡ አሐቲ ፡ ዕፀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልያስ ፡ ወአሐቲ፡ መሥፈርተ፡ ኤልያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትገብር ፡ ዐሠርተ ፡ ወክልኤተ ፡ ምክያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳተ ፡ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወክልኤ ፡ መኃትው ፡ እለ ፡ ቅድመ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግዚአብሔር ፡ ባለሟሎች ፡ የሚሆኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ፡ መምህራን ፡ እሊህ ፡ ናቸው ፡ መኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትው ፡ አላቸው ፡ በትምህርታቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ፡ ልቡና ፡ ብሩህ ፡ ያደርጋሉና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ሥዩማን ፡ ላዕለ ፡ ምድር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ፡ ዓለም ፡ በሰው ፡ ሁሉ ፡ ላይ ፡ የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሾሙ ፡ ዘካ ፡ ፬ ፥ ፫ ፥ ፲፩ ፥ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወለዘፈቀደ፡ይስሐጦሙ፡እምውስተ፡ጸላእቶሙ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከጠላቶቻቸውም ፡ ወገን ፡ ሊጣሏቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወደደውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ትወፅእ ፡ እሳት ፡ እምነ ፡ አፉሆሙ ፡ ወታጠፍኦሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጸላእቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሳት ፡ ከአፋቸው ፡ ወጥታ ፡ ታቃጥላቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋለች ፡ አለ ፡ መቅሠፍት ፡ በሥልጣና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ታዝዛ ፡ታጠፋቸዋለች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመዝ ፡ ይመውቱ ፡ እለ ፡ ይስሕጥዎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚጣሏቸው ፡ ሰዎች ፡ ሁሉ ፡ እንዲህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጠፋሉ ፡ ፪ ፡ ነገሥ ፡ ፩ ፥ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪እስመ ፡ እሙንቱ ፡ ሥልጣን ፡ ላዕለ ፡ ሰማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማዩን ፡ ያዝዙታልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይዕጽውዎ ፡ ከመ ፡ ኢይዝንም ፡ ዝናም ፡ ላዕለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ በመዋዕለ ፡ ትንቢቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሚያስተምሩበት ፡ ወራት ፡ ሰማይ ፡ ዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናም ፡ ለዘር ፡ ጠል ፡ ለመከር ፡ እንዳይሰጥ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይከለክሉ ፡ ዘንድ ፡ ሥልጣን ፡ ላለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተመልሶ ፡ በኤልያስ ፡ ጊዜ ፡ የሆነውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናገር ፡ ነው ። አንድም ፡ ያን ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደረጋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዓዲ ፡ ሥልጣን ፡ እሙንቱ ፡ ላዕለ ፡ ማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳግመኛም ፡ ውኃውን ፡ ያዝዙታልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይረስይዎ ፡ ደመ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደም ፡ ያደርጉት ፡ ዘንድ ፡ ተመልሶ ፡ በሄ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖክ ፡ ጊዜ ፡ የሆነውን ፡ መናገር ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ያን ፡ ጊዜ ፡ ይደረጋል ፡ (ትር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጓሜ ፡ ቀለምሲስ ፡ ግን ፡ ሙሴ ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተመቸ ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያሐምምዋ ፡ ለምድር ፡ በኵሉ ፡ መቅሠፍት ፡ መጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ ፡ ፈቀዱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወደዱትን ፡ ያህል ፡ መቅሠፍት ፡ እያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጡ ፡ በሰው ፡ መከራ ፡ ያጸናሉ ፡ ፩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገሥ ፡ ፲፯ ፥ ፩ ። ዘፀአ ፡ ፯ ፥ ፲፱ ፥ ፳ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወሶበ ፡ ፈጸሙ ፡ ስምዖሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐሳዌ ፡ መሢሕ ፡ አምላክ ፡ አይደለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ መስክረው ፡ ከፈጸሙ ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትንቢቶሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማዩን ፡ ምድሩን ፡ የብሱን ፡ ባሕሩን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "የፈጠረ ፡ አምላክ ፡ አለ ፡ ብለው ፡ አስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምረው ፡ ከፈጸሙ ፡ በኋላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አርዌ ፡ ዘዐርገ ፡ እምቀላይ ፡ ተበዐሰ ፡ ምስሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከከተማ ፡ ነግሦ ፡ የወጣ ፡ ሐሳዌ ፡ መሢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕ፡ (ይትበዐስ)፡ ከሳቸው፡ ጋራ፡ ይጣላል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሞዖሙ ፡ ወቀተሎሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
