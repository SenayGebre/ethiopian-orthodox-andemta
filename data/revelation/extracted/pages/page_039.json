    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ሶበ ፡ ወለደት ፡ ይብላዕ ፡ ሕፃና ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወለደች ፡ ጊዜ ፡ ብላቴናውን ፡ ይበላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ዳን ፡ ፰ ፡ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወወለደት ፡ ወልደ ፡ ተባዕተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድ ፡ ልጅ ፡ ወለደች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘውእቱ ፡ ይርዕዮሙ ፡ ለኵሉ ፡ አሕዛብ ፡ በበትረ ፡ ኅፂን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተወደደ ፡ በጽኑዕ ፡ ሥልጣን ፡ የሚጠብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመሰጥዎ ፡ ለውእቱ ፡ ሕፃን ፡ ወወሰድዎ ፡ ኀበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ወኀበ ፡ መንበሩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ብላቴና ፡ ነጥቀው ፡ ወደ ፡ እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር ፡ አወጡት ፡ ወደ ፡ መንበሩ ፡ አደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረሱት ፡ መዝ ፡ ፪ ፡ ፱ ። ራእ ፡ ፲፱ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወጐየት ፡ ይእቲ ፡ ብእሲት ፡ ውስተ ፡ ገዳም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወውስተ ፡ መካን ፡ ዘአስተዳለወ ፡ ላቲ ፡ እግዚአብሔር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያችም ፡ ሴት ፡ ሸሽታ ፡ ወደ ፡ በረሃ ፡ እግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ ወዳዘጋጀላትም ፡ ቦታ ፡ ሄደች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ትትዐቀብ ፡ በህየ ፡ በኵሉ ፡ መዋዕል ፡ ዐሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርተ ፡ ወክልኤተ ፡ ምእተ ፡ ወተስዓ ፡ ዕለተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሽሕ ፡ ከሁለት ፡ መቶ ፡ ከዘጠና ፡ ዕለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትጠበቅ ፡ ዘንድ ፡ ሐተታ ፡ እንዳለፈው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሦስቱ ፡ ዓመት ፡ ጳጉሜን ፡ ፲፭ ፡ የ፩ ፡ ዓመት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "፫ ፡ ቀን ፡ ፲፰ ፡ ቀን ፡ ይሆናል ፡ ሽሕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለት ፡ መቶ ፡ ሰባ ፡ አምስት ፡ ቀን ፡ ይሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናል ፡ ፲፪ ፡ ቀን ፡ ጎደለሳ ፡ ቢሉ ፡ ስድስቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሄደችበት ፡ ስድስቱ ፡ የተመለሰችበት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ (ብእሲት ፡ እንተ ፡ ትለብስ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህራን ፡ ብሉይና ፡ ሐዲስን ፡ ሲያስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሩ ፡ ታዩ ፡ ፀሐይ ፡ አምስቱ ፡ መጻሕፍተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙሴ ፡ ስድስተኛ ፡ መጽሐፈ ፡ ነቢያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርኅ ፡ ወንጌል ፡ ወርኅ ፡ አላት ፡ ወንጌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልን ፡ የጨረቃ ፡ ክፍለ ፡ ብርሃን ፡ ከፀሐይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክፍለ ፡ ብርሃን ፡ ሰባተኛ ፡ እጅ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ ወትነሥእ ፡ ሳብዐየ ፡ እደ ፡ እምብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃነ ፡ ፀሐይ ፡ እንዲል ፡ ወንጌልንም ፡ እስመ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳብዐይ ፡ ንባቡ ፡ ለእግዚአብሔር ፡ ይላታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልና ፡ አሥራ ፡ ሁለቱ ፡ ሐዋርያት ፡ በከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሩበት ፡ ክብር ፡ ከብረዋል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብእሲት ፡ ምእመናን ፡ ናቸው ፡ የብሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይንና ፡ የሐዲስን ፡ ግብር ፡ በምሳሌ ፡ ገን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘብ ፡ አድርገዋል ፡ ምእመናን ፡ አሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለቱ ፡ ሐዋርያት ፡ በከበሩበት ፡ ክብር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከብረዋል ፡ (ወፅንስት) ፡ መምህራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ በትምህርት ፡ ፀንሰዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወወለደት) ፡ ምእመናን ፡ ምግባር ፡ ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖትን ፡ ገንዘብ ፡ አድርገዋል ፡ (ወትግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕር) ፡ መምህራን ፡ ምእመናንን ፡ በትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህርት ፡ ለመውለድ ፡ መከራ ፡ ይቀበላሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናን ፡ ምግባር ፡ ሃይማኖትን ፡ ገን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘብ ፡ ለማድረግ ፡ መከራ ፡ ይቀበላሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወአስተርአየ) ፡ ካልእ ፡ በሰማይ ፡ ሌላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምልክት ፡ ታየ ፡ አርዌ ፡ ዲያብሎስ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀይሕ ፡ አለው ፡ ተፈጥሮው ፡ ከእሳት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውና ፡ ዐቢይ ፡ አለው ፡ በቦታ ፡ ከሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በላይ ፡ ነበረና ፡ (ወሰብዐቱ) ፡ ሰባት ፡ ተው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራጆች ፡ ያሉት ፡ የእኔ ፡ ናቸው ፡ ይላል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ያን ፡ ጊዜ ፡ ይሾማል ፡ (ወዐሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርቱ) ፡ ዐሥር ፡ አለቆች ፡ ያሉት ፡ ዐሥሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለቆች ፡ የእኔ ፡ ናቸው ፡ ይላል ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ፡ ጊዜ ፡ ይሾማል ፡ (ወውስተ ፡ አርእስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲሁ) ፡ የአለቃ ፡ አለቃ ፡ ያለው ፡ የእኔ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡ ይላል ። አንድም ፡ ያን ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሾማል ፡ (ወበዘነቡ) ፡ አርዌ ፡ ብሎታል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና ፡ ወበዘነቡ ፡ አለ ፡ ሰማያውያን ፡ ከሆኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በኋላ ፡ በማሳቱ ፡ ምእመናንን ፡ ምድራዊ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራን ፡ ያሠራቸዋል ፡ (ወቆመ ፡ ውእቱ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሳዌ ፡ መሢሕ ፡ አድሮ ፡ መምህራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ በትምህርት ፡ በወለዱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ ምእመናን ፡ ምግባር ፡ ሃይማኖትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገንዘብ ፡ ባደረጉ ፡ ጊዜ ፡ ይጣላቸው ፡ ዘን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ፡ ሔዋንን ፡ ባሳተበት ፡ በጥንተ ፡ ክፋቱ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸና ፡ (ወወለደት) ፡ መምህራን ፡ ምእመና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ በትምህርት ፡ ገንዘብ ፡ አደረጉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ዘውእቱ) ፡ ምግባር ፡ ሃይማኖት ፡ በአሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛብ ፡ ዘንድ ፡ የጠፋ ፡ መስሎ ፡ ሳለ ፡ በእግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ ዘንድ ፡ ለኋላ ፡ ትውልድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጠበቁን ፡ መናገር ፡ ነው ፡ ምእመናን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በአሕዛብ ፡ ዘንድ ፡ ቢጎዱ ፡ በእግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ዘንድ ፡ አለመጎዳታቸውን ፡ መና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ፡ ነው ፡ (ወመሰጥዎ) ፡ ብላቴናውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነጥቀው ፡ ወደ ፡ እግዚአብሔር ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንበሩ ፡ አደረሱት ፡ (ዘውእቱ ፡ ይርዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሙ) ፡ በተወደደ ፡ በጽኑ ፡ ሥልጣን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚጠብቃቸው ፡ (ወጐየት ፡ ይእቲ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህራን ፡ ምእመናን ፡ ወደ ፡ ገዳም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሸሽተው ፡ ሄዱ ፡ እግዚአብሔር ፡ ወደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዘጋጀላቸው ፡ ቦታ ፡ ሄዱ ፡ ሦስት ፡ ዓመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ ከመንፈቅ ፡ ሊጠበቁ ፡ ተጠብቀው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይኖሩ ፡ ዘንድ ። አንድም ፡ ብእሲት ፡ እመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤታችን ፡ ጌታን ፡ ወልዳ ፡ ወርኀ ፡ ዮሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንስ ፡ መጥምቅ ፡ ሲሰግድላት ፡ ታየ ፡ ወር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀ ፡ አለው ፡ ዮሐንስ ፡ መጥምቅን ፡ ጨረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃ ፡ ሠርቅ ፡ ካደረገች ፡ በኋላ ፡ እስከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሥራ ፡ አምስት ፡ ቀን ፡ ምልዓት ፡ እያደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረገች ፡ ትሄዳለች ፡ ከዚያ ፡ በኋላ ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጸፅ ፡ እያደረገች ፡ ትሄዳለች ፡ እሱም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሥራ ፡ አምስት ፡ ዓመት ፡ አስተምሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በብሔረ ፡ ዐረቢያ ፡ አርፎዋልና ፡ በዐሥራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለቱ ፡ ሐዋርያት ፡ አድሮ ፡ ያለ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈስ ፡ ቅዱስ ፡ አድሮባታል ። (ወፅንስት) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታን ፡ ፀንሳለች ። ወትግዕር ፡ በሌሎቹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሴቶች ፡ ልማድ ፡ ትግዕር ፡ አለ ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሷስ ፡ የለባትም ። አንድም ፡ አይሁድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማየ ፡ ዘለፋን ፡ ያጠጧታል ፡ ወአስተርአየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "(እንዳለፈው ፡ በል) ፡ (ወቆመ ፡ ውእቱ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመቤታችን ፡ ፊት ፡ ለፊት ፡ ቆመ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ሔዋንን ፡ ባሳተበት ፡ በጥንተ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክፋቱ ፡ ጸና ፡ ጌታን ፡ በወለደች ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሄሮድስ ፡ አድሮ ፡ ያስገድለው ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወወለደት) ፡ ኅያል ፡ ወልድን ፡ ወለደች ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ ወልዳ ፡ ለአርዌ ፡ ዘስሙ ፡ ተባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕት ፡ ላዕላይ ፡ ማይ ፡ ተባዕታይ ፡ ውእቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲል ፡ (ዘውእቱ) ፡ አሕዛብን ፡ በጽኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተወደደ ፡ ሥልጣን ፡ የሚጠብቃቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወወሰድዎ) ፡ ጌታ ፡ እንደ ፡ ሰውነቱ ፡ ሲሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደድ ፡ እንደ ፡ አምላክነቱ ፡ በአብ ፡ ዕሪና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳለ ፡ መናገር ፡ ነው ፡ እመቤታችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ግብፅ ፡ ሄደች ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ አዘጋጀላትም ፡ ወደ ፡ ደብረ ፡ ቍስቋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ሄደች ፡ (ከመ ፡ ትትዐቀብ) ፡ በግብፅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስት ፡ ዓመት ፡ ከመንፈቅ ፡ ትጠበቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
