  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተቃርን፡ ባላጋራ፡ ማለት ፡ ነው ፡ (ጥቅ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዐቀመ ፡ አይርሃ ፡ ሰይጣነ ፡ ላዕለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰሎሞን ፡ እንዲል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወድቀ ፡ ውስተ ፡ ምድር ፡ ወመላእክቲሁኒ ፡ ወድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁ ፡ ምስሌሁ ፡ ውስተ ፡ ምድር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደዚህ ፡ ዓለም ፡ ወረደ ፡ ሠራዊቱም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእሱ ፡ ጋራ፡ እንደሱ ፡ወረዱ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወፀብእዎ) ፡ ሚካኤል ፡ ማለት ፡ መኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከማከ ፡ ማለት ፡ ነው ፡ መኑ ፡ ከማከ ፡ የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባለ ፡ ጌታ ፡ ነው ፡ ጌታ ፡ ምእመናንን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዞ ፡ ሰማይ ፡ መስቀል ፡ ነው ፡ በመስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀል ፡ ተዋጋው ፡ እሱም ፡ ሠራዊቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይዞ ፡ ተዋጋው ፡ ወስዕኖሙ ፡ ድል ፡ ነሡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ፡ (ወኢረከበ) ፡ ከዚህ ፡ በኋላ ፡ ኀይል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላገኘም ፡ (ወወድቀ) ፡ ድል ፡ ተነሣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርዌም ፡ የተባለ ፡ ቀድሞ ፡ ዓለሙን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ ያሳተ ፡ ሰይጣን ፡ የተባለ ፡ ዲያብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎስ ፡ ነው ፡ (ወወድቀ) ፡ ድል ፡ ተነሣ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወመላእክቲሁኒ) ፡ ሠራዊቱም ፡ ከሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋራ ፡ እንደ ፡ እሱ ፡ ድል ፡ ተነሡ ፡ ሉቃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲ ፥ ፲፰ ። ዮሐ ፡ ፲፪ ፥ ፴፩ ። ዘፍጥ ፡ ፫ ፥ ፩ ፥ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪፲ ፤ ወሰማዕኩ ፡ ቃለ ፡ ዐቢየ ፡ በውስተ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘይብል ፡ ኮነት ፡ መድኃኒት ፡ ወኀይል ፡ ወመንግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥት ፡ ለአምላክነ ፡ ወሥልጣን ፡ ለመሢሑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማይ ፡ ቃል ፡ ሰማሁ ፡ (ኮነት) ፡ መድኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒት ፡ ኀይል ፡ መንግሥት ፡ ለፈጣሪያችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእግዚአብሔር ፡ አብ ፡ ሥልጣንም፡ ለእግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዚአብሔር ፡ ወልድ ፡ ሰጠች ፡ የሚል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ወድቀ ፡ መስተዋድይ ፡ ዘአስተዋደዮሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለአበዊነ፡ ቅድመ፡ እግዚአብሔር፡ መዓልተ፡ ወሌሊተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመዓልትም ፡ በሌሊትም ፡ አባቶቻች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ የሚከሳቸው ፡ የሚያጣላቸው ፡ ዲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎስ ፡ ወደዚህ ፡ ዓለም ፡ ወርዷልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፲፩ ፥ ፲፭ ። ኢዮ ፡ ፩ ፥ ፲፩ ፡ ዘካ ፡ ፫ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃ ፡ ፳፪ ፥ ፴፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪፲፩ ፤ ወሞዕዎ ፡ እሙንቱ ፡ በእንተ ፡ ደመ ፡ በግዑ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጉ ፡ ደሙን ፡ ስላፈሰሰ ፡ የመስቀል ፡ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌ ፡ የሚሆን ፡ የብርሃን ፡ ትእምርተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መስቀል ፡ ይዘው ፡ ድል ፡ ስለነሡት ፡ በእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ፡ ደመ ፡ በግዑ ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበእንተ ፡ ቃለ ፡ ጽድቆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ዕውነተኛ ፡ ነገራቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ኢያብደሩ ፡ ነፍሶሙ ፡ እስከ ፡ ለሞት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእሱ ፡ እስከ ፡ መለየት ፡ ድረስ፡ ደርሰው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛም ፡ እንደ ፡ እሱ ፡ ነን ፡ አላሉምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ (ዘይብል፡ ኮነት)፡ መንግሥት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኃይል፡ መድኀኒት፡ ለአምላክነ፡ ለመሢሑ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለፈጣሪያችን ፡ ለእግዚአብሔር ፡ ወልድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰጠች ፡ የሚል ፡ ቃል ፡ ሰማሁ ፡ (እስመ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድቀ) ፡ ድል ፡ ተነሥቷልና ፡ (ወሞዕዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሙንቱ)፡ ምእመናን፡ ናቸው፡ ድል፡ ነሡ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት፡ (በእንተ፡ ደመ፡ በግዑ)፡ በጉ፡ ደሙን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስላፈሰሰላቸው ፡ (ወበእንተ ፡ ቃለ ፡ ጽድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆሙ) ፡ በአካላዊ ፡ ቃል ፡ ስለማመናቸው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "(እስመ ፡ ኢያብደሩ) ፡ በሰማዕትነት ፡ እስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከ ፡ መሞት ፡ ድረስ ፡ ደርሰው ፡ በሕይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወተ ፡ ሥጋ ፡ እንኑር ፡ አላሉምና ፡ ሮሜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "፰ ፥ ፴፯ ። ም ፡ ፯ ፥ ፲፬ ። ቍ ፡ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪፲፪ ፤ ወበእንቲአሆሙ ፡ ተፈሥሑ ፡ ሰማያት ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ይነብሩ ፡ ውስቴቶን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለሳቸውም ፡ ሰማያት ፡ መላእክት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወእለ ፡ ይነብሩ) ፡ ደቂቀ ፡ አዳም ፡ ደስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ። አንድም ፡ ልዑላኑ ፡ ትሑታኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ፡ አላቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አሌ ፡ ላ ፡ ለምድር ፡ ወለባሕር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለየብስ ፡ ለባሕር ፡ ወዮላት ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጥሙቃኑ ፡ ለኢጥሙቃኑ ፡ ወዮላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ወረደ ፡ ሰይጣን ፡ ውስቴቶሙ ፡ ምስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐቢይ ፡ ኀምዙ ፡⟫",
          "word_wraps_to_next_line": false,
          "stage1_text": "ዐቢይ ፡ ጎምዙ ፡⟫",
          "stage2_correction": {
            "pair": "ጎ -> ኀ",
            "reason": "In Classical Ge'ez (Rev 12:12), the word is 'ኀምዙ' (from ኀምዝ, meaning venom/fierce wrath, glossed below as 'ከጽኑ ፡ ማሳቱ ፡ ጋራ'). The printed Fidel is clearly 'ኀ', which was visually misread as 'ጎ'."
          },
          "uncertain": []
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰይጣን ፡ ከጽኑ ፡ ማሳቱ ፡ ጋራ ፡ ወደሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ወርዷልና ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ የአምር ፡ ከመ ፡ ውኁድ ፡ መዋዕል ፡ ተርፎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥቂት ፡ ዘመን ፡ እንደ ፡ ቀረው ፡ ስላወቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመነ ፡ ሥጋዌ ፡ ነው ፡ (በሐሣዌ ፡ መሢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕ) ፡ ሦስት ፡ ዓመት ፡ ከመንፈቅ ፡ ነው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪፲፫ ፤ ወሶበ ፡ ርእየ ፡ ዝኩቱ ፡ አርዌ ፡ ከመ ፡ ወድቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ ምድር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደዚህ፡ ዓለም፡እንደ፡ ወረደ፡ ባየ፡ ጊዜ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም፡ ድል ፡ እንደ፡ ተነሣ፡ ባየ፡ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዴገና ፡ ለእንታክቲ ፡ ብእሲት ፡ እንተ ፡ ወለደት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕፃነ ፡ ተባዕተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወንድ ፡ ልጅ ፡ የወለደች ፡ ያችን ፡ ሴት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከተላት ፡ በሐሣዌ ፡ መሢሕ ፡ አድሮ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናንን ፡ በትምህርት ፡ የወለዱ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምህራንን ። አንድም ፡ ምግባር ፡ ሃይማኖ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ፡ ገንዘብ ፡ ያደረጉ ፡ ምእመናንን ፡ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተላቸው ። አንድም ፡ በሄሮድስ ፡ አድሮ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኅያል ፡ ወልድን ፡ የወለደች ፡ እመቤታች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንን ፡ ተከተላት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪፲፬ ፤ ወተውህባ ፡ ለይእቲ ፡ ብእሲት ፡ ክልኤ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክንፍ ፡ ከመ ፡ ዘዐቢይ ፡ ንስር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዚያች ፡ ሴት ፡ እንደ ፡ ታላቅ ፡ ንስር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ፡ ሁለት ፡ ክንፍ ፡ ተሰጣት ፡ ለመምህ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራን ፡ ለምእመናን ፡ እንደ ፡ አብርሃም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ፡ ምግባር ፡ ሃይማኖት ፡ ተሰጣቸው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ለመቤታችን ፡ ንጽሐ ፡ ሥጋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጽሐ ፡ ነፍስ ፡ ተሰጣት ፡ (ከመ፡ ዘዐቢይ)፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "የመንፈስ፡ ቅዱስ፡ ማደሪያ፡ እንደ፡ መሆኗ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ትሥርር ፡ ውስተ ፡ ገዳም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ገዳም ፡ ሸሽታ ፡ ትሄድ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "መምህራን ፡ ምእመናን ፡ ሸሽተው ፡ ወደ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "በረሃ ፡ ይሄዱ ፡ ዘንድ ፡ እመቤታችን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደ ፡ ግብፅ ፡ ትሄድ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውስተ ፡ መካን ፡ ከመ ፡ ትትዐቀብ ፡ በኵሉ ፡ መዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕል ፡ ዘመነ ፡ ወአዝማነ ፡ ወመንፈቀ ፡ ዘመን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዘመኑ ፡ ሁሉ ፡ ወደምትጠበቅበት፡ ቦታ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሄድ፡ ዘንድ ፡ እመቤታችን፡ መምህራን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምእመናን ፡ ናቸው ፡ (ዘመነ) ፡ አንዱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመን ፡ (ወአዝማነ) ፡ ሁለቱን ፡ ዘመን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወመንፈቀ ፡ ዘመን) ፡ መንፈቁን ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ዘመነ ፡ ወዘመነ ፡ ዘመን ፡ወመን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቀ ፡ ዘመን ፡ ይላል ፡ አብነት ፡ (ዘመነ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱን ፡ ዓመት ፡ (ወዘመነ ፡ ዘመን) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለቱን ፡ ዓመት ፡ (ወመንፈቀ ፡ ዘመን) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንፈቁን ። አንድም ፡ ዘመነ ፡ ወዘመነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዘመነ ፡ ወመንፈቀ ፡ ዘመን ፡ ይላል ፡ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብነት ፡ ትርጓሜው ፡ አንድ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እምቅድመ ፡ ገጹ ፡ ለውእቱ ፡ አርዌ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሐሳዌ ፡ መሢሕ ፡ ፊት ፡ ትጠበቅ ፡ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ፡ ዳን ፡ ፯ ፥ ፳፭ና ፡ ፲፪ ፥ ፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪፲፭ ፤ ወሠረረ ፡ ወዴገና ፡ ውእቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
