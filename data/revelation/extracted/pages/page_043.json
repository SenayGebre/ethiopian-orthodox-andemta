        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰገዱ ፡ ሎቱ ፡ ለውእቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሐሣዌ ፡ መሢሕ ፡ ሰገዱለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እንዘ ፡ ይብሉ ፡ መኑ ፡ ይመስሎ ፡ ለዝንቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ አውሬ ፡ ማን ፡ ይመስለዋል ፡ እያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ፡ እሱ ፡ እንደ ፡ ሃይማኖቱ ፡ አርዌ ፡ ይል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቸዋል ፡ እንጅ ፡ እነሱስ ፡ አምላክነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥነ ፡ ይሉታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወመኑ ፡ ይክል ፡ ፀቢኦቶ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድል ፡ ሊነሣው ፡ ለማን ፡ ይቻለዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወተውህበ ፡ ሎቱ ፡ አፍ ፡ ከመ ፡ ይንብብ ፡ ዐቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያተ ፡ ወፅርፈታተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽኑ ፡ ጽኑ ፡ ስድብ ፡ ይናገር ፡ ዘንድ ፡ አለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምላክ ፡ ነኝ ፡ ይል ፡ ዘንድ ፡ ውሽት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሰጠው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተውህበ ፡ ሎቱ ፡ ሥልጣን ፡ ይግበር ፡ ተአምረ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘፈቀደ ፡ አርብዓ ፡ ወክልኤተ ፡ አውራኀ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሦስት ፡ ዓመት ፡ ከመንፈቅ ፡ የወደደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ የምትሐት ፡ ታምራት ፡ ያደርግ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ሥልጣን ፡ ተሰጠው ፡ ዳን ፡ ፯ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "፰ ፡ ፲፩ ። ፪ ፡ ተሰ ፡ ፪ ፡ ፱ ። ራእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፩ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪ወእምዝ ፡ ፈትሐ ፡ አፉሁ ፡ ከመ ፡ ይፅርፍ ፡ ላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕለ ፡ እግዚአብሔር ፡ ወላዕለ ፡ ስሙ ፡ ወላዕለ ፡ ጽር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐ ፡ መቅደሱ ፡ ዘበሰማይ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ነገር ፡ ጀመረ ፡ እግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ነኝ ፡ ይል ፡ ዘንድ ፡ (ወላዕለ ፡ ስሙ)",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምላክ ፡ ነኝ ፡ ይል ፡ ዘንድ ፡ ውሽቱን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቀቀ፡ (ወላዕለ ፡ መቅደሱ) ፡ ጽርሐ ፡ አር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያም ፡ የእኔ ፡ ናት ፡ ይል ፡ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወተውህበ ፡ ሎቱ ፡ ከመ ፡ ይግበር ፡ ፀብአ ፡ ም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ፡ ቅዱሳን ፡ ወይማዖሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቅዱሳን ፡ ከምእመናን ፡ ጋራ ፡ ይጣላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ድል ፡ ይነሣቸው ፡ ዘንድ ፡ ሥል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣን ፡ ተሰጠው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተውህበ ፡ ሎቱ ፡ ሥልጣን ፡ ላዕለ ፡ ኵሉ ፡ አሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛብ ፡ ወሕዝብ ፡ ወበሐውርት ፡ ወነገድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሕዝብ ፡ በአሕዛብ፡ ላይ ፡ ሥልጣን ፡ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጠው ፡ ሕዝብ ፡ ያለውን ፡ ነገድ ፡ አሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዛብ ፡ ያለውን ፡ በሐውርት ፡ ብሎ ፡ ደገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መው ፡ ም ፡ ፲፩ ፡ ፯ ። ዳን ፡ ፯ ፡ ፳፩።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወሰገዱ ፡ ሎቱ ፡ ኵሎሙ ፡ እለ ፡ ይነብሩ ፡ ዲበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ፡ ዓለም ፡ የሚኖሩ፡ ሁሉ፡ ሰገዱለት፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ፡ኢኮኑ፡ጽሑፋነ፡ አስማቲሆሙ፡ ውስተ፡መጽሐፈ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወት፡ ዘበግዑ፡ ዘተቀትለ ፡ ዘእምፍጥረተ፡ ዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስማቸው ፡ በሕይወት ፡ መጽሐፍ ፡ ያልተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻፈ ፡ አለ ፡ መሥዋዕት ፡ በሆነው ፡ በበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዑ ፡ ልቡና ፡ ያልታወቀ ፡ እለ ፡ ኢኮነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሑፈ ፡ ዘእምፍጥረተ ፡ ዓለም ። ዓለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳይፈጠር ፡ መሥዋዕት ፡ በሆነው ፡ በበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዑ ፡ ልቡና ፡ ያልታወቀ ፡ ም ፡ ፲፪ ፡ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፫ ፡ ፭ ። ም ፡ ፲፯ ፡ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ዘቦ ፡ እዝን ፡ ሰሚዐ ፡ ለይስማዕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "እዝነ፡ ልቡና፡ያለው፡ሰው፡ ያስተውል፡አለ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሣዌ ፡ መሢሕ ፡ ያመነ ፡ እንዲጎዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላመነ ፡ እንዳይጎዳ ፡ አርዌ ፡ የተባለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቁሙ ፡ አርዌ ፡ እንዳይደለ ፡ ሐሣዌ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሢሕ ፡ እንደ ፡ ሆነ ፡ እዝነ፡ ልቡና፡ ያለው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ያስተውል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወተፄወወኒ ፡ ሕሊናየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቡናዬ ፡ አዘነብኝ ፡ የቀለምሲስ ፡ እኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
