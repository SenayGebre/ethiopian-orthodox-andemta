  "columns": [
    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ፡ ለእለ ፡ ይነብሩ ፡ ውስተ ፡ ምድር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ፡ ዓለም፡ የሚኖሩትን ፡ ያዝዛቸዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይግበሩ ፡ አምሳሎ ፡ ለዝንቱ ፡ አርዌ ፡ ዘቈስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመጥባሕት ፡ ወሐይወ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሾተል ፡ ተወግቶ ፡ የዳነ ፡ አለ ፡ ከሰባቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርእስተ ፡ ኃጣውእ፡ አንዲቱ፡ ኃጢአተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዳም ፡ በሞተ ፡ ወልደ ፡ እግዚአብሔር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠፍታ ፡ ትኖራለች ፡ በእሱ ፡ ጊዜ ፡ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሠራ ። አንድም ፡ ከሰባቱ ፡ አህጉር ፡ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲቱ ፡ ኢየሩሳሌም ፡ ጠፍታ ፡ ትኖራለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእሱ ፡ ጊዜ፡ የምትቀና፡ የሐሳዌ፡ መሢሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡ ሥዕሉን ፡ ሥለው ፡ ምስሉን ፡ መስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ፡ እንዲይዙ ፡ ያደርጋል ፡ ይይዙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ያዝዛቸዋል ፡ ዘዳግ ፡ ፲፫ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወተውህበ ፡ ሎቱ ፡ ይደይ ፡ ውስቴቱ ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈሰ ፡ ለአምሳለ ፡ ዝንቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሳዌ ፡ መሢሕ ፡ በተመሰለው ፡ ምስል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በተሣለው ፡ ሥዕል ፡ ቃል ፡ ያሳድርበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ሥልጣን ፡ ተሰጠው ፡ ይሰጠዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይንብብ ፡ ምስሉ ፡ ለውእቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተመሰለው ፡ ምስል ፡ የተሣለው ፡ ሥዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል ፡ ይናገር ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወገብሮሙ ፡ ለኵሎሙ ፡ እለ ፡ ኢሰገዱ ፡ ለአምሳለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝንቱ ፡ አርዌ ፡ ከመ ፡ ይሙቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሳዌ ፡ መሢሕ ፡ ለተመሰለው ፡ ምስል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለተሣለው ፡ ሥዕል ፡ ያልሰገዱትን ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲሞቱ ፡ ያደርጋል ፡ (በዐዋጅ ፡ ነው) ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወይገብር ፡ ኵሉ ፡ ንኡሱ ፡ ወዐቢዩ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታላቁ ፡ ታናሹም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አብዕልት ፡ ወነዳያን ፡ አግብርት ፡ ወአግዐዝያን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሆችም፡ባለጸጎችም፡ ጌቶችም፡ ባሮችም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፡ ይጽሐፉ፡ ውስተ ፡ እደዊሆሙ ፡ እንተ ፡የማን፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀኝ ፡ እጃቸው ፡ ዘመር ፡ ዘመስ ፡ ብለው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጽፉ ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእመ ፡ አኮ ፡ ውስተ ፡ ፍጽሞሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያውም ፡ ባይሆን ፡ በግንባራቸው ፡ ይጽፉ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ፡ ያዝዛቸዋል ፡ እንዲጽፉ ፡ ያደርጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋል ፡ ም ፡ ፲፬ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ወከመ ፡ አልቦ ፡ ዘይክል ፡ ወይጠ ፡ ወተሣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጦ ፡ እንበለ ፡ ጽሑፋን ፡ እሙንቱ ፡ ትእምርተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙ ፡ ለውእቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመር ፡ ዘመስ ፡ ብለው ፡ በቀኝ ፡ እጃቸው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተከተቡ ፡ በግንባራቸው ፡ ከጻፉ፡ ሰዎች፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀር ፡ የጻፉ ፡ ሰዎች ፡ እንጅ ፡ ዋጋ ፡ እንዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይገባላቸው ፡ ይከለክላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አው ፡ ዘኍልቈ ፡ ስሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘመርምያዋያስ ፡ ብለው፡ ከጻፉ፡ ሰዎች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀር ፡ የጻፉ ፡ ሰዎች ፡ ናቸው ፡ እንጅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእነሱ ፡ በቀር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "፲፰ ፤ ⟪ወዘሰ ፡ ጠቢብ ፡ ውእቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብልህ ፡ አዋቂ ፡ የሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘቦ ፡ ልብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕውቀት ፡ ያለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪የአምር ፡ ኍላቌሁ ፡ ለውእቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐሳዌ ፡ መሢሕን ፡ መጠኑን ፡ ያውቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ አምጣነ ፡ እጓለ ፡ እመሕያው ፡ ውእቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰው ፡ ልክ ፡ መጠን ፡ ሦስት ፡ ክንድ ፡ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስንዝር ፡ ቁመት ፡ ያለው ፡ እንደ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኍላቌሁኒ ፡ ስድስቱ ፡ ምእት ፡ ወስሳ ፡ ወስድስቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስድስት ፡ መቶ ፡ ስድሳ ፡ ስድስት ፡ አሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራው ፡ ያሉት ፡ የዕለተ ፡ ዐርብ ፡ ፍጥረት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ሆነ ፡ ያውቃል ። አንድም ፡ (ወዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰ) ፡ ብልህ ፡አዋቂ ፡ የሆነ ፡ (ወዘቦ) ፡ ዕው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀት ፡ ያለው ፡ የሐሳዌ ፡ መሢሕን ፡ የስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙን ፡ ቍጥር ፡ ያውቃል ፡ በእጓለ ፡ እመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕያው ፡ ልክ ፡ እንደ ፡ ሆነ ፡ መርምያዋያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ፡ እጓለ ፡ እመሕያው ፡ ሰባት ፡ ነው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስድስት ፡ መቶ ፡ ስሳ ፡ ስድስት ፡ ቍጥር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ፡ ሜም ፡ አርባ ፡ ምሜ ፡ አርባ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማንያ ፡ ዔ፡ ሰባ፡ ሰማንያና ፡ ሰባ ፡ መቶ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምሳ ፡ ሬስ ፡ ሁለት ፡ መቶ፡ ሳን ፡ ሦስት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወእምዝ፡ቆመ፡ዝክቱ፡በግዕ፡ላዕለ፡ደብረ፡ ጽዮን፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቀውም ፡ በግዕ ፡ ከመ ፡ ዘርጉዝ ፡ ብሎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነበረና ፡ ወእምዝ ፡ ቆመ ፡ አለ ፡ ዝክቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በግዕ ፡ ወልደ ፡ እግዚአብሔር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ በደብረ ፡ ጽዮን ፡ ቁሞ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አየሁ ፡ ምጽአት ፡ በደብረ፡ ጽዮን፡ ነውና።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በተራራ ፡ ላይ ፡ ያለ ፡ በዐፈር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጠጠር ፡ ብሎ ፡ ጠላቱን ፡ ድል ፡ እንዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሣ ፡ ድል ፡ ነሥቶ ፡ አየሁ ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመስቀል ፡ ድል ፡ ነሥቶ ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምስሌሁ ፡ ዐሠርቱ ፡ ወአርባዕቱ ፡ አልፍ ፡ ወአር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዓ ፡ ምእት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከእሱም፡ ጋራ፡ እንደ፡ እሱ፡ ዐሥራ፡አራት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እልፍ ፡ ካራት፡ ሽሕ፡ ሰማዕታት፡ ሕፃናት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድል ፡ ነሥተው ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ጽሑፍ ፡ ውስተ ፡ ፍጽሞሙ ፡ ስሙ ፡ ወስመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቡሁ ፡ ወስመ ፡ ቅዱስ ፡ መንፈሱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "በግንባራቸው ። አንድም ፡ በገጸ ፡ ልቡና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ስመ ፡ ተወላዲ ፡ ስመ ፡ ወላዲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመ ፡ ሠራጺ ፡ የተጻፈባቸው ፡ ም ፡ ፯ ፡ ፬፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "፱ ። ም ፡ ፫ ፡ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወመጽአ ፡ ቃል ፡ እምሰማይ ፡ ከመ ፡ ቃለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማይ ፡ ብዙኅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወደ ፡ ሰማይ ፡ እንዲህ ፡ የሚል ፡ ቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማሁ ፡ (ተሰማ) ፡ እንደ ፡ መጣያ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ፡ ቃል ፡ ያ ፡ ከሩቅ ፡ እንዲሰማ ፡ ከሩቅ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሰማ ፡ ማለቱ ፡ ነው ፡ ብዙኅ ፡ ባለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክቡድ ፡ ይላል፡ እንደ፡ ጉድጓድ ፡ ውኃ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ ፡ እንዲያስፈራ ፡ የሚያስፈራ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቶ ፡ አምሳን ፡ ቢጨምሩ ፡ ስድስት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቶ ፡ አምሳ ፡ ዋው ፡ ስድስት ፡ ዮድ ፡ ዐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥር ፡ ስድስት ፡ መቶ፡ ስሳ ፡ ስድስት ፡ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆናል ። ም ፡ ፲፯ ፡ ፱ ፡ ም ፡ ፲፭ ፡ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመ ፡ ቃለ ፡ ነጐድጓድ ፡ ዐቢይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ ታላቅ ፡ ነጐድጓድ ፡ ያለ ፡ ቃል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመ ፡ ቃለ ፡ መሰናቁት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ መሰንቆ ፡ ያለ ፡ ቃል ፡ ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሶበ ፡ ይሰነቀዉ፡ በበመሰንቆታቲሆሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "በየስልቱ ፡ በተመታ ፡ ጊዜ ፡ ም ፡ ፩ ፡ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወየኀልዩ ፡ ማኅሌተ ፡ ሐዲሰ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእንግዳ ፡ ምስጋና ፡ ያመሰግናሉ ፡ አም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላክ ፡ ሰው ፡ ሆነ ፡ ሰው ፡ አምላክ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ቅድመ ፡ መንበሩ ፡ ወቅድመ ፡ እልክቱ ፡ አርባዕቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንስሳሁ ፡ ወእልክቱኒ ፡ ሊቃናት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩ ፡ ፊት ፡ ባራቱ ፡ ኪሩቤል ፡ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኻያ ፡ አራቱ ፡ ሊቃናት ፡ ፊት ፡ (ታሪክ) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "የአሥሩ ፡ ነገድ ፡ ንጉሥ ፡ ኢዮራም ፡ የሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለቱ ፡ ነገድ ፡ ንጉሥ ፡ ኢዮሳፍጥ ፡ ይባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላሉ ፡ ንጉሠ ፡ ሞአብ ፡ ላሥሩ ፡ ነገድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንጉሥ ፡ ይገዛል ፡ ንጉሠ ፡ ኤዶምያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
