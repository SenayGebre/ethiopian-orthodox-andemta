      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጡ ፡ ቀዳማዊ ፡ መልአክ ፡ ሙሴ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐመደ፡ ዕቶኑን፡ ዘግኖ ፡ በግብፅ ፡ በበተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ጊዜ ፡ በግብፃውያን ፡ ይህ ፡ ሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታዘዘባቸው ፡ ዘፀአ ፡ ፱ ፥ ፰ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወከዐወ ፡ ካልእ ፡ መልአክ ፡ ጽዋዖ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሁለተኛው ፡ መንፈቅ ፡ ሁለተኛው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአክ ፡ በባሕር ፡ ጽዋዑን ፡ አፈሰሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ሥራውን ፡ ሠራ ፡ በሠራ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኮነት ፡ ባሕር ፡ ደመ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕር ፡ ደም ፡ ሆነች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሞተ ፡ ኵሉ ፡ ነፍሰ ፡ ሕይወት ፡ ዘውስተ ፡ ባሕር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በባሕር ፡ ተፈጥሮ ፡ በደመ ፡ ነፍስ ፡ ሕይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወት ፡ ሕያው ፡ ሆኖ ፡ የሚኖር ፡ ፍጥረት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ ሞተ ፡ አለ ፡ ጠፋ ፡ ምግብ ፡ ቢለወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥበት ፡ በፅምዕ፡ በሽሕ ፡ ቢመጡ ፡ ካልእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአክ ፡ ኢያሱ ፡ ነው ፡ በኢያሪኮ ፡ ሥራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ ሠራ ፡ አሕዛብ ፡ ጠፉ ፡ ዘፀአ ፡ ፯ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "፬ ፤ ⟪ወከዐወ ፡ ሣልስ ፡ መልአክ ፡ ጽዋዖ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍላግ ፡ ወውስተ ፡ አንቅዕተ ፡ ማያት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሦስተኛው ፡ መንፈቅ ፡ ሦስተኛው ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልአክ ፡ በአፍላግ ፡ በአንቅዕት ፡ ጽዋዑን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፈሰሰ ፡ አለ ፡ ሥራውን ፡ ሠራ ፡ አፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላግ ፡ አንቅዕት ፡ ሐተታ ፡ እንደ ፡ ቀደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "መው ፡ ም ፡ ፰ ፥ ፲ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኮኑ ፡ ደመ ፡ ኵሉ ፡ አንቅዕተ ፡ ማያት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንቅዕትም ፡ ሁሉ ፡ ደም ፡ ሆኑ ፡ ዘፀአ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "፯ ፥ ፲፱—፳፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "፭ ፤ ⟪ወይቤ ፡ መልአከ ፡ አንቅዕተ ፡ ማያት ፡ ጻድቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተ ፡ እግዚኦ ፡ ወራትዕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጋቤ ፡ ማያት ፡ መልአክ ፡ ነው ፡ ፈታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሒ ፡ በጽድቅ ፡ ኰናኒ ፡ በርትዕ ፡ የምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆን ፡ አቤቱ ፡ ዕውነትን ፡ የምትፈርድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕውነተኛ ፡ አቤቱ ፡ ቢል ፡ አንድ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘሀለውከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድመ ፡ ዓለም ፡ የነበርህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወትሄሉ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለሙን ፡ አሳልፈህ ፡ የምትኖር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመዝ ፡ ኰነንከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ ፡ ፈረድህ ፡ እንዲህ ፡ ፈረድህን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ ፡ ፈረድህ ፡ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "፮ ፤ ⟪እስመ ፡ ከዐዉ ፡ ደመ ፡ ቅዱሳኒከ ፡ ወነቢያቲከ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወዳጆችህ ፡ የነቢያት ፡ የሐዋርያትን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደም ፡ አፍስሰዋልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአስተይካሆሙ ፡ ደሞሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍዳቸውን ፡ አመጣህባቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ይደልዎሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚገባቸው፡ ስለ ፡ ሆነ። አንድም፡ በሽሕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢመጡ ፡ ሣልስ ፡ መልአክ ፡ ሳሙኤል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ በእስራኤል ፡ በልዑላኑ ፡ በትሑ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታኑ ፡ ሥራውን ፡ ሠራ ፡ (ወኮኑ) ፡ እስራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ጠፉ ፡ (ወይቤ) ፡ መጋቤ ፡ እስራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤል ፡ ኤሊ ፡ ነው ፡ ቅድመ ፡ ዓለም ፡ የነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርህ ፡ ዓለሙን ፡ አሳልፈህ ፡ የምትኖር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈታሒ ፡ በጽድቅ ፡ ኰናኒ ፡ በርትዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አቤቱ ፡ እንዲህ ፡ ፈረድህ ፡ (እስመ ፡ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐዉ ፡ ደመ) ፡ ነቢያት ፡ ካህናት ፡ በቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተው ፡ የሚሠውትን ፡ መሥዋዕት ፡ ሳይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቁ ፡ ሰውተዋልና ። አንድም ፡ የነቢያት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሐዋርያት ፡ ምሳሌ ፡ የሚሆን ፡ ደመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አባግዕን ፡ ሰውተዋልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፯",
          "line_type": "body",
          "text": "፯ ፤ ⟪ወሰማዕኩ ፡ ቃለ ፡ ዘይቤ ፡ በውስተ ፡ ምሥዋዕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዓለመ ፡ መላእክት ፡ እንዲህ ፡ የሚል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እወ ፡ እግዚኦ ፡ እግዚአብሔር ፡ ዘኵሎ ፡ ትመልክ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽድቅ ፡ ወርትዕ ፡ ኵነኔከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉን ፡ ፈጥረህ ፡ የምትገዛ ፡ በሁሉ ፡ አድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረህ ፡ የምትኖር ፡ አቤቱ ፡ ፍርድህ ፡ ጽድ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅ ፡ ርትዕ ፡ ነው ፡ የሚል ፡ ቃል ፡ ሰማሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፱ ፥ ፲፫ ። ም ፡ ፲፱ ፥ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "፰ ፤ ⟪ወከዐወ ፡ ራብዕ ፡ መልአክ ፡ ጽዋዖ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀሓይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባራተኛው ፡ መንፈቅ ፡ አራተኛው ፡ መል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክ ፡ በፀሓይ ፡ ሥራውን ፡ ሠራ ፡ በሠራ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተውህበ ፡ ሎቱ ፡ ሐሩር ፡ ከመ ፡ ያውዕዮ ፡ ለሰብእ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በእሳት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰውን ፡ በእሳት ፡ ያቃጥለው ፡ ዘንድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐሩር ፡ ተሰጠው ፡ የተሰጠውስ ፡ በተፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥሮ ፡ ነው ፡ ብሎ ፡ ሰውን ፡ በፅምዕ ፡ ይፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጀው ፡ ዘንድ ፡ ሲል ፡ ነው ፡ ሐተታ ፡ ዋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕዩ ፡ ጭራው ፡ ተለክቶ ፡ ተለክቶ ፡ ተመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥኖ ፡ ተመጥኖ ፡ የሚወጣበት ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽንሐሕ ፡ እንደ ፡ ግርግራ ፡ እንደ፡ አልጋ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "መለበምያ ፡ ያለ ፡ አለ ፡ ባራተኛው ፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቅ ፡ የማይሠራ ፡ ሥራ ፡ የለም ፡ መል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አኩ ፡ ያን ፡ ሰብሮ ፡ ይጥለዋል ፡ ዋዕየ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀሓይ ፡ ይጸናል ፡ ሰው ፡ ሁሉ ፡ በፅምዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያልቃልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወውዕየ ፡ ሰብእ ፡ በዐቢይ ፡ ሐሩር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ሁሉ ፡ በፅምዕ ፡ አለቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስከ ፡ ይፀርፉ ፡ ላዕለ ፡ ስመ ፡ እግዚአብሔር ፡ ዘው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "እቱ ፡ ሥሉጥ ፡ ላዕለ ፡ እልክቱ ፡ መቅሠፍታት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ፡ መቅሠፍት ፡ ማምጣት ፡ የሚቻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ፡ መሐሪ ፡ መስተሣሕል ፡ የሚባል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስመ ፡ እግዚአብሔርን ፡ ጽኑዕ ፡ ጨካኝ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብለው ፡ እስኪሰድቡ ፡ ድረስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢነስሑ ፡ ከመ ፡ ያእኵትዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያምኑበት ፡ ዘንድ ፡ አልተመለሱም ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ በሽሕ ፡ ቢመጡ፡ በኤልያስ ፡ ጊዜ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሆነውን ፡ መናገር ፡ ነው ፡ ቍ ፡ ፳፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፱ ፥ ፳ ፥ ፳፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወከዐወ ፡ ኀምስ ፡ መልአክ ፡ ጽዋዖ ፡ ላዕለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንበሩ ፡ ወላዕለ ፡ መንግሥቱ ፡ ለዝክቱ ፡ አርዌ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባምስተኛው ፡ መንፈቅ ፡ አምስተኛው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መልአክ ፡ በሐሳዌ ፡ መሢሕ ፡ በግዛቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "በከተማው ፡ ጽዋዑን ፡ አፈሰሰ ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራውን ፡ ሠራ ፡ በሠራ ፡ ጊዜ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጸልመት ፡ መንግሥቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "መንግሥቱ ፡ እጠፋ ፡ እጠፋ ፡ አለች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስከ ፡ ይሜጽሩ ፡ ልሳናቲሆሙ ፡ ሰብእ ፡ በሕማም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመከራው ፡ ጽናት ፡ የተነሣ ፡ ሰዎች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላሳቸውን ፡ እስኪያላምጡ ፡ ድረስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ጥቅ) ፡ እለ ፡ ሥርወ፡ ዕፅ ፡ ይሜጽሩ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ፡ ዘፀአ ፡ ፲ ፥ ፳፩ ። ኢሳ፡ ፰ ፥ ፳፩ ፥ ፳፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወእስከ ፡ ይፀርፉ ፡ ላዕለ ፡ እግዚአ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምነ ፡ ሕማመ ፡ አድልዕቲሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመከራውም ፡ ጽናት ፡ የተነሣ ፡ ሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዩን ፡ ምድሩን ፡ የብሱን ፡ ባሕሩን ፡ የፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠረ ፡ እግዚአብሔርን ፡ ጨካኝ ፡ ብለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስኪሰድቡ ፡ ድረስ ፡ (በሰማይ ፡ በምድር፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለ ፡ ቢል ፡ አንድ ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢነስሑ ፡ እምነ ፡ ግብሮሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከክፉ ፡ ሥራቸውም ፡ አልተመለሱም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ በሽሕ ፡ ቢመጡ ፡ ኢሳይያስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ በምናሴ ፡ በግዛቱ ፡ በከተማው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
