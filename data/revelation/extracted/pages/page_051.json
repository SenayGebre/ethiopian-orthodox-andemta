        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማዊት፡ጎኑ ፡ ተኝቶ ፡ ፵ ፡ ቀን ፡ ጾሞ ፡ ከስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድስት ፡ መቶ ፡ የሚበዙ ፡ ሙታን ፡ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሥቷል ፡ ኢሳ ፡ ፲፩ ፥ ፲፭ ፥ ፲፮ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "፲፫ ፤ ⟪ወእምዝ ፡ ወፅኡ ፡ እምነ ፡ አፉሁ ፡ ለዝክቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርዌ ፡ ቀዳማዊ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ በዲያብሎስ ፡ ሥልጣን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምአፉሁ ፡ ለሐሳዌ ፡ ነቢይ ፡ ሠለስቱ ፡ አጋንንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርኩሳን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሐሳዌ ፡ መሢሕ ፡ ትእዛዝ ፡ በሐሳዌ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤልያስ ፡ ሥልጣን ፡ ሦስት ፡ አጋንንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወጡ ፡ ርኩሳን ፡ ልዩ ፡ የሚሆኑ ፡ አጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንንት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከመ ፡ ቈርነናዓት ፡ እሙንቱ መንፈሰ ፡ አጋንንት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተሳቦ ፡ ቀንዳም ፡ ትል ፡ ዛጎል ፡ ል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሱ ፡ ጓጉንቸር፡ ይመስላሉ፡ (መንፈሰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንት) ፡ አጋንንት ፡ ናቸው ፡ ቢሉ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርየ ፡ አጋንንት ፡ አላቸው ፡ (አካለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጋንንት ፡ ቢሉ ፡ ይሆናል) ፡ ሰዎች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡ ቢሉ ፡ ሀብተ ፡ አጋንንት ፡ አድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮባቸዋል ፡ ም ፡ ፲፪ ፥ ፱ ። ም ፡ ፲፫ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም፡፲፫፥፲፩።ዘፀአ፡፰፥፮፥፩፡ነገሥ፡፳፪ ፥ ፳፩።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "፲፬ ፤ ⟪ወይገብሩ ፡ ተአምራተ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምትሐት ፡ ታምራት ፡ ያደርጋሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይወፅኡ ፡ ላዕለ ፡ ኵሉ ፡ ነገሥት ፡ እለ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵሉ ፡ ዓለም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባራቱ፡ መዓዘን፡ ወዳሉ ፡ ነገሥታት ፡ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጣሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያስተጋብእዎሙ ፡ ይትቃተሉ ፡ በዕለት ፡ ዐባይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንተ ፡ እግዚአብሔር ፡ ዘኵሎ ፡ ይመልክ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉን ፡ ፈጥሮ ፡ የሚገዛ ፡ ይመልዕ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢል ፡ በሁሉ ፡ አድሮ ፡ የሚኖር ፡ እግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ በሚፈርድባት ፡ በቍርፅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍርድ ፡ ቀን ፡ ይዋጉ ፡ ዘንድ ፡ ይሰበስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቧቸዋል ፡ (ይሰበስቧቸው ፡ ዘንድ ፡ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፅኡ ፡ ይሄዳሉ ፡ ቢል ፡ አንድ ፡ ነው) ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፲፫ ፥ ፲፫ ። ም ፡ ፲፱ ፥ ፲፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወናሁ ፡ እመጽእ ፡ ግብተ ፡ ከመ ፡ ሰራቂ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወብፁዕ ፡ ዘይተግህ ፡ ወየዐቅብ ፡ አልባሲሁ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይሑር ፡ ዕራቆ ፡ ወኢያስተርኢ ፡ ኀፍረቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወናሁ ፡ እመጽእ ፡ ግብተ ፡ ከመ ፡ ሰራቂ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሏልና ፡ ተግቶ ፡ ልብሱን ፡ የሚጠብቅ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰው ፡ ንዑድ ፡ ክቡር ፡ ነው ፡ (ከመ ፡ ኢይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑር ፡ ዕራቆ) ፡ ዕራቁቱን ፡ እንዳይሄድ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወኢያስተርኢ) ፡ ዕርቃኑ ፡ እንዳይገለጽ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ ሰውነቱን ፡ ተግቶ ፡ ከኃጢአት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚጠብቅ ፡ ሰው ፡ ንዑድ ፡ ክቡር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከክብር ፡ ባዶ ፡ እንዳይሆን ፡ ክብር ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳያጣ ፡ ፩ ፡ ተሰ ፡ ፭ ፥ ፪ ። ም ፡ ፫ ፥ ፲፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "፲፮ ፤ ⟪ወያስተጋብእዎሙ ፡ ውስተ ፡ መካን ፡ ዘስሙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርማርጌዶን ፡ በዕብራይስጥ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ያስተጋብኦሙ ፡ ቢል) ፡ በዕብራይስጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርማጌዶን ፡ በሚባል ፡ ቦታ ፡ ይሰበስባ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 4,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋል ፡ አለ ፡ ጌታ ፡ ነው ፡ ያስተጋብእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎሙ ፡ ሠለስቱ ፡ አጋንንት ፡ ያላቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሰበስቧቸዋል ፡ አርማጌዶን ፡ ማለት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መካነ፡ ድምሳሴ፡ መካነ ፡ ሥራዌ፡ ማለት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ መሳ ፡ ፭ ፥ ፲፱ ፥ ፴፩ ። ፪ ፡ ነገሥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "፱ ፥ ፳፯ና ፡ ፳፫ ፥፳፱ ። ዘካ ፡ ፲፪ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "፲፯ ፤ ⟪ወከዐወ ፡ ሳብዕ ፡ መልአክ ፡ ጽዋዖ ፡ ውስተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፋስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰባተኛው ፡ መንፈቅ ፡ ሰባተኛው ፡ መል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አክ፡ በነፋስ፡ ሥራውን፡ ሠራ፡ በሠራ፡ጊዜ፡",
          "word_wraps_to_next_line": false
        },
        {
