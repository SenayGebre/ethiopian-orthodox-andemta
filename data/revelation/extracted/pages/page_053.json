      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አነ ፡ እነግረከ ፡ ምሥጢራ ፡ ለዛቲ ፡ ብእሲት ፡ ወለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝክቱ ፡ አርዌ ፡ ዘይጸውራ ፡ ወሰብዐቱ ፡ አርእስቲሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዐሠርቱ ፡ አቅርንቲሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የዚያችን፡ ሴት፡ትርጓሜ፡የተሸከማትንም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውሬ፡የሰባቱንም፡ አርእስት፡ ያሥሩንም፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀንዶች ፡ ትርጓሜ ፡ እኔ ፡ እነግርሃለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪፰ ፤ ወዝክቱኒ ፡ አርዌ ፡ ዘርኢከ ፡ ሀለወ ፡ ወኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀለወ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያ ፡ ያየኸው ፡ አውሬ ፡ በገናንነት ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገናንነት ፡ የለም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሀለዎ ፡ ይዕርግ ፡ እምነ ፡ ቀላይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከከተማ ፡ ነግሦ ፡ ይወጣ ፡ ዘንድ ፡ አለው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና ፡ ሀለወ ፡ ላለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወየሐውር ፡ ለሙስና ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጥኖ ፡ ይጠፋልና ፡ ኢሀለወ ፡ ላለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይዴመሙ ፡ በእንቲአሁ ፡ እለ ፡ ይነብሩ ፡ ዲበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በምድር ፡ የሚኖሩ ፡ ሁሉ ፡ ያምኑበታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እለ ፡ ኢኮነ ፡ ጽሑፈ ፡ አስማቲሆሙ ፡ ውስተ ፡ መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐፈ ፡ ሕይወት ፡ ዘእምፍጥረተ ፡ ዓለም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ፡ ከተፈጠረ ፡ ዠምሮ ፡ ስማቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሕይወት ፡ መጽሐፍ ፡ ያልተጻፈ ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስማቸው ፡ በልበ ፡ እግዚአብሔር ፡ ለበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጎው ፡ ነገር ፡ ያልታወቀ ፡ ሰዎች ፡ ሁሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያምኑበታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሶበ ፡ ርእይዎ ፡ ለውእቱ ፡ አርዌ ፡ ከመ ፡ ሀለወ ፡ ወኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀለወ ፡ እንዘ ፡ ሀለወ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገናንነት ፡ ሳለ ፡ በገናንነት ፡ የሌለ ፡ እሱ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገናንነት ፡ እንዳለ ፡ ባዩ ፡ ጊዜ ፡ ያምኑ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በታል ። አንድም ፡ በልበ ፡ መናፍቃን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳለ ፡ በልበ ፡ ምእመናን ፡ የሌለ ፡ እሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልበ ፡ መናፍቃን ፡ እንዳለ ፡ ባዩ ፡ ጊዜ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያምኑበታል ፡ ም ፡ ፲፫ ፥ ፩ ፥ ፪ ። ም፡ ፲፫ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "፫ ። ም ፡ ፫ ፥ ፭ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪፱ ፤ ወዘቦ ፡ ልብ ፡ ወጥበብ ፡ የአምሮ ፡ ለዝንቱ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አእምሮ ፡ ያለው ፡ (ወጥበብ) ፡ ዕውቀት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያለው ፡ ይህን ፡ ያስተውለዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለዝንቱሰ ፡ አርዌ ፡ ወሰብዐቱ ፡ አርእስቲሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያየኸው ፡ አውሬ ፡ ትርጓሜ ፡ የሰባቱም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርእስት ፡ ትርጓሜያቸው ፡ ይህ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሰብዐቱ ፡ አርእስት ፡ ሰብዐቱ ፡ አድባር ፡ እሙንቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ዲቤሆሙ ፡ ትነብር ፡ ዛቲ ፡ ብእሲት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባቱ ፡ አርእስት፡ ሰባቱ ፡ አድባር፡ ናቸው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያች ፡ ሴት ፡ በላያቸው ፡ የተቀመጠችባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ፡ ም ፡ ፲፫ ፥ ፰ ። ም ፡ ፲፫ ፥ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "⟪፲ ፤ ወሰብዐቱ ፡ አድባር ፡ ሰብዐቱ ፡ ነገሥት ፡ እሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰባቱ ፡ አድባርም ፡ ሰባቱ ፡ ነገሥታት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኀምስቱ ፡ ወድቁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምስቱ ፡ አልፈዋል ፡ አለ ፡ ያልታወቁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአሐዱ ፡ ባሕቲቱ ፡ ሀለወ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱ ፡ ብቻ ፡ አለ ፡ ያልታወቀ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአሐዱ ፡ ኢመጽአ ፡ ዓዲ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱ ፡ ገና ፡ አልመጣም ፡ አለ ፡ ያልታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወቀ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሶበ ፡ መጽአ ፡ ይነብር ፡ ኅዳጠ ፡ መዋዕለ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመጣም ፡ ጊዜ ፡ ጥቂት ፡ ይቀመጣል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ፡ አምስቱ ፡ አልፈዋል ፡ ፈርዖን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጺሩጻይዳ፡ናቡከደነፆር፡ሰናክሬም፡ዲዮቅል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥያኖስ ፡ ናቸው ፡ ፈርዖን ፡ ለእግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔርኒ ፡ ኢየአምሮ ፡ ወለእስራኤልኒ ፡ ገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
