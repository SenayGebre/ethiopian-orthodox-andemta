          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦሙ ፡ ከመ ፡ ይኅበሩ ፡ በአሐዱ ፡ ምክር ፡⟫",
          "word_wraps_to_next_line": false
