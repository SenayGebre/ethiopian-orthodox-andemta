        },
        {
          "line_num": 14,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪፲፯ ፤ እስመ ፡ እግዚአብሔር ፡ ወደየ ፡ ውስተ ፡ ል",
          "word_wraps_to_next_line": true
        },
