          "text": "ምዕራፍ ፡ ፲፰ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪፩ ፤ ወእምድኅረ ፡ ዝንቱ ፡ ወረደ ፡ ካልዕ ፡ መል",
          "word_wraps_to_next_line": true
