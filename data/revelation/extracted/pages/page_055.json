        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይከውን ፡ መበለተ ፡ ላለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወያውዕይዋ ፡ በእሳት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
