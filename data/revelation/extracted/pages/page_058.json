        {
          "line_num": 1,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪፲፩ ፤ ወእምዝ ፡ ተርኅወ ፡ ሰማይ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ሰማይ ፡ ተከፈተ ፡ ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሰማይ ፡ መከፈት ፡ መዘጋት ፡ ኑሮበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይደለም ፡ የተዘጋ ፡ ቤት ፡ በተከፈተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጊዜ ፡ ያልታየ ፡ ዕቃ ፡ እንዲታይ ፡ ያልተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገለጸ ፡ ምሥጢር ፡ ተገለጸ ፡ ሲል ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወወፅአ ፡ ፈረስ ፡ ጸዓዳ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምባላይ ፡ ፈረስ ፡ ወጣ፡ ሲወጣ ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘይጼዐኖ ፡ ስሙ ፡ መሃይምን ፡ ወጻድቅ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተቀመጠበትም ፡ ስሙ ፡ መሃይምን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻድቅ ፡ ይባላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘበጽድቅ ፡ ይኴንን ፡ ወይፀብእ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዕውነተኛ ፡ ፈርድ ፡ ፍርድ ፡ የሚያጠፋ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ም፡ ፮ ፡ ፪ ። ም፡ ፩ ፡ ፭ና ፡ ፫ ፡ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፡ ፲፩ ፡ ፬ ፥ ፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪፲፪ ፤ ወአዕይንቲሁ ፡ ከመ ፡ ነደ ፡ እሳት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐይኖቹ ፡ እንደ ፡ ነደ ፡ እሳት ፡ ናቸው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ፡ ትእምርተ ፡ በቀል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዲበ ፡ ርእሱ ፡ አክሊል ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በራሱ ፡ ላይ ፡ አክሊል ፡ ደፍቷል ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምእመናን ፡ የሚሰጣቸው ፡ ክብር ፡ የባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕርዩ፡ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወጽሑፍ ፡ ውስተ ፡ ቀጸላሁ ፡ አስማት ፡ ዘአልቦ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘየአምሮ ፡ ዘእንበለ ፡ ውእቱ ፡ ባሕቲቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቀጸላውም ፡ ከእሱ ፡ በቀር ፡ ሌላ፡ የሚያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቀው ፡ የሌለ ፡ ስም ፡ ተጽፏል ፡ ም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ፲፬ና ፡ ፪ ፡ ፲፯ ። ም ፡ ፫ ፡ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፫",
          "line_type": "body",
          "text": "⟪፲፫ ፤ ወይለብስ ፡ ልብሰ ፡ ዘንዙሕ ፡ በደም ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደም ፡ የተረጨ ፡ ልብስ ፡ ለብሷል ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትስብእትን ፡ ተዋሕዷል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሰመዩ ፡ ስሞ ፡ ቃለ ፡ እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሙንም ፡ አካላዊ ፡ ቃል ፡ ይሉታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፡ ፷፫ ፡ ፩ ። ዮሐ ፡ ፩ ፡ ፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪፲፬ ፤ ወሐራ ፡ ሰማይ ፡ ይተልውዎ ፡ በአፍራስ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ጸዓድው ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መላእክት ፡ ባምባላይ ፡ ፈረስ ፡ ሆነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተከትለውታል ፡ አለ ፡ ሥልጣናቸውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናገር ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይለብሱ ፡ ሜላተ ፡ ብርሃን ፡ ንጹሐ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሩህ ፡ ልብስ ፡ ለብሰዋል ፡ አለ ፡ ጸጋቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ፡ መናገር ፡ ነው ፡ ም ፡ ፲፯ ፡ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪፲፭ ፤ ወይወፅእ ፡ እምነ ፡ አፉሁ ፡ ሰይፍ ፡ በሊሕ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘቦቱ ፡ ይቀሥፎሙ ፡ ለአሕዛብ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሕዛብን ፡ የሚያጠፋበት ፡ መቅሠፍት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በቃሉ ፡ ይታዘዛል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ ይርዕዮሙ ፡ በበትረ ፡ ኅጺን ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጎ ፡ በጎዎቹን ፡ በተወደደ ፡ ሥልጣን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይጠብቃቸዋል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወውእቱ ፡ ይከይዳ ፡ ለምከይደ ፡ ወይነ ፡ ሕምዘ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪መዓቱ ፡ ለእግዚአብሔር ፡ ዘኵሎ ፡ ይመልክ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉን ፡ ፈጥሮ ፡ የሚገዛ ፡ የእግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ፡ መዓቱ ፡ የሚፈጸምበትን ፡ አደባባይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተረግጧል ፡ አለ ፡ መዓቱ ፡ የሚፈጸምበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ፡ ሥልጣን ፡ ገንዘብ ፡ አድርጓል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፲፪ ፡ ፭ ። መዝ ፡ ፪ ፡ ፱ ። ም ፡ ፲፬፡፲፱።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፡ ፷፫ ፡ ፫ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪፲፮ ፤ ወጽሑፍ ፡ ውስተ ፡ ልብሱ ፡ ወውስተ ፡ ገቦሁ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ስም ፡ ዘይብል ፡ ንጉሠ ፡ ነገሥት ፡ ወእግዚአ ፡ አጋ⟫",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እዝት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በልብሱም ፡ ውስጥ ፡ በጎኑ ፡ ንጉሠ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገሥት ፡ እግዚአ ፡ አጋእዝት ፡ የሚል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጽፏል ፡ (ዕርቅ) ፡ በቀጸላው ፡ የተጻፈ",
          "word_wraps_to_next_line": true
