      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኍልቆሙሰ ፡ ከመ ፡ ኆፃ ፡ ባሕር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቍጥራቸውም ፡ ብዙ ፡ የብዙ ፡ ብዙ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፥ ሕዝ፡ ፴፰ ፥ ፪ ። ሕዝ፡ ፴፰ ፡ ፱ ፥ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "፱ ፤ ⟪ወዐርጉ ፡ ውስተ ፡ ስፍሓ ፡ ለምድር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድርን ፡ ያላብሷታል ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዐገትዋ ፡ ለትዕይንቶሙ ፡ ለቅዱሳን ፥ ወለሀገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድስት ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቅዱሳን ፡ ሀገር ፡ ኢየሩሳሌምን ፡ ከበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋት ፡ ይሠፍራሉ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዝ ፡ ወረደት ፡ እሳት ፡ እምሰማይ ፡ እምኀበ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ፡ ወበልዐቶሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ መቅሠፍት ፡ ከእግዚአብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሔር ፡ ዘንድ ፡ ታዝዛ ፡ ታጠፋቸዋለች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝ ፡ ፴፰ ፥ ፳፪ና፡ ፴፱ ፥ ፮ ። ዘካ ፡ ፲፪ ፥ ፱ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፲",
          "line_type": "body",
          "text": "፲ ፤ ⟪ወለዝክቱኒ ፡ ሰይጣን ፡ ዘያስሕቶሙ ፡ ወደይዎ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ ዐዘቅተ ፡ እሳት ፡ ወተይ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚያስታቸውንም ፡ ሰይጣን ፡ ጽኑ ፡ ሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃይ ፡ ባለበት ፡ በገሃነም ፡ ይጥሉታል ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኀበ ፡ ሀሎ ፡ ዝክቱ ፡ አርዌ ፡ ወሐሳዊ ፡ ነቢይ ፡ ከመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይደየኑ ፡ መዓልተ ፡ ወሌሊተ ፡ እስከ ፡ ለዓለመ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐሳዌ ፡ መሢሕ ፡ ባለበት ፡ ሐሳዌ ፡ ኤል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስም ፡ ባለበት ፡ በመዓልትም ፡ በሌሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትም ፡ ፍዳቸውን ፡ ለዘለዓለም ፡ ይቀበሉ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘንድ ። የገሃነመ፡ እሳት፡ መደበኛዋ፡ ሐሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዌ ፡ መሢሕ ፡ ነውና ፡ ኀበ ፡ ሀሎ ፡ አለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፲፱ ፥ ፳ ። ም ፡ ፲፬ ፡ ፲ ፥ ፲፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "፲፩ ፤ ⟪ወእምዝ ፡ ርኢኩ ፡ መንበረ ፡ ዐቢየ ፡ ወጸዓዳ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ብሩህ ፡ ታላቅ ፡ መንበርን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አየሁ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወእምዘ ፡ ይነብር ፡ ዲቤሁ ፡ ጐዩ ፡ እምቅድመ ፡ ገጹ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰማይ ፡ ወምድር ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "በመንበሩ ፡ ላይ ፡ ተቀምጦ ፡ ካለው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሱ ፡ ከፊቱ፡ መገለጽ፡ የተነሣ፡ ሰማይና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ ሸሹ ፡ አለ ፡ አለፉ ፥",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኀጥኡ ፡ መካነ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦታ ፡ ቦታነት ፡ አላገኙም ፡ ማቴ ፡ ፳፬ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "፴፭ ። ፪ ፡ ጴጥ ፡ ፫ ፡ ፯ ፥ ፲፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "፲፪ ፤ ⟪ወእምዝ ፡ መጽኡ ፡ ኵሎሙ ፡ ምውታን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐቢያን ፡ ወንኡሳን ፡ ወቆሙ ፡ ቅድመ ፡ መንበሩ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ፡ በኋላ ፡ ታላቁም ፡ ታናሹም ፡ ሙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታን ፡ ተነሥተው ፡ በመንበሩ ፡ ፊት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቆሙ ፥ (ይህ ፡ ይቀድማል) ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወከሠቱ ፡ ኵሎ ፡ መጻሕፍተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጻሕፍተ ፡ ብሉያት ፡ መጻሕፍተ ፡ ሐዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳት ፡ ተነገሩ ፡ ተመረመሩ ፡ ሐተታ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሊህ ፡ ባሉት ፡ የጸና ፡ መዳኑን ፡ እሊህ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሉት ፡ ያልጸና ፡ አለመዳኑን ፡ መናገር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወለመጽሐፈ ፡ ሕይወትሰ ፡ እንተ ፡ ባሕቲታ ፡ ከሠትዋ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጽሐፈ ፡ ሕይወት ፡ ወንጌል ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለብቻዋ ፡ ተነገረች ፡ አለ ፡ ድኅነት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማሰጠቷን ፡ መናገር ፡ ነው ። አንድም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "(ወከሠቱ) ፡ ምግባረ ፡ ኃጥአን፡ ተነገረች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተመረመረች ፡ አለ ፡ ዋጋ ፡ አለማሰጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቷን ፡ መናገር ፡ ነው ፥ (ወለመጽሐፈ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕይወትሰ) ፡ ምግባረ ፡ ጻድቃን ፡ ግን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለብቻዋ ፡ ተነገረች ፡ አለ ፡ ዋጋ ፡ ማሰጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቷን ፡ መናገር ፡ ነው ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተኰነኑ ፡ እልክቱ ፡ ምውታን ፡ በከመ ፡ ጽሑፍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ፡ ዝንቱ ፡ መጽሐፍ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በዚህ ፡ መጽሐፍ ፡ እንደ፡ ተጻፈ ፡ ሙታን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
