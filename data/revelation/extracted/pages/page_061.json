      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ፡ በገሃነም ፡ ጣሏቸው ፡ አለ ፡ ሞት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መግደሉን ፡ መቃብር ፡ መቀበሉን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "መተዋቸውን ፡ መናገር ፡ ነው ፡ (ዘምል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕት ፡ ተየ ፡ ዘምልዕተ ፡ ተይ ፡ ይላል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሞትሰ ፡ ዳግም ፡ ገሃነም ፡ ዘእሳት ፡ ውእቱ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለተኛ ፡ ሞትም ፡ ገሃነመ ፡ እሳት ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ ፡ ቆሮ ፡ ፲፭ ፡ ፳፮ ፥ ፶፬ ፥ ፶፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፡ ፳፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "፩ ፤ ⟪ወእምዝ፡ ርኢኩ፡ሰማየ፡ሐዲሰ፡ወምድረ፡ሐዳሰ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህም ፡ በኋላ ፡ ሐዲስ ፡ ሰማይ ፡ ሐዲስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድር ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ፡ ሰሰለ ፡ ሰማይ ፡ ቀዳማዊ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቀደመው ፡ ሰማይ ፡ አልፏልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወምድርኒ ፡ ቀዳሚት ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቀደመችው፡ ምድርም፡ አልፋለችና፡ መን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሥተ ፡ ሰማይ ፡ ተሰጠች ፡ ማለቱ ፡ ነው፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐተታ ፡ ሰማይ ፡ አላት ፡ ሰማይ ፡ አልፋ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሷ ፡ የምትተካ ፡ ስለ ፡ ሆነ ፡ ሰማያዊ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ ፡ ሠርተው ፡ የሚወርሷት ፡ ስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ሰማያውያን ፡ መላእክት ፡ የሚወር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሷት ፡ ስለ ፡ ሆነ ፡ ምድር ፡ አላት ፡ ምድር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልፋ ፡ እሷ ፡ የምትተካ ፡ ስለ ፡ ሆነ ፡ በም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድር ፡ በሠሩት ፡ ሥራ ፡ የምትወረስ ፡ ስለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ምድራውያን ፡ ጻድቃን ፡ የሚወር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሷት ፡ ስለ ፡ ሆነ ፡ በምድር ፡ ተድላ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋ ፡ ይፈጸማል ፡ በመንግሥተ ፡ ሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይም ፡ ተድላ ፡ ነፍስ ፡ ይፈጸማልና ፡ ሐዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ፡ አላት ፡ በተሐድሶ ፡ ጸንታ ፡ የምት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኖር ፡ ስለ ፡ ሆነ ፡ ከመታየት ፡ እንግዳ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናትና፡ ታድሰው፡ የሚወርሷት፡ ስለ፡ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕርኒ ፡ ተሥዕረት ፡ እንከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቅያኖስም ፡ አለፈች ፡ ኢሳ ፡ ፷፭ ፡ ፲፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "፪ ፡ ጴጥ ፡ ፫ ፡ ፲፫ ። ም ፡ ፳ ፡ ፲፩ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "፲፭ ፤ ⟪ወኵሉ ፡ ዘኢይትረከብ፡ ጽሑፈ፡ ውስተ፡ መጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሓፈ፡ ሕይወት፡ ይወድይዎ፡ ውስተ፡ ገሃነም፡ዘእሳት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሕይወት ፡ መጽሐፍ ፡ ያልተጻፈውን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁሉ ፡ አለ ፡ በልበ ፡ እግዚአብሔር ፡ ለበ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጎ ፡ ነገር ፡ ያልታወቀውን ፡ ሁሉ ፡ ጽኑ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥቃይ ፡ ባለበት ፡ በገሃነም ፡ ይጥሉታል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፡ ፲፱ ፡ ፳ ። ማቴ ፡ ፳፭ ፡ ፵፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "፪ ፤ ⟪ወሀገርኒ ፡ ቅድስት ፡ ሐዳስ፡ ኢየሩሳሌም ፡ ርኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክዋ ፡ ወረደት ፡ እምሰማይ ፡ እምኀበ ፡ እግዚአብሔር፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሀገር ፡ ቅድስት፡ ኢየሩሳሌምም፡ ከእግዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብሔር ፡ ዘንድ ፡ ተሰጠች ፡ ስትሰጥ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወድሉት ፡ ይእቲ ፡ ከመ ፡ መርዓት ፡ ሥርጉት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምታ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሴት ፡ ለባሏ ፡ ያጌጠች ፡ እንደ ፡ ሆነች ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በጣዕም ፡ በመዓዛ ፡ በብርሃን ፡ በስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያጌጠች ፡ ናት ፡ ዕብ ፡ ፲፩ ፡ ፲ ፥ ፲፮ ። ዕብ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፪ ፡ ፳፪ ። ገላት ፡ ፬ ፡ ፳፮ ። ም ፡ ፲፱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "፯ ፥ ፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "፫ ፤ ⟪ወሰማዕኩ ፡ ቃለ ፡ ዐቢየ ፡ እምሰማይ ፡ ዘይብል፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናሁ ፡ ቅድሳቱ ፡ ለእግዚአብሔር ፡ ምስለ ፡ እጓለ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "እመሕያው ፡ ኀደረት ፡ ምስሌሆሙ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከወደ ፡ ሰማይ ፡ እንዲህ ፡ የሚል ፡ ታላቅ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃል ፡ ሰማሁ ፡ መንግሥተ ፡ ሰማይ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምእመናን ፡ ተሰጠች ፡ የሚል ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ (ወእምዝ) ፡ ሐዲስ ፡ መለኮትና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐዲስ ፡ ትስብእት ፡ ተዋሕደው ፡ አየሁ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሥጋ ፡ አምላክ ፡ መሆን ፡ የአምላክ ፡",
          "word_wraps_to_next_line": false
        },
        {
