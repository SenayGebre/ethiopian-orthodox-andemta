          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነም ፡ ይሆናል ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዝንቱ ፡ ውእቱ ፡ ዳግም ፡ ሞት ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለተኛም ፡ ሞት ፡ ይህ ፡ ነው ፡ ዕብ ፡ ፲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "፳፮ ፡ ፳፱ ። ም ፡ ፳፪ ፡ ፲፭ ። ም ፡ ፳ ፡ ፲፬ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪፱ ፤ ወመጽአ ፡ አሐዱ ፡ እምነ ፡ እልክቱ ፡ ሰብዐቱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "መላእክት ፡ እለ ፡ ይጸውሩ ፡ ሰብዐተ ፡ ጽዋዐተ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ፡ ምሉዓን፡ ሰብዓተ፡ መቅሠፍተ፡ ደኃርያተ ፡ ወተ",
          "word_wraps_to_next_line": true,
          "stage1_text": "እለ ፡ ምሉዐን፡ ሰብዓተ፡ መቅሠፍተ፡ ደኃርያተ ፡ ወተ",
          "stage2_correction": {
