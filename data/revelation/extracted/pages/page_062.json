          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ይከውን ፡ ምንዳቤሆሙ ፡ ገሃነም ፡ ዘእሳት ፡ ወተይ ፡⟫",
          "word_wraps_to_next_line": false
        },
