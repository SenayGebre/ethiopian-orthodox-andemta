    {
      "column_index": 1,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠቁሮ ፡ አግኝቶታል ፡ ኋላ ፡ ጸልዮ ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልሶ ፡ አድኖታልና ፡ ሦስት ፡ ኅርወት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳለበት ፡ ሦስት ፡ ሥርዐት ፡ አፍር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሷል ፡ አክብር ፡ አባከ ፡ ወእመከን ፡ ኢት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክሥት ፡ ኃፍረተ ፡ ብእሲተ ፡ አቡከን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢትዘሙን ፡ በሐዲስ ፡ ዕንቍነቱ ፡ ከሮ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤል ፡ ቤት ፡ የተወለደ፡ የጴጥሮስ ፡ ዕንቍ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ጸሊም ፡ ወጻዓዳ ፡ እንደ ፡ ሆነ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞተ ፡ በሥጋ ፡ ወሐይወ ፡ በመንፈስ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እያለ ፡ ይጽፋልና ፡ ሦስት ፡ ኅርወት ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳለበት ፡ ሦስት ፡ ጊዜ ፡ ክዶታልና ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ፡ ለመጻሕፍቱ ፡ በሦስቱ ፡ ስም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርእስት ፡ ሰጥቷልና ። አንድም፡ ረዐይኬ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ፡ሦስት፡ጊዜ፡መላልሶ፡ ሹሞታልና፡ ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል፡ይሆናል ። ሰንፔር፡ ኅብሩ፡ፍሕም፡ ይመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስላል ፡ በብሉይ ፡ ዕንቍነቱ ፡ የስምዖን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕንቍ ፡ ነው ፡ ተናዶ ፡ ጠላቶቹን ፡ አጥፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቷልና፡(ጥቅ)፡ ስምዖን፡ ወሌዊ፡ ፈጸምዋ፡ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዐመፃ ፡ በቅንዓቶሙ ፡ ወበቃሕሞሙ ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ። በሐዲስ ፡ ዕንቍነቱ ፡ ከቤተ ፡ ስም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዖን ፡ የተወለደ ፡ የእንድርያስ ፡ ዕንቍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ተባዕ ፡ ለመስቀል ፡ በኵረ ፡ ሐዋር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያት፡ይለዋልና፡በአባት ፡ ከሮቤል፡ በእናት፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከስምዖን ፡ ይወለዳሉና ። ከአባት፡ ወገን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጴጥሮስን ፡ ከእናት ፡ ወገን፡እንድርያስን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመጣ ፡ ኬልቄዶን ፡ ኅብሩ ፡ ሐመል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚል ፡ ነው ፡ ብቃያ ፡ ይመስላል ፡ በብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉይ ፡ ዕንቍነቱ ፡ የይሳኮር ፡ ዕንቍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ በተግብሮ፡ ኗሪ፡ ነውና፡ (ጥቅ)፡ ይሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኮር፡ ፈተዋ፡ ለሠናይት፡ ወአትሐተ ፡ መት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከፎ ፡ ከመ ፡ ይትቀነይ ፡ ለምድር ፡ እን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲል ፡ በሐዲስ ፡ ዕንቍነቱ ፡ ከሳይኮር ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤት ፡ የተወለደ ፡ የማቴዎስ ፡ ዕንቍ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው ፡ ከሁሉ ፡ ይልቅ ፡ ምሳሌ ፡ ዘርዕን፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብዝቶ ፡ ጽፏልና ፡ መረግድ ፡ ኅብሩ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻዓዳ ፡ ወቀይሕ ፡ ነው ፡ እንደ ፡ አፈ ፡",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰይፍ ፡ ያለ ፡ መውጊያ ፡ አለበት ፡ በብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉይ ፡ ዕንቍነቱ ፡ የይሁዳ ፡ ዕንቍ ፡ ነው ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጻዓዳ ፡ እንደ ፡ ሆነ ፡ ጻዓዳ ፡ ስነኒሁ ፡ ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሐሊብ ፡ ወፍውሓት ፡ አዕይንቲሁ ፡ እም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይን ፡ ይለዋልና ። ቀይሕ ፡ እንደ ፡ ሆነ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የጠላቶቹን ፡ ደም ፡ ያፈሳልና ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፈ ፡ ሰይፍ ፡ ያለ ፡ መውጊያ ፡ አለበት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሁዳ ፡ እዴከ ፡ ዲበ ፡ ዘባኖሙ ፡ ለፀርከ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይለዋልና ። በሐዲስ ፡ ዕንቍነቱ ፡ ከይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁዳ ፡ ቤት ፡ የተወለደ ፡ የዮሐንስ ፡ ወልደ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘብዴዎስ ፡ ዕንቍ ፡ ነው ፡ ጻዓዳ ፡ እንደ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆነ ፡ ዮሐንስ ፡ ማለት ፡ ፍሥሐ ፡ ወሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሤት ፡ ርኅራኄ ፡ ወሣህል ፡ ማለት ፡ ነውና፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀይሕ ፡ እንደ ፡ ሆነ ፡ ደማችሁን ፡ አፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስሱ ፡ የምትል ፡ ሕገ ፡ ተስፋ ፡ ወንጌልን ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽፏልና ። አንድም ፡ ከጌታ ፡ ጎን ፡ ትኩስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደም ፡ ጥሩ ፡ ውኃ ፡ ሲፈስ ፡ አይቷልና ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ አፈ ፡ ሰይፍ ፡ ያለ ፡ መውጊያ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንደ ፡ አለበት ፡ ቀዳሚሁ ፡ ቃል ፡ ያላት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናፍቃንን ፡ አጋንንትን፡ እንደ፡ እሳት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታቃጥላቸዋለች ፡ እንደ ፡ መዶሻ ፡ ትቀጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅጣቸዋለች ፡ እንደ ፡ ሰይፍ ፡ ትቆራርጣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸዋለችና ። ሰርዶንክስ ፡ ኅብሩ ፡ ደም ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይመስላል ፡ ጽዕዳዌ፡ ዘይኄይሎ፡ ይላል ፡",
