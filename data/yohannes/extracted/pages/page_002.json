        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስትነትን ነገር የተናገረ። በዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህ ታዮጎሎስ ተብሏል ። ነባቤ",
