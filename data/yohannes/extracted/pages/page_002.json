        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እስመ አነ ወለድኩክሙ በት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሕርተ ክርስቶስ እንዲል፡⟪ት",
