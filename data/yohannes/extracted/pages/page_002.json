        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩፍ⟫ አለ። በክብርም በግብር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ፍጹም ነውና ⟪ረድዕ⟫ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጠኑ ለረድዕ እምከመ ኮነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
