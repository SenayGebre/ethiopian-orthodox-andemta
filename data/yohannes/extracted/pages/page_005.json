        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚህ ይልቅ የሚያስረዳ አነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውእቱ እግዚአብሔር አምላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከከ አምላከ አበዊከ አምላከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብርሃም አምላከ ይስሐቅ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምላከ ያዕቆብ ብለዋል ። አነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያንድነት አምላከ አምላከ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላከ የሶስትነት ። ዳዊትም ሣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህሉ ለእግዚአብሔር መልአ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምድረ ወበቃለ እግዚአብሔር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፀንዓ ሰማያት ። ወእምእስትንፋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰ አፉሁ ኵሉ ኃይሎሙ ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሏል ። በልጁ ህልው ሁኖ ስራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ሠራ ። ዳግመኛም ዓቢይ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግዚአብሔር ወዓቢይ ኃይሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአልቦ ኍልቍ ለጥበቢሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓቢይ እግዚአብሔር ። እግዚአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሔር አብ ፡ ወዓቢይ ኃይሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ወልድ ኃይሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለ ተገለጸበት ። ወአልቦ ኍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልቍ ለጥበቢሁ ፡ እግዚአብሔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር መንፈስ ቅዱስ ስለ ሀብቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዛት ። ዳዊት ይህን በተናገረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ፰፻ ዘመን ኢሳይያስ ፡ በዓመተ",
          "word_wraps_to_next_line": false,
          "stage1_text": "በ፪፻ ዘመን ኢሳይያስ ፡ በዓመተ",
          "stage2_correction": {
            "pair": "፪፻ -> ፰፻",
            "reason": "The Ethiopic numeral printed is ፰፻ (800), referring to the traditional 800-year reckoning between David and Isaiah, which was misread as ፪፻ (200)."
          },
          "uncertain": []
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞቱ ለዖዝያን ንጉሥ ርኢክዎ",
          "word_wraps_to_next_line": false,
          "stage1_text": "ሞቱ የዝያን ንጉሥ ርኢክዎ",
          "stage2_correction": {
            "pair": "የዝያን -> ለዖዝያን",
            "reason": "Canonical Ge'ez citation of Isaiah 6:1 ('በዓመተ ሞቱ ለዖዝያን ንጉሥ'). The ligature/spacing of ለዖዝያን was misread as የዝያን."
          },
          "uncertain": []
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለእግዚአብሔር እንዘ ይነብር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲበ መንበሩ ነዋህ ወብሩህ ወ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሉዕ ቤተ ስብሐቲሁ ወሱ",
          "word_wraps_to_next_line": true
        },
