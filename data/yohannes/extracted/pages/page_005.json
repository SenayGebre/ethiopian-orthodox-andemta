        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሆን አንዱ አምሳውን ሰሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን ነው ቢላቸው ይሆን የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምን ብሎ ከዚህ ይልቅ የጎላ",
