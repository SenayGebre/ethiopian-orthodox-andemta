        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢ ኤልያስሃ።⟫ ኤልያስን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካይደለህ ለምን ታጠምቃለህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ ዮርዳኖስን ከፍሎ መሻገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩን ጥምቀት ብሎለት፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢነቢየ⟫ ሙሴን ኢያሱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ካይደለህ ለምን ታጠምቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለህ፥ ለኒያ እስመ ለኵሎሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "አበዊነ አጥመቆሙ ሙሴ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደመና ወበባሕር ወተጠምቃ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "እገሪሆሙ ለካህናት ተብሎ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነግሮላቸዋል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "⟪ወአውሥአ ዮሐንስ ወይቤሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ አንሰ አጠምቀክሙ በማይ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴዎ ፫ ፲፩።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": "፳፮",
          "line_type": "body",
          "text": "እኔስ ለፀጅ ብርሌን ለልብስ ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላን እንዲያጥቡለት ለርሱ ጥም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀት በሚያበቃ ጥምቀት ለርሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተአምኖ ኃጣውእ በሚያበቃ ተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አምኖ ኃጣውእ አጠምቃችኋለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁ።አንድም በአፍ ብለህ መልስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ክርስቶስ ካይደለህ ለምን ሥርዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ለዋውጠህ ታስተምራለህ ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስቶስ በመጣ ጊዜ ሥርዓት ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋውጦ እንዲያስተምር መቅደስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትትሐነጽ እስከ ክርስቶስ ንጉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥ ወእምዝ ትትመዘበር ተብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሎ ተነግሮለታል ለኤልያስም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ይሚጥ ልበ አበው ኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውሉድ ተብሎ።ለኢያሱም ፤ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢየ ያነሥእ ለክሙ እምአኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊክሙ ተብሎ ተነግሮለታል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአውሥአ ዮሐንስ ወይቤሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ አንሰ አጠምቀክሙ በማይ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን ሥርዓት ለዋውጩ አስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተማርኩ።እኒያም በውሀ ያጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምቋችሁ ነበር። እኔም በውሀ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "አጠምቃችኋለሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወማዕከሌክሙ ሀሎ ይቀውም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘኢተአምርዎ አንትሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥርዓት ለዋውጦስ የሚያስተ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምር እናንተ የማታውቁት ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መካከላችሁ ቁሟል፤ኢተአም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዎ እንደ አምላክነቱ። ይቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውም። እንደ ሰውነቱ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "⟪ዘይመጽእ እምድኅሬየ ውእቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሀሎ እምቅድሜየ።⟫ ማር ፩ ፯",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉቃስ ፫ ፲፮ ግብ ፲፫ ፳፬ ፳፭",
          "word_wraps_to_next_line": false,
          "uncertain": [],
          "stage1_text": "ሉቃስ ፫ ፲፮ ግብ ፲፫ ፲ፅ ፲፯",
          "stage2_correction": {
            "pair": "፲ፅ ፲፯ -> ፳፬ ፳፭",
            "reason": "The Ethiopic numerals ፳፬ (24) and ፳፭ (25) were misread as ፲ፅ and ፲፯ due to faded crossbars; this is the canonical cross-reference to Acts (ግብረ ሐዋርያት) 13:24-25."
          }
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፱ ፬።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፳፯",
          "line_type": "body",
          "text": "ከኔ በኋላ የሚመጣው ከኔ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቀድሞ የነበረው ነው አለ ፤የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕርይ አምላክ ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ዘኢይደልወኒ እፍታሕ ቶታነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሣእኒሁ እምእገሪሁ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "የእግሩን ጫማ ልፈታ የማይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገባኝ። ዕፁር ማቴዎስ ፡ አድንን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማርቆስ፡ እፍታሕ ሉቃስ፡ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገናኛው ዮሐንስ እንዲህ ግን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለሆነ አድንን ይቀድማል እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍታሕ ይከተላል ዕፁር መጨ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረሻ ነው ይህን ተካፍለው ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈዋል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "⟪ወከመዝ ኮነ በቢታንያ በቤተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራባ በማዕዶተ ዮርዳኖስ በኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ ሀሎ ያጠምቅ ዮሐንስ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፳፰",
          "line_type": "body",
          "text": "ዮሐንስ ያጠምቅበት በነበረ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮርዳኖስ ማዶ ቢታንያ ቤተራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባ በሚባሉ አኅጉር እንዲህ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ ጉባዔ እንዲህ ያለ ክርክር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተደረገ። አንድም ቀድሞ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ ራባ የሚባሉ ነገሥታት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከተማ ሠርተውበት ኋላ ተፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትቷል ቀድሞ ከተማ ተሠር",
          "word_wraps_to_next_line": true
        },
        {
