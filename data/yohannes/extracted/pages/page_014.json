        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወርዱ ሁነዋልና ። አንድም አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላክ ሰው ሆነ ሰው አምላክ",
