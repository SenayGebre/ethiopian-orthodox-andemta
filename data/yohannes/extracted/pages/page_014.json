        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሀውን ጠጅ አድርግላቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብትዪኝ አይሆንም እልሽ ዘን",
