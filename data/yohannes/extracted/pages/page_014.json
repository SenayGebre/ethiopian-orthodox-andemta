        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፪ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወአመ ሣልስት ዕለት ከብካ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ኮነ በቃና ዘገሊላ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ወአመ ሳኒታ እንዘ ይቀውም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ ያለው እሑድ ። ወበሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒታ ፈቀደ ይሑር ገሊላ ። ሰኞ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአመ ሣልስት ማክሰኞ ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ከታች ውረድ ። ወአመ ሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒታ ርዕዮ ዮሐንስ፤ እሑድ ጌታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማክሰኞ ተጠምቆ ዕለቱን ሂዶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርባው ቅዳሜ ይፈጸማል ። እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑድ ገብቶ ያድራል አርባው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ቀን አንዳንድ ቀን አድርጎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሑድን ላርባው ቀን ሳኒታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ። በማቴዎስ ሀያ አምስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱን ዘመን አንዳንድ አድርጎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወበውእቱ መዋዕል እንዳለ ። ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመ ሳኒታ እንዘ ይቀውም ሰኞ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአመ ሳኒታ ፈቀደ ያለውና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወአመ ሣልስት ፤ ማክሰኞ ፡ ሣ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልስትነቱ ለእሑድ ። ሳኒታነቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሰኞ ፤ የገሊላ ክፍል በምትሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን በቃና በሶስተኛው ቀን ምሳ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰርግ ተደረገ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሀለወት ህየ እሙ ለእግዚእ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
