        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረች ። ቤተ ዘመድ ናትና ። አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ደግ ናትና ። ተጠርታ ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
