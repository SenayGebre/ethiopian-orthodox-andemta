        },
        {
          "line_num": 19,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪ወይቤላ እግዚእ ኢየሱስ ምን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ብየ ምስሌኪ አብእሲቶ ።⟫",
          "word_wraps_to_next_line": false,
          "uncertain": [
            {
              "printed_text": "አብእሲቶ",
