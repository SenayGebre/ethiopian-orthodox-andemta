        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ካንች ጋራ ምን ፀብ አለኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ወሀውን ጠጅ አድር",
