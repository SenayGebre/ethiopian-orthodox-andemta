          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ምልዕዎን፤⟫ አስተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሯቸው አላቸው ። ⟪ወመልዕዎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ፡⟫ ፍጹም ትምርት አስተማሯ",
          "word_wraps_to_next_line": true
        },
