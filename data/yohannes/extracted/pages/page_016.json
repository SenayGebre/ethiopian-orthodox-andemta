          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያእመረ እምኀበ አምጽእዎ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመጡበት ግን አላወቀም ። ⟪ወ",
