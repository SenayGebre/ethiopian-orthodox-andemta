          "text": "ምሥያጥ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባባቴ ቤት ገበያ አታድርጉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪ወተዘከሩ አርዳኢሁ ከመ ጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑፍ ውእቱ ዘይብል ቅንአተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤትከ በልዓኒ ።⟫ መዝ ፷፰ ፲",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ደቀመዛሙርቱም የቤትህ ቅና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አቃጠለኝ የሚል ጽሑፍ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳለ አሰቡ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "⟪ወአውሥእዎ አይሁድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "አይሁድም መለሱ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤልዎ ምንተ ትእምርተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታርኢ ዘዘንተ ትገብር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን የምትሠራ ምን ምልክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ታሳያለህ ማለት ከምድራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውያን ነገሥታት ከሌዋውያን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ካህናት ወገን ያይደለህ ገበያ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "መፍታትን ማን አሰናብቶህ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው አሉት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪ወአውሥአ እግዚእ ኢየሱስ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ጌታም መለሰ ። ⟪ወይቤሎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ንሥትዎ ለዝንቱ ቤተ መቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደስ ።⟫ ማቴ ፳፮ ፷፩ ። ማር ፲፬ ፶፰ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን ቤተ መቅደስ አፍርሱት ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበሣልስት ዕለት አነሥኦ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሦስተኛው ቀን አንጸዋለሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪ወይቤልዎ አይሁድ በ፵ ወ፮",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓመት ተሐንጸ ዝንቱ ቤተመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅደስ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "ይህ ቤተ መቅደስ በርባ ስድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ዓመት ተሠርቶ ነበር ።",
          "word_wraps_to_next_line": false,
          "uncertain": []
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንተሰ በሠሉስ መዋዕል ታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሥኦ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተስ በጎ በሶስተኛው ቀን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንጸዋለሁ አልክ ። ምን ይዘው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ አሉ ቢሉ ትሩፋን በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቢሎን ሳሉ ይህ ሁሉ መከራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባባቶቻችን የተደረገባቸው ቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ መቅደስን ባያሠሩ እንጂ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። እኛ ሚጠቱ የተደረገል",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን እንደሆነ ቤት ሳንሠራ ዘር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳንዘራ ቤተ መቅደስን እንሠራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለን ብለው ብፅዓት ገቡ ። ኋላ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚጠቱ ተደረገላቸው ። ዘር ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሩ ቤት ሲሠሩ ሁለት ዓመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ኑረዋል በሶስተኛው ጀም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረው ባርባ ስድስት ዓመት ሠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርተው ፈጽመዋል ። ይህም በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘሩባቤል መንግሥት ይታወቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ል የዘሩባቤል መላ ዘመነ መ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንግሥቱ አርባ ዘጠኝ ነው ። ሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይታነጽ ሁለት ዓመት ከታነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጸ በኋላ አንድ ዓመት ኑሮ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርፏል ። አንድም ዘመን ያጠራ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጥራሉ መሥራት በጀመሩ በ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስድስተኛው ዓመት አጀም ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንታ መጥተው አግቡን እናግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራችሁ አሏቸው ። ኦሪታቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይባእ ምዓበዊ ወአምናዊ",
          "word_wraps_to_next_line": false,
          "uncertain": []
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትላለችና አይሆንም አሉአቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። ዕርፅ ከአርጤክስስ ዘንድ ሂ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደው ነገር ሠሩባቸው ያች ሀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ዓላዊተ ነገሥት ናት ል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታምጽ ግንብ ትሠራለች ብለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ፡ አትሥሩ ብሎ አዋጅ ነገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረባቸው ተጀምሮ ቀረ ። ዓቢይ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አርጤክስስ ሙቶ ካልዕ አር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጤክስስ ነገሠ ፡ በናቱ አይሁዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዊ ነው የአርጤክስስ ልጅ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ከቃቤት ገብቶ ታሪክ ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "መለከት የቤተ መቅደስን ሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዓት ሞዓብ አሞን መገበራቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውን አገኘ ። ዛሬ እንደምን ሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነዋል ብሎ ጠየቀ መሥራት",
          "word_wraps_to_next_line": false
        },
