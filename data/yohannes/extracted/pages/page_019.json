        },
        {
          "line_num": 35,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "ኒቆዲሞስም ካደገ በኋላ ሁለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተኛ መወለድ ለሰው እንደም",
          "word_wraps_to_next_line": true
        },
