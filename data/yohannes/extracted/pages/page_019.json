        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ከርሠ እሙ ወይትወለድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳግመ ።⟫",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁለተኛማ ይወለድ ዘንድ ወ",
