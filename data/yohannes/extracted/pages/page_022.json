        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም ሥራቸው በጎ የሆነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሁድ ። አንድም ሥራቸው",
