      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ። አንተኑ ነግደ ለኢየሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌም አነ ኤርምያስ ያሉ ፋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርስ ባቢሎን በስደት ። ኢየሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሳሌም ከተፈታች ፷፮ ዓመት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንተ ለኢየሩሳሌም እንግዳ ነህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው ። ኦሪት አክብር ገጸ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረጋዊ ባትል ይህ ጅጃ አእም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሮውን ያጣ ሽማግሌ ብዬ በሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደብኩህ ነበር ። እነሆ መምሕሬ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤርምያስ ለድውያን የምንቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባው እጽቀ በለስ ቆርጠህ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጣ ብሎኝ ደሟ ይንጠፈጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋል ። ቅጠሏ አልጠወለገም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለው እስኪ አሳየኝ አለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢያይ ደምዋ እየተንጠፈጠፈ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅጠሏ ሳይጠወልግ አየ ። ላን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ተአምራት ቢደረግልህ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንጂ ሲልክህ ምን ወራት ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሯል አለው ። ወርኀ ዘርዕ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢለው ወርኀ ጽጌ ሆኖብሃልሳ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይለዋል ። ወርኀ ጽጌ ነው ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለው ወርኀ ዘርዕ ሁኖብሃልሳ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይለዋል ። ነገሩን በዚህ ይረዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ፡ ይልቅስ ና ከወንድምህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከባሮክ ላገናኝህ ብሎ ወስዶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አገናኘው ። የሚጠትን ነገር ግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጥልን ብለው ቀኖና ቢገቡ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ ዓመት እንደቀረው ተገለጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላቸው ። ወረቀት ጽፈው ማን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በወሰደልን ሲሉ የታዘዘ ንስር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቀረበ ። ወረቀቱን ከአንገቱ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥረው እጽቀ በለሱን ጨም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረው ሰደዱት ። ኤርምያስም ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገኑ ሰው ሙቶበት ከንጉሡ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "መቃብር ተካሶ ሊያስቀብር ሲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሄድ ከፈረሰ ግምብ ሥር አሳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርፎ ሳለ ኤርምያስ ኤርምያስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብሎ በቃል ሰብአዊ ጠርቶ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረቀቱን ጣለለት ። ወዲያው ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኬዶ ለምውት በእገሪሁ ይላል",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምውቱን ቢረግጠው ተነሥቶ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "የወረቀቱን ቃል መስክሮ አር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፏል ። ቃሉም ለሚጠት ፬ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "መት ቀርቶታልና የተጋባችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተፋቱ ያልተጋባችሁ ተጠበቁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚል ነው ክፉዎቹ ግን ሚጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ይደረግ እንጂ አገራችንን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማን ነሥቶን ሚስታችንንስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማን አፋቶን ብለው ዝም ብለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ኖሩ ። ጊዜው ቢደርስ ኤርም",
          "word_wraps_to_next_line": true,
          "stage1_text": "ው ኖሩ ። ጊዜው ቢያርስ ኤርም",
          "stage2_correction": {
            "pair": "ያ -> ደ",
            "reason": "The glyph is 'ደ' forming 'ቢደርስ' ('when the time arrived'), which was misread as 'ቢያርስ'."
          },
          "uncertain": []
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያስ ደጋጎቹን ይዞ ጉዞ ጀመረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኒያም ተከተሉት ፡አትከተሉኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "አትምጡብኝ ቀድሞ እንዲህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላችሁ አይሆንም ብላችኋል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አላቸው ፡ አሕዛብም እንዲህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲጠሏችሁ አትቀሩም የሚስት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "የልጅ አገርስ አገር አይደለምን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሏቸው ፡ ሳንገባስ እንቀርም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይሆንም ብለው ሄዱ ። ፈለገ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኤፍራጥስ ሲደርሱ ባሮክን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤሜሌክን አስረድቶ ገጠማቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። ድል አድርጎ ሰደዳቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተመልሰው ወደነበሩበት ሂዱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንግዴህ ወዲህስ አትምጡብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን አይሆንም ስንላችሁ እምቢ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላችሁ ሂዳችኋል ። የወደዱ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ቢያጡ ያጡትን ይቀላው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጡ እንዲሉ ፡ ብለው ሰደዷቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው እግራቸው እንዳይረሳቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሄደው አገር አቅንተው ኑረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ። ሠመርናሃ ብለዋታል ስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
