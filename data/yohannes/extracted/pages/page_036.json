        {
          "line_num": 1,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "⟪ኢይክል አንሰ ገቢረ ለልየ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምኀቤየ ወኢምንትኒ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፴",
          "line_type": "body",
          "text": "እኔ ምንም ምን ከራሴ ብቻ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንቅቼ አላስተምርም።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ በከመ ሰማዕኩ እኴንን።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "በህልውና እንደሰማሁ የሰማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁትን አስተምራለሁ እንጂ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵነኔየኒ ጽድቅ ውእቱ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምርቴም እውነት ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ኢየኀሥሥ ፈቃደ ዚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አየ ዘእንበለ ፈቃዱ ለዘፈነወኒ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የላከኝ የባቴን ፈቃድ ላደር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግ እወዳለሁ እንጂ የኔ ፈቃድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊደረግ አልወድምና። አንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም የኔ ፈቃድ ከባቴ ፈቃድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልዩ ሁኖ የኔ ፈቃድ ሊደረግ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልወድም የኔ ፈቃድ ከባቴ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቃድ ጋራ አንድ ነውና። የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቴ ፈቃድ ሊደረግ እወዳለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁ እንጂ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "⟪ወእመሰ ለልየ ስምዓ ኮንኩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለርእስየ ኢኮነ ጽድቀ ስምዕየ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "እኔ ለራሴ ብመሰክር ምስክርነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቴ እውነት አይደለም፡የርሱ ሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰት ሁኖ አይደለም ንጹሐን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነን በሚሉ ዘለፋ ሊሆንባቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነው እንጂ እርሱስ በሐልዮ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳልሠራ ለማጠየቅ።ይመጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "እ መልአኩ ለዝንቱ ዓለም ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢይረክብ በላዕሌየ ወኢምንተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒ ብሏል።በነቢብም እንዳልሠራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለማጠየቅ ፡ ነቢይ ኢገብረ ኃጢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አተ ወኢተረክበ ሐሰት ውስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ አፉሁ ብሎ መስክሮለታል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "በገቢርም እንዳልሠራ ለማጠ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "የቅ።መኑ ይዛለፈኒ በእንተ ኃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጢአት ብሏል።ንጹሐን ነን በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚሉ መፈራረጃ ሊሆንባቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዲህ አለ እንጂ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "⟪ወባሕቱ ካልዕ ውእቱ ሰማዕትየ⟫",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማቴ ፫ ፲፯ ዮሐን ፩ ፲፭ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፴፪",
          "line_type": "body",
          "text": "ምስክሬ ሌላ ነው አለ።ዮሐንስ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "፬ም ተአምራት፡መጻሕፍት፡አብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአአምር ከመ ጽድቅ ውእቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስምዑ ዘስምዓ ኮነ በእንቲአየ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለኔም የመሰከረው ምስክሩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "እውነት ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "⟪አኮኑ አንትሙ ለአክሙ ኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዮሐንስ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፴፫",
          "line_type": "body",
          "text": "እናንተ ወደ ዮሐንስ ልካችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "አልነበረምን።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነገረክሙ አምዐ በጽድቅ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንቲአየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስለኔ ምስክርነቱንስ በውነት ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግሯችሁ አልነበረምን።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "⟪ወአንሰ አኮ ስምዓ ሰብእ ዘእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቅድ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፴፬",
          "line_type": "body",
          "text": "ነገር ግን እኔ የሰውን ምስክር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት አልሻም።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ዘንተ ዘእብል ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንትሙ ትእመኑ ወትድኅኑ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ግን ይኸን የምናገር እና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ታምኑ ትድኑ ዘንድ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተ ታምኑ ትድኑ ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይህን እናገራለሁ እንጂ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "⟪ወዝንቱ ውእቱ ማኅቶት ዘይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": "፴፭",
          "line_type": "body",
          "text": "ሐቱ ወያበርህ።⟫ የሚያበራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋና ይህ ነው።ከዚያ ወለሊሁሰ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢኮነ ብርሃነ አለ፡ከዚህ እንዲህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አለ እንደምን ነው ቢሉ ፀሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ በወጣ ጊዜ የፋናን ብርሃን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚሻው እንደሌለ ጌታም ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተማረ ጊዜ የዮሐንስን ትም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
