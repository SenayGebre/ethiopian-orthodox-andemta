          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ፤ሀሎ ዝየ ወልድ ዘቦ ኃም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ኅብስተ ሰገም ወክልኤቲ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሣት ፡ እንደ ሉቃስ፡ለእመ ኢ",
          "word_wraps_to_next_line": true
        },
