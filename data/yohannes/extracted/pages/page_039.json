          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሖርነ ንሣየጥ ይሉታል።ይህን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ትታችሁ ግበሩ ምርፋቃተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይላቸዋል ፤ ይኸንስ ለምን ይሽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዋል ቢሉ ከወንድሞቹ ለማይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያዝ ሰማያዊ ኅብስትን የሚያ",
          "word_wraps_to_next_line": true
        },
