          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ አማን ነቢይ ውእቱ ዝንቱ",
          "word_wraps_to_next_line": false
        },
