          "stage1_text": "መጣ ነውና ክርሱ ለማነጻጸር።",
          "stage2_correction": {
            "pair": "ክርሱ -> ከርሱ",
            "reason": "The preposition prefix is 1st-order ከ ('ከርሱ ለማነጻጸር' = to compare with Him), misread as 6th-order ክ due to slight serif wear."
          },
          "uncertain": []
        },
        {
          "line_num": 29,
          "margin_tag": "፲፬",
          "line_type": "body",
          "text": "⟪ወርእዮሙ ሕዝብ ዘገብረ ተ",
          "word_wraps_to_next_line": true
        },
