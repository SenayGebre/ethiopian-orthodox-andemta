        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስ ፡ መገናኛው ዮሐንስ በተገና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝ አሰናብት አሉት።አሰናብት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቢሉት እንደ ፫ቱ አኮ መፍትው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሑሩ ርኁባኒሆሙ አላ ሀብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎሙ አንትሙ ዘይበልዑ አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው እንደ ማርቆስ፡ንሑርኑ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንሣየጥ በ፪፻ ዲናር ኅብስተ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ናበልዖሙ ለእሉ ይሉታል።እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንደ ዮሐንስ ፤ ዘ፪፻ ዲናር ኅብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስት ኢየአክሎሙ ከመ ይንሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኡ በበሕቅ ለለ ፩ዱ እምኔሆሙ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሉት፤እንደ ማርቆስ፤ሑሩ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርእዩ ሚመጠን ኅበውዝ ብክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙ ይላቸዋል።እንደ ሶስቱ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብነ ዝየ ዘእንበለ ኃምስ ኅብስት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወክልኤቲ ዓሣት እንደ ዮሐን",
          "word_wraps_to_next_line": true
        },
