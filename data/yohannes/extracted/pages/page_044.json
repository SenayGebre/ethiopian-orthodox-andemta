        },
        {
          "line_num": 22,
          "margin_tag": "፷፭",
          "line_type": "body",
          "text": "ዕውቀቱ ካባቴ ካልተሰጠው ስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለዚህ ነገር በኔ ማመን የሚ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቻለው የለም ብዬ እነግራች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኋለሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፷፮",
          "line_type": "body",
          "text": "⟪ወበእንተ ዝንቱ ነገር ብዙኃን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "እምአርዳኢሁ እለ ገብኡ ድኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሬሆሙ ወኢሖሩ እንከ ምስሌሁ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፷፮",
          "line_type": "body",
          "text": "ስለዚህ ማለት እንዲህ ስላላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው ከሕዝቡ ወገን ከርሱ ጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራ ያልሄዱ ወደኋላቸው የተ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መለሱ ብዙ ናቸው የተናገረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው አይቀርም አያደርገውን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይናገር ብለው ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፷፯",
          "line_type": "body",
          "text": "⟪ወይቤሎሙ እግዚእ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ፲ወ፪ቱ አርዳኢሁ አንትሙኒ",
          "word_wraps_to_next_line": false
        },
        {
