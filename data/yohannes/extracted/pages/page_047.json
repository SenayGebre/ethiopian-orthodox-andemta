        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ግር ተድላ ርእሱ የኃሥሥ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "ከራሱ አንቅቶ የሚያስተምር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ራሱን ደስ ሊያሰኝ ይወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳል። ለልየኑ እነግር ለርእስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "የ ዘሰ ለርእሱ ይነግር ተድላ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርእሱ የኃሥሥ ይላል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘሰ ይፈቅድ ያድሉ ለዘፈነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዎ ጻድቅ ውእቱ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላኪውን ደስ ሊያሰኝ የሚወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ ግን እውነተኛ ነው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአልቦ ዓመፃ በኀቤሁ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርሱም ሐሰት የለበትም፤አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ላኪየን ደስ ላሰኝ የም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወድ እኔ የባሕርይ አምላክ ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኝ ብዬ ባስተምር ሐሰት አላ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተምርም።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪አኮኑ ሙሴ ወሀበክሙ ኦሪተ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ዘፀ ፳፬ ፫። ሙሴ ኦሪ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ሰርቶላችሁ የለምን።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢ፩ሂ እምኔክሙ ኢትገብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርዋ ለኦሪት።⟫ ከናንተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "፩ዱ ስንኳ ኦሪትን አይሠራትም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድም አንዳችሁ ስንኳ ኦሪት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን አትሠሩዋትም።አንድም ⟪አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቦ ዘይገብራ ።⟫ የሚሠራት የለም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "⟪ለምንት እንከ ተኃሥዉ ወት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈቅዱ ትቅትሉኒ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፳",
          "line_type": "body",
          "text": "ኦሪትን የማንሠራት እንደም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ነው ትሉኝ እንደሆነ ኦሪት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢትቅትል ጻድቀ ትላለች ፥ጻድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቁ እኔን ልትገድሉኝ ለምን ት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሻላችሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "⟪ወአውሥኡ ሕዝብ ወይቤልዎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋኔንኑ ብከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "ሕዝቡም መለሱ ሎቱ ስብሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት ጋኔን አድሮብሃልን ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪መኑ የኃሥሥ ይቅትልከ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማን ሊገድልህ ይሻሃል አሉት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአውሥአ እግዚእ ኢየሱስ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጌታም መለሰ።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ፩ደ ግብረ ገበርኩ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ ሥራ ሠራሁ ጉሕቀት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን መጻጕዕን ፈወስኩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኵልክሙ አንከርከሙኒ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለጊዜው ሁላችሁ አደነቃች",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሁኝ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "⟪በእንተ ዝንቱ ወሀበክሙ ግዝ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረተ።⟫ዘሌ ፲፪ ፫ ዘፍ ፲፯ ፲ ፡",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "ስለዚህ ማለት ጥንቃቄ አይሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድስ እንዳይሆን ሙሴ ግዝረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትን ሠርቶላችኋል፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኢኮነት እምኀበ ሙሴ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እፎ የአምር ዝንቱ መጽሐፈ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘኢመሐሮ መኑሂ ብለውት ነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "በርና ታሪክ አያውቅም እንዳ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይሉት ነገር ግን በሙሴ አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጀመረችም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ እምአበው ይእቲ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "በነአብርሃም ነው እንጂ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበሰንበት ትገዝርዎ ለሰብእ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅዳሜ የተወለደውን ቅዳሜ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትገዝሩታላችሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "⟪ወእመሰ በሰንበት ግዝረተ ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነሥእ ብእሲ ከመ ኢይሠዓር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕጉ ለሙሴ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "ዘኢተገዝረ ክተማ ነፍስቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አመ ሳምንትዕለት ብላ ኦሪት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "የተናገረችው እንዳይፈርስ ቅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዳሜ የምትገዝሩት ከሆነ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ለምንት እንከ ሊተ ትግዕዙ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒ ለእመ አሕየውክዎ ለብእ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሲ ኵለንታሁ በሰንበት፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰውን ሁለንታ ሥጋውን በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተአምራት ሁለንታ ነፍሱን በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምርት ቅዳሜ ባድነው ለም",
