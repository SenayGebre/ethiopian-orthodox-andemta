        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገር ከቶ ሰው ተናግሮት አያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቅም አሏቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፵፯",
          "line_type": "body",
          "text": "⟪ወአውሥኡ ፈሪሳውያን።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": "፵፯",
          "line_type": "body",
          "text": "ፈሪሳውያንም መለሱ። ⟪ወይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቤልዎሙ ትጌግዩኑ አንትሙኒ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተም ተስታላችሁን አሏ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቸው።ዋዌው ለሐዋርያት ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": "፵፰",
          "line_type": "body",
          "text": "⟪ቦኑ እመላእክት ወእምፈሪሳው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያን ዘአምነ ቦቱ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፵፰",
          "line_type": "body",
          "text": "ወይስ ከለቆች ከፈሪሳውያን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ወገን ያመነበት አለ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፵፱",
          "line_type": "body",
          "text": "⟪ዘእንበለ እሉ ጊጉያን ሕዝብ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "እለ ኢየአምሩ ኦሪተ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፵፱",
          "line_type": "body",
          "text": "ኦሪትን ከማያውቁ ከኒህ ስሁታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን በቀር።⟪ወእሙንቱሰ ርጉማን፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እነሱ ግን የተረገሙ ናቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": "፶",
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ኒቆዲሞስ ዘሖረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኀቤሁ ለእግዚእ ኢየሱስ ቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲሙ ሌሊተ አሐዱ እምኔ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆሙ።⟫ዮሐ ፫ ፪።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፶",
          "line_type": "body",
          "text": "አስቀድሞ በሌሊት ወደ ጌታ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሄደ ከርሳቸው አንዱ ኒቆዲ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሞስ አላቸው።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፶፩",
          "line_type": "body",
          "text": "⟪ኦሪትክሙኑ ትኴንኖ ለሰብእ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘእንበለ ይሕትትዎ ቅድመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወያእምሩ ምግባሮ ዘገብረ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘዳ ፲፱ ፲፯።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": "፶፩",
          "line_type": "body",
          "text": "ኦሪትነኑ ሲል ነው በእንተ ክ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብርክሙ እንዲል ። ከርሳቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወገን የሚሆን አስቀድሞ በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሌሊት ወደ ጌታ የሄደ ኒቆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲሞስ ኦሪታችን ስራውን አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስቀድሞ መርምሮ ሳያውቁ ፍ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረዱበት ትላለችን አላቸው፤አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድም እርሱ አምኑዋልና።ኦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሪትክሙኑ ይላል።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": "፶፪",
          "line_type": "body",
          "text": "⟪ወአውሥእዎ ወይቤልዎ አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተኒ እምገሊላኑ ትብል አንተ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": "፶፪",
          "line_type": "body",
          "text": "አንተም አዋቂው እንዳላዋቂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትሆናለህ አሉት።",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ኀሥሥ መጽሐፈ ወትርአይ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ እምገሊላ ኢይትነሣእ ነቢይ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቢይ ከገሊላ እንዳይነሣ ከመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሐፍ ሻ መርምር።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": "፶፫",
          "line_type": "body",
          "text": "⟪ወገብኡ ኵሉ ለለ አሐዱ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስተ ቤቶሙ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፶፫",
          "line_type": "body",
          "text": "ሁሉም እያንዳንዳቸው ወደቤ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ታቸው ተመለሱ። ሻ መርም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ር ብለውታልና ሊሹ ሊመረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምሩ፤አንድም እርስ በርሳቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተጃመሩ ይሉናል ብለው፤አን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድም ነገራቸው ቢፈርስባቸው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላቴኖቻቸው ግሙራ ኢተና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገረ ሰብእ ዘከመ ተናገረ ው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እቱ ብእሲ አሉ፤ኒቆዲሞስ ኦ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሪትክሙኑ ትኴንኖ ለሰብእ አለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "በእንተ ዘማዊት ብእሲት።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "chapter_title",
          "text": "ምዕራፍ ፰።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "⟪ወኢየሱስኒ ሖረ ውስተ ደብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረ ዘይት፤⟫ ጌታ በምኵ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ራብ ሲያስተምር ውሎ አዳሩ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ን ወደ ደብረ ዘይት ሄደ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "⟪ወአንግሀ በጽባሕ ወቦአ ካዕበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምኵራበ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፪",
          "line_type": "body",
          "text": "ወኮነ መዓልተ ይሜህር በም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኵራብ ወሌሊተ ይበይት ውስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ደብረ ዘይት እንዲል፤ሌ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሊት በደብረ ዘይት ሲጸልይ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድራል፤ቀን በምኵራብ ሲያስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተምር ይውል ነበርና ማለዳ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገሥግሦ ወደምኵራብ ሄደ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወተጋብኡ ኵሉ ሕዝብ ኀቤሁ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕዝቡ ሁሉ ወደርሱ መጡ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወነበረ ይምሐሮሙ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
