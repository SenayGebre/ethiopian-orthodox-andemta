          "margin_tag": "፵፱",
          "line_type": "body",
          "text": "ጌታም መለሰ ሳምራዊ ላሉት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "አይመልስላቸውም በስመ ትዕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይርቱ ተጠቅመንበታልና ፡ እኔስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋኔን የለብኝም አላቸው ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ አከብር አባየ ፡⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ግን አባቴን አከብራለሁ ፤",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አክብር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "አከብር ዘንድ ነው እንጂ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአንትሙሰ ታስተሐቅሩኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትንቁኛላችሁ ማለት እናንተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ግን ዕሩቅ ብእሲ ትሉኛላችሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፶",
          "line_type": "body",
          "text": "⟪አንሰ ኢየኀሥሥ ተድላ ለር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
