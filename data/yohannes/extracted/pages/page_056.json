        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምላክ ነኝ ብዬ አላስተምርም",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ሀሎ ዘየኀሥሥ ሊተ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
