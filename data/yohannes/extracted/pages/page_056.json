        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሕኩ ርእስየ ኢይበቍዓኒ ስብሐ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትየ ወኢምንተኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ራሴን ባከብር ምሥጋናዬ",
