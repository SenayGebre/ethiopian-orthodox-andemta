        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለልማዱ ጠባቂውን ከጠባቂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "አስጠባቂውን ከአስጠባቂ አነጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጽሮ መናገር ይገባ ነበር እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርሳቸው ግን አስጠባቂውን ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠባቆች አነጻጽረው ተናገሩ",
