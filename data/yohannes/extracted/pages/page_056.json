        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምን አሉት ። ሳምራዊ ያይወል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
