          "margin_tag": "፵፱",
          "line_type": "body",
          "text": "⟪ወአውሥአ እግዚእ ኢየሱስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወይቤሎሙ አንሰ ጋኔን አል",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብየ ፥⟫",
