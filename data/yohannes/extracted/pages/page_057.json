          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይክል ቦቱ አሐዱሂ ገቢረ ፤⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱ ስንኳ ስራ ሊሰራበት የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማይችልበት ሞት አለብኝና ፡ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፍዳ የነጻንበትን ልጅነት ያገኘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንበትን ሞቱን ስለምን በሌሊ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት መሰለው ቢሉ ሰው በመ",
