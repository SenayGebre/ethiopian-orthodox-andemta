        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሐዱሂ እምዘ ሀሎ ውስተ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ።⟫ በዚህ ዓለም ካለው ስራ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንዱን ስንኳ ልትሰሩበት የ",
          "word_wraps_to_next_line": true
        },
