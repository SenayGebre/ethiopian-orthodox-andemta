          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማትችሉበት ሞት አለባችሁና",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "መዓልት ዕድሜያችሁ ሳለ ያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባቴን ስራ ሰርቼ እናንተን ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
