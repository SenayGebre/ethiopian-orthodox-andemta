        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንዳይሠራው እርሱም በሕይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወተ ሥጋ ሳለ የሚሰራውን",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከሞተ በኋላ አይሠራውምና",
          "word_wraps_to_next_line": false
        },
