        {
          "line_num": 1,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "⟪ወበከመ የአምረኒ አብ ፤⟫ ማቴ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፩ ፳፯ ሉቃ ፲ ፳፪ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፭",
          "line_type": "body",
          "text": "አብ ሙት ተሰቀል እንዳለኝ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አነኒ አአምሮ ለአብ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔም ልሞት ልሰቀል እንደ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "መጣሁ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እሜጡ ነፍስየ ቤዛ አባግዕየ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለምዕመናን ቤዛ ለሕማም ለሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አሳልፌ ሰውነቴን እሰጣለሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ወብየ ካልዓትኒ ዓባግዕ እለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢኮና እምዝንቱ ዓፀድ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "በዚህ ቦታ የሌሉ ሌሎች በጎ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ች አሉኝ በኢየሩሳሌም የሌሉ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ፬ቱ ማዕዘን ያሉ ሌሎች አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉኝ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወኪያሆንሂ ሀለወኒ አምጽኦን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዝየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደዚህ አመጣቸው ዘንድ ማ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለት እርሳቸውንም በሃይማኖት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "አንድ አደርጋቸው ዘንድ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኝ ፥ አድምኦን ይላል አስተም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራቸው ዘንድ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይሰምዓኒ ቃልየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትምርቴን ይቀበሉኛል ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወይከውና አሐደ መርዔተ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አሐዱ ኖላዊ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ላንድ ጠባቂ መንጎች ይሆና",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሉ ላንድ ለክርስቶስ አካል ብ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልት ላንድ ኤጲስ ቆጶስ ማኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "በር ቤተ ሰብእ ይሆናሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪ወበእንተዝ ያፈቅረኒ አብ እስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ አነ እሜጡ ነፍስየ ቤዛ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባግዕየ ከመ ካዕበ አንሥእ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሳ ፶፫ ፯ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ዳግመኛ አሥነሣት ዘንድ ሰው",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነቴን ለሕማም ለሞት አሳልፌ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "እሰጣለሁና ስለዚህ አብ ይወደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኛል ፥ ያልተካከለ ። ትንሣኤውን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለሞቱ ካዕበ አለ ፥ አንድም የ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተካከለ ነው ፥ በሕይወት ለመኖ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 2,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሩ ትንሣኤውን ካዕበ አለ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 2,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "⟪ወአልቦ ዘየሐይደንያ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "ያለኔ ፈቃድ ነፍሴን ከሥጋዬ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሚለያት የለም ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አላ ለልየ እሜጥዎ በፈቃድየ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኔ ወድጄ እለያታለሁ እንጂ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ ብውሕ ሊተ አመጥዎ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍሴን ከሥጋዬ እለያት ዘንድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይገባኛልና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪አንብራሂ ፥⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነፍሴን ከሥጋዬ ለይቼ በገነት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአሢማ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥጋዬን ከነፍሴ ለይቼ በመቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብር አኖራት ዘንድ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወብውሕ ሊተ ካዕበ አንሥእ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደግሞም አስነሣት ዘንድ ይቻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለኛል ። አንድም አንብራ ፡ ሥጋ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዬን በመስቀል ፥ አሢማ ፥ በመቃ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብር ፥ አንሥአ በትንሣኤ ። አንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ሥጋዬን ከነፍሴ ለይቼ ሥ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጋዬን በመቃብር ነፍሴን በገነ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ት አንሥአ በትንሣኤ ። አንድ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም አንብራሂ ነፍሴን ከሥጋዬ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለይቼ በገነት ፥ ሥጋዬን ከነፍሴ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለይቼ በመቃብር ። ወአንሥአ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "በትንሣኤ ፥ ወአሢማ ፡ በእርገት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "በየማነ አብ በዘባነ ኪሩብ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘንተ ትእዛዘ ነሣእኩ እምኀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "በ አቡየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "አዋሀዶ ማስነሣትን ካባቴ ገ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዘብ አደረግሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪ወተናፈቁ እንከ ካዕበ አይሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድ በበይናቲሆሙ በእንተ ዝን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቱ ነገር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
