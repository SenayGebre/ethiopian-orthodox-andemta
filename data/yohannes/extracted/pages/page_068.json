        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "እናንተ ታምኑ ዘንድ ። አስቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድሞ አውቆ የነገረን የባሕር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 3,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይ አምላክ ቢሆን እንጂ ነው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብላችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ንዑ ንሑር ኀቤሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነገር ግን ኑ ወደርሱ እንሂድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "⟪ወይቤሎሙ ቶማስ ዘይብልዎ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዲዲሞስ ለቢጹ ለአርዳእ ን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሑርኬ ንሕነኒ ከመ ንሙት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስሌሁ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፲፮",
          "line_type": "body",
          "text": "ንሑር ምስሌሁ ከመ ንሙት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምስሌሁ ። ዲዲሞስ የተባለ ቶ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማስ ወንድሞቹን ሐዋርያትን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኛም ከርሱ ጋራ እንደርሱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "እንሞት ዘንድ እንሂድ አላቸ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "ው ። ሹመት ሽልማት እናገኛ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለን ብለን ተከትለነው ነበር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሹመቱን ሽልማቱን ሳናገኝ እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንሙት ። የቂላ በሬ ጤፉን ሳይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "በሉ ጣፊያውን እንዲሉ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "⟪ወሖረ እግዚእ ኢየሱስ ቢታንያ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፲፯",
          "line_type": "body",
          "text": "ጌታ ወደ ቢታንያ ሄደ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወበጺሖ ህየ ረከቦ በዘወድአ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረቡዓ መዋዕለ ፡ እምዘ ተቀብረ⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዚያም በደረሰ ጊዜ ከተቀበረ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "አራት ቀን ሆኖት አገኘ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "⟪ወቢታንያሰ ቅርብት ይእቲ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢየሩሳሌም መጠነ ፲ ወ፭ቱ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምዕራፍ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": "፲፰",
          "line_type": "body",
          "text": "ቢታንያ ግን ከኢየሩሳሌም ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሥራ አምስት ምዕራፍ ትቀር",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ ነበረች ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "⟪ወብዙኃን እምነ አይሁድ እለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሖሩ ኀበ ማርያ ወማርታ ከመ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያላቅስዎን በእንተ እኁሆን ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 36,
          "margin_tag": "፲፱",
          "line_type": "body",
          "text": "ወንድማቸው አልዓዛር ስለሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተ ሊያላቅሱላት ወደማርያና",
