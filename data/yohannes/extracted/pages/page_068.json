        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወደማርታ የመጡ አይሁድ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብዙ ናቸው ።",
          "word_wraps_to_next_line": false
        },
        {
