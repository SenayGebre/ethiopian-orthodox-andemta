        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወማርያሰ ነበረት ቤተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ተርፈት ሲል ነው ፤ ወነበረት",
