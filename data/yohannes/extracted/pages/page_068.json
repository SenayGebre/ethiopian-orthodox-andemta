        },
        {
          "line_num": 7,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውስተ ኢየሩሳሌም እንዲል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማርያ ግን ከቤት ቀረች ። ሰው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከቤት አስቀምጦ መውጣት አ",
