        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይገባምና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "⟪ወትቤሎ ማርታ ለእግዚእ ኢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሱስ ሶበሰ ሀሎከ ዝየ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኢሞተ እኁየ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 14,
          "margin_tag": "፳፩",
          "line_type": "body",
          "text": "ማርታም ጌታዬ ከዚህ ኑረህ ቢ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሆን ወንድሜ ባልሞተም ነበር ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 16,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "⟪ወይእዜኒ አእምር ከመ ዘሰአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልከ ለእግዚአብሔር ይሁበከ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "እግዚአብሔር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፳፪",
          "line_type": "body",
          "text": "እግዚአብሔር የለመንከውን እ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንዲያደርግልህ አውቃለሁና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድውይ መፈወስ እንጂ ሙት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማንሣት የማይቻለው መስሏት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "⟪ወይቤላ እግዚእ ኢየሱስ እኁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኪሰ ይትነሣእ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፳፫",
          "line_type": "body",
          "text": "አንች አላመንሽም እንጂ ወን",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድምሽስ ይነሣል አላት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "⟪ወትቤሎ ማርታ አእምር ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ ይትነሣእ አመ ትንሣኤ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሙታን በደኃሪት ዕለት ።⟫ ሉ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቃ ፲፬ ፲፩ ዮሐ ፭ ፳፱ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፳፬",
          "line_type": "body",
          "text": "የኋላውን የነገራት መስሏት በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕለተ ምጽአት ሙታን በሚነ",
