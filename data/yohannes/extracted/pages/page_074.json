        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ራሱን በኅጠተ ሥርናይ መስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 7,
          "margin_tag": null,
