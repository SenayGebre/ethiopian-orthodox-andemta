        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "መናን በተሐድሶ ይኖራሉ ፥ በ",
          "word_wraps_to_next_line": true
        }
      ]
    },
    {
      "column_index": 3,
      "lines": [
        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሚያመጣው ፥ ደሙን በወይን",
          "word_wraps_to_next_line": false
        },
