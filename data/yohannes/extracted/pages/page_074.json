          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈራለች ፻ ፷ ፴ ። አንድም ⟪ኅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ጠተ ሥርናይ⟫ እኔ ካልሞትሁ",
