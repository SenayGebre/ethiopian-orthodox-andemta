          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፴፩",
          "line_type": "body",
          "text": "⟪ወናሁ እብለክሙ ይእዜ በጽ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
