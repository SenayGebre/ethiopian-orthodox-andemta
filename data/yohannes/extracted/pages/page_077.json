          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማንሻ ። አንድም ሰበ ኮነ የአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምር ከመ ይፍልስ ፥ ከበዓለ",
