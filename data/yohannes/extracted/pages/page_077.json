          "text": "ምዝንቱ ዓለም ወየሐውር ኀበ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "አብ ዘፈነዎ ።⟫ ማቴ ፳፮ ፪ ፡ ማር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "፲፬ ፩ ። ሉቃ ፳፪ ፩ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": "፩",
          "line_type": "body",
          "text": "ከበዓለ ፋሲካ አስቀድሞ ጌታ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ችን ኢየሱስ ክርስቶስ ከዚህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም በሞት ተለይቶ ወደአ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብ እንዲሄድ ጊዜው እንደደ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ረሰ ያውቅ ነበር ። አፍቀሮሙ",
