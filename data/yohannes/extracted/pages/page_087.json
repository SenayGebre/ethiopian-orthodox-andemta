        },
        {
          "line_num": 36,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሬ ትሩፋትን ታፈሩ ዘንድ ፡ ወ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 37,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትከውኑ ። የኔ ደቀ መዛሙርት",
