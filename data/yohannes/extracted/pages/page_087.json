        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከዓማ ኦሪት ተለይታችሁ የኔ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደቀ መዛሙርት እንድትሆኑ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብትሆኑ በዚህ አባቴ ይመሰ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገናል ። አንድም በዝንቱ ይሰ",
