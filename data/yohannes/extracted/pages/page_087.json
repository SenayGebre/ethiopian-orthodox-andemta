          "text": "⟪ወእሄሉ በፍቅሩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "በፍቅሩም ፀንቼ እንዳለሁ ፥ ዕቀ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 19,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቡ ሀልዉ በል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "⟪ወነገርኩክሙ ዘንተ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 21,
          "margin_tag": "፲፩",
          "line_type": "body",
          "text": "ይህን ነገርኋችሁ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ የሀሉ ልብየ ወፍሥሐየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወፍቅርየ ኀቤክሙ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": null,
          "line_type": "body",
          "text": "ልብየ ትምርት ፥ ፍሥሐየ ልጅ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነት ። ፍቅርየ መስቀል በናንተ ዘ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንድ ፀንቶ ይኖር ዘንድ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ከመ ፍጹመ ይኩን ፍሥሐክሙ⟫",
