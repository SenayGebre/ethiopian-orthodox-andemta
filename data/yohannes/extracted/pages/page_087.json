        },
        {
          "line_num": 38,
          "margin_tag": null,
          "line_type": "body",
          "text": "ትባሉ ዘንድ ። እምዓማክሙ አ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ምጻእኩክሙ ። ከዓማ ኦሪት ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "ይቼ አመጣኋችሁ ።",
