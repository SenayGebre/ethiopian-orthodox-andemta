          "word_wraps_to_next_line": false
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሻችሁት ሁሉ ይደረግላችኋል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወበዝንቱ ይሴባሕ አቡየ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "ከመ ብዙኃ ፍሬ ትፈርዩ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "ብዙ ፍሬ ትሩፋት እንድታፈሩ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": null,
          "line_type": "body",
          "text": "ብትሆኑ ።",
