        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ባሕ ይላል ፡ በዚህ አባቴ ይመ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 35,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰገን ዘንድ ። ከመ ትፍረዩ ፡ ፍ",
