        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጽሞ ደስ ይላችሁ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ዘከመ ይደልዎሙ ለአኃው",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "section_title",
          "text": "ተፋቅሮ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": "፲፪",
          "line_type": "body",
          "text": "⟪ወዛቲ ይእቲ ትእዛዘ እንቲአየ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወዘንተ አዘዝኩክሙ ከመ ትት",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 33,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፋቀሩ በበይቲክሙ በከመ አነ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "አፍቀርኩክሙ ።⟫ ዮሐ ፲፫ ፴፬",
