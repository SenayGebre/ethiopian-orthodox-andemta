          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወባሕቱ ፅንዑ እስመ አነ ሞ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዕክዎ ለዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
