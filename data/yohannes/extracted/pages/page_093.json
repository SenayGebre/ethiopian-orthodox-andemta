        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "አውቀው አምነዋል ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "⟪ወአንሰ በእንቲአሆሙ እስእል⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": "፱",
          "line_type": "body",
          "text": "እኔ ስለርሳቸው እለምንሃለሁ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወአኮ በእንተ ዓለም ዘእስእለ",
