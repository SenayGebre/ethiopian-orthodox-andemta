        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ ተወልጄ እንደመጣሁ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 22,
          "margin_tag": null,
          "line_type": "body",
          "text": "ንተ ፈቃድ ሰው እንደሆንሁ",
