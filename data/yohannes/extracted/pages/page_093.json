        },
        {
          "line_num": 39,
          "margin_tag": null,
          "line_type": "body",
          "text": "ያንተ ገንዘቦች ናቸውና ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 40,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወሊተ ወሀብከኒዮሙ ።⟫",
          "word_wraps_to_next_line": false
        }
      ]
    },
    {
