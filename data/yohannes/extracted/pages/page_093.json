        {
          "line_num": 1,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሰጠንከው መጠን ልጅህም ይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 2,
          "margin_tag": null,
          "line_type": "body",
          "text": "ገልጽልህ ዘንድ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 3,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "⟪ወዛቲ ይእቲ ሕይወት ዘለዓለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 4,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ከመ ያእምሩ ኪያከ ለ፩",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 5,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዘበአማን አምላክ ጽድቅ ባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 6,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቲትከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 7,
          "margin_tag": "፫",
          "line_type": "body",
          "text": "የዘላለም ሕይወት የሚገኝበት",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 8,
          "margin_tag": null,
          "line_type": "body",
          "text": "ሃይማኖትም አንተ ብቻ የባሕ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 9,
          "margin_tag": null,
          "line_type": "body",
          "text": "ርይ አምላክ እንደሆንክ ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 10,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪ወዘፈነውከ ኢየሱስ ክርስቶስ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወልድከ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "የላክኸው ኢየሱስ ክርስቶስ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 13,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም የባሕርይ አምላክ እንደሆ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 14,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነ ያውቁ ዘንድ ነው እንዲያ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "ውቁ መሆን ነው ። ቢያውቁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "በት ነው ቢያውቁ የዘላለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ም ሕይወት የሚገኝበት ሃይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 18,
          "margin_tag": null,
          "line_type": "body",
          "text": "ማኖት ይህች ናት ።",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 19,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "⟪አንሰ ሰባሕኩከ በዲበ ምድር",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 20,
          "margin_tag": null,
          "line_type": "body",
          "text": "ፈጺምየ ግብረ ዘወሀብከኒ ከ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 21,
          "margin_tag": null,
          "line_type": "body",
          "text": "መ እግበር ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 22,
          "margin_tag": "፬",
          "line_type": "body",
          "text": "እሠራው ዘንድ ገንዘብ ያደረግ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 23,
          "margin_tag": null,
          "line_type": "body",
          "text": "ህልኝን ሥራ ሠርቼ ገለጽሁህ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 24,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "⟪ወይእዜኒ አንተ አባ ሰብሐኒ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 25,
          "margin_tag": null,
          "line_type": "body",
          "text": "በስብሐትየ ዘሀሎ ኀቤከ እም",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 26,
          "margin_tag": null,
          "line_type": "body",
          "text": "ቅድመ ይትፈጠር ዓለም ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 27,
          "margin_tag": "፭",
          "line_type": "body",
          "text": "አባት ሆይ አሁንም አንተ ዓ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለም ሳይፈጠር ካንተ ዘንድ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ ጌትነቴ ግለጸኝ ፥ አንድም ⟪በ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ስብሐቲከ ዘሀሎ ኀቤየ⟫ ይላል",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ዓለም ሳይፈጠር ከኔ ዘንድ ባ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "ለ ጌትነትህ ግለጸኝ ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 33,
          "margin_tag": "፮",
          "line_type": "body",
          "text": "⟪ወነገርኩ ስመከ ለሰብእ ለእለ",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 34,
          "margin_tag": null,
          "line_type": "body",
          "text": "ወሀብከኒ እምዓለም ።⟫",
