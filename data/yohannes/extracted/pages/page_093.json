        },
        {
          "line_num": 28,
          "margin_tag": null,
          "line_type": "body",
          "text": "የምለምንህ በሀብት ስበህ በረ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 29,
          "margin_tag": null,
          "line_type": "body",
          "text": "ድኤት አቅርበህ ለሰጠኸኝ ለ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 30,
          "margin_tag": null,
          "line_type": "body",
          "text": "ኒህ ነው እንጂ ለሌላው ያይ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 31,
          "margin_tag": null,
          "line_type": "body",
          "text": "ደል ፥",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 32,
          "margin_tag": null,
          "line_type": "body",
          "text": "⟪እስመ እሊአከ እሙንቱ ።⟫",
