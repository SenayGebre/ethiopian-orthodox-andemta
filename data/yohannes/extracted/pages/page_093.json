          "line_num": 14,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "⟪ወእሙንቱሂ ነሢኦሙ አማን",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 15,
          "margin_tag": null,
          "line_type": "body",
          "text": "አእመሩ ከመ እምኀቤከ ወጻ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 16,
          "margin_tag": null,
          "line_type": "body",
          "text": "እኩ ወአምኑ ከመ አንተ ፈ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 17,
          "margin_tag": null,
          "line_type": "body",
          "text": "ነውከኒ ።⟫",
          "word_wraps_to_next_line": false
        },
        {
          "line_num": 18,
          "margin_tag": "፰",
          "line_type": "body",
          "text": "እርሳቸውም የነገርኳቸውን ት",
