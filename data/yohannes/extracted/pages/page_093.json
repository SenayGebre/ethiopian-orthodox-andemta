        },
        {
          "line_num": 11,
          "margin_tag": null,
          "line_type": "body",
          "text": "የሰጠኸኝን ነገር ሰጥቻቸዋለሁ",
          "word_wraps_to_next_line": true
        },
        {
          "line_num": 12,
          "margin_tag": null,
          "line_type": "body",
          "text": "ና ማለት የነገርኸኝን አስተም",
